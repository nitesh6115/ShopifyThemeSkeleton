[
  {
    "name": "theme_info",
    "theme_name": "CoderX",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "default": 100,
        "unit": "px",
        "label": "Logo Width"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Color Scheme",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background Gradient",
            "info": "If you want Background in Gradient then  you can use this other you can make it empty"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text Color",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Primary Button Background",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button_border_color",
            "label": "Primary Button Border Color",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Primary Button Text",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button",
            "label": "Secondary Button Background",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "secondary_button_border_color",
            "label": "Secondary Button Border Color",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Secondary Button Text",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "shadow",
            "default": "#121212"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button_border_color",
          "secondary_button": "secondary_button",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_border_color"
        }
      }
    ]
  },
  {
  "name": "Typography",
  "settings": [

    {
      "type": "header",
      "content": "Font Families"
    },

    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "inter_n6"
    },

    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body Font",
      "default": "inter_n4"
    },

    {
      "type": "font_picker",
      "id": "nav_font",
      "label": "Navigation Font",
      "default": "inter_n5"
    },

    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Button Font",
      "default": "inter_n6"
    },

    {
      "type": "header",
      "content": "Typography Scale"
    },

    {
      "type": "range",
      "id": "base_font_size",
      "label": "Base Font Size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading Scale Ratio",
      "min": 1.1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.2
    },

    {
      "type": "header",
      "content": "Mobile Typography"
    },

    {
      "type": "range",
      "id": "mobile_scale",
      "label": "Mobile Font Scale",
      "min": 1.1,
      "max": 1.5,
      "step": 0.1,
      "default": 1.2
    },

    {
      "type": "header",
      "content": "Button Typography"
    },

    {
      "type": "range",
      "id": "button_size",
      "label": "Button Font Size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "select",
      "id": "button_transform",
      "label": "Button Text Transform",
      "options": [
        { "value": "none", "label": "Normal" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    }

  ]
},
{
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  }
]
