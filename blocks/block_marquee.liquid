      "id": "pause_hover",
      "label": "Pause on hover",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "drag",
      "label": "Enable drag",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "auto_duplicate",
      "label": "Auto duplicate content",
      "default": true
    },

    {
      "type": "range",
      "id": "speed",
      "label": "Speed Desktop",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 30
    },

    {
      "type": "range",
      "id": "speed_mobile",
      "label": "Speed Mobile",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Hover zoom"
    },

    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box shadow"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
