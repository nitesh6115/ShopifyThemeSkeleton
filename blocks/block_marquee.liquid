      "id": "pause_hover",
      "label": "Pause on hover",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "drag",
      "label": "Enable drag",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "auto_duplicate",
