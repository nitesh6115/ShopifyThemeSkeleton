{%- capture style_schema -%}
  --gap: {{ block.settings.gap }}px;
  --gap-m: {{ block.settings.gap_m }}px;
  --bg: {{ block.settings.background }};
  --speed: {{ block.settings.speed }};
  --speed-mobile: {{ block.settings.speed_mobile }};
  --dir: {{ block.settings.marquee_direction }};
   {% if block.settings.set_full_radius %}
  --radius-top-left: {{ block.settings.radius_top_left }}px;
  --radius-top-right: {{ block.settings.radius_top_right }}px;
  --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
  --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
  {% else %}
  --radius-top-left: {{ block.settings.radius }}px;
  --radius-top-right: {{ block.settings.radius }}px;
  --radius-bottom-left: {{ block.settings.radius }}px;
  --radius-bottom-right: {{ block.settings.radius }}px;
  {% endif %}
  --border: {{ block.settings.border }}px;
  --border-color: {{ block.settings.border_color }};
  --pt: {{ block.settings.pt }}px;
  --pb: {{ block.settings.pb }}px;
  --pl: {{ block.settings.pl }}px;
  --pr: {{ block.settings.pr }}px;
  --ptm: {{ block.settings.ptm }}px;
  --pbm: {{ block.settings.pbm }}px;
  --plm: {{ block.settings.plm }}px;
  --prm: {{ block.settings.prm }}px;
{%- endcapture -%}

{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list -%}
  marquee;
  {{ block.settings.layout_direction }};
  {% if block.settings.width == 'custom' %}
  block-custom-width-desktop;
  {% else %}
  block-width-desktop-{{ block.settings.width }};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  block-custom-width-tablet;
  {% else %}
  block-width-tablet-{{ block.settings.width_tablet }};
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  block-custom-width-mobile;
  {% else %}
  block-width-mobile-{{ block.settings.width_mobile }};
  {% endif %}
{% endcapture %}
{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}
<div
  id="marquee-{{ block.id }}"
  class="{{ class_list }}"
  style="{{ style_schema }}"
  data-speed="{{ block.settings.speed }}"
  data-dir="{{ block.settings.marquee_direction }}"
  data-reverse="{{ block.settings.reverse }}"
  data-hover="{{ block.settings.pause_hover }}"
  data-drag="{{ block.settings.drag }}"
  data-dup="{{ block.settings.auto_duplicate }}"
  data-speed="{{ block.settings.speed }}"
  data-speed-m="{{ block.settings.speed_mobile }}"
  {{ block.shopify_attributes }}
>
  <div class="marquee-inner">
    <div class="marquee-track">
      <div class="marquee-loop">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>
{% stylesheet %}
      .marquee {
      overflow: hidden;
      position: relative;
      background: var(--bg);
  	border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
  	border: var(--border) solid var(--border-color);
  	padding-top: var(--pt);
  	padding-bottom: var(--pb);
  	padding-left: var(--pl);
  	padding-right: var(--pr);
    }
    .marquee-inner {
      overflow: hidden;
      width: 100%;
    }
    .marquee-track {
      display: flex;
      gap: var(--gap);
      width: max-content;
      will-change: transform;
    }

    .marquee-loop {

      display: flex;
      gap: var(--gap);

    }
    .marquee-loop > * {
      flex: 0 0 auto;
    }
  .marquee[data-dir="vertical"] .marquee-track {
    flex-direction: column;
  }
  .marquee.is-paused .marquee-track {
    animation-play-state: paused;
    pointer-events: auto;
  }
  .marquee-dragging {
    cursor: grabbing;
  }
  @media (max-width: 767px) {
  .marquee {
  		gap: var(--gap-m);
  		padding-top: var(--ptm);
  		padding-bottom: var(--pbm);
  		padding-left: var(--plm);
  		padding-right: var(--prm);
  	}
  }
{% endstylesheet %}
{% javascript %}
  window.marqueeInit = window.marqueeInit || {};
  function initMarquee(block) {
    const id = block.dataset.id;
    if (window.marqueeInit[id]) return;
    window.marqueeInit[id] = true;
    const track = block.querySelector('.marquee-track');
    let speedDesktop = parseFloat(block.dataset.speed) || 30;
    let speedMobile = parseFloat(block.dataset.speedM) || 20;
    let dir = block.dataset.dir || 'horizontal';
    let reverse = block.dataset.reverse === 'true';
    let pauseHover = block.dataset.hover === 'true';
    let drag = block.dataset.drag === 'true';
    let dup = block.dataset.dup === 'true';
    let speed = window.innerWidth < 768 ? speedMobile : speedDesktop;
    let pos = 0;
    let isDown = false;
    let startX = 0;
    // auto duplicate
    if (dup) {
      while (track.scrollWidth < block.offsetWidth * 2) {
        track.innerHTML += track.innerHTML;
      }
    }
    function animate() {
      if (!isDown) {
        if (reverse) {
          pos += speed * 0.02;
        } else {
          pos -= speed * 0.02;
        }
        if (dir === 'horizontal') {
          if (Math.abs(pos) > track.scrollWidth / 2) pos = 0;
          track.style.transform = `translateX(${pos}px)`;
        } else {
          if (Math.abs(pos) > track.scrollHeight / 2) pos = 0;
          track.style.transform = `translateY(${pos}px)`;
        }
      }
      requestAnimationFrame(animate);
    }
    animate();
    // pause hover
    if (pauseHover) {
      block.addEventListener('mouseenter', () => {
        isDown = true;
      });
      block.addEventListener('mouseleave', () => {
        isDown = false;
      });
    }
    // drag
    if (drag) {
      block.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.clientX;
      });
      window.addEventListener('mouseup', () => {
        isDown = false;
      });
      window.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        let move = e.clientX - startX;
        pos += move * 0.5;
        startX = e.clientX;
      });
    }
    // touch
    block.addEventListener('touchstart', (e) => {
      isDown = true;
      startX = e.touches[0].clientX;
    });
    block.addEventListener('touchend', () => {
      isDown = false;
    });
    block.addEventListener('touchmove', (e) => {
      if (!isDown) return;
      let move = e.touches[0].clientX - startX;
      pos += move * 0.5;
      startX = e.touches[0].clientX;
    });
  }
  document.querySelectorAll('.marquee').forEach((el) => {
    initMarquee(el);
  });
  document.addEventListener('shopify:section:load', function (e) {
    e.target.querySelectorAll('.marquee').forEach((el) => {
    initMarquee(block);
    })
  });
{% endjavascript %}
{% schema %}
{
  "name": "Marquee",
  "tag": null,
  "blocks": [{ "type": "@theme" }],

  "settings": [
    {
      "type": "header",
      "content": "Marquee Settings"
    },

    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Direction",
      "default": "horizontal",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" }
      ]
    },

    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Reverse direction",
      "default": false
    },

    {
