{%- capture style_schema -%}
  --gap: {{ block.settings.gap }}px;
  --align-y: {{ block.settings.align_y }};
  --gap-m: {{ block.settings.gap_m }}px;
  --bg: {{ block.settings.background }};
  --speed: {{ block.settings.speed }};
  --speed-mobile: {{ block.settings.speed_mobile }};
  --dir: {{ block.settings.marquee_direction }};
   {% if block.settings.set_full_radius %}
  --radius-top-left: {{ block.settings.radius_top_left }}px;
  --radius-top-right: {{ block.settings.radius_top_right }}px;
  --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
  --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
  {% else %}
  --radius-top-left: {{ block.settings.radius }}px;
  --radius-top-right: {{ block.settings.radius }}px;
  --radius-bottom-left: {{ block.settings.radius }}px;
  --radius-bottom-right: {{ block.settings.radius }}px;
  {% endif %}
  --border: {{ block.settings.border }}px;
  --border-color: {{ block.settings.border_color }};
  --pt: {{ block.settings.pt }}px;
  --pb: {{ block.settings.pb }}px;
  --pl: {{ block.settings.pl }}px;
  --pr: {{ block.settings.pr }}px;
  --ptm: {{ block.settings.ptm }}px;
  --pbm: {{ block.settings.pbm }}px;
  --plm: {{ block.settings.plm }}px;
  --prm: {{ block.settings.prm }}px;
{%- endcapture -%}

{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list -%}
  marquee;
  {{ block.settings.layout_direction }};
  {% if block.settings.width == 'custom' %}
  block-custom-width-desktop;
  {% else %}
  block-width-desktop-{{ block.settings.width }};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  block-custom-width-tablet;
  {% else %}
  block-width-tablet-{{ block.settings.width_tablet }};
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  block-custom-width-mobile;
  {% else %}
  block-width-mobile-{{ block.settings.width_mobile }};
  {% endif %}
{% endcapture %}
{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}
<div
  id="marquee-{{ block.id }}"
  class="{{ class_list }}"
  style="{{ style_schema }}"
  data-speed="{{ block.settings.speed }}"
  data-reverse="{{ block.settings.reverse }}"
  data-hover="{{ block.settings.pause_hover }}"
  data-drag="{{ block.settings.drag }}"
  data-dup="{{ block.settings.auto_duplicate }}"
  data-speed="{{ block.settings.speed }}"
  data-speed-m="{{ block.settings.speed_mobile }}"
  {{ block.shopify_attributes }}
>
  <div class="marquee-inner">
    <div class="marquee-track">
      <div class="marquee-loop">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>
{% stylesheet %}
      .marquee {
      overflow: hidden;
      position: relative;
      background: var(--bg);
  	border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
  	border: var(--border) solid var(--border-color);
  	padding-top: var(--pt);
  	padding-bottom: var(--pb);
  	padding-left: var(--pl);
  	padding-right: var(--pr);
    }
    .marquee-inner {
      overflow: hidden;
      width: 100%;
    }
    .marquee-track {
      display: flex;
      gap: var(--gap);
      width: max-content;
      will-change: transform;
    }

    .marquee-loop {
      align-items: var(--align-y);
      display: flex;
      gap: var(--gap);

    }
    .marquee-loop > * {
      flex: 0 0 auto;
    }
  .marquee.is-paused .marquee-track {
    animation-play-state: paused;
    pointer-events: auto;
  }
  .marquee-dragging {
    cursor: grabbing;
  }
  @media (max-width: 767px) {
  .marquee {
  		gap: var(--gap-m);
  		padding-top: var(--ptm);
  		padding-bottom: var(--pbm);
  		padding-left: var(--plm);
  		padding-right: var(--prm);
  	}
  }
{% endstylesheet %}
{% javascript %}
function initMarquee(block) {

  if (block.marqueeInit) return;
  block.marqueeInit = true;

  const track = block.querySelector(".marquee-track");
  const loop = block.querySelector(".marquee-loop");

  let speedDesktop = parseFloat(block.dataset.speed) || 1;
  let speedMobile = parseFloat(block.dataset.speedM) || 1;

  let reverse = block.dataset.reverse === "true";
  let pauseHover = block.dataset.hover === "true";
  let drag = block.dataset.drag === "true";
  let dup = block.dataset.dup === "true";

  let pos = 0;
  let lastTime = 0;
  let isPaused = false;
  let isDown = false;
  let startX = 0;

  let loopSize = 0;
  let speed = 0;



  /* ---------------- SPEED ---------------- */

  function getSpeed() {
    speed =
      window.innerWidth < 768
        ? speedMobile
        : speedDesktop;
  }



  /* ---------------- DUPLICATE ---------------- */

    function buildLoop() {

      track.innerHTML = "";

      const base = loop.cloneNode(true);

      track.appendChild(base);

      let total = base.offsetWidth;

      while (total < block.offsetWidth * 3) {

        const clone = loop.cloneNode(true);

        track.appendChild(clone);

        total += clone.offsetWidth;
      }

      loopSize = base.getBoundingClientRect().width;
    }



  /* ---------------- ANIMATION ---------------- */

    function frame(time) {

      if (!lastTime) lastTime = time;

      const delta = time - lastTime;

      lastTime = time;

      if (!isPaused && !isDown) {

        const move = (speed * delta) / 50;

        pos += reverse ? move : -move;

        /* ✅ smooth infinite using modulo */

        if (loopSize > 0) {
          pos = pos % loopSize;
        }

        track.style.transform =
          `translate3d(${pos}px,0,0)`;
      }

      requestAnimationFrame(frame);
    }


  /* ---------------- HOVER ---------------- */

  if (pauseHover) {

    block.addEventListener("mouseenter", () => {
      isPaused = true;
    });

    block.addEventListener("mouseleave", () => {
      isPaused = false;
    });
  }



  /* ---------------- DRAG ---------------- */

  if (drag) {

    block.addEventListener("mousedown", e => {

      isDown = true;
      startX = e.clientX;

    });

    window.addEventListener("mouseup", () => {
      isDown = false;
    });

    window.addEventListener("mousemove", e => {

      if (!isDown) return;

      const dx = e.clientX - startX;

      pos += dx;

      startX = e.clientX;
    });
  }



  /* ---------------- TOUCH ---------------- */

  block.addEventListener("touchstart", e => {

    isDown = true;
    startX = e.touches[0].clientX;

  });

  block.addEventListener("touchend", () => {
    isDown = false;
  });

  block.addEventListener("touchmove", e => {

    if (!isDown) return;

    const dx =
      e.touches[0].clientX - startX;

    pos += dx;

    startX = e.touches[0].clientX;

  });



  /* ---------------- INIT ---------------- */

  function init() {

    getSpeed();

    buildLoop();

    lastTime = 0;

  }

  init();

  requestAnimationFrame(frame);



  /* ---------------- RESIZE FIX ---------------- */

  window.addEventListener(
    "resize",
    () => {

      init();

    }
  );
}



/* ---------- INIT ---------- */

document
  .querySelectorAll(".marquee")
  .forEach(initMarquee);



document.addEventListener(
  "shopify:section:load",
  e => {

    e.target
      .querySelectorAll(".marquee")
      .forEach(initMarquee);

  }
);
{% endjavascript %}
{% schema %}
