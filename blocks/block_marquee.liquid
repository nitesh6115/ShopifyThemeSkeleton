{%- capture style_schema -%}
  --align-x: {{ block.settings.align_x }};
  --align-y: {{ block.settings.align_y }};
  --child-size: {{ block.size }};
  --wrap: nowrap;
  --gap: {{ block.settings.gap }}px;
  --gap-m: {{ block.settings.gap_m }}px;
  --bg: {{ block.settings.background }};
  --speed: {{ block.settings.speed }};
{%- endcapture -%}

{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list -%}
  marquee;
  group;
  {{ block.settings.layout_direction }};
  box-nowrap;

  {% if block.settings.width == 'custom' %}
  block-custom-width-desktop;
  {% else %}
  block-width-desktop-{{ block.settings.width }};
  {% endif %}

  {% if block.settings.width_tablet == 'custom' %}
  block-custom-width-tablet;
  {% else %}
  block-width-tablet-{{ block.settings.width_tablet }};
  {% endif %}

  {% if block.settings.width_mobile == 'custom' %}
  block-custom-width-mobile;
  {% else %}
  block-width-mobile-{{ block.settings.width_mobile }};
  {% endif %}

{% endcapture %}

{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}

<div
  class="{{ class_list }}"
  style="{{ style_schema }}"
  data-speed="{{ block.settings.speed }}"
  {{ block.shopify_attributes }}
>
  <div class="marquee-inner">
    <div class="marquee-track">
      <div class="marquee-loop">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>
{% stylesheet %}
    .marquee {

    overflow: hidden;
    position: relative;

  }

  .marquee-inner {

    overflow: hidden;
    width: 100%;

  }

  .marquee-track {

    display: flex;
    gap: var(--gap);

    width: max-content;

    will-change: transform;

  }

  .marquee-loop {

    display: flex;
    gap: var(--gap);

  }

  .marquee-loop > * {

    flex: 0 0 auto;

  }
{% endstylesheet %}
{% javascript %}
  document.querySelectorAll('.marquee').forEach((block) => {
    const track = block.querySelector('.marquee-track');

    let speed = parseFloat(block.dataset.speed) || 30;

    let pos = 0;

    function animate() {
      pos -= speed * 0.02;

      if (Math.abs(pos) > track.scrollWidth / 2) {
        pos = 0;
      }

      track.style.transform = `translateX(${pos}px)`;

      requestAnimationFrame(animate);
    }

    animate();
  });
{% endjavascript %}
{% schema %}
