{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
-%}
{%- capture style_schema -%}
--block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-desktop-text-alignment: left;
                --block-mobile-text-alignment: left;
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
                --pill-bg: {{ block.settings.pill-bg }};
                --pill-text: {{ block.settings.pill-text }};
                --pill-hover-bg: {{ block.settings.hover-pill-bg }};
                --pill-hover-text: {{ block.settings.hover-pill-text }};
                --pill-radius: {{ block.settings.pill-radius }}px;
                --pill-border: {{ block.settings.pill-border }};
                --pill-border-width: {{ block.settings.pill-border-width }}px;
                --pill-hover-border: {{ block.settings.hover-pill-border }};
                --price-color: {{ block.settings.price_color }};
                --compare-color: {{ block.settings.compare_color }};
                --save-bg: {{ block.settings.saving_off_bg }};
                --save-color: {{ block.settings.saving_off_color }};
{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}
<div class="product_block variant_picker {% if product.has_only_default_variant %}hidden-varaints{% endif %}" {{ block.shopify_attributes }} style="{{- style_schema -}}">
  {% for option in product.options_with_values %}
    <div class="product-option" data-option-position="{{ option.position }}">
      <label>{{ option.name }}</label>

      <div class="option-values">
        {% for value in option.values %}
          {% assign variant = value.variant %}

          <button
            type="button"
            class="option-value {% if block.settings.show_price and product.options.size > 0 %} single_price_option {% endif %}"
            data-value="{{ value | escape }}"
          >
            {% if block.settings.show_saving_off and product.options.size > 0 %}
              {% if variant.compare_at_price > variant.price %}
                {% assign discount = variant.compare_at_price | minus: variant.price %}
                {% assign discount_percentage = discount | times: 100 | divided_by: variant.compare_at_price | round %}
                <span class="saving">{{ discount_percentage }}% OFF</span>
              {% endif %}
            {% endif %}

            <span>{{ value }}</span>

            {% if block.settings.show_price and product.options.size > 0 %}
              <span class="v_price">
                {{ variant.price | money }}
                {% if variant.compare_at_price > variant.price %}
                  <span class="v_compare_price">
                    {{ variant.compare_at_price | money }}
                  </span>
                {% endif %}
              </span>
            {% endif %}
          </button>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
{% stylesheet %}
  .hidden-varaints{
    display: none;
  }
  .option-value.is-unavailable {
    opacity: 0.3;
    pointer-events: none;
  }
  .sls-selling-plan-group-options{
      display: flex !important;
  }
  label#seal-purchase-options-label {
      display: none;
  }
  .sls-more-info-container {
      display: none;
  }
  button.option-value.single_price_option {
      display: flex;
      align-items: center;
      flex-direction: column;
      gap: 9px;
      padding: 25px 20px;
      margin-top: 20px;
  }
  .sls-widget-branding {
      display: none;
  }
  .sls-option-container.seal-table.sls-active {
      border: 2px solid #eecdb6 !important;
      box-shadow: none !important;
  }
  .option-value.is-soldout {
    opacity: 0.5;
    text-decoration: line-through;
    cursor: not-allowed !important;
  }
  .product-option label {
      font-size: 14px;
  }
  .product-option .option-value {
      min-height: 44px;
      padding: 0 15px;
      background: var(--pill-bg);
      border: var(--pill-border-width) solid var(--pill-border);
      border-radius: var(--pill-radius);
      color: var(--pill-text);
      cursor: pointer;
      position: relative;
      font-size: 14px;
  }

  .product-option .option-values {
      gap: 20px;
    --variant-min-width: 100px;
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(var(--variant-min-width), 1fr)
    );
  }

  .product-option .option-value.is-active,
  .product-option .option-value:hover {
      background: var(--pill-hover-bg);
      color: var(--pill-hover-text);
      border-color: var(--pill-hover-border);
  }

  .product-option {
      padding: 10px 0;
  }
  .product-option span.v_price {
      color: var(--price-color);
      font-size: 17px;
      font-weight: bold;
  }

  .product-option span.v_price span.v_compare_price {
      font-size: 15px;
      text-decoration: line-through;
      color: var(--compare-color);
  }

  .product-option .option-values span.saving {
      position: absolute;
      top: -18px;
      margin: 0 auto;
      background: var(--save-bg);
      padding: 8px 10px;
      font-size: 12px;
      font-weight: bold;
      color: var(--save-color);
      border-radius: var(--pill-radius);
  }
  @media(max-width: 767px){
    .product-option .option-values{
      gap: 10px;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "tag": null,
  "name": "Variant Selector",
  "settings": [
    {
      "type": "header",
      "content": "Block Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "max": 100,
      "min": 0,
      "default": 5,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "max": 100,
      "min": 0,
      "default": 5,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_radius",
      "label": "Block Radius",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Block Background"
    },
    {
      "type": "header",
      "content": "Variant Picker Style"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Each Varaints Price",
      "info": "Its work when prodcut have only one option"
    },
    {
      "type": "color",
      "id": "price_color",
      "visible_if": "{{ block.settings.show_price == true }}",
      "label": "Price Color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "compare_color",
      "visible_if": "{{ block.settings.show_price == true }}",
      "label": "Compare Price Color",
      "default": "#ddd"
    },
    {
      "type": "checkbox",
      "id": "show_saving_off",
      "label": "Show Saving Off",
      "info": "Its work when prodcut have only one option and its varaints has compare price"
    },
    {
      "type": "color",
      "id": "saving_off_bg",
      "visible_if": "{{ block.settings.show_saving_off == true }}",
      "label": "Saving Of Background Color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "saving_off_color",
      "visible_if": "{{ block.settings.show_saving_off == true }}",
      "label": "Saving of Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Pills Color Settigns"
    },
    {
      "type": "color",
      "id": "pill-bg",
      "label": "Pill Background Color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "pill-text",
      "label": "Pill text Color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "pill-border",
      "label": "Pill Border Color",
      "default": "#000"
    },
    {
      "type": "header",
      "content": "Pills Hover Settings"
    },
    {
      "type": "color",
      "id": "hover-pill-bg",
      "label": "Pill Background Hover Color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "hover-pill-text",
      "label": "Pill Text Hover Color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "hover-pill-border",
      "label": "Pill Border Hover Color",
      "default": "#000"
    },
    {
      "type": "range",
      "id": "pill-border-width",
      "label": "Pill Border Size",
      "default": 1,
      "min": 0,
      "max": 50,
      "unit": "px",
      "step": 1
    },
    {
      "type": "range",
      "id": "pill-radius",
      "label": "Pill Border Radius",
      "default": 10,
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1
    }
  ],
  "presets": [{ "name": "variant_picker" }]
}
{% endschema %}
