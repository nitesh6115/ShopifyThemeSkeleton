{% capture style_schema %}
--bg: {{ block.settings.background }};
    {% if block.settings.set_full_radius %}
    --radius-top-left: {{ block.settings.radius_top_left }}px;
    --radius-top-right: {{ block.settings.radius_top_right }}px;
    --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
    --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
    {% else %}
    --radius-top-left: {{ block.settings.radius }}px;
    --radius-top-right: {{ block.settings.radius }}px;
    --radius-bottom-left: {{ block.settings.radius }}px;
    --radius-bottom-right: {{ block.settings.radius }}px;
    {% endif %}
    --border: {{ block.settings.border }}px;
    --border-color: {{ block.settings.border_color }};
    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;
    --pt-m: {{ block.settings.pt_m }}px;
    --pb-m: {{ block.settings.pb_m }}px;
    --pl-m: {{ block.settings.pl_m }}px;
    --pr-m: {{ block.settings.pr_m }}px;

    {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%;
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
    {% endif %}
{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}

{% capture class_list %}
  slider_block_container;
    {% if block.settings.height == 'custom' %}
     block-custom-height-desktop;
     {% else %}
    block-height-desktop-{{ block.settings.height }};
    {% endif %}
    {% if block.settings.width == 'custom' %}
    block-custom-width-desktop;
    {% else %}
    block-width-desktop-{{ block.settings.width }};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    block-custom-width-tablet;
    {% else %}
     block-width-tablet-{{ block.settings.width_tablet }};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    block-custom-width-mobile;
    {% else %}
     block-width-mobile-{{ block.settings.width_mobile }};
    {% endif %}
    ratio--{{ block.settings.ratio }}
    {% if block.settings.hover_zoom %}is-zoom;{% endif %}
    {% if block.settings.shadow %}is-shadow;{% endif %}
    {% if block.settings.hide_desktop %}hide-desktop;{% endif %}
  {% if block.settings.hide_mobile %}hide-mobile;{% endif %}
{% endcapture %}
{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}

<div class="{{- class_list -}}" style="{{- style_schema -}}" {{ block.shopify_attributes }}>
  {% capture slider_style %}
    --arrow-color: {{ block.settings.arrow_color }};
      --arrow-bg: {{ block.settings.arrow_bg }};
      --dot-color: {{ block.settings.dot_color }};
      --dot-active: {{ block.settings.dot_active }};
      --per-row-desktop: {{ block.settings.per_row_desktop }};
      --per-row-tablet: {{ block.settings.per_row_tablet }};
      --per-row-mobile: {{ block.settings.per_row_mobile }};

      --gap: {{ block.settings.gap }}px;
      --gap-m: {{ block.settings.gap_m }}px;
  {% endcapture %}
  {% assign slider_style = slider_style | strip_newlines %}

  <div
    class=" slider_block slider-{{ block.id }} {% if block.settings.enable_desktop %} slider-desktop{% endif %} {% if block.settings.enable_tablet %} slider-tablet{% endif %} {% if block.settings.enable_mobile %} slider-mobile{% endif %}"
    data-id="{{ block.id }}"
    id="slider-{{ block.id }}"
    data-adaptive="{{ block.settings.adaptive_height }}"
    data-autoplay="{{ block.settings.autoplay }}"
    data-speed="{{ block.settings.autoplay_speed }}"
    data-arrows="{{ block.settings.show_arrows }}"
    data-dots="{{ block.settings.show_dots }}"
    data-infinite="{{ block.settings.infinite }}"
    data-per-desktop="{{ block.settings.per_row_desktop }}"
    data-per-tablet="{{ block.settings.per_row_tablet }}"
    data-per-mobile="{{ block.settings.per_row_mobile }}"
    style="{{- slider_style -}}"
  >
    <div class="slider-inner">
      <div class="slider-track" id="track-{{ block.id }}">
        {% content_for 'blocks' %}
      </div>
    </div>

    {% if block.settings.show_arrows %}
      <button class="slider-prev" data-id="{{ block.id }}">‹</button>
      <button class="slider-next" data-id="{{ block.id }}">›</button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="slider-dots" id="dots-{{ block.id }}"></div>
    {% endif %}
  </div>
</div>
{% javascript %}

function initSlider(id) {

  const slider =
    document.getElementById("slider-" + id);

  if (!slider) return;

  const track =
    document.getElementById("track-" + id);

  const prev =
    slider.querySelector(".slider-prev");

  const next =
    slider.querySelector(".slider-next");

  const dotsWrap =
    document.getElementById("dots-" + id);

  const slides =
    [...track.children];

  const infinite =
    slider.dataset.infinite === "true";

  const adaptive =
    slider.dataset.adaptive === "true";

  const autoplay =
    slider.dataset.autoplay === "true";

  const speed =
    parseInt(slider.dataset.speed) || 3000;

  let index = 0;



  /* -------------------- */

  function getPerRow() {

    const desktop =
      parseInt(slider.dataset.perDesktop) || 1;

    const tablet =
      parseInt(slider.dataset.perTablet) || 1;

    const mobile =
      parseInt(slider.dataset.perMobile) || 1;

    if (window.innerWidth >= 1366)
      return desktop;

    if (window.innerWidth >= 768)
      return tablet;

    return mobile;

  }



  /* -------------------- */

  function updateHeight() {

    if (!adaptive) return;

    const inner =
      slider.querySelector(".slider-inner");

    const slide =
      slides[index];

    if (!slide) return;

    inner.style.height =
      slide.offsetHeight + "px";

  }



  /* -------------------- */

  function go(i) {

    const perRow =
      getPerRow();

    const pages =
      Math.ceil(
        slides.length / perRow
      );

    const maxIndex =
      (pages - 1) * perRow;

    if (infinite) {

      if (i > maxIndex)
        i = 0;

      if (i < 0)
        i = maxIndex;

    } else {

      if (i > maxIndex)
        i = maxIndex;

      if (i < 0)
        i = 0;

    }

    index = i;

    const slide =
      slides[index];

    if (!slide) return;

    track.scrollTo({
      left: slide.offsetLeft,
      behavior: "smooth"
    });

    updateDots();
    updateHeight();

  }



  /* -------------------- */
  /* swipe / scroll dots fix */

  let scrollTimer;

  track.addEventListener(
    "scroll",
    () => {

      clearTimeout(scrollTimer);

      scrollTimer =
        setTimeout(() => {

          const perRow =
            getPerRow();

          let closest = 0;
          let min = Infinity;

          slides.forEach(
            (slide, i) => {

              const diff =
                Math.abs(
                  slide.offsetLeft -
                  track.scrollLeft
                );

              if (diff < min) {

                min = diff;
                closest = i;

              }

            }
          );

          index =
            Math.floor(
              closest / perRow
            ) * perRow;

          updateDots();
          updateHeight();

        }, 80);

    }
  );



  /* -------------------- */

  if (prev)
    prev.onclick =
      () => go(
        index - getPerRow()
      );

  if (next)
    next.onclick =
      () => go(
        index + getPerRow()
      );



  /* -------------------- */

  function buildDots() {

    if (!dotsWrap) return;

    dotsWrap.innerHTML = "";

    const perRow =
      getPerRow();

    const pages =
      Math.ceil(
        slides.length / perRow
      );

    for (let i = 0; i < pages; i++) {

      const b =
        document.createElement("button");

      b.onclick =
        () => go(
          i * perRow
        );

      dotsWrap.appendChild(b);

    }

  }



  /* -------------------- */

  function updateDots() {

    if (!dotsWrap) return;

    const perRow =
      getPerRow();

    const page =
      Math.round(
        index / perRow
      );

    dotsWrap
      .querySelectorAll("button")
      .forEach(
        (d, i) => {

          d.classList.toggle(
            "active",
            i === page
          );

        }
      );

  }



  /* -------------------- */

  let autoTimer = null;

function startAutoplay() {

  if (!autoplay) return;

  stopAutoplay();

  autoTimer = setInterval(() => {

    go(
      index + getPerRow()
    );

  }, speed);

}

function stopAutoplay() {

  if (autoTimer) {

    clearInterval(autoTimer);
    autoTimer = null;

  }

}



  /* -------------------- */
  /* drag */

  let isDown = false;
  let startX;
  let scrollLeft;

  track.addEventListener(
  "pointerdown",
  (e) => {

    stopAutoplay();

    isDown = true;
    startX = e.pageX;
    scrollLeft = track.scrollLeft;

  }
);

  track.addEventListener(
  "pointerup",
  () => {

    isDown = false;
    startAutoplay();

  }
);

 track.addEventListener(
  "pointerleave",
  () => {

    isDown = false;
    startAutoplay();

  }
);

  track.addEventListener(
    "pointermove",
    (e) => {

      if (!isDown) return;

      const walk =
        e.pageX - startX;

      track.scrollLeft =
        scrollLeft - walk;

    }
  );



  /* -------------------- */

  function updateSliderItems() {

    const perRow =
      getPerRow();

    const gap =
      parseFloat(
        getComputedStyle(track).gap
      ) || 0;

    const width =
      track.getBoundingClientRect()
        .width;

    const itemWidth =
      (width -
        gap * (perRow - 1))
      / perRow;

    slides.forEach(el => {

      el.style.flex =
        "0 0 auto";

      el.style.width =
        itemWidth + "px";

    });

  }



  /* -------------------- */

  updateSliderItems();
  buildDots();
  updateDots();
  updateHeight();
  startAutoplay();


  window.addEventListener(
    "resize",
    () => {

      updateSliderItems();
      buildDots();
      updateDots();
      updateHeight();
      startAutoplay();

    }
  );

}



/* ---------- INIT ---------- */

document
  .querySelectorAll(
    ".slider_block"
  )
  .forEach(el => {

    initSlider(
      el.dataset.id
    );

  });



document.addEventListener(
  "shopify:section:load",
  function (e) {

    e.target
      .querySelectorAll(
        ".slider_block"
      )
      .forEach(el => {

        initSlider(
          el.dataset.id
        );

      });

  }
);

{% endjavascript %}
{% stylesheet %}
       .slider_block_container {
        background: var(--bg);
        border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
        border: var(--border) solid var(--border-color);
        padding-top: var(--pt);
        padding-bottom: var(--pb);
        padding-left: var(--pl);
        padding-right: var(--pr);
        overflow: hidden;
        position: relative;
      }

    .slider_block{
    position:relative;
    width:100%;
    }

    .slider-inner{
    overflow:hidden;

  transition:height .3s ease;
    }

    .slider-track{
    display:flex;
    gap:var(--gap,8px);
    overflow-x:auto;
    scroll-behavior:smooth;
    scroll-snap-type:x mandatory;

  align-items:flex-start;
    }
  .slider-track{
  overflow-x:auto;
  overflow-y:hidden;

  /* hide scrollbar firefox */
  scrollbar-width:none;

  /* smooth */
  -webkit-overflow-scrolling:touch;
  }

  /* hide scrollbar chrome safari edge */
  .slider-track::-webkit-scrollbar{
  display:none;
  }
    .slider-track > *{
    scroll-snap-align:start;
    flex:0 0 auto;
    }

    /* arrows */

    .slider-prev,
    .slider-next{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:36px;
    height:36px;
    border:none;
    cursor:pointer;
    background:var(--arrow-bg);
    color:var(--arrow-color);
    box-shadow: 0px 4px 6px -4px #0000001A;
    border-radius: 100%;
    z-index:5;
    }

    .slider-prev{ left:0; }
    .slider-next{ right:0; }


    /* dots */

    .slider-dots{
    display:flex;
    gap:6px;
    justify-content:center;
    margin-top:8px;
    }

    .slider-dots button{
    width:12px;
    height:12px;
    border-radius:50%;
    border:none;
    background:var(--dot-color);
    opacity:.4;
    }

    .slider-dots button.active{
    background:var(--dot-active);
    width: 42px;
    border-radius: 10px;
    opacity:1;
    }
    .slider-inner{
      width:100%;
    }

    .slider-track{
      width:100%;
    }
    .slider-inner{
  overflow:hidden;
  transition:height .35s ease;
}

    /* responsive enable */

    @media (min-width: 1366px){
    .slider_block:not(.slider-desktop) .slider-track{
    overflow:visible;
    flex-wrap:wrap;
    }
    .slider_block:not(.slider-desktop) .slider-prev,
    .slider_block:not(.slider-desktop) .slider-next,
    .slider_block:not(.slider-desktop) .slider-dots{
      display: none;
    }
    .slider_block:not(.slider-desktop) .slider-inner {
    height: auto !important;
}
  }

  @media only screen and (min-width: 768px) and (max-width: 1365px) {
    .slider_block:not(.slider-tablet) .slider-track{
    overflow:visible;
    flex-wrap:wrap;
    }
    .slider_block:not(.slider-tablet) .slider-prev,
    .slider_block:not(.slider-tablet) .slider-next,
    .slider_block:not(.slider-tablet) .slider-dots{
      display: none;
    }
    .slider_block:not(.slider-tablet) .slider-inner {
    height: auto !important;
}
    }

    @media(max-width:767px){
    .slider_block:not(.slider-mobile) .slider-track{
    overflow:visible;
    flex-wrap:wrap;
    }
    .slider_block:not(.slider-mobile) .slider-prev,
    .slider_block:not(.slider-mobile) .slider-next,
    .slider_block:not(.slider-mobile) .slider-dots{
      display: none;
    }
    .slider_block:not(.slider-mobile) .slider-inner {
    height: auto !important;
}
    .slider-track{
    gap:var(--gap-m,8px);
    }
      .slider_block_container{
            padding-top: var(--pt-m);
            padding-bottom: var(--pb-m);
            padding-left: var(--pl-m);
            padding-right: var(--pr-m);
          }
      }
{% endstylesheet %}
{% schema %}
{
  "name": "Slider",
  "tag": null,
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "per_row_desktop",
      "label": "Per row desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },

    {
      "type": "range",
      "id": "per_row_tablet",
      "label": "Per row tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },

    {
      "type": "range",
      "id": "per_row_mobile",
      "label": "Per row mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Slide Gap"
    },
    {
      "type": "range",
      "id": "gap_m",
      "label": "Gap mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_desktop",
      "label": "Enable slider desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_tablet",
      "label": "Enable slider tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mobile",
      "label": "Enable slider mobile",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay"
    },

    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 8000,
      "step": 500,
      "default": 3000
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "adaptive_height",
      "label": "Adaptive height",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },

    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#000"
    },

    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Arrow bg",
      "default": "#fff"
    },

    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },

    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#999"
    },

    {
      "type": "color",
      "id": "dot_active",
      "label": "Active dot",
      "default": "#000"
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box shadow"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Choose Unit Width Dektop",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Custom Width Desktop In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_desktop == 'px' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_desktop == '%' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Choose Unit Width Tablet",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Custom Width Tablet In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_tablet == 'px' and block.settings.width_tablet == 'custom'}}"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_tablet == '%' and block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_mobile",
      "label": "Choose Unit Width Mobile",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel_mobile",
      "default": 48,
      "label": "Custom Width Mobile In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_mobile == 'px' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_mobile == '%' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_background",
