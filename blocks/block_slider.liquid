{% doc %}
  Advanced Text Block
{% enddoc %}

<div
  class="
    slider_block_container
    {% if block.settings.height == 'custom' %}
     block-custom-height-desktop
     {% else %}
    block-height-desktop-{{ block.settings.height }}
    {% endif %}
    {% if block.settings.width == 'custom' %}
    block-custom-width-desktop
    {% else %}
    block-width-desktop-{{ block.settings.width }}
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    block-custom-width-tablet
    {% else %}
     block-width-tablet-{{ block.settings.width_tablet }}
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    block-custom-width-mobile
    {% else %}
     block-width-mobile-{{ block.settings.width_mobile }}
    {% endif %}
    ratio--{{ block.settings.ratio }}
    {% if block.settings.hover_zoom %}is-zoom{% endif %}
    {% if block.settings.shadow %}is-shadow{% endif %}
  "
  style="
    --bg: {{ block.settings.background }};
    {% if block.settings.set_full_radius %}
    --radius-top-left: {{ block.settings.radius_top_left }}px;
    --radius-top-right: {{ block.settings.radius_top_right }}px;
    --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
    --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
    {% else %}
    --radius-top-left: {{ block.settings.radius }}px;
    --radius-top-right: {{ block.settings.radius }}px;
    --radius-bottom-left: {{ block.settings.radius }}px;
    --radius-bottom-right: {{ block.settings.radius }}px;
    {% endif %}
    --border: {{ block.settings.border }}px;
    --border-color: {{ block.settings.border_color }};
    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;
    --pt-m: {{ block.settings.pt_m }}px;
    --pb-m: {{ block.settings.pb_m }}px;
    --pl-m: {{ block.settings.pl_m }}px;
    --pr-m: {{ block.settings.pr_m }}px;

    {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%;
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div
    class="
      slider_block slider-{{ block.id }}

      {% if block.settings.enable_desktop %} slider-desktop{% endif %}
      {% if block.settings.enable_tablet %} slider-tablet{% endif %}
      {% if block.settings.enable_mobile %} slider-mobile{% endif %}
    "
    data-id="{{ block.id }}"
    id="slider-{{ block.id }}"
    data-adaptive="{{ block.settings.adaptive_height }}"
    data-autoplay="{{ block.settings.autoplay }}"
    data-speed="{{ block.settings.autoplay_speed }}"
    data-arrows="{{ block.settings.show_arrows }}"
    data-dots="{{ block.settings.show_dots }}"

    style="
      --arrow-color: {{ block.settings.arrow_color }};
      --arrow-bg: {{ block.settings.arrow_bg }};
      --dot-color: {{ block.settings.dot_color }};
      --dot-active: {{ block.settings.dot_active }};
    "
  >
    <div class="slider-inner">
      <div class="slider-track" id="track-{{ block.id }}">
        {% content_for 'blocks' %}
      </div>
    </div>

    {% if block.settings.show_arrows %}
      <button class="slider-prev" data-id="{{ block.id }}">‹</button>
      <button class="slider-next" data-id="{{ block.id }}">›</button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="slider-dots" id="dots-{{ block.id }}"></div>
    {% endif %}
  </div>
</div>
{% javascript %}
  function initSlider(id) {
    const slider = document.getElementById('slider-' + id);
    if (!slider) return;
    const track = document.getElementById('track-' + id);
    const prev = slider.querySelector('.slider-prev');
    const next = slider.querySelector('.slider-next');
    const dotsWrap = document.getElementById('dots-' + id);
    const autoplay = slider.dataset.autoplay === 'true';
    const speed = parseInt(slider.dataset.speed) || 3000;
    let index = 0;
    const slides = track.children;
    function go(i) {
      if (i < 0) i = 0;
      if (i >= slides.length) i = slides.length - 1;

      index = i;

      const slide = slides[index];

      track.scrollTo({
        left: slide.offsetLeft,
        behavior: 'smooth'
      });

      updateDots();
    }
    if (prev) prev.onclick = () => go(index - 1);
    if (next) next.onclick = () => go(index + 1);
    if (dotsWrap) {
      dotsWrap.innerHTML = '';
      for (let i = 0; i < slides.length; i++) {
        let b = document.createElement('button');
        b.onclick = () => go(i);
        dotsWrap.appendChild(b);
      }
    }
    function updateDots() {
      if (!dotsWrap) return;
      dotsWrap.querySelectorAll('button').forEach((d, i) => {
        d.classList.toggle('active', i === index);
      });
    }
    if (autoplay) {
      setInterval(() => {
        index++;
        if (index >= slides.length) index = 0;
        go(index);
      }, speed);
    }
    let isDown = false;
    let startX;
    let scrollLeft;
    track.addEventListener('pointerdown', (e) => {
      isDown = true;
      track.classList.add('dragging');
      startX = e.pageX;
      scrollLeft = track.scrollLeft;
    });
    track.addEventListener('pointerleave', () => {
      isDown = false;
      track.classList.remove('dragging');
    });
    track.addEventListener('pointerup', () => {
      isDown = false;
      track.classList.remove('dragging');
    });
    track.addEventListener('pointermove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX;
      const walk = (x - startX) * 1;
      track.scrollLeft = scrollLeft - walk;
    });
    track.style.scrollBehavior = 'auto';
  }
  document.querySelectorAll('.slider_block').forEach((el) => {
    initSlider(el.dataset.id);
  });
  document.addEventListener('shopify:section:load', function (e) {
    e.target.querySelectorAll('.slider_block').forEach((el) => {
      initSlider(el.dataset.id);
    });
  });
{% endjavascript %}
{% stylesheet %}
       .slider_block_container {
        background: var(--bg);
        border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
        border: var(--border) solid var(--border-color);
        padding-top: var(--pt);
        padding-bottom: var(--pb);
        padding-left: var(--pl);
        padding-right: var(--pr);
        overflow: hidden;
        position: relative;
      }

    .slider_block{
    position:relative;
    width:100%;
    }

    .slider-inner{
    overflow:hidden;

  transition:height .3s ease;
    }

    .slider-track{
    display:flex;
    gap:var(--carousel-gap,8px);
    overflow-x:auto;
    scroll-behavior:smooth;
    scroll-snap-type:x mandatory;

  align-items:flex-start;
    }
  .slider-track{
  overflow-x:auto;
  overflow-y:hidden;

  /* hide scrollbar firefox */
  scrollbar-width:none;

  /* smooth */
  -webkit-overflow-scrolling:touch;
  }

  /* hide scrollbar chrome safari edge */
  .slider-track::-webkit-scrollbar{
  display:none;
  }
    .slider-track > *{
    scroll-snap-align:start;
    flex:0 0 auto;
    }

    /* arrows */

    .slider-prev,
    .slider-next{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:36px;
    height:36px;
    border:none;
    cursor:pointer;
    background:var(--arrow-bg);
    color:var(--arrow-color);
    box-shadow: 0px 4px 6px -4px #0000001A;
    border-radius: 100%;
    z-index:5;
    }

    .slider-prev{ left:0; }
    .slider-next{ right:0; }


    /* dots */

    .slider-dots{
    display:flex;
    gap:6px;
    justify-content:center;
    margin-top:8px;
    }

    .slider-dots button{
    width:12px;
    height:12px;
    border-radius:50%;
    border:none;
    background:var(--dot-color);
    opacity:.4;
    }

    .slider-dots button.active{
    background:var(--dot-active);
    width: 42px;
    border-radius: 10px;
    opacity:1;
    }



    /* responsive enable */

    @media (min-width: 1366px){
    .slider_block:not(.slider-desktop) .slider-track{
    overflow:visible;
    flex-wrap:wrap;
    }
    .slider_block:not(.slider-desktop) .slider-prev,
    .slider_block:not(.slider-desktop) .slider-next,
    .slider_block:not(.slider-desktop) .slider-dots{
      display: none;
    }
  }

  @media only screen and (min-width: 768px) and (max-width: 1365px) {
    .slider_block:not(.slider-tablet) .slider-track{
    overflow:visible;
    flex-wrap:wrap;
    }
    .slider_block:not(.slider-tablet) .slider-prev,
    .slider_block:not(.slider-tablet) .slider-next,
    .slider_block:not(.slider-tablet) .slider-dots{
      display: none;
    }
    }

    @media(max-width:767px){
    .slider_block:not(.slider-mobile) .slider-track{
    overflow:visible;
    flex-wrap:wrap;
    }
    .slider-track{
      width: calc(100vw - 90px);
    }
    .slider_block:not(.slider-mobile) .slider-prev,
    .slider_block:not(.slider-mobile) .slider-next,
    .slider_block:not(.slider-mobile) .slider-dots{
      display: none;
    }
      .slider_block_container{
            padding-top: var(--pt-m);
            padding-bottom: var(--pb-m);
            padding-left: var(--pl-m);
            padding-right: var(--pr-m);
          }
      }
{% endstylesheet %}
{% schema %}
{
  "name": "Slider",
  "tag": null,
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_desktop",
      "label": "Enable slider desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_tablet",
      "label": "Enable slider tablet",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mobile",
      "label": "Enable slider mobile",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay"
    },

    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 8000,
      "step": 500,
      "default": 3000
    },
    {
      "type": "checkbox",
      "id": "adaptive_height",
      "label": "Adaptive height",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },

    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#000"
    },

    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Arrow bg",
      "default": "#fff"
    },

    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },

    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#999"
    },

    {
      "type": "color",
      "id": "dot_active",
      "label": "Active dot",
      "default": "#000"
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box shadow"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Choose Unit Width Dektop",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Custom Width Desktop In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_desktop == 'px' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_desktop == '%' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Choose Unit Width Tablet",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Custom Width Tablet In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_tablet == 'px' and block.settings.width_tablet == 'custom'}}"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_tablet == '%' and block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
