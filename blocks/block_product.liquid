{% assign product = block.settings.product %}

{{ 'custom-product.css' | asset_url | stylesheet_tag }}
{%- capture style_schema -%}
    --section-bg:{{ block.settings.section_bg }};
    --section-wraper-width:{% if block.settings.section_width %}100%{% else %}{{ block.settings.wraper_width }}px{% endif %};
    --section-padding-top:{{ block.settings.padding_top_desktop }}px;
    --section-padding-bottom:{{ block.settings.padding_bottom_desktop }}px;
    --section-padding-left:{{ block.settings.padding_left_desktop }}px;
    --section-padding-right:{{ block.settings.padding_right_desktop }}px;
    --section-mobile-padding-top:{{ block.settings.padding_top_mobile }}px;
    --section-mobile-padding-bottom:{{ block.settings.padding_bottom_mobile }}px;
    --section-mobile-padding-left:{{ block.settings.padding_left_mobile }}px;
    --section-mobile-padding-right:{{ block.settings.padding_right_mobile }}px;
    --media-radius:{{ block.settings.media-radius }}px;
    --media-thumb-radius:{{ block.settings.media-thumb-radius }}px;
    --media-thumb-width:{{ block.settings.media-thumb-width }}px;
    --media-thumb-mobile-width:{{ block.settings.media-thumb-mobile-width }}px;
    --media-thumb-border-size:{{ block.settings.media-thumb-border-width }}px;
    --media-thumb-border-color:{{ block.settings.media_border }};
    --media-thumb-border-active-color:{{ block.settings.media_border_active }};
{%- endcapture -%}
{% assign style_schema = style_schema | strip_newlines %}
{%- capture Inforation_block -%}
  --align-x: {{ block.settings.align_x }};
  --align-y: {{ block.settings.align_y }};
  --child-size: {{ block.size }};
  --wrap: {{ block.settings.wrap }};
  --gap: {{ block.settings.gap }}px;
  --gap-m: {{ block.settings.gap_m }}px;
  --bg: {{ block.settings.background }};
  {% if block.settings.set_full_radius %}
  --radius-top-left: {{ block.settings.radius_top_left }}px;
  --radius-top-right: {{ block.settings.radius_top_right }}px;
  --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
  --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
  {% else %}
  --radius-top-left: {{ block.settings.radius }}px;
  --radius-top-right: {{ block.settings.radius }}px;
  --radius-bottom-left: {{ block.settings.radius }}px;
  --radius-bottom-right: {{ block.settings.radius }}px;
  {% endif %}
  --border: {{ block.settings.border }}px;
  --border-color: {{ block.settings.border_color }};
  --pt: {{ block.settings.pt }}px;
  --pb: {{ block.settings.pb }}px;
  --pl: {{ block.settings.pl }}px;
  --pr: {{ block.settings.pr }}px;
  --ptm: {{ block.settings.ptm }}px;
  --pbm: {{ block.settings.pbm }}px;
  --plm: {{ block.settings.plm }}px;
  --prm: {{ block.settings.prm }}px;
  {% if block.settings.height == 'custom' %}
  --block-custom-height-desktop: {{ block.settings.custom_height }}%;
  {% endif %}
  {% if block.settings.width == 'custom' %}
  --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
  {% endif %}
{%- endcapture -%}

{% assign Inforation_block = style_schema | strip_newlines %}
{%- capture info_class_list -%}
  group;
  group--vertical;
  box-wrap; 
  {% if block.settings.height == 'custom' %}
  block-custom-height-desktop;
  {% else %}
  block-height-desktop-{{ block.settings.height }}; 
  {% endif %}
  {% if block.settings.width == 'custom' %}
  block-custom-width-desktop;
  {% else %}
  block-width-desktop-{{ block.settings.width }};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  block-custom-width-tablet; 
  {% else %}
  block-width-tablet-{{ block.settings.width_tablet }}; 
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  block-custom-width-mobile; 
  {% else %}
  block-width-mobile-{{ block.settings.width_mobile }}; 
  {% endif %}
  {% if block.settings.hover_zoom %}is-zoom;{% endif %}
  {% if block.settings.shadow %}is-shadow;{% endif %}
  {% if block.settings.hide_desktop %}hide-desktop;{% endif %}
  {% if block.settings.hide_mobile %}hide-mobile;{% endif %}
{% endcapture %}
{% assign info_class_list = info_class_list | strip_newlines | replace: ';', ' ' | strip %}

<div
  class="product_section {% if block.settings.show_thumbs %} enable_thumbs {% else %} hide_thumbs {% endif %}"
  style="{{- style_schema -}}"
  id="MainProduct_{{ block.id }}"
  data-variants='{{ product.variants | json }}'
  data-section="{{ block.id }}"
  data-product-id="{{ product.id }}"
>
  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  <div class="product-wrapper">
    <div class="product_media-wrapper">
      {% render 'product_media_gallery', variant_images: variant_images, product: product %}
    </div>
    <div class="product_information_wrapper {{  info_class_list }}" style="{{- Inforation_block -}}">
      {%- assign product_form_id = 'product-form-' | append: block.id -%}
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
<script>
(function () {

function initProductScript(sectionId) {

  const section = document.querySelector('#MainProduct_' + sectionId);
  if (!section) return;

  /* -------------------------
     GALLERY
  -------------------------- */

  const gallery = section.querySelector(".custom-product-gallery");
  const thumbs = section.querySelectorAll(".gallery-thumb");
  const track = section.querySelector(".gallery-thumbs-track");
  const mediaItems = section.querySelectorAll(".gallery-media-item");
  const wrapper = section.querySelector(".gallery-thumbs-wrapper");
  const prevBtn = section.querySelector(".thumb-prev");
  const nextBtn = section.querySelector(".thumb-next");

  let currentTranslate = 0;

  function checkOverflow() {

    if (!track) return;

    const container = track.parentElement;

    const isOverflowing =
      Math.ceil(track.scrollWidth) >
      Math.ceil(container.clientWidth);

    wrapper?.classList.toggle("is-overflowing", isOverflowing);

    if (!isOverflowing) {
      currentTranslate = 0;
      track.style.transform = "translateX(0px)";
    }
  }

  function activateMedia(mediaId) {

    

  }

  thumbs.forEach(thumb => {
    thumb.addEventListener("click", function () {
      activateMedia(this.dataset.mediaId);
    });
  });

  prevBtn?.addEventListener("click", function () {
    currentTranslate += 100;
    if (currentTranslate > 0) currentTranslate = 0;
    track.style.transform = `translateX(${currentTranslate}px)`;
  });

  nextBtn?.addEventListener("click", function () {
    const maxTranslate =
      track.parentElement.offsetWidth -
      track.scrollWidth;

    currentTranslate -= 100;

    if (currentTranslate < maxTranslate)
      currentTranslate = maxTranslate;

    track.style.transform =
      `translateX(${currentTranslate}px)`;
  });

  checkOverflow();
  window.addEventListener("resize", checkOverflow);


  /* -------------------------
     VARIANTS
  -------------------------- */

  const variants = section.dataset.variants
    ? JSON.parse(section.dataset.variants)
    : [];

  const form = section.querySelector("form[id^='product-form-']");
  if (!form) return;

  const hiddenInput = form.querySelector("input[name='id']");
  const priceWrapper = section.querySelector(".product-price");
  const optionGroups = section.querySelectorAll(".product-option");
  const addToCartBtn = form.querySelector(".add-to-cart");

  let selectedOptions = [];
  let currentVariant = null;


  function formatMoney(cents) {

    return new Intl.NumberFormat(
      Shopify.locale,
      {
        style: "currency",
        currency: Shopify.currency.active,
      }
    ).format(cents / 100);

  }


  /* -------------------------
     INITIAL
  -------------------------- */

  const initialVariant =
    variants.find(v => v.id == hiddenInput.value) ||
    variants.find(v => v.available) ||
    variants[0];

  if (!initialVariant) return;

  selectedOptions = [
    initialVariant.option1,
    initialVariant.option2,
    initialVariant.option3,
  ];

  updateUI();
  updateVariant();


  /* -------------------------
     OPTION CLICK
  -------------------------- */

  optionGroups.forEach((group, index) => {

    group.querySelectorAll(".option-value")
      .forEach(button => {

        button.addEventListener("click", function () {

          selectedOptions[index] =
            this.dataset.value;

          updateUI();
          updateVariant();

        });

      });

  });


  /* -------------------------
     UI
  -------------------------- */

  function updateUI() {

    optionGroups.forEach((group, index) => {

      group.querySelectorAll(".option-value")
        .forEach(button => {

          button.classList.remove(
            "is-active",
            "is-soldout",
            "is-unavailable"
          );

          if (
            button.dataset.value ==
            selectedOptions[index]
          ) {
            button.classList.add("is-active");
          }

        });

    });

  }


  /* -------------------------
     VARIANT UPDATE
  -------------------------- */

  function updateVariant() {

    currentVariant = variants.find(v => {

      return (
        v.option1 == selectedOptions[0] &&
        (v.option2 == selectedOptions[1] || !v.option2) &&
        (v.option3 == selectedOptions[2] || !v.option3)
      );

    });

    if (!currentVariant) return;

    hiddenInput.value = currentVariant.id;


    /* IMAGE */

    if (currentVariant.featured_media) {

      activateMedia(
        currentVariant.featured_media.id
      );

    }


    /* PRICE */

    const regular =
      priceWrapper?.querySelector(
        ".regular_price"
      );

    const compare =
      priceWrapper?.querySelector(
        ".sale_price"
      );

    const save =
      priceWrapper?.querySelector(
        ".save"
      );

    if (regular) {
      regular.textContent =
        formatMoney(currentVariant.price);
    }

    if (
      compare &&
      currentVariant.compare_at_price >
        currentVariant.price
    ) {

      compare.textContent =
        formatMoney(
          currentVariant.compare_at_price
        );

      compare.style.display = "inline";

      const percent = Math.round(
        (
          (currentVariant.compare_at_price -
            currentVariant.price) *
          100
        ) /
          currentVariant.compare_at_price
      );

      save.textContent = percent + "% OFF";
      save.style.display = "inline";

    } else {

      compare?.style.display = "none";
      save?.style.display = "none";

    }


    /* BUTTON */

    if (!currentVariant.available) {

      addToCartBtn.disabled = true;
      addToCartBtn.textContent = "Sold Out";

    } else {

      addToCartBtn.disabled = false;
      addToCartBtn.textContent =
        "Add to Cart";

    }

  }

}


/* -------------------------
   INIT
-------------------------- */

document.addEventListener(
  "DOMContentLoaded",
  function () {

    document
      .querySelectorAll("[id^='MainProduct_']")
      .forEach(section => {

        const id =
          section.id.replace(
            "MainProduct_",
            ""
          );

        initProductScript(id);

      });

  }
);


document.addEventListener(
  "shopify:section:load",
  function (e) {

    const id =
      e.target.id.replace(
        "MainProduct_",
        ""
      );

    initProductScript(id);

  }
);

})();
</script>
{% schema %}
{
  "name": "Product Template",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "product",
      "id": "product",
      "label": "product"
    },
    {
      "type": "checkbox",
      "id": "section_width",
      "label": "Full Width"
    },
    {
      "type": "range",
      "id": "wraper_width",
      "label": "Container Width",
      "max": 1900,
      "min": 900,
      "default": 1400,
      "step": 100,
      "unit": "px",
      "visible_if": "{{ block.settings.section_width == false }}"
    },
    {
      "type": "select",
      "id": "align_x",
      "label": "Position",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ]
    },
    {
      "type": "header",
      "content": "Product Information Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Choose Unit Width Dektop",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Custom Width Desktop In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_desktop == 'px' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_desktop == '%' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Choose Unit Width Tablet",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Custom Width Tablet In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_tablet == 'px' and block.settings.width_tablet == 'custom'}}"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_tablet == '%' and block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_mobile",
      "label": "Choose Unit Width Mobile",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel_mobile",
      "default": 48,
      "label": "Custom Width Mobile In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_mobile == 'px' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_mobile == '%' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Height"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_m",
      "label": "Gap Mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Block Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "header",
      "content": "Block Radius"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "visible_if": "{{ block.settings.set_full_radius == false }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "label": "Set Each Corner Radius",
      "id": "set_full_radius"
    },
    {
      "type": "range",
      "id": "radius_top_left",
      "label": "Radius Top Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_top_right",
      "label": "Radius Top Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_left",
      "label": "Radius Bottom Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_right",
      "label": "Radius Bottom Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border",
      "label": "Border",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },

    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Left",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Right",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },

    {
      "type": "range",
      "id": "ptm",
      "label": "Top",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pbm",
      "label": "Bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "plm",
      "label": "Left",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "prm",
      "label": "Right",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#fff"
    },
    { "type": "header", "content": "Desktop Padding Controls" },

    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Padding Left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Padding Right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile Padding Controls"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Padding Left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
