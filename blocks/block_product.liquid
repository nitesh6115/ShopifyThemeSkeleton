{% assign product = block.settings.product %}

{{ 'custom-product.css' | asset_url | stylesheet_tag }}
{%- capture style_schema -%}
    --section-bg:{{ block.settings.section_bg }};
    --section-wraper-width:{% if block.settings.section_width %}100%{% else %}{{ block.settings.wraper_width }}px{% endif %};
    --section-padding-top:{{ block.settings.padding_top_desktop }}px;
    --section-padding-bottom:{{ block.settings.padding_bottom_desktop }}px;
    --section-padding-left:{{ block.settings.padding_left_desktop }}px;
    --section-padding-right:{{ block.settings.padding_right_desktop }}px;
    --section-mobile-padding-top:{{ block.settings.padding_top_mobile }}px;
    --section-mobile-padding-bottom:{{ block.settings.padding_bottom_mobile }}px;
    --section-mobile-padding-left:{{ block.settings.padding_left_mobile }}px;
    --section-mobile-padding-right:{{ block.settings.padding_right_mobile }}px;
    --media-radius:{{ block.settings.media-radius }}px;
    --media-thumb-radius:{{ block.settings.media-thumb-radius }}px;
    --media-thumb-width:{{ block.settings.media-thumb-width }}px;
    --media-thumb-mobile-width:{{ block.settings.media-thumb-mobile-width }}px;
    --media-thumb-border-size:{{ block.settings.media-thumb-border-width }}px;
    --media-thumb-border-color:{{ block.settings.media_border }};
    --media-thumb-border-active-color:{{ block.settings.media_border_active }};
{%- endcapture -%}
{% assign style_schema = style_schema | strip_newlines %}
{%- capture Inforation_block -%}
  --align-x: {{ block.settings.align_x }};
  --align-y: {{ block.settings.align_y }};
  --child-size: {{ block.size }};
  --wrap: {{ block.settings.wrap }};
  --gap: {{ block.settings.gap }}px;
  --gap-m: {{ block.settings.gap_m }}px;
  --bg: {{ block.settings.background }};
  {% if block.settings.set_full_radius %}
  --radius-top-left: {{ block.settings.radius_top_left }}px;
  --radius-top-right: {{ block.settings.radius_top_right }}px;
  --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
  --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
  {% else %}
  --radius-top-left: {{ block.settings.radius }}px;
  --radius-top-right: {{ block.settings.radius }}px;
  --radius-bottom-left: {{ block.settings.radius }}px;
  --radius-bottom-right: {{ block.settings.radius }}px;
  {% endif %}
  --border: {{ block.settings.border }}px;
  --border-color: {{ block.settings.border_color }};
  --pt: {{ block.settings.pt }}px;
  --pb: {{ block.settings.pb }}px;
  --pl: {{ block.settings.pl }}px;
  --pr: {{ block.settings.pr }}px;
  --ptm: {{ block.settings.ptm }}px;
  --pbm: {{ block.settings.pbm }}px;
  --plm: {{ block.settings.plm }}px;
  --prm: {{ block.settings.prm }}px;
  {% if block.settings.height == 'custom' %}
  --block-custom-height-desktop: {{ block.settings.custom_height }}%;
  {% endif %}
  {% if block.settings.width == 'custom' %}
  --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
  {% endif %}
{%- endcapture -%}

{% assign Inforation_block = Inforation_block | strip_newlines %}
{%- capture info_class_list -%}
  group;
  group--vertical;
  box-wrap; 
  {% if block.settings.height == 'custom' %}
  block-custom-height-desktop;
  {% else %}
  block-height-desktop-{{ block.settings.height }}; 
  {% endif %}
  {% if block.settings.width == 'custom' %}
  block-custom-width-desktop;
  {% else %}
  block-width-desktop-{{ block.settings.width }};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  block-custom-width-tablet; 
  {% else %}
  block-width-tablet-{{ block.settings.width_tablet }}; 
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  block-custom-width-mobile; 
  {% else %}
  block-width-mobile-{{ block.settings.width_mobile }}; 
  {% endif %}
  {% if block.settings.hover_zoom %}is-zoom;{% endif %}
  {% if block.settings.shadow %}is-shadow;{% endif %}
  {% if block.settings.hide_desktop %}hide-desktop;{% endif %}
  {% if block.settings.hide_mobile %}hide-mobile;{% endif %}
{% endcapture %}
{% assign info_class_list = info_class_list | strip_newlines | replace: ';', ' ' | strip %}

<div
  class="product_section {% if block.settings.show_thumbs %} enable_thumbs {% else %} hide_thumbs {% endif %}"
  style="{{- style_schema -}}"
  id="MainProduct_{{ block.id }}"
  data-variants='{{ product.variants | json }}'
  data-section="{{ block.id }}"
  data-product-id="{{ product.id }}"
>
  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  <div class="product-wrapper">
    <div class="product_media-wrapper">
      {% render 'product_media_gallery', variant_images: variant_images, product: product %}
    </div>
    <div class="product_information_wrapper {{  info_class_list }}" style="{{- Inforation_block -}}">
      {%- assign product_form_id = 'product-form-' | append: block.id -%}
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
<script>
function initProductScript(sectionId) {

  const section = document.querySelector('#MainProduct_' + sectionId);
  if (!section) return;
  const gallery = section.querySelector(".custom-product-gallery");
  if (!gallery) return;
  const thumbs = gallery.querySelectorAll(".gallery-thumb");
  const track = gallery.querySelector(".gallery-thumbs-track");
  const mediaItems = gallery.querySelectorAll(".gallery-media-item");
  const wrapper = gallery.querySelector(".gallery-thumbs-wrapper");
  const prevBtn = gallery.querySelector(".thumb-prev");
  const nextBtn = gallery.querySelector(".thumb-next");


  /*----------------------------
      MEDIA ELEMENTS 
    ---------------------------*/
    let currentTranslate = 0;

  function checkOverflow() {

  const container = track.parentElement;

  const isOverflowing =
    Math.ceil(track.scrollWidth) >
    Math.ceil(container.clientWidth);

  wrapper.classList.toggle("is-overflowing", isOverflowing);

  if (!isOverflowing) {
    currentTranslate = 0;
    track.style.transform = "translateX(0px)";
  }
}

  function activateMedia(mediaId) {
  
    mediaItems.forEach(item => {
      item.classList.remove("is-active");
      if (item.dataset.mediaId === mediaId) {
        item.classList.add("is-active");
      }

      const video = item.querySelector("video");
      if (video) video.pause();
    });

    thumbs.forEach(thumb => {
      thumb.classList.remove("is-active");
      if (thumb.dataset.mediaId === mediaId) {
        thumb.classList.add("is-active");
        scrollThumbIntoView(thumb);
      }
    });
  }
  
  
  function scrollThumbIntoView(thumb) {
    const thumbLeft = thumb.offsetLeft;
    const thumbRight = thumbLeft + thumb.offsetWidth;
    const visibleLeft = Math.abs(currentTranslate);
    const visibleRight = visibleLeft + track.parentElement.offsetWidth;

    if (thumbLeft < visibleLeft) {
      currentTranslate = -thumbLeft;
    } else if (thumbRight > visibleRight) {
      currentTranslate = -(thumbRight - track.parentElement.offsetWidth);
    }

    track.style.transform = `translateX(${currentTranslate}px)`;
  }

  prevBtn?.addEventListener("click", function() {
    currentTranslate += 100;
    if (currentTranslate > 0) currentTranslate = 0;
    track.style.transform = `translateX(${currentTranslate}px)`;
  });

  nextBtn?.addEventListener("click", function() {
    const maxTranslate = track.parentElement.offsetWidth - track.scrollWidth;
    currentTranslate -= 100;
    if (currentTranslate < maxTranslate) currentTranslate = maxTranslate;
    track.style.transform = `translateX(${currentTranslate}px)`;
  });

  thumbs.forEach(thumb => {
    thumb.addEventListener("click", function() {
      activateMedia(this.dataset.mediaId);
    });
  });
  
  checkOverflow();
  window.addEventListener("resize", checkOverflow);

  const variants = section.dataset.variants
    ? JSON.parse(section.dataset.variants)
    : [];
  const form = section.querySelector("form[id^='product-form-']");
  if (!form) return;

  const hiddenInput = form.querySelector("input[name='id']");
  const priceWrapper = section.querySelector('.product-price');
  const optionGroups = section.querySelectorAll('.product-option');
  const addToCartBtn = form.querySelector('.add-to-cart');
  const showBtnPrice = addToCartBtn?.hasAttribute('data-btn-price');

  /* -------------------------
     QUANTITY ELEMENTS
  -------------------------- */
  const qtyWrapper = section.querySelector('[data-quantity-wrapper]');
  const qtyInput = qtyWrapper?.querySelector('.qty-input');
  const plusBtn = qtyWrapper?.querySelector('.qty-plus');
  const minusBtn = qtyWrapper?.querySelector('.qty-minus');
  const qtyError = qtyWrapper?.querySelector('.qty-error');

  /* -------------------------
     STICKY ELEMENTS
  -------------------------- */
  const sticky = section.querySelector('.sticky-atc');
  const stickyBtn = sticky?.querySelector('.sticky-btn');
  const stickyPrice = sticky?.querySelector('.sticky-price');
  const stickyCompare = sticky?.querySelector('.sticky-compare');
  const stickySave = sticky?.querySelector('.sticky-save');
  const stickyVariant = sticky?.querySelector('.sticky-variant');
  const stickyImage = sticky?.querySelector('.sticky-image');

  let selectedOptions = [];
  let currentVariant = null;
  let cartData = null;

  function formatMoney(cents) {
    return new Intl.NumberFormat('{{ shop.locale }}', {
      style: 'currency',
      currency: '{{ shop.currency }}',
    }).format(cents / 100);
  }

  /* -------------------------
     FETCH CART (once)
  -------------------------- */
  fetch('/cart.js')
    .then(res => res.json())
    .then(data => {
      cartData = data;
    });

  /* -------------------------
     INITIAL VARIANT
  -------------------------- */
  const initialVariant =
    variants.find(v => v.id == hiddenInput.value) ||
    variants.find(v => v.available) ||
    variants[0];

  selectedOptions = [
    initialVariant.option1 || null,
    initialVariant.option2 || null,
    initialVariant.option3 || null,
  ];

  updateUI();
  updateVariant();

  /* -------------------------
     OPTION CLICK
  -------------------------- */
  optionGroups.forEach((group, index) => {
    group.querySelectorAll('.option-value').forEach((button) => {
      button.addEventListener('click', function () {
        if (this.classList.contains('is-unavailable')) return;
        selectedOptions[index] = this.dataset.value;
        updateUI();
        updateVariant();
      });
    });
  });

  /* -------------------------
     UPDATE VARIANT
  -------------------------- */
    function updateUI() {
  optionGroups.forEach((group, index) => {
    group.querySelectorAll('.option-value').forEach((button) => {

      const testOptions = [...selectedOptions];
      testOptions[index] = button.dataset.value;

      const existingVariant = variants.find((variant) => {
        return (
          (variant.option1 === testOptions[0] || !variant.option1) &&
          (variant.option2 === testOptions[1] || !variant.option2) &&
          (variant.option3 === testOptions[2] || !variant.option3)
        );
      });

      const isAvailable = existingVariant?.available;
      const exists = !!existingVariant;

      button.classList.remove('is-active', 'is-soldout', 'is-unavailable');

      if (button.dataset.value === selectedOptions[index]) {
        button.classList.add('is-active');
      }

      if (!exists) {
        button.classList.add('is-unavailable');
      } else if (!isAvailable) {
        button.classList.add('is-soldout');
      }

    });
  });
  }
  function updateVariant() {

    currentVariant = variants.find((variant) => {
      return (
        (variant.option1 === selectedOptions[0] || !variant.option1) &&
        (variant.option2 === selectedOptions[1] || !variant.option2) &&
        (variant.option3 === selectedOptions[2] || !variant.option3)
      );
    });

    if (!currentVariant) return;

    hiddenInput.value = currentVariant.id;
     /*-------IMAGE UPDATE --------*/
     if (currentVariant?.featured_media) {
  activateMedia(currentVariant.featured_media.id.toString());
  
}
    /* ---- PRICE ---- */
    const regularPriceEl = priceWrapper.querySelector('.regular_price');
    const comparePriceEl = priceWrapper.querySelector('.sale_price');
    const saveEl = priceWrapper.querySelector('.save');

    regularPriceEl.textContent = formatMoney(currentVariant.price);

    if (currentVariant.compare_at_price && currentVariant.compare_at_price > currentVariant.price) {
      comparePriceEl.textContent = formatMoney(currentVariant.compare_at_price);
      comparePriceEl.style.display = 'inline';

      const percent = Math.round(
        ((currentVariant.compare_at_price - currentVariant.price) * 100) /
        currentVariant.compare_at_price
      );

      saveEl.textContent = percent + '% OFF';
      saveEl.style.display = 'inline';
    } else {
      comparePriceEl.style.display = 'none';
      saveEl.style.display = 'none';
    }

    /* ---- BUTTON ---- */
    if (!currentVariant.available) {
      addToCartBtn.disabled = true;
      addToCartBtn.textContent = 'Sold Out';
    } else {
      addToCartBtn.disabled = false;
      addToCartBtn.innerHTML = showBtnPrice
        ? `<span class='btn_text'>Add to Cart</span><span class='icon'>—</span><span class='btn_price'>${formatMoney(currentVariant.price)}</span>`
        : `<span class='btn_text'>Add to Cart</span>`;
    }

    /* ---- STICKY ---- */
    if (sticky) {
      stickyPrice.textContent = formatMoney(currentVariant.price);
      stickyVariant.textContent = currentVariant.title;

      if (currentVariant.compare_at_price && currentVariant.compare_at_price > currentVariant.price) {
        const percent = Math.round(
          ((currentVariant.compare_at_price - currentVariant.price) * 100) /
          currentVariant.compare_at_price
        );
        stickyCompare.textContent = formatMoney(currentVariant.compare_at_price);
        stickySave.textContent = percent + '% OFF';
        stickyCompare.style.display = 'inline';
        stickySave.style.display = 'block';
      } else {
        stickyCompare.style.display = 'none';
        stickySave.style.display = 'none';
      }

      stickyBtn.disabled = !currentVariant.available;
      stickyBtn.textContent = currentVariant.available ? 'Add to Cart' : 'Sold Out';
    }

    if (qtyInput) {
      qtyInput.value = 1;
      validateQuantity();
    }

    document.dispatchEvent(
      new CustomEvent('variant:change', { detail: { variant: currentVariant } })
    );
  }

  /* -------------------------
     QUANTITY VALIDATION
  -------------------------- */
  function validateQuantity() {
    if (!currentVariant || !qtyInput) return;

    const maxInventory = currentVariant.inventory_quantity;
    const inventoryPolicy = currentVariant.inventory_policy;

    let cartQty = 0;

    if (cartData?.items?.length) {
      const existingItem = cartData.items.find(item => item.id == currentVariant.id);
      cartQty = existingItem ? existingItem.quantity : 0;
    }

    const requestedQty = parseInt(qtyInput.value) || 1;

    if (inventoryPolicy === 'deny') {
      const remaining = maxInventory - cartQty;

      if (remaining <= 0) {
        qtyInput.value = 1;
        plusBtn.disabled = true;
        qtyError.style.display = 'block';
        qtyError.textContent = 'Sold Out';
        return;
      }

      if (requestedQty > remaining) {
        qtyInput.value = remaining;
        qtyError.style.display = 'block';
        qtyError.textContent = `Only ${remaining} left`;
      } else {
        qtyError.style.display = 'none';
      }

      plusBtn.disabled = requestedQty >= remaining;
    } else {
      qtyError.style.display = 'none';
      plusBtn.disabled = false;
    }
  }

  if (qtyInput) {
    plusBtn.addEventListener('click', () => {
      qtyInput.value = parseInt(qtyInput.value) + 1;
      validateQuantity();
    });

    minusBtn.addEventListener('click', () => {
      if (parseInt(qtyInput.value) > 1) {
        qtyInput.value = parseInt(qtyInput.value) - 1;
      }
      validateQuantity();
    });
  }
/* -------------------------
   STICKY SHOW / HIDE
-------------------------- */
/* -------------------------
   STICKY CLICK = REAL SUBMIT
-------------------------- */

if (stickyBtn && form) {
  stickyBtn.addEventListener('click', function () {

    if (!currentVariant || !currentVariant.available) return;

    // Sync quantity from main input
    if (qtyInput) {
      const hiddenQty = form.querySelector("input[name='quantity']");
      if (hiddenQty) {
        hiddenQty.value = qtyInput.value;
      }
    }

    form.requestSubmit(); // safest way
  });
}
if (sticky && addToCartBtn) {

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          sticky.classList.remove('active');
        } else {
          sticky.classList.add('active');
        }
      });
    },
    { threshold: 0 }
  );

  observer.observe(addToCartBtn);
}
/* -------------------------
   SEAL SUBSCRIPTION PRICE SYNC
-------------------------- */


}


/* -------------------------
   INIT
-------------------------- */

document.addEventListener(
  "DOMContentLoaded",
  function () {

    document
      .querySelectorAll("[id^='MainProduct_']")
      .forEach(section => {

        const id =
          section.id.replace(
            "MainProduct_",
            ""
          );

        initProductScript(id);

      });

  }
);


document.addEventListener(
  "shopify:section:load",
  function (e) {

    const id =
      e.target.id.replace(
        "MainProduct_",
        ""
      );

    initProductScript(id);

  }
);

</script>
{% schema %}
{
  "tag": null,
  "name": "Product Template",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "product",
      "id": "product",
      "label": "product"
    },
    {
      "type": "checkbox",
      "id": "section_width",
      "label": "Full Width"
    },
    {
      "type": "range",
      "id": "wraper_width",
      "label": "Container Width",
      "max": 1900,
      "min": 900,
      "default": 1400,
      "step": 100,
      "unit": "px",
      "visible_if": "{{ block.settings.section_width == false }}"
    },
    {
      "type": "select",
      "id": "align_x",
      "label": "Position",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ]
    },
    {
      "type": "select",
      "id": "align_y",
      "label": "Alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ]
    },
    {
      "type": "header",
      "content": "Inforation Block Height"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_m",
      "label": "Gap Mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Block Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "header",
      "content": "Block Radius"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "visible_if": "{{ block.settings.set_full_radius == false }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "label": "Set Each Corner Radius",
      "id": "set_full_radius"
    },
    {
      "type": "range",
      "id": "radius_top_left",
      "label": "Radius Top Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_top_right",
      "label": "Radius Top Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_left",
      "label": "Radius Bottom Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_right",
      "label": "Radius Bottom Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border",
      "label": "Border",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },

    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Left",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Right",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },

    {
      "type": "range",
      "id": "ptm",
      "label": "Top",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pbm",
      "label": "Bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "plm",
      "label": "Left",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "prm",
      "label": "Right",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Section Background",
