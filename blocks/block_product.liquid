{% assign product = block.settings.product %}
{%- capture style_schema -%}
    --media-radius:{{ block.settings.media-radius }}px;
    --media-thumb-radius:{{ block.settings.media-thumb-radius }}px;
    --media-thumb-width:{{ block.settings.media-thumb-width }}px;
    --media-thumb-mobile-width:{{ block.settings.media-thumb-mobile-width }}px;
    --media-thumb-border-size:{{ block.settings.media-thumb-border-width }}px;
    --media-thumb-border-color:{{ block.settings.media_border }};
    --media-thumb-border-active-color:{{ block.settings.media_border_active }};
{%- endcapture -%}
{% assign style_schema = style_schema | strip_newlines %}

{%- capture info_block -%}
  --align-x: {{ block.settings.align_x }};
  --align-y: {{ block.settings.align_y }};
  --child-size: {{ block.size }};
  --wrap: {{ block.settings.wrap }};
  --gap: {{ block.settings.gap }}px;
  --gap-m: {{ block.settings.gap_m }}px;
  --bg: {{ block.settings.background }};
  {% if block.settings.set_full_radius %}
  --radius-top-left: {{ block.settings.radius_top_left }}px;
  --radius-top-right: {{ block.settings.radius_top_right }}px;
  --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
  --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
  {% else %}
  --radius-top-left: {{ block.settings.radius }}px;
  --radius-top-right: {{ block.settings.radius }}px;
  --radius-bottom-left: {{ block.settings.radius }}px;
  --radius-bottom-right: {{ block.settings.radius }}px;
  {% endif %}
  --border: {{ block.settings.border }}px;
  --border-color: {{ block.settings.border_color }};
  --pt: {{ block.settings.padding_top_desktop }}px;
  --pb: {{ block.settings.padding_bottom_desktop }}px;
  --pl: {{ block.settings.padding_left_desktop }}px;
  --pr: {{ block.settings.padding_right_desktop }}px;
  --ptm: {{ block.settings.padding_top_mobile }}px;
  --pbm: {{ block.settings.padding_bottom_mobile }}px;
  --plm: {{ block.settings.padding_left_mobile }}px;
  --prm: {{ block.settings.padding_right_mobile }}px;
  {% if block.settings.height == 'custom' %}
  --block-custom-height-desktop: {{ block.settings.custom_height }}%;
  {% endif %}
  {% if block.settings.width == 'custom' %}
  --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
  {% endif %}
{%- endcapture -%}

{% assign info_block = info_block | strip_newlines %}

{%- capture info_class_list -%}
  group;
  group--vertical;
  box-wrap; 
  {% if block.settings.height == 'custom' %}
  block-custom-height-desktop;
  {% else %}
  block-height-desktop-{{ block.settings.height }}; 
  {% endif %}
  {% if block.settings.width == 'custom' %}
  block-custom-width-desktop;
  {% else %}
  block-width-desktop-{{ block.settings.width }};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  block-custom-width-tablet; 
  {% else %}
  block-width-tablet-{{ block.settings.width_tablet }}; 
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  block-custom-width-mobile; 
  {% else %}
  block-width-mobile-{{ block.settings.width_mobile }}; 
  {% endif %}
  {% if block.settings.hover_zoom %}is-zoom;{% endif %}
  {% if block.settings.shadow %}is-shadow;{% endif %}
  {% if block.settings.hide_desktop %}hide-desktop;{% endif %}
  {% if block.settings.hide_mobile %}hide-mobile;{% endif %}
{% endcapture %}
{% assign info_class_list = info_class_list | strip_newlines | replace: ';', ' ' | strip %}
<div
  class="product_section {% if block.settings.show_thumbs %} enable_thumbs {% else %} hide_thumbs {% endif %} {% if block.settings.enable_zoom %} zoom-enabled {% endif %}"
  style="{{- style_schema -}}"
  id="MainProduct_{{ block.id }}"
  data-variants='{{ product.variants | json }}'
  data-section="{{ block.id }}"
  data-product-id="{{ product.id }}"
>
  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="product-wrapper">
    <div class="product_media-wrapper">
      {% render 'product_media_gallery', variant_images: variant_images, product: product %}
    </div>
    <div class="product_information_wrapper {{  info_class_list }}" style="{{- info_block -}}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
{% stylesheet %}
.section-content .gallery-thumbs {
    width: 0;
}
.product-wrapper{
  margin: 0 auto;
  display: flex;
  gap: 48px;
  flex-wrap: wrap;
}
.hide_thumbs .prdouctThubs {
    display: none;
}
.product-wrapper .zoom-container {
  position: relative;
  overflow: hidden;
  touch-action: none; /* required for pinch */
  cursor: zoom-in;
}

.product-wrapper .zoom-image {
  width: 100%;
  transition: transform 0.2s ease;
  transform-origin: center;
}
.main-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border: none;
  cursor: pointer;
}

.main-prev { left: 10px; }
.main-next { right: 10px; }

.hide_thumbs .main-nav {
  display: block;
}

.enable_thumbs .main-nav {
  display: none;
}
@media (max-width: 767px){
  .button_from {
    position: sticky;
    bottom: 0;
    left: 0;
    right: 0;
}
.button_from.is-fixed button.add-to-cart {
    position: fixed;
    bottom: 0;
    z-index: 3;
    width: auto;
    margin: 0 auto;
}

}
.product_block{
    padding-top: var(--block-desktop-padding-top);
    padding-left: var(--block-desktop-padding-left);
    padding-bottom: var(--block-desktop-padding-bottom);
    padding-right:var(--block-desktop-padding-right);
    background: var(--block-bg);
    text-align: var(--block-desktop-text-alignment, left);
    color: var(--block-text-color);
    font-size: var(--desktop-font-size);
    width: 100%;
}
.product_title{
    font-size: var(--desktop-font-size);
    font-weight: 700
}
/*--------------- media gallery ------------- */
.custom-product-gallery {
  width: 100%;
  margin: auto;
  position: relative;
}
.product_media-wrapper {
    max-width: 100%;
    width: 100%;
}
.product_information_wrapper {
    max-width: 100%;
    width: 100%;
}
@media(min-width: 1023px){
 .product_media-wrapper,
 .product_information_wrapper {
    max-width: calc(50% - 24px);
} 
}
.gallery-main {
  position: relative;
  overflow: hidden;
  margin: 0;
  padding: 0;
}

.gallery-media-item {
  display: none;
}

.gallery-media-item.is-active {
  display: block;
}

.gallery-media-item img,
.gallery-media-item video,
.gallery-media-item model-viewer {
  width: 100%;
  height: auto;
  border-radius: var(--media-radius);
}

.gallery-thumbs {
  display: flex;
  gap: 10px;
  overflow-x: auto;
}

.gallery-thumb {
  border: var(--media-thumb-border-size) solid var(--media-thumb-border-color);
  padding: 0;
  cursor: pointer;
  background: none;
}

.gallery-thumb.is-active {
  border: var(--media-thumb-border-size) solid var(--media-thumb-border-active-color);
}

.gallery-thumb img {
  width: var(--media-thumb-width);
  height: var(--media-thumb-width);
  object-fit: cover;
}
.gallery-thumbs-wrapper {
  display: flex;
  align-items: center;
  gap: 12px;
}

.gallery-thumbs {
  overflow: hidden;
  flex: 1;
}

.gallery-thumbs-track {
  display: flex;
  gap: 10px;
  transition: transform 0.3s ease;
  will-change: transform;
}

.gallery-thumb {
  flex: 0 0 auto;
    width: var(--media-thumb-width);
    height: var(--media-thumb-width);
    padding: 0;
    border: 2px solid #eee;
    background: none;
    cursor: pointer;
    border-radius: var(--media-thumb-radius);
    overflow: hidden;
}

.gallery-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.product_information_wrapper.group.group--vertical.box-wrap.block-height-desktop-fit {
    flex: 0 0 auto;
    height: 100%;
}
.product_information_wrapper.group.group--vertical.box-wrap.block-height-desktop-fill {
    height: auto;
}
.gallery-thumb.is-active {
  border: 2px solid rgba(238, 205, 182, 1);
}
.prdouctThubs{
  position: relative;
  margin-top: 18px;
}
.thumb-nav {
  border: var(--media-thumb-border-size) solid var(--media-thumb-border-color);
  width: 32px;
  height: 32px;
  cursor: pointer;
  font-size: 18px;
  display: none;
  position: absolute;
  border-radius: 6px;
  z-index: 1;
  color: var(--media-thumb-border-active-color);
  top: 50%;
  transform: translatey(-50%);
}
button.thumb-nav.thumb-prev {
    left: 0;
}
button.thumb-nav.thumb-next {
    right: 0;
}
.gallery-thumbs-wrapper.is-overflowing .thumb-nav {
  display: block;
}
@media (hover: hover) {

  .gallery-thumb img {
    transition: transform 0.4s ease;
  }

  .gallery-thumb:hover img {
    transform: scale(1.08);
  }

}

@media (max-width: 767px){
.gallery-thumb {
    width: var(--media-thumb-mobile-width);
    height: var(--media-thumb-mobile-width);
}
.trust-badges{
  justify-content: center;
}
}
.sticky-atc {
  position: fixed;
  left: 0;
  right: 0;
  bottom: -150px;
  background: #fff;
  box-shadow: 0 -4px 20px rgba(0,0,0,.08);
  transition: bottom .3s ease;
  z-index: 50;
}
.sticky-atc.active {
  bottom: 0;
}
.sticky-inner {
  max-width: 1200px;
  margin: auto;
  padding: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}
.sticky-left {
  display: flex;
  align-items: center;
  gap: 15px;
}
.sticky-image {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: 8px;
}

.sticky-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.sticky-title {
  font-weight: 600;
}

.sticky-variant {
  font-size: 14px;
  opacity: .7;
}

.sticky-price {
  font-weight: 600;
}
.sticky-price-wrapper {
    display: flex;
    gap: 12px;
    align-items: center;
}
.sticky-price-wrapper .stick-price {
    font-weight: bold;
}

.sticky-price-wrapper .sticky-save {
    padding: 5px 10px;
    font-size: 12px;
    background: #dcfce7;
    color: #539474;
}

.sticky-price-wrapper span {
    line-height: normal;
}

span.sticky-compare {
    text-decoration: line-through;
    opacity: .8;
}
.product_section:not(.zoom-enabled) .zoom-container {
  cursor: default;
}
@media(max-width:768px){
  
.sticky-inner {
  padding: 12px var(--section-padding-right) 12px var(--section-padding-left);
}
  .sticky-image {
    width: 50px;
    height: 50px;
  }
}
{% endstylesheet %}
<script>
function initProductScript(sectionId) {

  const section = document.querySelector('#MainProduct_' + sectionId);
  if (!section) return;

  /* -------------------------
     HELPERS
  -------------------------- */
  const $ = (sel, parent = section) => parent?.querySelector(sel);
  const $$ = (sel, parent = section) => parent ? [...parent.querySelectorAll(sel)] : [];

  const formatMoney = (cents) => {
    return new Intl.NumberFormat('{{ shop.locale }}', {
      style: 'currency',
      currency: '{{ shop.currency }}',
    }).format(cents / 100);
  };

  /* -------------------------
     GALLERY
  -------------------------- */
  function initGallery() {
    const gallery = $('.custom-product-gallery');
    if (!gallery) return;

    const mainItems = $$('.gallery-media-item', gallery);
    const thumbs = $$('.gallery-thumb', gallery);
    const prevMain = $('.main-prev', gallery);
    const nextMain = $('.main-next', gallery);

    let currentIndex = 0;

    function showSlide(index) {
      if (!mainItems.length) return;

      currentIndex = (index + mainItems.length) % mainItems.length;

      mainItems.forEach((el, i) => {
        el.classList.toggle('is-active', i === currentIndex);
      });

      thumbs.forEach(t => {
        t.classList.toggle(
          'is-active',
          t.dataset.mediaId === mainItems[currentIndex].dataset.mediaId
        );
      });
    }

    prevMain?.addEventListener('click', () => showSlide(currentIndex - 1));
    nextMain?.addEventListener('click', () => showSlide(currentIndex + 1));

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => showSlide(i));
    });

    return { showSlide };
  }

  /* -------------------------
     ZOOM
  -------------------------- */
  function initZoom() {
    if (!section.classList.contains('zoom-enabled')) return;

    $$('.zoom-container').forEach(container => {
      const img = $('.zoom-image', container);
      if (!img) return;

      if (window.matchMedia("(hover: hover)").matches) {
        container.addEventListener('mousemove', (e) => {
          const rect = container.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          img.style.transformOrigin = `${x}% ${y}%`;
          img.style.transform = "scale(2)";
        });

        container.addEventListener('mouseleave', () => {
          img.style.transform = "scale(1)";
        });
      }
    });
  }

  /* -------------------------
     VARIANTS
  -------------------------- */
  function initVariants(galleryAPI) {

    const form = $("form[id^='product-form-']");
    if (!form) return;

    const variants = section.dataset.variants
      ? JSON.parse(section.dataset.variants)
      : [];

    const hiddenInput = $("input[name='id']", form);
    const optionGroups = $$('.product-option');
    const addToCartBtn = $('.add-to-cart', form);
    const priceWrapper = $('.product-price');

    let selectedOptions = [];
    let currentVariant = null;

    const initialVariant =
      variants.find(v => v.id == hiddenInput?.value) ||
      variants.find(v => v.available) ||
      variants[0];

    selectedOptions = [
      initialVariant?.option1 || null,
      initialVariant?.option2 || null,
      initialVariant?.option3 || null,
    ];

    function updateUI() {
      optionGroups.forEach((group, index) => {
        $$('.option-value', group).forEach(btn => {

          const test = [...selectedOptions];
          test[index] = btn.dataset.value;

          const matchedVariant = variants.find(v =>
            (!v.option1 || v.option1 === test[0]) &&
            (!v.option2 || v.option2 === test[1]) &&
            (!v.option3 || v.option3 === test[2])
          );

          // ACTIVE / AVAILABLE STATES
          btn.classList.toggle('is-active', btn.dataset.value === selectedOptions[index]);
          btn.classList.toggle('is-unavailable', !matchedVariant);
          btn.classList.toggle('is-soldout', matchedVariant && !matchedVariant.available);

          // -------------------------
          // 🔥 UPDATE PRICE PER OPTION
          // -------------------------
          const priceEl = btn.querySelector('.v_price');
          const compareEl = btn.querySelector('.v_compare_price');
          const savingEl = btn.querySelector('.saving');

          if (matchedVariant && priceEl) {
            priceEl.childNodes[0].nodeValue = formatMoney(matchedVariant.price) + ' ';

            if (compareEl) {
              if (matchedVariant.compare_at_price > matchedVariant.price) {
                compareEl.textContent = formatMoney(matchedVariant.compare_at_price);
                compareEl.style.display = 'inline';
              } else {
                compareEl.style.display = 'none';
              }
            }

            if (savingEl) {
              if (matchedVariant.compare_at_price > matchedVariant.price) {
                const percent = Math.round(
                  ((matchedVariant.compare_at_price - matchedVariant.price) * 100) /
                  matchedVariant.compare_at_price
                );
                savingEl.textContent = percent + '% OFF';
                savingEl.style.display = 'block';
              } else {
                savingEl.style.display = 'none';
              }
            }
          }
        });
      });
    }

    function updatePrice() {
      if (!priceWrapper || !currentVariant) return;

      const regular = $('.regular_price', priceWrapper);
      const compare = $('.sale_price', priceWrapper);
      const save = $('.save', priceWrapper);

      if (regular) {
        regular.textContent = formatMoney(currentVariant.price);
      }

      if (compare && save) {
        if (currentVariant.compare_at_price > currentVariant.price) {
          compare.textContent = formatMoney(currentVariant.compare_at_price);
          compare.style.display = 'inline';

          const percent = Math.round(
            ((currentVariant.compare_at_price - currentVariant.price) * 100) /
            currentVariant.compare_at_price
          );

          save.textContent = percent + '% OFF';
          save.style.display = 'inline';
        } else {
          compare.style.display = 'none';
          save.style.display = 'none';
        }
      }
    }

    function updateButton() {
      if (!addToCartBtn || !currentVariant) return;

      const showBtnPrice = addToCartBtn.hasAttribute('data-btn-price');

      addToCartBtn.disabled = !currentVariant.available;

      if (!currentVariant.available) {
        addToCartBtn.textContent = 'Sold Out';
        return;
      }

      if (showBtnPrice) {
        addToCartBtn.innerHTML = `
          <span class="btn_text">Add to Cart</span>
          <span class="btn_separator">—</span>
          <span class="btn_price">${formatMoney(currentVariant.price)}</span>
        `;
      } else {
        addToCartBtn.innerHTML = `<span class="btn_text">Add to Cart</span>`;
      }
    }

    function updateVariant() {
      currentVariant = variants.find(v =>
        (!v.option1 || v.option1 === selectedOptions[0]) &&
        (!v.option2 || v.option2 === selectedOptions[1]) &&
        (!v.option3 || v.option3 === selectedOptions[2])
      );

      if (!currentVariant) return;

      if (hiddenInput) hiddenInput.value = currentVariant.id;

      if (galleryAPI && currentVariant.featured_media) {
        galleryAPI.showSlide(
          variants.findIndex(v => v.featured_media?.id === currentVariant.featured_media.id)
        );
      }

      updatePrice();
      updateButton();

      document.dispatchEvent(
        new CustomEvent('variant:change', { detail: { variant: currentVariant } })
      );
    }

    optionGroups.forEach((group, index) => {
      $$('.option-value', group).forEach(btn => {
        btn.addEventListener('click', () => {
          if (btn.classList.contains('is-unavailable')) return;
          selectedOptions[index] = btn.dataset.value;
          updateUI();
          updateVariant();
        });
      });
    });

    updateUI();
    updateVariant();
  }

  /* -------------------------
     QUANTITY
  -------------------------- */
  function initQuantity() {
    const wrapper = $('[data-quantity-wrapper]');
    if (!wrapper) return;

    const input = $('.qty-input', wrapper);
    const plus = $('.qty-plus', wrapper);
    const minus = $('.qty-minus', wrapper);

    if (!input) return;

    plus?.addEventListener('click', () => {
      input.value = parseInt(input.value || 1) + 1;
    });

    minus?.addEventListener('click', () => {
      if (input.value > 1) input.value--;
    });
  }

  /* -------------------------
     STICKY
  -------------------------- */
  function initSticky() {
    const sticky = $('.sticky-atc');
    const btn = $('.add-to-cart');

    if (!sticky || !btn) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        sticky.classList.toggle('active', !entry.isIntersecting);
      },
      { threshold: 0 }
    );

    observer.observe(btn);
  }

  /* -------------------------
     INIT ALL
  -------------------------- */
  const galleryAPI = initGallery();
  initZoom();
  initVariants(galleryAPI);
  initQuantity();
  initSticky();
}

/* -------------------------
   GLOBAL INIT
-------------------------- */
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll("[id^='MainProduct_']").forEach(section => {
    initProductScript(section.id.replace("MainProduct_", ""));
  });
});

document.addEventListener("shopify:section:load", (e) => {
  initProductScript(e.target.id.replace("MainProduct_", ""));
});
</script>
{% schema %}
{
  "tag": null,
  "name": "Product Template",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "product",
      "id": "product",
      "label": "product"
    },
    {
      "type": "header",
      "content": "Inforation Block Height"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_m",
      "label": "Gap Mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Block Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    { "type": "header", "content": "Desktop Padding Controls" },

    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Padding Left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Padding Right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile Padding Controls"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
