{%- capture style_schema -%}
  --bw: {{ block.settings.border }}px;
    --bc: {{ block.settings.color }};
    --w: {{ block.settings.width }}%;
    --bg: {{ block.settings.background }};
    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --ptm: {{ block.settings.ptm }}px;
    --pbm: {{ block.settings.pbm }}px;
    {% if block.settings.height == 'custom' %}
    --block-custom-height-desktop: {{ block.settings.custom_height }}%;
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
    {% endif %}
    {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
    {% endif %}
{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list -%}
custom-liquid-block; 
align--{{ block.settings.align }}; 
{% if block.settings.hide_mobile %}hide-mobile;{% endif %} 
{% if block.settings.hide_desktop %}hide-desktop;{% endif %}
{% if block.settings.height == 'custom' %}
  block-custom-height-desktop;
  {% else %}
  block-height-desktop-{{ block.settings.height }}; 
  {% endif %}
  {% if block.settings.width == 'custom' %}
  block-custom-width-desktop;
  {% else %}
  block-width-desktop-{{ block.settings.width }};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  block-custom-width-tablet; 
  {% else %}
  block-width-tablet-{{ block.settings.width_tablet }}; 
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  block-custom-width-mobile; 
  {% else %}
  block-width-mobile-{{ block.settings.width_mobile }}; 
  {% endif %}
{% endcapture %}
{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}

<div class="{{- class_list -}}" style=" {{- style_schema -}}"{{ block.shopify_attributes }}>
 {% liquid
  assign threshold = block.settings.threshold | times: 100
%}
<div class="cart-progress-wrapper"
    data-threshold="{{ threshold }}"
    data-pre-goal-message-template="{{ block.settings.pre_message | escape }}"
    data-post-goal-message="{{ block.settings.success_message | escape }}"
    style="
      --bar-bg: {{ block.settings.bg_color }};
      --bar-fill: {{ block.settings.fill_color }};
    ">
    <div class="cart-progress-bar-container">
      <div class="cart-progress-bar"></div>
    </div>
    <div class="goal-message"></div>
</div>
</div>
{% stylesheet %}
.cart-progress-bar-container {
  width: 100%;
  height: 6px;
  background: var(--bar-bg);
  border-radius: 10px;
  overflow: hidden;
}

.cart-progress-bar {
  width: 0%;
  height: 100%;
  background: var(--bar-fill);
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.goal-message {
  margin-top: 8px;
  font-size: 14px;
}

.cart-progress-wrapper.is-complete .cart-progress-bar {
  animation: pulse 1s ease;
}

@keyframes pulse {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

.custom-liquid-block {
    background: var(--bg);
    padding-top: var(--pt);
    padding-bottom: var(--pb);
  }
  
  @media (min-width: 1366px) {
  .custom-liquid-block.block-width-desktop-fill {
    align-self: stretch;
}
}
@media only screen and (min-width: 768px) and (max-width: 1365px) {
.custom-liquid-block.block-width-tablet-fill{
align-self: stretch;
}
}
  /* mobile */
  @media (max-width:767px){
  .custom-liquid-block.block-mobile-desktop-fill {
    align-self: stretch;
    flex: unset;
}
    .custom-liquid-block {
      padding-top: var(--ptm);
      padding-bottom: var(--pbm);
    }
  }
  /* hide */
  @media (min-width:768px){
    .hide-desktop{ display:none !important; }
  }
  @media (max-width:767px){
    .hide-mobile{ display:none !important; }
  }
{% endstylesheet %}
{% javascript %}
(function () {

  let cartCache = null;

  function getCart() {
    return fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        cartCache = cart;
        return cart;
      });
  }

  function updateFreeShippingBar() {

    getCart().then(cart => {

      const wrappers = document.querySelectorAll(".cart-progress-wrapper");
      if (!wrappers.length) return;

      // ✅ Calculate NON-subscription total
      let nonSubscriptionTotal = 0;

      cart.items.forEach(item => {
        if (!item.selling_plan_allocation) {
          nonSubscriptionTotal += item.line_price;
        }
      });

      const rate = Shopify?.currency?.rate || 1;
      const currency = Shopify?.currency?.active || 'USD';

      wrappers.forEach((wrapper) => {

        const bar = wrapper.querySelector(".cart-progress-bar");
        const message = wrapper.querySelector(".goal-message");

        const thresholdUSD = parseInt(wrapper.dataset.threshold || 0);
        if (!thresholdUSD) return;

        const threshold = thresholdUSD * rate;
        const cartTotal = nonSubscriptionTotal * rate;

        let progress = (cartTotal / threshold) * 100;
        progress = Math.min(progress, 100);

        let remaining = Math.max(threshold - cartTotal, 0);

        const formatted = new Intl.NumberFormat(undefined, {
          style: 'currency',
          currency: currency,
        }).format(remaining / 100);

        // ✅ UI update
        if (bar) bar.style.width = progress + "%";

        if (wrapper) {
          if (progress >= 100) {
            wrapper.classList.add("is-complete");
          } else {
            wrapper.classList.remove("is-complete");
          }
        }

        const template = wrapper.dataset.preGoalMessageTemplate;
        const success = wrapper.dataset.postGoalMessage;

        if (message) {
          if (remaining > 0) {
            message.innerHTML = template.replace('[amount]', formatted);
          } else {
            message.innerHTML = success;
          }
        }

      });

    });
  }

  // ✅ INIT
  document.addEventListener("DOMContentLoaded", updateFreeShippingBar);

  // ✅ Shopify cart events (if supported)
  document.addEventListener("cart:updated", updateFreeShippingBar);
  document.addEventListener("ajaxCart:updated", updateFreeShippingBar);

  // ✅ Fallback (works in ALL themes)
  document.addEventListener("click", function () {
    setTimeout(updateFreeShippingBar, 300);
  });

})();
{% endjavascript %}

{% schema %}
{
  "name": "Custom Liquid",
  "tag": null,
  "settings": [
    {
      "type": "number",
      "id": "threshold",
      "label": "Free Shipping Threshold",
      "default": 75
    },
    {
      "type": "text",
      "id": "pre_message",
      "label": "Message before goal",
      "default": "You're only [amount] away from FREE SHIPPING"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "🎉 Congrats! You've unlocked FREE SHIPPING"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Bar Background",
      "default": "#eee"
    },
    {
      "type": "color",
      "id": "fill_color",
      "label": "Bar Fill Color",
      "default": "#000"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Height"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "header",
      "content": "Visibility"
    },

    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide desktop"
    },

    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide mobile"
    }
  ],
  "presets": [{ "name": "Progress Bar" }]
}
{% endschema %}
