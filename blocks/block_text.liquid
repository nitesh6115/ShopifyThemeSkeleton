{%- liquid
  assign b = block.settings
-%}


{%- capture style_schema -%}

  /* alignment */
  --text-align: {{ b.alignment }};

  /* font */
  --font-size-desktop: {{ b.font_size }}px;
  --font-size-mobile: {{ b.font_size_mobile }}px;
  --font-weight: {{ b.font_weight }};
  --lh-d: {{ b.line_height }};
  --lh-m: {{ b.line_height_mobile }};
  --ls-d: {{ b.letter_spacing }}px;
  --ls-m: {{ b.letter_spacing_mobile }}px;
  --text-color: {{ b.color }};

  /* background */
  --bg: {{ b.background }};
  --radius: {{ b.radius }}px;
  --border-size: {{ b.border_size }}px;
  --border-color: {{ b.border_color }};

  /* padding desktop */
  --pt: {{ b.pt }}px;
  --pb: {{ b.pb }}px;
  --pl: {{ b.pl }}px;
  --pr: {{ b.pr }}px;

  /* padding mobile */
  --pt-m: {{ b.pt_m }}px;
  --pb-m: {{ b.pb_m }}px;
  --pl-m: {{ b.pl_m }}px;
  --pr-m: {{ b.pr_m }}px;


  /* height */
  {% if b.height == 'custom' %}
    --block-custom-height-desktop: {{ b.custom_height }}%;
  {% endif %}

  /* width desktop */
  {% if b.width == 'custom' %}
    --block-custom-width-desktop:
      {% if b.custom_width_unit_desktop == 'px' %}
        {{ b.custom_width_pixel }}px
      {% else %}
        {{ b.custom_width }}%
      {% endif %};
  {% endif %}

  /* width tablet */
  {% if b.width_tablet == 'custom' %}
    --block-custom-width-tablet:
      {% if b.custom_width_unit_tablet == 'px' %}
        {{ b.custom_width_tablet_pixel }}px
      {% else %}
        {{ b.custom_width_tablet }}%
      {% endif %};
  {% endif %}

  /* width mobile */
  {% if b.width_mobile == 'custom' %}
    --block-custom-width-mobile:
      {% if b.custom_width_unit_mobile == 'px' %}
        {{ b.custom_width_pixel_mobile }}px
      {% else %}
        {{ b.custom_width_mobile }}%
      {% endif %};
  {% endif %}

{%- endcapture -%}


{%- capture class_list -%}

text_block

{% if b.height == 'custom' %}
  block-custom-height-desktop
{% else %}
  block-height-desktop-{{ b.height }}
{% endif %}

{% if b.width == 'custom' %}
  block-custom-width-desktop
{% else %}
  block-width-desktop-{{ b.width }}
{% endif %}

{% if b.width_tablet == 'custom' %}
  block-custom-width-tablet
{% else %}
  block-width-tablet-{{ b.width_tablet }}
{% endif %}

{% if b.width_mobile == 'custom' %}
  block-custom-width-mobile
{% else %}
  block-width-mobile-{{ b.width_mobile }}
{% endif %}

{% if b.hide_mobile %}
  hide-mobile
{% endif %}

{% if b.hide_desktop %}
  hide-desktop
{% endif %}

{%- endcapture -%}


{% assign class_list = class_list | strip_newlines | replace: '  ', ' ' | strip %}



<div
  class="{{ class_list }}"
  style="{{ style_schema }}"
  {{ block.shopify_attributes }}
>

  {% if b.block_link != blank %}
    <a class="block_link" href="{{ b.block_link }}">
  {% endif %}

  {{ b.text }}

  {% if b.block_link != blank %}
    </a>
  {% endif %}

</div>



{% stylesheet %}

.text_block{
  text-align: var(--text-align);

  font-size: var(--font-size-desktop);
  font-weight: var(--font-weight);
  line-height: var(--lh-d);
  letter-spacing: var(--ls-d);

  color: var(--text-color);
  background: var(--bg);

  border-radius: var(--radius);
  border-style: solid;
  border-width: var(--border-size);
  border-color: var(--border-color);

  padding-top: var(--pt);
  padding-bottom: var(--pb);
  padding-left: var(--pl);
  padding-right: var(--pr);

  display: inline-block;
}


.text_block p{
  font-size: var(--font-size-desktop);
  line-height: var(--lh-d);
  letter-spacing: var(--ls-d);
  font-weight: var(--font-weight);
}


/* mobile */

@media screen and (max-width: 767px){

  .text_block{
    font-size: var(--font-size-mobile);
    line-height: var(--lh-m);
    letter-spacing: var(--ls-m);

    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
  }

  .text_block p{
    font-size: var(--font-size-mobile);
    line-height: var(--lh-m);
    letter-spacing: var(--ls-m);
  }

}

{% endstylesheet %}
{% schema %}
{
  "name": "Text",
  "tag": null,

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Text</p>"
    },
    {
      "type": "url",
      "id": "block_link",
      "label": "Block Link"
    },



    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },



    {
      "type": "header",
      "content": "Width"
    },

    {
      "type": "select",
      "id": "width",
      "label": "Desktop Width",
      "default": "fill",
      "options": [
        { "value": "fit-content", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ]
    },

    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Unit",
      "options": [
        { "value": "%", "label": "%" },
        { "value": "px", "label": "px" }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },

    {
      "type": "number",
      "id": "custom_width_pixel",
      "label": "Width px",
      "default": 200,
      "visible_if": "{{ block.settings.width == 'custom' and block.settings.custom_width_unit_desktop == 'px' }}"
    },

    {
      "type": "range",
      "id": "custom_width",
      "label": "Width %",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' and block.settings.custom_width_unit_desktop == '%' }}"
    },



    {
      "type": "header",
      "content": "Height"
    },

    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "fit",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ]
    },

    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height %",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },



    {
      "type": "header",
      "content": "Typography"
    },

    {
      "type": "range",
      "id": "font_size",
      "label": "Font size desktop",
      "min": 8,
      "max": 80,
      "step": 1,
      "default": 16
    },

    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 8,
      "max": 40,
      "step": 1,
      "default": 14
    },

    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "400",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },

    {
      "type": "select",
      "id": "line_height",
      "label": "Line height desktop",
      "default": "1.4",
      "options": [
        { "value": "1", "label": "Tight" },
        { "value": "1.2", "label": "Normal" },
        { "value": "1.4", "label": "Comfortable" },
        { "value": "1.6", "label": "Loose" },
        { "value": "1.8", "label": "Extra loose" }
      ]
    },

    {
      "type": "select",
      "id": "line_height_mobile",
      "label": "Line height mobile",
      "default": "1.4",
      "options": [
        { "value": "1", "label": "Tight" },
        { "value": "1.2", "label": "Normal" },
        { "value": "1.4", "label": "Comfortable" },
        { "value": "1.6", "label": "Loose" },
        { "value": "1.8", "label": "Extra loose" }
      ]
    },

    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing desktop",
      "min": -5,
      "max": 20,
      "step": 1,
      "default": 0
    },

    {
      "type": "range",
      "id": "letter_spacing_mobile",
      "label": "Letter spacing mobile",
      "min": -5,
      "max": 20,
      "step": 1,
      "default": 0
    },

    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#000000"
    },



    {
      "type": "header",
      "content": "Background"
    },

    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },

    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },

    {
      "type": "range",
      "id": "border_size",
      "label": "Border size",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    },



    {
      "type": "header",
      "content": "Spacing Desktop"
    },

    { "type": "range", "id": "pt", "label": "Top", "min": 0, "max": 200, "step": 2, "default": 0 },
    { "type": "range", "id": "pb", "label": "Bottom", "min": 0, "max": 200, "step": 2, "default": 0 },
    { "type": "range", "id": "pl", "label": "Left", "min": 0, "max": 200, "step": 2, "default": 0 },
    { "type": "range", "id": "pr", "label": "Right", "min": 0, "max": 200, "step": 2, "default": 0 },



    {
      "type": "header",
      "content": "Spacing Mobile"
    },

    { "type": "range", "id": "pt_m", "label": "Top", "min": 0, "max": 100, "step": 2, "default": 0 },
    { "type": "range", "id": "pb_m", "label": "Bottom", "min": 0, "max": 100, "step": 2, "default": 0 },
    { "type": "range", "id": "pl_m", "label": "Left", "min": 0, "max": 100, "step": 2, "default": 0 },
    { "type": "range", "id": "pr_m", "label": "Right", "min": 0, "max": 100, "step": 2, "default": 0 },



    {
      "type": "header",
      "content": "Visibility"
    },

    { "type": "checkbox", "id": "hide_mobile", "label": "Hide on mobile" },
    { "type": "checkbox", "id": "hide_desktop", "label": "Hide on desktop" }

  ],

  "presets": [
    { "name": "Text" }
  ]
}
{% endschema %}
