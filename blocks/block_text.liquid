{% doc %}
  Advanced Text Block
{% enddoc %}

<div
 
  style="
    --text-align: {{ block.settings.alignment }};
    --font-size-desktop: {{ block.settings.font_size }}px;
    --font-size-mobile: {{ block.settings.font_size_mobile }}px;
    --font-weight: {{ block.settings.font_weight }};
    --text-color: {{ block.settings.color }};
    --bg: {{ block.settings.background }};
    --radius: {{ block.settings.radius }}px;
    --border-size: {{ block.settings.border_size }}px;
    --border-color: {{ block.settings.border_color }};
    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;
    --pt-m: {{ block.settings.pt_m }}px;
    --pb-m: {{ block.settings.pb_m }}px;
    --pl-m: {{ block.settings.pl_m }}px;
    --pr-m: {{ block.settings.pr_m }}px;
    
    --item-width: {{ block.settings.width }}%;
    --item-width-m: {{ block.settings.width_m }}%;
    --item-grow: {{ block.settings.grow }};
    --item-shrink: {{ block.settings.shrink }};
  "
  {{ block.shopify_attributes }}
>
 <div class="text_block"> {{ block.settings.text }}</div>
</div>

{% stylesheet %}
  .text_block {
    text-align: var(--text-align);
    font-size: var(--font-size-desktop);
    font-weight: var(--font-weight);
    color: var(--text-color);
    background: var(--bg);
    border-radius: var(--radius);
    border-style: solid;
    border-width: var(--border-size);
    border-color: var(--border-color);
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    padding-left: var(--pl);
    padding-right: var(--pr);
    display: inline-block;
  }
  .text_block p{
    font-size: var(--font-size-desktop);
    font-weight: var(--font-weight);
    color: var(--text-color);
  }
  /* mobile */
  @media screen and (max-width: 749px) {
    .text_block p{
      font-size: var(--font-size-mobile);
    }
     .text_block {
      font-size: var(--font-size-mobile);
      padding-top: var(--pt-m);
      padding-bottom: var(--pb-m);
      padding-left: var(--pl-m);
      padding-right: var(--pr-m);
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Text</p>"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
  "type":"range",
  "id":"width",
  "label":"Width %",
  "min":5,
  "max":100,
  "step":5,
  "default":100
},

{
  "type":"range",
  "id":"width_m",
  "label":"Width mobile %",
  "min":10,
  "max":100,
  "step":5,
  "default":100
},

{
  "type":"range",
  "id":"grow",
  "label":"Grow",
  "min":0,
  "max":5,
  "step":1,
  "default":0
},

{
  "type":"range",
  "id":"shrink",
  "label":"Shrink",
  "min":0,
  "max":5,
  "step":1,
  "default":1
},
    {
      "type": "header",
      "content": "Font"
    },
