{%- liquid
  assign b = block.settings
-%}


{%- capture style_schema -%}

  /* alignment */
  --text-align: {{ b.alignment }};

  /* font */
  --font-size-desktop: {{ b.font_size }}px;
  --font-size-mobile: {{ b.font_size_mobile }}px;
  --font-weight: {{ b.font_weight }};
  --lh-d: {{ b.line_height }};
  --lh-m: {{ b.line_height_mobile }};
  --ls-d: {{ b.letter_spacing }}px;
  --ls-m: {{ b.letter_spacing_mobile }}px;
  --text-color: {{ b.color }};

  /* background */
  --bg: {{ b.background }};
  --radius: {{ b.radius }}px;
  --border-size: {{ b.border_size }}px;
  --border-color: {{ b.border_color }};

  /* padding desktop */
  --pt: {{ b.pt }}px;
  --pb: {{ b.pb }}px;
  --pl: {{ b.pl }}px;
  --pr: {{ b.pr }}px;

  /* padding mobile */
  --pt-m: {{ b.pt_m }}px;
  --pb-m: {{ b.pb_m }}px;
  --pl-m: {{ b.pl_m }}px;
  --pr-m: {{ b.pr_m }}px;


  /* height */
  {% if b.height == 'custom' %}
    --block-custom-height-desktop: {{ b.custom_height }}%;
  {% endif %}

  /* width desktop */
  {% if b.width == 'custom' %}
    --block-custom-width-desktop:
      {% if b.custom_width_unit_desktop == 'px' %}
        {{ b.custom_width_pixel }}px
      {% else %}
        {{ b.custom_width }}%
      {% endif %};
  {% endif %}

  /* width tablet */
  {% if b.width_tablet == 'custom' %}
    --block-custom-width-tablet:
      {% if b.custom_width_unit_tablet == 'px' %}
        {{ b.custom_width_tablet_pixel }}px
      {% else %}
        {{ b.custom_width_tablet }}%
      {% endif %};
  {% endif %}

  /* width mobile */
  {% if b.width_mobile == 'custom' %}
    --block-custom-width-mobile:
      {% if b.custom_width_unit_mobile == 'px' %}
        {{ b.custom_width_pixel_mobile }}px
      {% else %}
        {{ b.custom_width_mobile }}%
      {% endif %};
  {% endif %}

{%- endcapture -%}


{%- capture class_list -%}

text_block

{% if b.height == 'custom' %}
  block-custom-height-desktop
{% else %}
  block-height-desktop-{{ b.height }}
{% endif %}

{% if b.width == 'custom' %}
  block-custom-width-desktop
{% else %}
  block-width-desktop-{{ b.width }}
{% endif %}

{% if b.width_tablet == 'custom' %}
  block-custom-width-tablet
{% else %}
  block-width-tablet-{{ b.width_tablet }}
{% endif %}

{% if b.width_mobile == 'custom' %}
  block-custom-width-mobile
{% else %}
  block-width-mobile-{{ b.width_mobile }}
{% endif %}

{% if b.hide_mobile %}
  hide-mobile
{% endif %}

{% if b.hide_desktop %}
  hide-desktop
{% endif %}

{%- endcapture -%}


{% assign class_list = class_list | strip_newlines | replace: '  ', ' ' | strip %}



<div
  class="{{ class_list }}"
  style="{{ style_schema }}"
  {{ block.shopify_attributes }}
>

  {% if b.block_link != blank %}
    <a class="block_link" href="{{ b.block_link }}">
  {% endif %}

  {{ b.text }}

  {% if b.block_link != blank %}
    </a>
  {% endif %}

</div>



{% stylesheet %}

.text_block{
  text-align: var(--text-align);

  font-size: var(--font-size-desktop);
  font-weight: var(--font-weight);
  line-height: var(--lh-d);
  letter-spacing: var(--ls-d);

  color: var(--text-color);
  background: var(--bg);

  border-radius: var(--radius);
  border-style: solid;
  border-width: var(--border-size);
  border-color: var(--border-color);

  padding-top: var(--pt);
  padding-bottom: var(--pb);
  padding-left: var(--pl);
  padding-right: var(--pr);

  display: inline-block;
}


.text_block p{
  font-size: var(--font-size-desktop);
  line-height: var(--lh-d);
  letter-spacing: var(--ls-d);
  font-weight: var(--font-weight);
}


/* mobile */

@media screen and (max-width: 767px){

  .text_block{
    font-size: var(--font-size-mobile);
    line-height: var(--lh-m);
    letter-spacing: var(--ls-m);

    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
  }

  .text_block p{
    font-size: var(--font-size-mobile);
    line-height: var(--lh-m);
    letter-spacing: var(--ls-m);
  }

}

{% endstylesheet %}
{% schema %}
{
  "name": "Text",
  "tag": null,

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Text</p>"
    },
    {
      "type": "url",
      "id": "block_link",
      "label": "Block Link"
    },



    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },



    {
      "type": "header",
      "content": "Width Desktop"
    },

    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "default": "fill",
      "options": [
        { "value": "fit-content", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ]
    },

    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Unit",
      "options": [
        { "label": "%", "value": "%" },
        { "label": "px", "value": "px" }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },

    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Width px",
      "visible_if": "{{ block.settings.width == 'custom' and block.settings.custom_width_unit_desktop == 'px' }}"
    },

    {
      "type": "range",
      "id": "custom_width",
      "label": "Width %",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' and block.settings.custom_width_unit_desktop == '%' }}"
    },



    {
      "type": "header",
      "content": "Width Tablet"
    },

    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "default": "fill",
      "options": [
        { "value": "fit-content", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ]
    },

    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Unit",
      "options": [
        { "label": "%", "value": "%" },
        { "label": "px", "value": "px" }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },

    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Width px",
      "visible_if": "{{ block.settings.width_tablet == 'custom' and block.settings.custom_width_unit_tablet == 'px' }}"
    },

    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Width %",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_tablet == 'custom' and block.settings.custom_width_unit_tablet == '%' }}"
    },



    {
      "type": "header",
      "content": "Width Mobile"
    },

    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "default": "fill",
      "options": [
        { "value": "fit-content", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ]
    },

    {
      "type": "select",
      "id": "custom_width_unit_mobile",
      "label": "Unit",
      "options": [
        { "label": "%", "value": "%" },
        { "label": "px", "value": "px" }
      ],
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },

    {
      "type": "number",
      "id": "custom_width_pixel_mobile",
      "default": 48,
      "label": "Width px",
      "visible_if": "{{ block.settings.width_mobile == 'custom' and block.settings.custom_width_unit_mobile == 'px' }}"
    },

    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Width %",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' and block.settings.custom_width_unit_mobile == '%' }}"
    },



    {
      "type": "header",
      "content": "Height"
    },

    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "fit",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ]
    },

    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom height %",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}
