      "label": "Font weight",
      "default": "400",
      "options": [
        { "value": "100", "label": "100 Thin" },
        { "value": "200", "label": "200 Extra Light" },
        { "value": "300", "label": "300 Light" },
        { "value": "400", "label": "400 Regular" },
        { "value": "500", "label": "500 Medium" },
        { "value": "600", "label": "600 Semi Bold" },
        { "value": "700", "label": "700 Bold" },
        { "value": "800", "label": "800 Extra Bold" },
        { "value": "900", "label": "900 Black" }
      ]
    },

    {
      "type": "color",
      "id": "color",
      "label": "Font color",
      "default": "#000000"
    },



    {
      "type": "header",
      "content": "Background"
    },

    {
      "type": "color",
      "id": "background",
      "label": "Background color"
    },

    {
      "type": "range",
      "id": "radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },

    {
      "type": "range",
      "id": "border_size",
      "label": "Border size",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    },
{
  "type": "header",
  "content": "Padding Desktop"
},

{
  "type": "range",
  "id": "pt",
  "label": "Padding top",
  "min": 0,
  "max": 200,
  "step": 2,
  "default": 0
},

{
  "type": "range",
  "id": "pb",
  "label": "Padding bottom",
  "min": 0,
  "max": 200,
  "step": 2,
  "default": 0
},

{
  "type": "range",
  "id": "pl",
  "label": "Padding left",
  "min": 0,
  "max": 200,
  "step": 2,
  "default": 0
},

{
  "type": "range",
  "id": "pr",
  "label": "Padding right",
  "min": 0,
  "max": 200,
  "step": 2,
  "default": 0
},

{
  "type": "header",
  "content": "Padding Mobile"
},

{
  "type": "range",
  "id": "pt_m",
  "label": "Padding top mobile",
  "min": 0,
  "max": 100,
  "step": 2,
  "default": 0
