{% doc %}
  Advanced Text Block
{% enddoc %}

<div
  class="text_block
    {% if block.settings.height == 'custom' %}
     block-custom-height-desktop 
     {% else %}
    block-height-desktop-{{ block.settings.height }}
    {% endif %}
    {% if block.settings.width == 'custom' %}
    block-custom-width-desktop
    {% else %}
    block-width-desktop-{{ block.settings.width }}
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    block-custom-width-tablet
    {% else %}
     block-width-tablet-{{ block.settings.width_tablet }}
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    block-custom-width-mobile
    {% else %}
     block-width-mobile-{{ block.settings.width_mobile }}
    {% endif %}
  "
  style="
    --text-align: {{ block.settings.alignment }};
    --font-size-desktop: {{ block.settings.font_size }}px;
    --font-size-mobile: {{ block.settings.font_size_mobile }}px;
    --font-weight: {{ block.settings.font_weight }};
    --text-color: {{ block.settings.color }};
    --bg: {{ block.settings.background }};
    --radius: {{ block.settings.radius }}px;
    --border-size: {{ block.settings.border_size }}px;
    --border-color: {{ block.settings.border_color }};
    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;
    --pt-m: {{ block.settings.pt_m }}px;
    --pb-m: {{ block.settings.pb_m }}px;
    --pl-m: {{ block.settings.pl_m }}px;
    --pr-m: {{ block.settings.pr_m }}px;
    {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%; 
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {{ block.settings.custom_width }}%;
    {% endif %}
    {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {{ block.settings.custom_width_tablet }}%;
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {{ block.settings.custom_width_mobile }}%;
    {% endif %} 
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.block_link != blank %}
    <a class="block_link" href="{{ block.settings.block_link }}">
  {% endif %}
  {{ block.settings.text }}
  {% if block.settings.block_link != blank %}
  </a>
  {% endif %}
</div>

{% stylesheet %}
  .text_block {
    text-align: var(--text-align);
    font-size: var(--font-size-desktop);
    font-weight: var(--font-weight);
    color: var(--text-color);
    background: var(--bg);
    border-radius: var(--radius);
    border-style: solid;
    border-width: var(--border-size);
    border-color: var(--border-color);
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    padding-left: var(--pl);
    padding-right: var(--pr);
    display: inline-block;
  }
  .text_block p{
    font-size: var(--font-size-desktop);
    font-weight: var(--font-weight);
    color: var(--text-color);
  }
  /* mobile */
  @media screen and (max-width: 767px) {
    .text_block p{
      font-size: var(--font-size-mobile);
    }
     .text_block {
      font-size: var(--font-size-mobile);
      padding-top: var(--pt-m);
      padding-bottom: var(--pb-m);
      padding-left: var(--pl-m);
      padding-right: var(--pr-m);
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Text</p>"
    },
    {
      "type": "url",
      "label": "Block Link",
      "id": "block_link"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
     {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Font"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size desktop",
      "min": 8,
      "max": 80,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 8,
      "max": 40,
      "step": 1,
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "400",
      "options": [
        { "value": "100", "label": "100 Thin" },
        { "value": "200", "label": "200 Extra Light" },
        { "value": "300", "label": "300 Light" },
        { "value": "400", "label": "400 Regular" },
        { "value": "500", "label": "500 Medium" },
        { "value": "600", "label": "600 Semi Bold" },
        { "value": "700", "label": "700 Bold" },
        { "value": "800", "label": "800 Extra Bold" },
        { "value": "900", "label": "900 Black" }
      ]
    },
    {
      "type": "color",
      "id": "color",
      "label": "Font color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border_size",
      "label": "Border size",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Padding left",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Padding right",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Padding top mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl_m",
      "label": "Padding left mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr_m",
      "label": "Padding right mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Hide Controls"
    },
    { "type": "checkbox", "id": "hide_mobile", "label": "Hide on Mobile" },
    { "type": "checkbox", "id": "hide_desktop", "label": "Hide on Desktop" }
  ],

  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}
