{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
{%- assign widths = '165,360,535,750,1070,1500' -%}
{%- capture style_schema -%}
--bg: {{ block.settings.background }};
    {% if block.settings.set_full_radius %}
    --radius-top-left: {{ block.settings.radius_top_left }}px;
    --radius-top-right: {{ block.settings.radius_top_right }}px;
    --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
    --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
    {% else %}
    --radius-top-left: {{ block.settings.radius }}px;
    --radius-top-right: {{ block.settings.radius }}px;
    --radius-bottom-left: {{ block.settings.radius }}px;
    --radius-bottom-right: {{ block.settings.radius }}px;
    {% endif %}
    --border: {{ block.settings.border }}px;
    --border-color: {{ block.settings.border_color }};

    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;

    --pt-m: {{ block.settings.pt_m }}px;
    --pb-m: {{ block.settings.pb_m }}px;
    --pl-m: {{ block.settings.pl_m }}px;
    --pr-m: {{ block.settings.pr_m }}px;

    --pos: {{ block.settings.position }}%;
    {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%; 
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
    {% endif %}
{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list -%}
    before_after_block before-after-container;
    {% if block.settings.height == 'custom' %}
     block-custom-height-desktop; 
     {% else %}
    block-height-desktop-{{ block.settings.height }};
    {% endif %}
    {% if block.settings.width == 'custom' %}
    block-custom-width-desktop;
    {% else %}
    block-width-desktop-{{ block.settings.width }};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    block-custom-width-tablet;
    {% else %}
     block-width-tablet-{{ block.settings.width_tablet }};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    block-custom-width-mobile;
    {% else %}
     block-width-mobile-{{ block.settings.width_mobile }};
    {% endif %}
    {% if block.settings.shadow %}is-shadow;{% endif %}
     {% if block.settings.hide_mobile %} hide-mobile;{% endif %}
    {% if block.settings.hide_desktop %} hide-desktop;{% endif %}
{%- endcapture -%}
{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}

<div id="ba-{{ block.id }}" class="{{- class_list -}}" style="{{- style_schema -}}" {{ block.shopify_attributes }}>
  {% if block.settings.after != blank and block.settings.before != blank %}
  <div class="before-after-wrapper">
    <div class="before-after-image-container" id="ba-container-{{ block.id }}">
      <div class="image-container">
        {{
          block.settings.before
          | image_url: width: 1500
          | image_tag:
            widths: widths,
            sizes: '(min-width: 1200px) 700px, 100vw',
            loading: 'lazy',
            fetch_priority: fetch_priority,
            class: 'image-before slider-image',
            alt: block.settings.before.alt | escape | default : 'block_image'
        }}
        {{
          block.settings.after
          | image_url: width: 1500
          | image_tag:
            widths: widths,
            fetch_priority: fetch_priority,
            sizes: '(min-width: 1200px) 700px, 100vw',
            loading: 'lazy',
            class: 'image-after slider-image',
            alt: block.settings.after.alt | escape | default : 'block_image'
        }}
      </div>
      <!-- step="10" -->
      <input
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="Percentage of before photo shown"
        class="slider slider_button_befor"
      >
      <div class="slider-line" aria-hidden="true"></div>
      <div class="slider-button" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="30"
          height="30"
          fill="currentColor"
          viewBox="0 0 256 256"
        >
          <rect width="256" height="256" fill="none"></rect>
          <line
            x1="128"
            y1="40"
            x2="128"
            y2="216"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></line>
          <line
            x1="96"
            y1="128"
            x2="16"
            y2="128"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></line>
          <polyline
            points="48 160 16 128 48 96"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></polyline>
          <line
            x1="160"
            y1="128"
            x2="240"
            y2="128"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></line>
          <polyline
            points="208 96 240 128 208 160"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></polyline>
        </svg>
      </div>
      <div class="before-after-label label-before">Before</div>
      <div class="before-after-label label-after">After</div>
    </div>
  </div>
  {% endif %}
</div>
{% stylesheet %}
  .before_after_block {
    background: var(--bg);
    border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
	  border: var(--border) solid var(--border-color);
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    padding-left: var(--pl);
    padding-right: var(--pr);
    overflow: hidden;
    position: relative;
  }
  .before-after-container {
    position: relative;
  }
  .before-after-container img {
    display: block;
    width: 100%;
  }
  .before-after-after {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    overflow: hidden;
  }
  .before-after-slider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 3px;
    height: 100%;
    background:var(--star-line-color);
    cursor: ew-resize;
  }
  .before-after-label {
    position: absolute;
    top: 20px;
    background: #fff;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 14px;
  }
  .label-before { left: 20px; }
  .label-after { right: 20px; }
  .before-after-container img,
  .ba-placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .before-after-after {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
  }
  .ba-placeholder {
    width: 100%;
    height: 100%;
    background: #f4f4f4;
  }
  .before-after-container .before-after-image-container{
    display: grid;
    position: relative;
    overflow: hidden;
    --position: 50%;
  }
  .before-after-container .slider-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left;
  }
  .before-after-container .image-before {
    position: absolute;
    inset: 0;
    width: var(--position);
  }
  .before-after-container .slider {
    position: absolute;
    inset: 0;
    cursor: pointer;
    opacity: 0;
    width: 100%;
    height: 100%;
  }
  .before-after-container .slider:focus-visible ~ .slider-button {
    outline: 5px solid black;
    outline-offset: 3px;
  }
  .before-after-container .slider-line {
    position: absolute;
    inset: 0;
    width: .2rem;
    height: 100%;
    background-color: #fff;
    /* z-index: 10; */
    left: var(--position);
    transform: translateX(-50%);
    pointer-events: none;
  }
  .before-after-container .slider-button {
    position: absolute;
    background-color: #fff;
    color: black;
    padding: .5rem;
    border-radius: 100vw;
    display: grid;
    place-items: center;
    top: 50%;
    left: var(--position);
    transform: translate(-50%, -50%);
    pointer-events: none;
    box-shadow: 1px 1px 1px hsl(0, 50%, 2%, .5);
  }
  @media screen and (max-width: 767px) {
  .before_after_block{
    padding-top: var(--pt-m);
    padding-bottom: var(--pb-m);
    padding-left: var(--pl-m);
    padding-right: var(--pr-m);
  }
  }
{% endstylesheet %}
<script>
 const container = document.querySelector('#ba-container-{{ block.id }}');
  container.querySelector('.slider_button_befor').addEventListener('input', (e) => {
    container.style.setProperty('--position', `${e.target.value}%`);
  });
</script>
{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "before",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after",
      "label": "After Image"
    },
    {
      "type": "range",
      "id": "position",
      "label": "Slider start position",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Hover zoom"
    },

    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box shadow"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Choose Unit Width Dektop",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Custom Width Desktop In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_desktop == 'px' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_desktop == '%' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Choose Unit Width Tablet",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Custom Width Tablet In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_tablet == 'px' and block.settings.width_tablet == 'custom'}}"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_tablet == '%' and block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_mobile",
      "label": "Choose Unit Width Mobile",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel_mobile",
      "default": 48,
      "label": "Custom Width Mobile In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_mobile == 'px' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_mobile == '%' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Block Radius"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "visible_if": "{{ block.settings.set_full_radius == false }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border",
      "label": "Border",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Padding left",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Padding right",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Padding top mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl_m",
      "label": "Padding left mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr_m",
      "label": "Padding right mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    { "type": "checkbox", "id": "hide_mobile", "label": "Hide on Mobile" },
    { "type": "checkbox", "id": "hide_desktop", "label": "Hide on Desktop" }
  ],

  "presets": [
    {
      "name": "Befor After Image"
    }
  ]
}
{% endschema %}
