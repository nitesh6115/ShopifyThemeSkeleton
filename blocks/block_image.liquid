{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- capture style_schema -%}
    --bg: {{ block.settings.background }};
    {% if block.settings.set_full_radius %}
    --radius-top-left: {{ block.settings.radius_top_left }}px;
    --radius-top-right: {{ block.settings.radius_top_right }}px;
    --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
    --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
    {% else %}
    --radius-top-left: {{ block.settings.radius }}px;
    --radius-top-right: {{ block.settings.radius }}px;
    --radius-bottom-left: {{ block.settings.radius }}px;
    --radius-bottom-right: {{ block.settings.radius }}px;
    {% endif %}
    --border: {{ block.settings.border }}px;
    --border-color: {{ block.settings.border_color }};
    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;
    --pt-m: {{ block.settings.pt_m }}px;
    --pb-m: {{ block.settings.pb_m }}px;
    --pl-m: {{ block.settings.pl_m }}px;
    --pr-m: {{ block.settings.pr_m }}px;
    
    {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%; 
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
    {% endif %}
{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list -%}
image_block;
    {% if block.settings.height == 'custom' %}
     block-custom-height-desktop; 
     {% else %}
    block-height-desktop-{{ block.settings.height }};
    {% endif %}
    {% if block.settings.width == 'custom' %}
    block-custom-width-desktop;
    {% else %}
    block-width-desktop-{{ block.settings.width }};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    block-custom-width-tablet;
    {% else %}
     block-width-tablet-{{ block.settings.width_tablet }};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    block-custom-width-mobile;
    {% else %}
     block-width-mobile-{{ block.settings.width_mobile }};
    {% endif %}
    ratio--{{ block.settings.ratio }};
    {% if block.settings.hover_zoom %}is-zoom;{% endif %}
    {% if block.settings.shadow %}is-shadow;{% endif %}
{% endcapture %}
{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}

<div
  class="{{- class_list -}}" style=" {{- style_schema -}}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.image != blank and block.settings.image_link != blank %}
    <a class="block_link" href="{{ block.settings.image_link }}">
  {% endif %}
  {% if block.settings.image != blank %}
    {%- capture img_alt -%}{%- if block.settings.bg_image.alt != blank -%}{{ block.settings.bg_image.alt }}{% else %}{{ shop.name }}{% endif %}{%- endcapture -%}
    {{ block.settings.bg_image | image_url: width: 1600
            | image_tag:
            loading: 'lazy',
            fetch_priority: fetch_priority,
            widths: '360, 540, 720, 900, 1080, 1320, 1600',
            sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
            alt: img_alt
        }}
  {% else %}
    {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
  {% endif %}
  {% if block.settings.image != blank and block.settings.image_link != blank %}
  </a>
  {% endif %}
</div>

{% stylesheet %}
   .image_block {
    background: var(--bg);
    border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
	  border: var(--border) solid var(--border-color);
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    padding-left: var(--pl);
    padding-right: var(--pr);
    overflow: hidden;
    position: relative;
  }
    /* image */
  .image_block img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    transition: transform .35s ease;
  }

  .ratio--square {aspect-ratio: 1 / 1;}
  .ratio--landscape {aspect-ratio: 4 / 3;}
  .ratio--portrait {aspect-ratio: 3 / 4;}
  .ratio--auto {aspect-ratio: auto;}
  .ratio--auto img {aspect-ratio: auto;}
  .ratio--square img {aspect-ratio: 1 / 1;object-fit: cover;}
  .ratio--landscape img {aspect-ratio: 4 / 3;object-fit: cover;}
  .ratio--portrait img {aspect-ratio: 3 / 4;object-fit: cover;}
    /* mobile */
  @media screen and (max-width: 767px) {
  .image_block{
        padding-top: var(--pt-m);
        padding-bottom: var(--pb-m);
        padding-left: var(--pl-m);
        padding-right: var(--pr-m);
      }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "label": "Image Link",
      "id": "image_link"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Hover zoom"
    },

    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box shadow"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Choose Unit Width Dektop",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Custom Width Desktop In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_desktop == 'px' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_desktop == '%' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Choose Unit Width Tablet",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Custom Width Tablet In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_tablet == 'px' and block.settings.width_tablet == 'custom'}}"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_tablet == '%' and block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_mobile",
      "label": "Choose Unit Width Mobile",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel_mobile",
      "default": 48,
      "label": "Custom Width Mobile In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_mobile == 'px' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_mobile == '%' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Block Radius"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "visible_if": "{{ block.settings.set_full_radius == false }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "label": "Set Each Corner Radius",
      "id": "set_full_radius"
    },
    {
      "type": "range",
      "id": "radius_top_left",
      "label": "Radius Top Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_top_right",
      "label": "Radius Top Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_left",
      "label": "Radius Bottom Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_right",
      "label": "Radius Bottom Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border",
      "label": "Border",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Padding left",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Padding right",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Padding top mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl_m",
      "label": "Padding left mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr_m",
      "label": "Padding right mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    { "type": "checkbox", "id": "hide_mobile", "label": "Hide on Mobile" },
    { "type": "checkbox", "id": "hide_desktop", "label": "Hide on Desktop" }
  ],

  "presets": [
    {
      "name": "Image"
    }
  ]
}
{% endschema %}
