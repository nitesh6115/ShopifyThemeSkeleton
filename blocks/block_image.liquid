{% doc %}
  Advanced Text Block
{% enddoc %}

<div
  class="
    image_block
    ratio--{{ block.settings.ratio }}
    {% if block.settings.hover_zoom %}is-zoom{% endif %}
    {% if block.settings.shadow %}is-shadow{% endif %}
  "
  style="
    --bg: {{ block.settings.background }};
    --radius: {{ block.settings.radius }}px;
    --border-size: {{ block.settings.border_size }}px;
    --border-color: {{ block.settings.border_color }};
    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;
    --pt-m: {{ block.settings.pt_m }}px;
    --pb-m: {{ block.settings.pb_m }}px;
    --pl-m: {{ block.settings.pl_m }}px;
    --pr-m: {{ block.settings.pr_m }}px;
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.image != blank %}
    {{ block.settings.image | image_url: width: 1600
            | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900, 1080, 1320, 1600',
            sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
            alt: block.settings.image.alt | escape
        }}
  {% else %}

  {% endif %}
</div>

{% stylesheet %}
   .image_block {
    background: var(--bg);
    border-radius: var(--radius);
    border: var(--border-size) solid var(--border-color);
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    padding-left: var(--pl);
    padding-right: var(--pr);
    overflow: hidden;
    position: relative;
  }
    /* image */
  .image_block img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    transition: transform .35s ease;
  }
  /* zoom */
  .is-zoom:hover img {
    transform: scale(1.08);
  }
  /* shadow */
  .is-shadow {
    box-shadow: 0 10px 25px rgba(0,0,0,.15);
  }
  .ratio--square {aspect-ratio: 1 / 1;}
  .ratio--landscape {aspect-ratio: 4 / 3;}
  .ratio--portrait {aspect-ratio: 3 / 4;}
  .ratio--auto {aspect-ratio: auto;}
  .ratio--auto img {aspect-ratio: auto;}
  .ratio--square img {aspect-ratio: 1 / 1;object-fit: cover;}
  .ratio--landscape img {aspect-ratio: 4 / 3;object-fit: cover;}
  .ratio--portrait img {aspect-ratio: 3 / 4;object-fit: cover;}
    /* mobile */
  @media screen and (max-width: 749px) {
  .image_block{
        padding-top: var(--pt-m);
        padding-bottom: var(--pb-m);
        padding-left: var(--pl-m);
        padding-right: var(--pr-m);
      }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Hover zoom"
    },

    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box shadow"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border_size",
      "label": "Border size",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Padding left",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Padding right",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Padding top mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl_m",
      "label": "Padding left mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr_m",
      "label": "Padding right mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0
    }
  ],

  "presets": [
    {
      "name": "Image"
    }
  ]
}
{% endschema %}
