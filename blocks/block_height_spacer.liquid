{%- capture style_schema -%}
  --desktop-px-height: {{ block.settings.desktop_px_height }};
  --tablet-px-height: {{ block.settings.tablet_px_height }};
  --mobile-px-height: {{ block.settings.mobile_px_height }};

  --desktop-vh-height: {{ block.settings.desktop_vh_height }};
  --tablet-vh-height: {{ block.settings.tablet_vh_height }};
  --mobile-vh-height: {{ block.settings.mobile_vh_height }};
{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list -%}
spacer-block; 
align--{{ block.settings.align }}; 
{% if block.settings.hide_mobile %}hide-mobile;{% endif %} 
{% if block.settings.hide_desktop %}hide-desktop;{% endif %}
{% if block.settings.height == 'custom' %}
  block-custom-height-desktop;
  {% else %}
  block-height-desktop-{{ block.settings.height }}; 
  {% endif %}
  {% if block.settings.width == 'custom' %}
  block-custom-width-desktop;
  {% else %}
  block-width-desktop-{{ block.settings.width }};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  block-custom-width-tablet; 
  {% else %}
  block-width-tablet-{{ block.settings.width_tablet }}; 
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  block-custom-width-mobile; 
  {% else %}
  block-width-mobile-{{ block.settings.width_mobile }}; 
  {% endif %}
{% endcapture %}
{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}

<div class="{{- class_list -}}" style=" {{- style_schema -}}"{{ block.shopify_attributes }}>
  <div class="spacer-height">&nbsp;</div>
</div>
{% stylesheet %}
.spacer-block {
    width: 100%;
}
@media (min-width: 1366px) {

}
@media only screen and (min-width: 768px) and (max-width: 1365px) {

}
  /* mobile */
  @media (max-width:767px){

  }
  /* hide */
  @media (min-width:768px){
    .hide-desktop{ display:none !important; }
  }
  @media (max-width:767px){
    .hide-mobile{ display:none !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Divider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Height Desktop"
    },
    {
      "type": "select",
      "id": "desktop_height_type",
      "options": [
        {
            "label": "Pixel",
            "value": "px"
        },
        {
            "label": "Window Height (VH)",
            "value": "vh"
        }
      ],
      "default": "px",
      "label": "Desktop Height Type"
    },
    {
      "type": "range",
      "id": "desktop_px_height",
      "visible_if": "{{ block.settings.desktop_height_type == 'px' }}",
      "label": "Height In px",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_vh_height",
      "visible_if": "{{ block.settings.desktop_height_type == 'vh' }}",
      "label": "Height In VH",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "select",
      "id": "tablet_height_type",
      "options": [
        {
            "label": "Pixel",
            "value": "px"
        },
        {
            "label": "Window Height (VH)",
            "value": "vh"
        }
      ],
      "default": "px",
      "label": "Tablet Height Type"
    },
    {
      "type": "range",
      "id": "tablet_px_height",
      "visible_if": "{{ block.settings.tablet_height_type == 'px' }}",
      "label": "Height In px",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "tablet_vh_height",
      "visible_if": "{{ block.settings.tablet_height_type == 'vh' }}",
      "label": "Height in VH",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "select",
      "id": "mobile_height_type",
      "options": [
        {
            "label": "Pixel",
            "value": "px"
        },
        {
            "label": "Mobile Height (VH)",
            "value": "vh"
        }
      ],
      "default": "px",
      "label": "Mobile Height Type"
    },
    {
      "type": "range",
      "id": "mobile_px_height",
      "visible_if": "{{ block.settings.mobile_height_type == 'px' }}",
      "label": "Height In px",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_vh_height",
      "visible_if": "{{ block.settings.mobile_height_type == 'vh' }}",
      "label": "Height in VH",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "header",
      "content": "Visibility"
    },

    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide desktop"
    },

    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide mobile"
    }
  ],
  "presets": [{ "name": "Spacer" }]
}
{% endschema %}
