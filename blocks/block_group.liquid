<div
  class="
    group {{ block.settings.layout_direction }}
    {% if block.settings.height == 'custom' %}
       block-custom-height-desktop
       {% else %}
      block-height-desktop-{{ block.settings.height }}
      {% endif %}
      {% if block.settings.width == 'custom' %}
      block-custom-width-desktop
      {% else %}
      block-width-desktop-{{ block.settings.width }}
      {% endif %}
       {% if block.settings.width_tablet == 'custom' %}
      block-custom-width-tablet
      {% else %}
       block-width-tablet-{{ block.settings.width_tablet }}
      {% endif %}
      {% if block.settings.width_mobile == 'custom' %}
      block-custom-width-mobile
      {% else %}
       block-width-mobile-{{ block.settings.width_mobile }}
      {% endif %}
    {% if block.settings.hover_zoom %}is-zoom{% endif %}
    {% if block.settings.shadow %}is-shadow{% endif %}
    {% if block.settings.hide_desktop %}hide-desktop{% endif %}
    {% if block.settings.hide_mobile %}hide-mobile{% endif %}
  "
  style="
    --align-x: {{ block.settings.align_x }};
    --align-y: {{ block.settings.align_y }};
    --wrap: {{ block.settings.wrap }};
    --gap: {{ block.settings.gap }}px;
    --gap-m: {{ block.settings.gap_m }}px;
    --bg: {{ block.settings.background }};
    --radius: {{ block.settings.radius }}px;
    --border: {{ block.settings.border }}px;
    --border-color: {{ block.settings.border_color }};
    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;
    --ptm: {{ block.settings.ptm }}px;
    --pbm: {{ block.settings.pbm }}px;
    --plm: {{ block.settings.plm }}px;
    --prm: {{ block.settings.prm }}px;
    {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%;
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {{ block.settings.custom_width }}%;
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {{ block.settings.custom_width_tablet }}%;
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {{ block.settings.custom_width_mobile }}%;
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.block_link != blank %}
    <a class="block_link link_overlay" href="{{ block.settings.block_link }}"></a>
  {% endif %}
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
/* ======================
GROUP BASE
====================== */

 .group {
    display: flex;
    flex-direction: row;
    flex-wrap: var(--wrap);
    justify-content: var(--align-x);
    align-items: var(--align-y);
    gap: var(--gap);
    background: var(--bg);
    border-radius: var(--radius);
    border: var(--border) solid var(--border-color);
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    padding-left: var(--pl);
    padding-right: var(--pr);
    width: 100%;
  }

.group--vertical{
  flex-direction:column;
  justify-content:var(--align-y,flex-start);
  align-items:var(--align-x,stretch);
}
/* ======================
DO NOT FORCE CHILD HEIGHT
====================== */

.group > *{
  height:auto;
}

/* ======================
HEIGHT SYSTEM
====================== */

.block-height-desktop-fill{
  height:100%;
}

.block-height-desktop-fit{
  height:auto;
}



/* ======================
FIX vertical + 100% height
====================== */

.group--vertical.block-height-desktop-fill > *{
  flex:0 0 auto;
}

.group--vertical.block-custom-height-desktop > *{
  flex:0 0 auto;
}



.block-custom-height-desktop{
  height:var(--block-custom-height-desktop);
}



  /* mobile */
  @media (min-width: 1366px){
    .block-width-desktop-fill{
    flex: 1;
  }
  .block-custom-width-desktop {
      width: var(--block-custom-width-desktop);
  }
  .block-width-desktop-fit-content {
    width: fit-content;
  }
  }
  @media only screen and (min-width: 768px) and (max-width: 1365px) {
    .block-width-tablet-fill{
    flex: 1;
  }
  .block-width-tablet-fit-content {
    width: fit-content;
  }
  .block-custom-width-tablet {
      width: var(--block-custom-width-tablet);
  }
  }
  @media (max-width: 767px) {
    .group {
      gap: var(--gap-m);
      padding-top: var(--ptm);
      padding-bottom: var(--pbm);
      padding-left: var(--plm);
      padding-right: var(--prm);
    }
    .block-width-mobile-fill{
    flex: 1;
    }
    .block-width-mobile-fit-content {
      width: fit-content;
    }
    .block-custom-width-mobile {
      width: var(--block-custom-width-mobile);
  }
  }

  /* visibility */
  .hide-desktop {
    display: none !important;
  }
    /* zoom */
  .is-zoom{
  transition: all .25s ease;
  }
  .is-zoom:hover img {
    transform: scale(1.08);
  }
  .is-zoom:hover{
    transform: translateY(-4px);
  }
  /* shadow */
  .is-shadow {
    box-shadow: 0 10px 25px rgba(0,0,0,.15);
  }
  @media (max-width: 768px) {
    .hide-desktop {
      display: flex !important;
    }
    .hide-mobile {
      display: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Group",
  "tag": null,
  "blocks": [{ "type": "@theme" }],

  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout",
      "default": "group--horizontal",
      "options": [
        { "value": "group--horizontal", "label": "Row" },
        { "value": "group--vertical", "label": "Column" }
      ]
    },

    {
      "type": "select",
      "id": "align_x",
      "label": "Align",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ]
    },

    {
      "type": "select",
      "id": "align_y",
      "label": "Align",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" },
        { "value": "stretch", "label": "Stretch" }
      ]
    },

    {
      "type": "select",
      "id": "wrap",
      "label": "Wrap",
      "default": "wrap",
      "options": [
        { "value": "wrap", "label": "On" },
        { "value": "nowrap", "label": "Off" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Hover zoom"
    },

    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box shadow"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Height"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_m",
      "label": "Gap Mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Block Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
