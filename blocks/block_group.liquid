{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
{%- capture style_schema -%}
  --align-x: {{ block.settings.align_x }};
  --align-y: {{ block.settings.align_y }};
  --child-size: {{ block.size }};
  --wrap: {{ block.settings.wrap }};
  --gap: {{ block.settings.gap }}px;
  --gap-m: {{ block.settings.gap_m }}px;
  --bg: {{ block.settings.background }};
  {% if block.settings.set_full_radius %}
  --radius-top-left: {{ block.settings.radius_top_left }}px;
  --radius-top-right: {{ block.settings.radius_top_right }}px;
  --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
  --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
  {% else %}
  --radius-top-left: {{ block.settings.radius }}px;
  --radius-top-right: {{ block.settings.radius }}px;
  --radius-bottom-left: {{ block.settings.radius }}px;
  --radius-bottom-right: {{ block.settings.radius }}px;
  {% endif %}
  --border: {{ block.settings.border }}px;
  --border-color: {{ block.settings.border_color }};
  --pt: {{ block.settings.pt }}px;
  --pb: {{ block.settings.pb }}px;
  --pl: {{ block.settings.pl }}px;
  --pr: {{ block.settings.pr }}px;
  --ptm: {{ block.settings.ptm }}px;
  --pbm: {{ block.settings.pbm }}px;
  --plm: {{ block.settings.plm }}px;
  --prm: {{ block.settings.prm }}px;
  {% if block.settings.height == 'custom' %}
  --block-custom-height-desktop: {{ block.settings.custom_height }}%;
  {% endif %}
  {% if block.settings.width == 'custom' %}
  --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
  {% endif %}
{%- endcapture -%}

{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list -%}
  group;
  {{ block.settings.layout_direction }}; 
  box-{{ block.settings.wrap }};
  {% if block.settings.height == 'custom' %}
  block-custom-height-desktop;
  {% else %}
  block-height-desktop-{{ block.settings.height }}; 
  {% endif %}
  {% if block.settings.width == 'custom' %}
  block-custom-width-desktop;
  {% else %}
  block-width-desktop-{{ block.settings.width }};
  {% endif %}
  {% if block.settings.width_tablet == 'custom' %}
  block-custom-width-tablet; 
  {% else %}
  block-width-tablet-{{ block.settings.width_tablet }}; 
  {% endif %}
  {% if block.settings.width_mobile == 'custom' %}
  block-custom-width-mobile; 
  {% else %}
  block-width-mobile-{{ block.settings.width_mobile }}; 
  {% endif %}
  {% if block.settings.hover_zoom %}is-zoom;{% endif %}
  {% if block.settings.shadow %}is-shadow;{% endif %}
  {% if block.settings.hide_desktop %}hide-desktop;{% endif %}
  {% if block.settings.hide_mobile %}hide-mobile;{% endif %}
{% endcapture %}

{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}

<div class="{{- class_list }}" style="{{- style_schema -}}" {{ block.shopify_attributes }}>
  
  {% if block.settings.image_link != blank %}
    <a class="image_link link_overlay" href="{{ block.settings.image_link }}"></a>
  {% endif %}
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
.group {
	display: flex;
	flex-direction: row;
	flex-wrap: var(--wrap);
	justify-content: var(--align-x);
	align-items: var(--align-y);
	gap: var(--gap);
	background: var(--bg);
	border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
	border: var(--border) solid var(--border-color);
	padding-top: var(--pt);
	padding-bottom: var(--pb);
	padding-left: var(--pl);
	padding-right: var(--pr);
	width: 100%;
	position: relative;
}

a.image_link.link_overlay {
	position: absolute;
	top: 0;
	bottom: 0;
	left: 0;
	right: 0;
	border-radius: var(--radius);
}
.group--vertical {
	flex-direction: column;
	justify-content: var(--align-y, flex-start);
	align-items: var(--align-x, stretch);
}
.group>* {
	height: auto;
}
.block-height-desktop-fill {
  align-self: stretch;
}
.block-height-desktop-fit {
	height: auto;

}
.block-height-desktop-fill .background-image-block {
    height: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: var(--align-y);
}

.group--vertical.block-height-desktop-fill>* {
	flex: 0 0 auto;
}
.group--vertical.block-custom-height-desktop>* {
	flex: 0 0 auto;
}
.block-custom-height-desktop {
	height: var(--block-custom-height-desktop);
}
.box-nowrap.block-height-desktop-fit>* {
	height: 100%;
}
.box-nowrap >*{
  width: 100%;
  flex: 0 0 auto;
}
@media (min-width: 1366px) {
  
	.block-width-desktop-fill {
		flex: 1;
	}
	.block-custom-width-desktop {
		width: var(--block-custom-width-desktop);
	}
	.block-width-desktop-fit-content {
		width: fit-content;
	}
  .block-custom-width-desktop .btn{
  flex: 1;
}
}

@media only screen and (min-width: 768px) and (max-width: 1365px) {
	.block-width-tablet-fill {
		flex: 1;
	}
  .block-custom-width-tablet .btn{
  flex: 1;
}
	.block-width-tablet-fit-content {
		width: fit-content;
	}
	.block-custom-width-tablet {
		width: var(--block-custom-width-tablet);
	}
	.block-custom-width-tablet {
		height: auto;
	}
}

@media (max-width: 767px) {
	.group {
		gap: var(--gap-m);
		padding-top: var(--ptm);
		padding-bottom: var(--pbm);
		padding-left: var(--plm);
		padding-right: var(--prm);
	}
  .block-custom-width-mobile .btn{
  flex: 1;
}
	.block-width-mobile-fill {
		flex: 1;
	}
	.block-width-mobile-fit-content {
		width: fit-content;
	}
	.block-custom-width-mobile {
		width: var(--block-custom-width-mobile);
		flex-shrink: 0;
	}
	.block-height-desktop-fill,
	.block-custom-height-desktop {
		height: auto;
		min-height: auto;
    align-self: stretch;
	}
}
.hide-desktop {
	display: none !important;
}
.is-zoom {
	transition: all .25s ease;
}
.is-zoom:hover img ,.is-zoom:hover video,.is-zoom:hover iframe {
	transform: scale(1.08);
}
.is-zoom:hover {
	transform: translateY(-4px);
}
.is-shadow {
	box-shadow: 0 10px 25px rgba(0, 0, 0, .15);
}
@media (max-width: 768px) {
	.hide-desktop {
		display: flex !important;
	}
	.hide-mobile {
		display: none !important;
	}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Group",
  "tag": null,
  "blocks": [{ "type": "@theme" }],

  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout",
      "default": "group--horizontal",
      "options": [
        { "value": "group--horizontal", "label": "Row" },
        { "value": "group--vertical", "label": "Column" }
      ]
    },

    {
      "type": "select",
      "id": "align_x",
      "label": "Position",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ]
    },

    {
      "type": "select",
      "id": "align_y",
      "label": "Alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ]
    },

    {
      "type": "select",
      "id": "wrap",
      "label": "Wrap",
      "default": "wrap",
      "options": [
        { "value": "wrap", "label": "On" },
        { "value": "nowrap", "label": "Off" }
      ]
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Hover zoom"
    },

    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box shadow"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Choose Unit Width Dektop",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Custom Width Desktop In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_desktop == 'px' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_desktop == '%' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Choose Unit Width Tablet",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Custom Width Tablet In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_tablet == 'px' and block.settings.width_tablet == 'custom'}}"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_tablet == '%' and block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_mobile",
      "label": "Choose Unit Width Mobile",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel_mobile",
      "default": 48,
      "label": "Custom Width Mobile In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_mobile == 'px' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_mobile == '%' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Height"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_m",
      "label": "Gap Mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Block Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "header",
      "content": "Block Radius"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "visible_if": "{{ block.settings.set_full_radius == false }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "label": "Set Each Corner Radius",
      "id": "set_full_radius"
    },
    {
      "type": "range",
      "id": "radius_top_left",
      "label": "Radius Top Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_top_right",
      "label": "Radius Top Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_left",
      "label": "Radius Bottom Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_right",
      "label": "Radius Bottom Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border",
      "label": "Border",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },

    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Left",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Right",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
