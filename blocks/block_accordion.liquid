{%- capture style_schema -%}
    --bg: {{ block.settings.background }};
    {% if block.settings.set_full_radius %}
    --radius-top-left: {{ block.settings.radius_top_left }}px;
    --radius-top-right: {{ block.settings.radius_top_right }}px;
    --radius-bottom-left: {{ block.settings.radius_bottom_left }}px;
    --radius-bottom-right: {{ block.settings.radius_bottom_right }}px;
    {% else %}
    --radius-top-left: {{ block.settings.radius }}px;
    --radius-top-right: {{ block.settings.radius }}px;
    --radius-bottom-left: {{ block.settings.radius }}px;
    --radius-bottom-right: {{ block.settings.radius }}px;
    {% endif %}
    --border: {{ block.settings.border }}px;
    --border-color: {{ block.settings.border_color }};
    
    --font-weight: {{ block.settings.font_weight }};
    --lh-d: {{ block.settings.line_height }};
    --lh-m: {{ block.settings.line_height_mobile }};
    --ls-d: {{ block.settings.letter_spacing }}px;
    --ls-m: {{ block.settings.letter_spacing_mobile }}px;

    --q-color: {{ block.settings.q_color }};
    --a-color: {{ block.settings.a_color }};
    --q-align: {{ block.settings.q_align }};
    --a-align: {{ block.settings.a_align }};

    --fs: {{ block.settings.font_size }}px;
    --fsm: {{ block.settings.font_size_mobile }}px;

    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;

    --ptm: {{ block.settings.pt_m }}px;
    --pbm: {{ block.settings.pb_m }}px;
    --plm: {{ block.settings.pl_m }}px;
    --prm: {{ block.settings.pr_m }}px;
     {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%;
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
    {% endif %}
{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list %}
  accordion_block;
    {% if block.settings.shadow %}is-shadow;{% endif %}
    {% if block.settings.height == 'custom' %}
     block-custom-height-desktop;
     {% else %}
    block-height-desktop-{{ block.settings.height }};
    {% endif %}
    {% if block.settings.width == 'custom' %}
    block-custom-width-desktop;
    {% else %}
    block-width-desktop-{{ block.settings.width }};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    block-custom-width-tablet;
    {% else %}
     block-width-tablet-{{ block.settings.width_tablet }};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    block-custom-width-mobile;
    {% else %}
     block-width-mobile-{{ block.settings.width_mobile }};
    {% endif %}

    {% if block.settings.hide_mobile %} hide-mobile;{% endif %}
    {% if block.settings.hide_desktop %} hide-desktop;{% endif %}
{% endcapture -%}
{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}

<div class="{{- class_list -}}"style="{{- style_schema -}}"{{ block.shopify_attributes }}>
  <details class="accordion_item">
    <summary class="accordion_question icon-{{ block.settings.icon_position }}" style="--icon-size: {{ block.settings.icon_size }}px;--icon-color: {{ block.settings.icon_color }};">
    {% if block.settings.enable_heading %}
      <h4 class="acc_text">
        {{ block.settings.question }}
      </h4>
    {% else %}
      <span class="acc_text">
        {{ block.settings.question }}
      </span>
    {% endif %}
      <span class="acc_icon">
        {% case block.settings.icon_type %}
          {% when 'plus' %}
            <span class="plus">+</span>
            <span class="minus">−</span>
          {% when 'chevron' %}
            ›
          {% when 'arrow' %}
            →
          {% when 'char' %}
            {{ block.settings.icon_char }}
        {% endcase %}
      </span>
    </summary>
    <div class="accordion_answer rte">
      {{ block.settings.answer }}
    </div>
  </details>
</div>
{% stylesheet %}
    .accordion_block{
     background: var(--bg);
     border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
	   border: var(--border) solid var(--border-color);
     overflow: hidden;
     padding:var(--pt) var(--pr) var(--pb) var(--pl);
  }
  .acc_text{
    font-size:var(--fs);
    font-weight: var(--font-weight);
    color: var(--q-color);
    line-height: var(--lh-d);
    letter-spacing: var(--ls-d);
    text-transform: var(--text-uppercase);
  }
  .accordion_question{
    text-align: var(--q-align);
  }
  .accordion_answer{
    text-align: var(--a-align);
  }
  .acc_text{
      flex: 1;
  }
  .accordion_question{
    display:flex;
    align-items:center;
    justify-content:space-between;
    cursor:pointer;
    gap: 15px;
    color:var(--q-color);
    cursor:pointer;
    font-size:var(--fs);
  }
  .acc_icon{
    font-size:var(--icon-size);
    color:var(--icon-color);
    transition:0.3s;
  }
  .icon-left{
    flex-direction:row-reverse;
  }
  .icon-right{
    flex-direction:row;
  }
  details[open] .acc_icon{
    transform: rotate(180deg);
  }
  .minus{
    display:none;
  }
  details[open] .plus{
    display:none;
  }
  details[open] .minus{
    display:inline;
  }
  @media(max-width:768px){
  .accordion_block{
    padding:var(--ptm) var(--prm) var(--pbm) var(--plm);
  }
  .acc_text{
    font-size:var(--fsm);
  }
  }
  .accordion_answer{
    background:var(--a-bg);
    color:var(--a-color);
    font-size:var(--fs);
    padding-top: 2rem;
  }
  @media(max-width:768px){
  .accordion_answer{
    font-size:var(--fsm);
  }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Accordion",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "Accordion question"
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "Answer",
      "default": "<p>Accordion answer</p>"
    },
    {
      "type": "header",
      "content": "Icon"
    },

    {
      "type": "select",
      "id": "icon_type",
      "label": "Icon type",
      "options": [
        { "value": "plus", "label": "Plus / Minus" },
        { "value": "chevron", "label": "Chevron" },
        { "value": "arrow", "label": "Arrow" },
        { "value": "char", "label": "Custom Character" }
      ],
      "default": "plus"
    },

    {
      "type": "text",
      "id": "icon_char",
      "label": "Custom icon",
      "default": "+",
      "visible_if": "{{ block.settings.icon_type == 'char' }}"
    },

    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },

    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 16
    },

    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "q_align",
      "label": "Question alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },

    {
      "type": "select",
      "id": "a_align",
      "label": "Answer alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box shadow"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Choose Unit Width Dektop",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Custom Width Desktop In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_desktop == 'px' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_desktop == '%' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Choose Unit Width Tablet",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Custom Width Tablet In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_tablet == 'px' and block.settings.width_tablet == 'custom'}}"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_tablet == '%' and block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_mobile",
      "label": "Choose Unit Width Mobile",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel_mobile",
      "default": 48,
      "label": "Custom Width Mobile In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_mobile == 'px' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_mobile == '%' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Question style"
    },
    {
      "type": "checkbox",
      "id": "enable_heading",
      "label": "Enable Heading Style"
    },
     {
      "type": "header",
      "content": "Font"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14
    },
    {
      "type": "checkbox",
      "label": "Uppercase Text",
      "id": "text_uppercase"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "400",
      "options": [
        { "value": "100", "label": "100 Thin" },
        { "value": "200", "label": "200 Extra Light" },
        { "value": "300", "label": "300 Light" },
        { "value": "400", "label": "400 Regular" },
        { "value": "500", "label": "500 Medium" },
        { "value": "600", "label": "600 Semi Bold" },
        { "value": "700", "label": "700 Bold" },
        { "value": "800", "label": "800 Extra Bold" },
        { "value": "900", "label": "900 Black" }
      ]
    },
    {
  "type": "range",
  "id": "letter_spacing",
  "label": "Letter spacing desktop",
  "min": -5,
  "max": 20,
  "step": 1,
  "default": 0
},
{
  "type": "range",
  "id": "letter_spacing_mobile",
  "label": "Letter spacing mobile",
  "min": -5,
  "max": 20,
  "step": 1,
  "default": 0
},

{
  "type": "select",
  "id": "line_height",
  "label": "Line height desktop",
  "options": [
    { "value": "1", "label": "1" },
    { "value": "1.2", "label": "1.2" },
    { "value": "1.4", "label": "1.4 (normal)" },
    { "value": "1.6", "label": "1.6" },
    { "value": "1.8", "label": "1.8 (loose)" },
    { "value": "2", "label": "2" }
  ],
  "default": "1.4"
},
{
  "type": "select",
  "id": "line_height_mobile",
  "label": "Line height mobile",
  "options": [
    { "value": "1", "label": "1" },
    { "value": "1.2", "label": "1.2" },
    { "value": "1.4", "label": "1.4" },
    { "value": "1.6", "label": "1.6" },
    { "value": "1.8", "label": "1.8" },
    { "value": "2", "label": "2" }
  ],
  "default": "1.4"
},
    { "type": "color", "id": "q_color", "label": "Text", "default": "#000000" },
    {
      "type": "header",
      "content": "Answer style"
    },
    { "type": "color", "id": "a_color", "label": "Text", "default": "#000000" },
    {
      "type": "header",
      "content": "Box"
    },
    { "type": "color_background", "id": "background", "label": "Background" },
    {
      "type": "header",
      "content": "Block Radius"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "visible_if": "{{ block.settings.set_full_radius == false }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "checkbox",
      "label": "Set Each Corner Radius",
      "id": "set_full_radius"
    },
    {
      "type": "range",
      "id": "radius_top_left",
      "label": "Radius Top Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_top_right",
      "label": "Radius Top Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_left",
      "label": "Radius Bottom Left",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "radius_bottom_right",
      "label": "Radius Bottom Right",
      "visible_if": "{{ block.settings.set_full_radius == true }}",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border",
      "label": "Border",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },

    {
      "type": "header",
      "content": "Padding Desktop"
    },

    { "type": "range", "id": "pt", "label": "Top", "min": 0, "max": 100, "step": 2, "default": 0 },
    { "type": "range", "id": "pb", "label": "Bottom", "min": 0, "max": 100, "step": 2, "default": 0 },
    { "type": "range", "id": "pl", "label": "Left", "min": 0, "max": 100, "step": 2, "default": 0 },
    { "type": "range", "id": "pr", "label": "Right", "min": 0, "max": 100, "step": 2, "default": 0 },

    {
      "type": "header",
      "content": "Padding Mobile"
    },

    { "type": "range", "id": "pt_m", "label": "Top", "min": 0, "max": 60, "step": 2, "default": 0 },
    { "type": "range", "id": "pb_m", "label": "Bottom", "min": 0, "max": 60, "step": 2, "default": 0 },
    { "type": "range", "id": "pl_m", "label": "Left", "min": 0, "max": 60, "step": 2, "default": 0 },
    { "type": "range", "id": "pr_m", "label": "Right", "min": 0, "max": 60, "step": 2, "default": 0 },

    {
      "type": "header",
      "content": "Visibility"
    },

    { "type": "checkbox", "id": "hide_mobile", "label": "Hide mobile" },
    { "type": "checkbox", "id": "hide_desktop", "label": "Hide desktop" }
  ],

  "presets": [{ "name": "Accordion" }]
}
{% endschema %}
