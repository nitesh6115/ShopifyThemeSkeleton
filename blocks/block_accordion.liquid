<div
  class="
    accordion_block

    {% if block.settings.height == 'custom' %}
     block-custom-height-desktop 
     {% else %}
    block-height-desktop-{{ block.settings.height }}
    {% endif %}
    {% if block.settings.width == 'custom' %}
    block-custom-width-desktop
    {% else %}
    block-width-desktop-{{ block.settings.width }}
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    block-custom-width-tablet
    {% else %}
     block-width-tablet-{{ block.settings.width_tablet }}
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    block-custom-width-mobile
    {% else %}
     block-width-mobile-{{ block.settings.width_mobile }}
    {% endif %}

    {% if block.settings.hide_mobile %} hide-mobile{% endif %}
    {% if block.settings.hide_desktop %} hide-desktop{% endif %}
  "
  style="
    --text-color: {{ block.settings.color }};
    --bg: {{ block.settings.background }};
    --radius: {{ block.settings.radius }}px;
    --border-size: {{ block.settings.border_size }}px;
    --border-color: {{ block.settings.border_color }};

    --q-color: {{ block.settings.q_color }};
    --q-bg: {{ block.settings.q_bg }};
    --q-border: {{ block.settings.q_border }};

    --a-color: {{ block.settings.a_color }};
    --a-bg: {{ block.settings.a_bg }};

    --fs: {{ block.settings.font_size }}px;
    --fsm: {{ block.settings.font_size_mobile }}px;

    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;

    --ptm: {{ block.settings.pt_m }}px;
    --pbm: {{ block.settings.pb_m }}px;
    --plm: {{ block.settings.pl_m }}px;
    --prm: {{ block.settings.pr_m }}px;
     {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%; 
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {{ block.settings.custom_width }}%;
    {% endif %}
    {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {{ block.settings.custom_width_tablet }}%;
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {{ block.settings.custom_width_mobile }}%;
    {% endif %} 
  "
>

  <details class="accordion_item">

    <summary class="accordion_question">
      {{ block.settings.question }}
    </summary>

    <div class="accordion_answer rte">
      {{ block.settings.answer }}
    </div>

  </details>

</div>
{% stylesheet %}
  .accordion_block{

   background: var(--bg);
   border-radius: var(--radius);
   border-style: solid;
   border-width: var(--border-size);
   border-color: var(--border-color);

  padding:var(--pt) var(--pr) var(--pb) var(--pl);

}

@media(max-width:768px){
.accordion_block{
  padding:var(--ptm) var(--prm) var(--pbm) var(--plm);
}
}

.accordion_question{
  background:var(--q-bg);
  color:var(--q-color);
  padding:12px;
  cursor:pointer;
  font-size:var(--fs);
}

.accordion_answer{
  background:var(--a-bg);
  color:var(--a-color);
  padding:12px;
  font-size:var(--fs);
}

@media(max-width:768px){
.accordion_question,
.accordion_answer{
  font-size:var(--fsm);
}
}
{% endstylesheet %}
{% schema %}
{
  "name": "Accordion",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "Accordion question"
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "Answer",
      "default": "<p>Accordion answer</p>"
    },
    {
  "type": "select",
  "id": "q_align",
  "label": "Question alignment",
  "options": [
    { "value": "left", "label": "Left" },
    { "value": "center", "label": "Center" },
    { "value": "right", "label": "Right" }
  ],
  "default": "left"
},

{
  "type": "select",
  "id": "a_align",
  "label": "Answer alignment",
  "options": [
    { "value": "left", "label": "Left" },
    { "value": "center", "label": "Center" },
    { "value": "right", "label": "Right" }
  ],
  "default": "left"
},
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Font"
    },

    {
      "type": "range",
      "id": "font_size",
      "label": "Font size desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14
    },

    {
      "type": "header",
      "content": "Question style"
    },
    { "type": "color", "id": "q_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "q_bg", "label": "BG", "default": "#f3f4f6" },
    {
      "type": "header",
      "content": "Answer style"
    },

    { "type": "color", "id": "a_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "a_bg", "label": "BG", "default": "#ffffff" },



    {
      "type": "header",
      "content": "Box"
    },

    { "type": "color_background", "id": "box_bg", "label": "Background" },

    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 8
    },



    {
      "type": "header",
      "content": "Padding Desktop"
    },

    { "type": "range", "id": "pt", "label": "Top", "min": 0, "max": 100, "step": 2, "default": 0 },
    { "type": "range", "id": "pb", "label": "Bottom", "min": 0, "max": 100, "step": 2, "default": 0 },
    { "type": "range", "id": "pl", "label": "Left", "min": 0, "max": 100, "step": 2, "default": 0 },
    { "type": "range", "id": "pr", "label": "Right", "min": 0, "max": 100, "step": 2, "default": 0 },



    {
      "type": "header",
      "content": "Padding Mobile"
    },

    { "type": "range", "id": "pt_m", "label": "Top", "min": 0, "max": 60, "step": 2, "default": 0 },
    { "type": "range", "id": "pb_m", "label": "Bottom", "min": 0, "max": 60, "step": 2, "default": 0 },
    { "type": "range", "id": "pl_m", "label": "Left", "min": 0, "max": 60, "step": 2, "default": 0 },
    { "type": "range", "id": "pr_m", "label": "Right", "min": 0, "max": 60, "step": 2, "default": 0 },



    {
      "type": "header",
      "content": "Visibility"
    },

    { "type": "checkbox", "id": "hide_mobile", "label": "Hide mobile" },
    { "type": "checkbox", "id": "hide_desktop", "label": "Hide desktop" }

  ],

  "presets": [
    { "name": "Accordion" }
  ]
}
{% endschema %}