{% doc %}
Advanced Heading Block
{% enddoc %}
{% assign tag = block.settings.tag %}
<{{ tag }}
  class="heading-block
  size--{{ block.settings.size_mode }}
  {% if block.settings.hide_mobile %}hide-mobile{% endif %}
  {% if block.settings.hide_desktop %}hide-desktop{% endif %}
  "
  style="
  --color: {{ block.settings.color }};  
  --bg: {{ block.settings.bg }};
  --radius: {{ block.settings.radius }}px;
  --border: {{ block.settings.border }}px;
  --border-color: {{ block.settings.border_color }};
  --fs: {{ block.settings.font_size }}px;
  --fsm: {{ block.settings.font_size_m }}px;
  --fw: {{ block.settings.font_weight }};
  --pt: {{ block.settings.pt }}px;
  --pb: {{ block.settings.pb }}px;
  --pl: {{ block.settings.pl }}px;
  --pr: {{ block.settings.pr }}px;
  --ptm: {{ block.settings.ptm }}px;
  --pbm: {{ block.settings.pbm }}px;
  --plm: {{ block.settings.plm }}px;
  --prm: {{ block.settings.prm }}px;
{% case block.settings.width %}
      {% when 'fit-content' %}
      --item-width:auto;
      {% when 'fill' %}
      --item-width:fill;
      {% when 'custom' %}
      --item-width:{{ block.settings.custom_width }}%;
      {% endcase %}

      {% case block.settings.width_mobile %}
      {% when 'fit-content' %}
      --item-width-m:auto;
      {% when 'fill' %}
      --item-width-m:fill;
      {% when 'custom' %}
      --item-width-m:{{ block.settings.custom_width_mobile }}%;
      {% endcase %}

      {% case block.settings.height %}
      {% when 'fit' %}
      --item-height:auto;
      {% when 'fill' %}
      --item-height:fill;
      {% when 'custom' %}
      --item-height:{{ block.settings.custom_height }}%;
      {% endcase %}
  "
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</{{ tag }}>
{% stylesheet %}
.heading-block {
  color: var(--color);  
  background: var(--bg); 
  border-radius: var(--radius);
  border: var(--border) solid var(--border-color);
  padding-top: var(--pt);
  padding-bottom: var(--pb);
  padding-left: var(--pl);
  padding-right: var(--pr);
}
/* custom font */
.size--custom {
  font-size: var(--fs);
  font-weight: var(--fw);
}
@media (max-width:749px){
  .heading-block{
    padding-top: var(--ptm);
    padding-bottom: var(--pbm);
    padding-left: var(--plm);
    padding-right: var(--prm);
  }
  .size--custom{
    font-size: var(--fsm);
  }
}
/* hide */
@media (min-width:750px){
  .hide-desktop{ display:none !important; }
}
@media (max-width:749px){
  .hide-mobile{ display:none !important; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Heading",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Heading"
    },
    {
    "type": "color",
    "id": "color",
    "label": "Text color",
    "default": "#000000"
    },
    {
      "type": "select",
      "id": "tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ]
    },
    {
      "type": "select",
      "id": "size_mode",
      "label": "Font size",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Theme size" },
        { "value": "custom", "label": "Custom" }
      ]
    },
    {
      "visible_if": "{{ block.settings.size_mode == 'custom' }}",
      "type": "range",
      "id": "font_size",
      "label": "Font size desktop",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 32
    },
    {
      "visible_if": "{{ block.settings.size_mode == 'custom' }}",
      "type": "range",
      "id": "font_size_m",
      "label": "Font size mobile",
      "min": 10,
      "max": 80,
      "step": 1,
      "default": 24
    },
    {
      "visible_if": "{{ block.settings.size_mode == 'custom' }}",
      "type": "range",
      "id": "font_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 600
    },
        {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border",
      "label": "Border size",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    { "type": "range","id": "pt","label": "Top","min": 0,"max": 200,"step": 2,"default": 0 },
    { "type": "range","id": "pb","label": "Bottom","min": 0,"max": 200,"step": 2,"default": 0 },
    { "type": "range","id": "pl","label": "Left","min": 0,"max": 200,"step": 2,"default": 0 },
    { "type": "range","id": "pr","label": "Right","min": 0,"max": 200,"step": 2,"default": 0 },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    { "type": "range","id": "ptm","label": "Top","min": 0,"max": 150,"step": 2,"default": 0 },
    { "type": "range","id": "pbm","label": "Bottom","min": 0,"max": 150,"step": 2,"default": 0 },
    { "type": "range","id": "plm","label": "Left","min": 0,"max": 150,"step": 2,"default": 0 },
    { "type": "range","id": "prm","label": "Right","min": 0,"max": 150,"step": 2,"default": 0 },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide desktop"
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide mobile"
    }
  ],
  "presets": [
    { "name": "Heading" }
  ]
}
{% endschema %}