{%- capture style_schema -%}
   --radius-top-left: {{ block.settings.radius }}px;
    --radius-top-right: {{ block.settings.radius }}px;
    --radius-bottom-left: {{ block.settings.radius }}px;
    --radius-bottom-right: {{ block.settings.radius }}px;

  --desktop-px-height: {{ block.settings.desktop_px_height }}px;
  --tablet-px-height: {{ block.settings.tablet_px_height }}px;
  --mobile-px-height: {{ block.settings.mobile_px_height }}px;

  --desktop-vh-height: {{ block.settings.desktop_vh_height }}vh;
  --tablet-vh-height: {{ block.settings.tablet_vh_height }}vh;
  --mobile-vh-height: {{ block.settings.mobile_vh_height }}vh;
  {% if block.settings.desktop_height_type == 'auto' %}
  --desktop-auto-height: {{ block.settings.image.aspect_ratio }};
  {% endif %}
  {% if block.settings.tablet_height_type == 'auto' %}
  --tablet-auto-height: {{ block.settings.image.aspect_ratio }};
  {% endif %}
  {% if block.settings.mobile_height_type == 'auto' %}
  --mobile-auto-height: {{ block.settings.image.aspect_ratio }};
  {% endif %}
  --bg-size:{{ block.settings.bg_size }};
  --bg-position:{{ block.settings.bg_position }};
  --overlay-bg: {{ block.settings.overlay_color }};
  --overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};

  {%if block.settings.image != blank %}
    background-Image: url({{ block.settings.image | image_url: width: 1600 }};)
{% endif %}
{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}

{%- capture class_list -%}
background-image-block; 
{% if block.settings.hide_mobile %}hide-mobile;{% endif %} 
{% if block.settings.hide_desktop %}hide-desktop;{% endif %}
{% if block.settings.desktop_height_type == 'px' %}
desktop-px-height;
{% elsif block.settings.desktop_height_type == 'vh' %}
desktop-vh-height; 
{% else %}
    desktop-auto-height; 
{% endif %}
{% if block.settings.tablet_height_type == 'px' %}
tablet-px-height;
{% elsif block.settings.tablet_height_type == 'vh' %}
tablet-vh-height;
{% else %}
tablet-auto-height;
{% endif %}
{% if block.settings.mobile_height_type == 'px' %}
mobile-px-height;
{% elsif block.settings.mobile_height_type == 'vh' %}
mobile-vh-height;
{% else %}
    mobile-auto-height;
  {% endif %}
{% endcapture %}
{% assign class_list = class_list | strip_newlines | replace: ';', ' ' | strip %}

{% liquid
  assign product = block.settings.product
-%}
<div class="{{- class_list -}}" data-product="{{ product }}" style=" {{- style_schema -}}"{{ block.shopify_attributes }}>
  {% if block.settings.overlay_color != blank %}
    <div class="block-overlay"></div>
  {% endif %}
  {%  content_for 'blocks' %}
</div>
{% stylesheet %}
.background-image-block {
    width: 100%;
    background-size:var(--bg-size);
    background-position:var(--bg-position);
    position: relative;
    display: flex;
    justify-content: var(--align-x);
    align-items: var(--align-y);
    border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
}
.block-overlay{
    border-radius: inherit;
    position:absolute;
    inset:0;
    background: var(--overlay-bg);
    opacity: var(--overlay-opacity);
    pointer-events:none;
    border-radius: var(--radius-top-left) var(--radius-top-right) var(--radius-bottom-right) var(--radius-bottom-left) ;
}
@media (min-width: 1366px) {
.background-image-block.desktop-vh-height {
    width: 100%;
    height: var(--desktop-vh-hegiht);
}
.background-image-block.desktop-auto-height {
    aspect-ratio: var(--desktop-auto-height);
}
.background-image-block.desktop-px-height,
.block-height-desktop-fill .background-image-block.desktop-px-height {
    width: 100%;
    height: var(--desktop-px-height);
    
}
}
@media only screen and (min-width: 768px) and (max-width: 1365px) {
 .background-image-block.tablet-auto-height {
    aspect-ratio: var(--desktop-auto-height);
}   
    .background-image-block.tablet-vh-height {
    width: 100%;
    height: var(--tablet-vh-height);
}
.background-image-block.tablet-px-height ,.block-height-desktop-fill .background-image-block.desktop-px-height{
    width: 100%;
    height: var(--tablet-px-height);
}

}
  /* mobile */
  @media (max-width:767px){
    .background-image-block.mobile-auto-height {
    aspect-ratio: var(--desktop-auto-height);
}
.background-image-block.mobile-vh-height {
    width: 100%;
    height: var(--mobile-vh-height);
}
.background-image-block.mobile-px-height ,.block-height-desktop-fill .background-image-block.desktop-px-height {
    width: 100%;
    height: var(--mobile-px-height);
}
  }
  /* hide */
  @media (min-width:768px){
    .hide-desktop{ display:none !important; }
  }
  @media (max-width:767px){
    .hide-mobile{ display:none !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Background Image",
  "tag": null,
  "blocks": [
    {"type": "@theme"}
  ],
  "settings": [
    {
        "type": "image_picker",
        "label": "Background Image",
        "id": "image"
    },
    { "type": "color_background", "id": "overlay_color", "label": "Overlay Color" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Overlay Opacity",
      "default": 0
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Background Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "bg_size",
      "label": "Background Size",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Height Desktop"
    },
    {
      "type": "select",
      "id": "desktop_height_type",
      "options": [
        {
            "label": "Pixel",
            "value": "px"
        },
        {
            "label": "Window Height (VH)",
            "value": "vh"
        },
        {
            "label": "auto",
            "value": "auto"
        }
      ],
      "default": "auto",
      "label": "Desktop Height Type"
    },
    {
      "type": "range",
      "id": "desktop_px_height",
      "visible_if": "{{ block.settings.desktop_height_type == 'px' }}",
      "label": "Height In px",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "desktop_vh_height",
      "visible_if": "{{ block.settings.desktop_height_type == 'vh' }}",
      "label": "Height In VH",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "select",
      "id": "tablet_height_type",
      "options": [
        {
            "label": "Pixel",
            "value": "px"
        },
        {
            "label": "Window Height (VH)",
            "value": "vh"
        },
        {
            "label": "auto",
            "value": "auto"
        }
      ],
      "default": "auto",
      "label": "Tablet Height Type"
    },
    {
      "type": "range",
      "id": "tablet_px_height",
      "visible_if": "{{ block.settings.tablet_height_type == 'px' }}",
      "label": "Height In px",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "tablet_vh_height",
      "visible_if": "{{ block.settings.tablet_height_type == 'vh' }}",
      "label": "Height in VH",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "select",
      "id": "mobile_height_type",
      "options": [
        {
            "label": "Pixel",
            "value": "px"
        },
        {
            "label": "Mobile Height (VH)",
            "value": "vh"
        },
        {
            "label": "auto",
            "value": "auto"
        }
      ],
      "default": "auto",
      "label": "Mobile Height Type"
    },
    {
      "type": "range",
      "id": "mobile_px_height",
      "visible_if": "{{ block.settings.mobile_height_type == 'px' }}",
      "label": "Height In px",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_vh_height",
      "visible_if": "{{ block.settings.mobile_height_type == 'vh' }}",
      "label": "Height in VH",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "header",
      "content": "Visibility"
    },

    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide desktop"
    },

    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide mobile"
    }
  ],
  "presets": [{ "name": "Background Image" }]
}
{% endschema %}
