<div
  class="
    button_block

    {% if block.settings.height == 'custom' %}
     block-custom-height-desktop 
     {% else %}
    block-height-desktop-{{ block.settings.height }}
    {% endif %}
    {% if block.settings.width == 'custom' %}
    block-custom-width-desktop
    {% else %}
    block-width-desktop-{{ block.settings.width }}
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    block-custom-width-tablet
    {% else %}
     block-width-tablet-{{ block.settings.width_tablet }}
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    block-custom-width-mobile
    {% else %}
     block-width-mobile-{{ block.settings.width_mobile }}
    {% endif %}

    {% if block.settings.hide_desktop %}hide-desktop{% endif %}
    {% if block.settings.hide_mobile %}hide-mobile{% endif %}
  "
  style="
    --gap: {{ block.settings.gap }}px;
    --gap-m: {{ block.settings.gap_m }}px;

    --bg: {{ block.settings.background }};
    --radius: {{ block.settings.radius }}px;
    --border: {{ block.settings.border }}px;
    --border-color: {{ block.settings.border_color }};

    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;
    --ptm: {{ block.settings.ptm }}px;
    --pbm: {{ block.settings.pbm }}px;
    --plm: {{ block.settings.plm }}px;
    --prm: {{ block.settings.prm }}px;

    --btn-align: {{ block.settings.alignment }};

    --fs: {{ block.settings.font_size }}px;
    --fsm: {{ block.settings.font_size_mobile }}px;
    --btn-height: {{ block.settings.btn_height }}px;
    --btn-height-mobile: {{ block.settings.btn_height_mobile }}px;
    --primary-bg: {{ block.settings.primary_bg }};
    --primary-text: {{ block.settings.primary_text }};
    --primary-border: {{ block.settings.primary_border }};

    --primary-bg-hover: {{ block.settings.primary_bg_hover }};
    --primary-text-hover: {{ block.settings.primary_text_hover }};
    --primary-border-hover: {{ block.settings.primary_border_hover }};
    --primary-border-size: {{ block.settings.primary_border_size }}px;

    --secondary-bg: {{ block.settings.secondary_bg }};
    --secondary-text: {{ block.settings.secondary_text }};
    --secondary-border: {{ block.settings.secondary_border }};
    --secondary_border-size: {{ block.settings.secondary_border_size }}px;

    --secondary-bg-hover: {{ block.settings.secondary_bg_hover }};
    --secondary-text-hover: {{ block.settings.secondary_text_hover }};
    --secondary-border-hover: {{ block.settings.secondary_border_hover }};
    {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%; 
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div class="button_box {% if block.settings.btn_full_width %} btn_full_width {% endif %}">
    {% if block.settings.primary_label != blank %}
      <a href="{{ block.settings.primary_link }}" class="btn btn-primary">
        {{ block.settings.primary_label }}
      </a>
    {% endif %}
    {% if block.settings.secondary_label != blank %}
      <a href="{{ block.settings.secondary_link }}" class="btn btn-secondary">
        {{ block.settings.secondary_label }}
      </a>
    {% endif %}
  </div>
</div>
{% stylesheet %}
  .button_block{
    background: var(--bg);
    border-radius: var(--radius);
    border: var(--border) solid var(--border-color);
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    padding-left: var(--pl);
    padding-right: var(--pr);
    width: 100%;
    position: relative;
}
.button_box{
  display:flex;
  gap: var(--gap);
  flex-wrap:wrap;
  justify-content:var(--btn-align);
}
.btn_full_width .button_box {
  flex-direction: column;
}
.button_block .btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:10px 20px;

  font-size:var(--fs);
  transition:0.2s;
  text-decoration: none;
  min-height: var(--btn-height);
}
.btn_full_width .btn{
width: 100%;
}
@media(max-width:768px){
.button_block .btn{
  font-size:var(--fsm);
  min-height: var(--btn-height-mobile);
}
.button_box{
  gap: var(--gap-m);
}
}
.button_block .btn-primary{
  background:var(--primary-bg);
  color:var(--primary-text);
  border:var(--primary-border-size) solid var(--primary-border);
}
.button_block .btn-primary:hover{
  background:var(--primary-bg-hover);
  color:var(--primary-text-hover);
  border-color:var(--primary-border-hover);
}
.button_block .btn-secondary{
  background:var(--secondary-bg);
  color:var(--secondary-text);
  border:var(--secondary-border-size) solid var(--secondary-border);
}
.button_block .btn-secondary:hover{
  background:var(--secondary-bg-hover);
  color:var(--secondary-text-hover);
  border-color:var(--secondary-border-hover);
}
{% endstylesheet %}
{% schema %}
{
  "name": "Buttons",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space" }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    { "type": "text", "id": "primary_label", "label": "Label", "default": "Shop now" },
    { "type": "url", "id": "primary_link", "label": "Link" },
    { "type": "color", "id": "primary_bg", "label": "BG", "default": "#000000" },
    { "type": "color", "id": "primary_text", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "primary_border", "label": "Border", "default": "#000000" },
    { "type": "color", "id": "primary_bg_hover", "label": "BG Hover", "default": "#333333" },
    { "type": "color", "id": "primary_text_hover", "label": "Text Hover", "default": "#ffffff" },
    { "type": "color", "id": "primary_border_hover", "label": "Border Hover", "default": "#333333" },
    {
      "type": "range",
      "id": "primary_border_size",
      "label": "Border Size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "primary_border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    { "type": "text", "id": "secondary_label", "label": "Label", "default": "Learn more" },
    { "type": "url", "id": "secondary_link", "label": "Link" },
    { "type": "color", "id": "secondary_bg", "label": "BG", "default": "#ffffff" },
    { "type": "color", "id": "secondary_text", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "secondary_border", "label": "Border", "default": "#000000" },
    { "type": "color", "id": "secondary_bg_hover", "label": "BG Hover", "default": "#000000" },
    { "type": "color", "id": "secondary_text_hover", "label": "Text Hover", "default": "#ffffff" },
    { "type": "color", "id": "secondary_border_hover", "label": "Border Hover", "default": "#000000" },
    {
      "type": "range",
      "id": "secondary_border_size",
      "label": "Border Size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "secondary_border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Choose Unit Width Dektop",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Custom Width Desktop In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_desktop == 'px' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_desktop == '%' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Choose Unit Width Tablet",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Custom Width Tablet In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_tablet == 'px' and block.settings.width_tablet == 'custom'}}"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_tablet == '%' and block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_mobile",
      "label": "Choose Unit Width Mobile",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel_mobile",
      "default": 48,
      "label": "Custom Width Mobile In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_mobile == 'px' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_mobile == '%' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Button Full Width"
    },
    {
      "type": "checkbox",
      "id": "btn_full_width",
      "label": "Enable Full Width Butto"
    },
    {
      "type": "header",
      "content": "Buttons Height"
    },
    {
      "type": "range",
      "id": "btn_height",
      "label": "Button Height Desktop",
      "min": 15,
      "max": 80,
      "step": 1,
      "default": 56
    },
    {
      "type": "range",
      "id": "btn_height_mobile",
      "label": "Button Height Mobile",
      "min": 15,
      "max": 80,
      "step": 1,
      "default": 56
    },
    
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size desktop",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 14
    },
    {
      "type": "header",
      "content": "Block Gap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_m",
      "label": "Gap Mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Block Background"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background"
    },
    {
      "type": "header",
      "content": "Block Radius"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "border",
      "label": "Border",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },

    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pl",
      "label": "Left",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pr",
      "label": "Right",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },

    {
      "type": "range",
      "id": "ptm",
      "label": "Top",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "pbm",
      "label": "Bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "plm",
      "label": "Left",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "prm",
      "label": "Right",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },

    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },

    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    }
  ],

  "presets": [
    { "name": "Buttons" }
  ]
}
{% endschema %}