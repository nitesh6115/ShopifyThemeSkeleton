{% doc %}
  Advanced Group Block
{% enddoc %}
<div
  class="
    group
    {{ block.settings.layout_direction }}
    width--{{ block.settings.width_mode }}
    height--{{ block.settings.height_mode }}
  "
  style="
    --padding: {{ block.settings.padding }}px;
    --alignment: {{ block.settings.alignment }};
    --bg: {{ block.settings.background }};
    --radius: {{ block.settings.radius }}px;
    --border-size: {{ block.settings.border_size }}px;
    --border-color: {{ block.settings.border_color }};
    --width-custom: {{ block.settings.width_custom }}%;
    --height-custom: {{ block.settings.height_custom }}{{ block.settings.height_unit }};
    --overlay: {{ block.settings.overlay_gradient }};
    --gap-x: {{ block.settings.gap_x }}px;
    --gap-y: {{ block.settings.gap_y }}px;
    --gap-x-mobile: {{ block.settings.gap_x_mobile }}px;
    --gap-y-mobile: {{ block.settings.gap_y_mobile }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="group__inner">
    {% content_for 'blocks' %}
  </div>

  {% if block.settings.overlay_gradient != blank %}
    <div class="group__overlay"></div>
  {% endif %}
</div>

{% stylesheet %}
  .group {

    display: flex;
    overflow: hidden;

    background: var(--bg);

    border-radius: var(--radius);

    border-style: solid;
    border-width: var(--border-size);
    border-color: var(--border-color);

    gap: var(--gap-y) var(--gap-x);

    position: relative;

  }


  /* inner */

  .group__inner {
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
  }


  /* overlay */

  .group__overlay {

    position: absolute;
    inset: 0;

    background: var(--overlay);

    z-index: 1;

  }


  /* direction */

  .group--horizontal {

    flex-direction: row;
    align-items: center;

    padding: 0 var(--padding);

  }

  .group--vertical {

    flex-direction: column;

    align-items: var(--alignment);

    padding: var(--padding) 0;

  }


  /* width */

  .width--fit {
    width: auto;
  }

  .width--full {
    width: 100%;
  }

  .width--custom {
    width: var(--width-custom);
  }


  /* height */

  .height--fit {
    height: auto;
  }

  .height--full {
    height: 100%;
  }

  .height--custom {
    height: var(--height-custom);
  }


  /* mobile gap */

  @media screen and (max-width: 749px) {

    .group {

      gap: var(--gap-y-mobile) var(--gap-x-mobile);

    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "Group",

  "blocks": [{ "type": "@theme" }],

  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout",
      "default": "group--vertical",
      "options": [
        { "value": "group--horizontal", "label": "Row" },
        { "value": "group--vertical", "label": "Column" }
      ]
    },

    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },

    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },

    {
      "type": "range",
      "id": "border_size",
      "label": "Border size",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },

    {
      "type": "select",
      "id": "width_mode",
      "label": "Width",
      "default": "full",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "full", "label": "Full" },
        { "value": "custom", "label": "Custom" }
      ]
    },

    {
      "type": "range",
      "id": "width_custom",
      "label": "Custom width %",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 100
    },

    {
      "type": "select",
      "id": "height_mode",
      "label": "Height",
      "default": "fit",
      "options": [
        { "value": "fit", "label": "Fit" },
        { "value": "full", "label": "Full" },
        { "value": "custom", "label": "Custom" }
      ]
    },

    {
      "type": "range",
      "id": "height_custom",
      "label": "Custom height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 100,
      "visible_if": "{{ block.settings.height_mode == 'custom' }}"
    },

    {
      "type": "select",
      "id": "height_unit",
      "label": "Height unit",
      "default": "%",
      "options": [
        { "value": "%", "label": "%" },
        { "value": "vh", "label": "vh" }
      ],
      "visible_if": "{{ block.settings.height_mode == 'custom' }}"
    },

    {
      "type": "text",
      "id": "overlay_gradient",
      "label": "Overlay gradient"
    },

    {
      "type": "header",
      "content": "Gap Desktop"
    },

    {
      "type": "range",
      "id": "gap_x",
      "label": "Horizontal gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0
    },

    {
      "type": "range",
      "id": "gap_y",
      "label": "Vertical gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0
    },

    {
      "type": "header",
      "content": "Gap Mobile"
    },

    {
      "type": "range",
      "id": "gap_x_mobile",
      "label": "Horizontal gap mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    },

    {
      "type": "range",
      "id": "gap_y_mobile",
      "label": "Vertical gap mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    },

    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 0
    }
  ],

  "presets": [
    {
      "name": "Row"
    },
    {
      "name": "Column"
    }
  ]
}
{% endschema %}