
{%- capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'block_group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}


{% schema %}
{
  "name": "Group",

  "blocks": [
    { "type": "@theme" }
  ],

  "settings": [

    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout",
      "default": "group--horizontal",
      "options": [
        { "value": "group--horizontal", "label": "Row" },
        { "value": "group--vertical", "label": "Column" }
      ]
    },

    {
      "type": "select",
      "id": "align_x",
      "label": "Align",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ]
    },

    {
      "type": "select",
      "id": "align_y",
      "label": "Align",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" },
        { "value": "stretch", "label": "Stretch" }
      ]
    },

    {
      "type": "select",
      "id": "wrap",
      "label": "Wrap",
      "default": "wrap",
      "options": [
        { "value": "wrap", "label": "On" },
        { "value": "nowrap", "label": "Off" }
      ]
    },


    {
      "type": "range",
      "id": "cols",
      "visible_if": "{{ block.settings.layout_direction == 'group--horizontal' }}",
      "label": "Columns desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },

    {
      "type": "range",
      "id": "cols_m",
      "label": "Columns mobile",
      "visible_if": "{{ block.settings.layout_direction == 'group--horizontal' }}",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },


    {
      "type": "checkbox",
      "id": "equal_height",
      "label": "Equal height"
    },


    {
      "type": "range",
      "id": "grow",
      "label": "Grow",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0
    },

    {
      "type": "range",
      "id": "shrink",
      "label": "Shrink",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 1
    },


    {
      "type": "range",
      "id": "gap_x",
      "label": "Gap X",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0
    },

    {
      "type": "range",
      "id": "gap_y",
      "label": "Gap Y",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0
    },


    {
      "type": "range",
      "id": "gap_x_m",
      "label": "Gap X mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    },

    {
      "type": "range",
      "id": "gap_y_m",
      "label": "Gap Y mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    },


    {
      "type": "color",
      "id": "background",
      "label": "Background"
    },

    {
      "type": "range",
      "id": "radius",
      "label": "Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },

    {
      "type": "range",
      "id": "border",
      "label": "Border",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
  "type": "header",
  "content": "Padding Desktop"
},

{
  "type": "range",
  "id": "pt",
  "label": "Top",
  "min": 0,
  "max": 200,
  "step": 2,
  "default": 0
},
{
  "type": "range",
  "id": "pb",
  "label": "Bottom",
  "min": 0,
  "max": 200,
  "step": 2,
  "default": 0
},
{
  "type": "range",
  "id": "pl",
  "label": "Left",
  "min": 0,
  "max": 200,
  "step": 2,
  "default": 0
},
{
  "type": "range",
  "id": "pr",
  "label": "Right",
  "min": 0,
  "max": 200,
  "step": 2,
  "default": 0
},
{
  "type": "header",
  "content": "Padding Mobile"
},

{
  "type": "range",
  "id": "ptm",
  "label": "Top",
  "min": 0,
  "max": 150,
  "step": 2,
  "default": 0
},
{
  "type": "range",
  "id": "pbm",
  "label": "Bottom",
  "min": 0,
  "max": 150,
  "step": 2,
  "default": 0
},
{
  "type": "range",
  "id": "plm",
  "label": "Left",
  "min": 0,
  "max": 150,
  "step": 2,
  "default": 0
},
{
  "type": "range",
  "id": "prm",
  "label": "Right",
  "min": 0,
  "max": 150,
  "step": 2,
  "default": 0
},
{
  "type": "header",
  "content": "Visibility"
},

{
  "type": "checkbox",
  "id": "hide_desktop",
  "label": "Hide on desktop",
  "default": false
},

{
  "type": "checkbox",
  "id": "hide_mobile",
  "label": "Hide on mobile",
  "default": false
}

  ],

  "presets": [
    { "name": "Block Group" }
  ]
}
{% endschema %}