{% doc %}
Advanced Group Block (Safe Builder Version)
{% enddoc %}
<div
  class="group {{ block.settings.layout_direction }} {% if block.settings.hide_desktop %}hide-desktop{% endif %}
  {% if block.settings.hide_mobile %}hide-mobile{% endif %}
 {% if block.settings.equal_height %}is-equal{% endif %}"
  style="
    --align-x: {{ block.settings.align_x }};
    --align-y: {{ block.settings.align_y }};
    --wrap: {{ block.settings.wrap }};
    --cols: {{ block.settings.cols }};
    --cols-m: {{ block.settings.cols_m }};
    --grow: {{ block.settings.grow }};
    --shrink: {{ block.settings.shrink }};
    --gap-x: {{ block.settings.gap_x }}px;
    --gap-y: {{ block.settings.gap_y }}px;
    --gap-x-m: {{ block.settings.gap_x_m }}px;
    --gap-y-m: {{ block.settings.gap_y_m }}px;
    --bg: {{ block.settings.background }};
    --radius: {{ block.settings.radius }}px;
    --border: {{ block.settings.border }}px;
    --border-color: {{ block.settings.border_color }};
    --width: {{ block.settings.width_custom }}%;
    --height: {{ block.settings.height_custom }}px;
    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --pl: {{ block.settings.pl }}px;
    --pr: {{ block.settings.pr }}px;
    --ptm: {{ block.settings.ptm }}px;
    --pbm: {{ block.settings.pbm }}px;
    --plm: {{ block.settings.plm }}px;
    --prm: {{ block.settings.prm }}px;

    --item-width: {{ block.settings.width }}%;
    --item-width-m: {{ block.settings.width_m }}%;
    --item-grow: {{ block.settings.grow }};
    --item-shrink: {{ block.settings.shrink }};
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>



{% stylesheet %}
.group {
  display: flex;
  flex-direction: row;
  flex-wrap: var(--wrap);
  justify-content: var(--align-x);
  align-items: var(--align-y);
  gap: var(--gap-y) var(--gap-x);
  background: var(--bg);
  border-radius: var(--radius);
  border: var(--border) solid var(--border-color);
  padding-top: var(--pt);
  padding-bottom: var(--pb);
  padding-left: var(--pl);
  padding-right: var(--pr);
  width: 100%;
}

/* direction */

.group--horizontal {
  flex-direction: row;
  
}

.group--vertical {
  flex-direction: column;
  align-items: var(--align-x);
}

/* equal height */

.is-equal > * {
  align-self: stretch;
}

/* grow shrink */

.group > * {
  flex-grow: var(--grow);
  flex-shrink: var(--shrink);
  text-align: unset;
}

/* ✅ APPLY COLUMNS ONLY WHEN WRAP */
.group--horizontal  > * > * {
  flex-grow: var(--item-grow, var(--grow));
  flex-shrink: var(--item-shrink, var(--shrink));
  flex-basis: var(
    --item-width,
    calc(
      (100% - (var(--cols) - 1) * var(--gap-x))
      / var(--cols)
    )
  );
}
/* mobile */

@media (max-width: 749px) {

  .group {
    gap: var(--gap-y-m) var(--gap-x-m);
    padding-top: var(--ptm);
    padding-bottom: var(--pbm);
    padding-left: var(--plm);
    padding-right: var(--prm);
  }

  .group--horizontal  > * > * {
  display: flex;
  flex-basis: var(
    --item-width-m,
    calc(
      (100% - (var(--cols-m) - 1) * var(--gap-x-m))
      / var(--cols-m)
    )
  );

}

}

/* visibility */

.hide-desktop {
  display: none !important;
}

@media (max-width: 749px) {

  .hide-desktop {
    display: flex !important;
  }

  .hide-mobile {
    display: none !important;
  }

}
{% endstylesheet %}



{% schema %}
{
  "name": "Group",

  "blocks": [
    { "type": "@theme" }
  ],

  "settings": [

    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout",
      "default": "group--horizontal",
      "options": [
        { "value": "group--horizontal", "label": "Row" },
        { "value": "group--vertical", "label": "Column" }
      ]
    },

    {
      "type": "select",
      "id": "align_x",
      "label": "Align",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space between" }
      ]
    },

    {
      "type": "select",
      "id": "align_y",
      "label": "Align",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" },
        { "value": "stretch", "label": "Stretch" }
      ]
    },

    {
      "type": "select",
      "id": "wrap",
      "label": "Wrap",
      "default": "wrap",
      "options": [
        { "value": "wrap", "label": "On" },
        { "value": "nowrap", "label": "Off" }
      ]
    },


    {
      "type": "range",
      "id": "cols",
      "visible_if": "{{ block.settings.layout_direction == 'group--horizontal' }}",
      "label": "Columns desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },

    {
      "type": "range",
      "id": "cols_m",
      "label": "Columns mobile",
      "visible_if": "{{ block.settings.layout_direction == 'group--horizontal' }}",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },


    {
      "type": "checkbox",
      "id": "equal_height",
      "label": "Equal height"
    },


    {
      "type": "range",
      "id": "grow",
      "label": "Grow",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0
    },

    {
      "type": "range",
      "id": "shrink",
      "label": "Shrink",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 1
    },


    {
      "type": "range",
      "id": "gap_x",
      "label": "Gap X",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0
    },

    {
      "type": "range",
      "id": "gap_y",
      "label": "Gap Y",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0
    },


    {
      "type": "range",
      "id": "gap_x_m",
