{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
-%}
{%- capture style_schema -%}
--block-bg: {{ block.settings.bg_color }};
    --block-radius: {{ block.settings.block_radius }}px;
    --block-desktop-text-alignment: {{ block.settings.desktop_text_align }};
    --block-mobile-text-alignment: {{ block.settings.mobile_text_align }};
    --block-text-color: {{ block.settings.text_color }};
    --block-desktop-padding-top: {{ block.settings.padding_top }}px;
    --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
    --block-desktop-padding-left: {{ block.settings.padding_left }}px;
    --block-desktop-padding-right: {{ block.settings.padding_right }}px;
    --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
    --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
    --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
    --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;

    --btn-height: {{ block.settings.btn_height }}px;
    --btn-height-mobile: {{ block.settings.btn_height_mobile }}px;
    --btn-padding: {{ block.settings.btn_height | times: 0.55 | round: 0 }}px;

    --btn-bg: {{ block.settings.btn_bg }};
    --btn-text: {{ block.settings.btn_text }};

    --btn-hover-bg: {{ block.settings.btn_hover_bg }};
    --btn-hover-text: {{ block.settings.btn_hover_text }};
    --btn-radius: {{ block.settings.btn_radius }}px;
    --btn-border: {{ block.settings.btn_border }};
    --btn-font-size: {{ block.settings.btn_size }}px;
    --btn-uppercase: {% if block.settings.btn_uppercase %} uppercase {% else %} normal {%endif %};
    --btn-border-width: {{ block.settings.btn_border_width }}px;
    --btn-hover-border: {{ block.settings.btn_hover_border }};

    --buy-btn-bg: {{ block.settings.buy_btn_bg }};
    --buy-btn-text: {{ block.settings.buy_btn_text }};
    --buy-border: {{ block.settings.buy_btn_border }};
    --buy-btn-hover-bg: {{ block.settings.buy_btn_hover_bg }};
    --buy-btn-hover-text: {{ block.settings.buy_btn_hover_text }};
    --buy-btn-hover-border: {{ block.settings.buy_btn_hover_border }};

{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}
<div
  class="product_block buy_buttons {% if block.settings.show_dynamic_button %} buy_now_enabled {% endif %}"
  {{ block.shopify_attributes }}
  style="{{- style_schema -}}"
>
  {%- assign product_form_id = 'product-form-' | append: block.id -%}
  {% assign current_variant = product.selected_or_first_available_variant %}
  {%- form 'product',
    product,
    id: product_form_id,
    class: 'form',
    novalidate: 'novalidate',
    data-type: 'add-to-cart-form'
  -%}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

    {% if block.settings.show_qty %}
      <div class="product-quantity" data-quantity-wrapper>
        <button type="button" class="qty-btn qty-minus">−</button>

        <input
          type="text"
          name="quantity"
          value="1"
          min="1"
          step="1"
          readonly
          class="qty-input"
        >

        <button type="button" class="qty-btn qty-plus">+</button>

        <p class="qty-error" style="display:none;"></p>
      </div>
    {% else %}
      <input
        type="hidden"
        name="quantity"
        value="1"
        min="1"
        step="1"
      >
    {% endif %}
    <div class="button_from">
      <button
        type="submit"
        class="add-to-cart"
        {% if block.settings.show_price %}
          data-btn-price
        {% endif %}
      >
        <span class="btn_text">{{ block.settings.btn_text_label | default : 'Add to Cart'}}</span>
        {% if block.settings.show_price %}
          <span class="icon">—</span>
          <span class="btn_price">{{ current_variant.price | money }}</span>
        {% endif %}
      </button>
    </div>
    {% if block.settings.show_dynamic_button %}
      {{ form | payment_button }}
    {% endif %}
  {% endform %}
  {% if block.settings.enabled_sticky_add %}
    <div class="sticky-atc" id="StickyATC-{{ section.id }}">
      <div class="sticky-inner">
        <div class="sticky-left">
          {{ product.featured_image
            | image_url: width: 120
            | image_tag:
            class: 'sticky-image',
            loading: 'lazy',
            widths: '50, 100, 150, 200, 250, 300',
            sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
            alt: product.featured_imag
            }}
          <div class="sticky-meta">
            <div class="sticky-title">{{ product.title }}</div>
            <div class="sticky-variant"></div>
            <div class="sticky-price-wrapper">
              <span class="sticky-price"></span>
              <span class="sticky-compare"></span>
              <span class="sticky-save"></span>
            </div>
          </div>
        </div>

        <button type="button" class="sticky-btn">Add to Cart</button>
      </div>
    </div>
  {% endif %}
</div>
{% stylesheet %}
  button.add-to-cart,.sticky-btn {
    width: 100%;
    background: var(--btn-bg);
    font-weight: 800;
    color: var(--btn-text);
    border: var(--btn-border-width) solid var(--btn-border);
    border-radius: var(--btn-radius);
    transition: .2s ease;
    padding: 0 var(--btn-padding);
    display: flex;
    min-height: var(--btn-height);
    align-items: center;
    justify-content: center;
    text-transform: var(--btn-uppercase);
    gap: 10px;
    font-size: 16px;
    cursor: pointer;
}
button.add-to-cart:hover,.sticky-btn:hover {
    background: var(--btn-hover-bg);
    color: var(--btn-hover-text);
    border: var(--btn-border-width) solid var(--btn-hover-border);
}
.sticky-btn{
width: auto;
}
button.add-to-cart[disabled],.sticky-btn[disabled] {
    opacity: 0.5;
    pointer-events: none;
}
.buy_now_enabled  .shopify-payment-button {
    margin-top: 1rem;
}

.buy_now_enabled button.shopify-payment-button__button.shopify-payment-button__button--unbranded {
    width: 100%;
    background: var(--buy-btn-bg);
    font-weight: 800;
    color: var(--buy-btn-text);
    border: var(--btn-border-width) solid var(--buy-border);
    border-radius: var(--btn-radius);
    transition: .2s ease;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    min-height: var(--btn-height);
    justify-content: center;
    text-transform: var(--btn-uppercase);
    gap: 10px;
   font-size: 16px;
    cursor: pointer;
}

.buy_now_enabled button.shopify-payment-button__button.shopify-payment-button__button--unbranded:hover {
    background: var(--buy-btn-hover-bg);
    color: var(--buy-btn-hover-text);
    border-color: var(--buy-btn-hover-border);
}

.buy_now_enabled .shopify-payment-button__button[disabled] {
    pointer-events: none;
}

.selling-plan-group-options-name-select {
    margin: 0;
}

.sealsubs-container label.sls-selling-plan-group-name, .sealsubs-container .sls-option-container label, .sealsubs-container label.sls-purchase-options-label {font-size: 16px;}

.sls-price {
    font-size: 16px;
}

.sls-label-container.seal-col {
    display: block;
    line-height: normal;
}

.seal-row {
    display: flex;
    align-items: center;
}
.product-quantity {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 1rem;
}

.qty-btn {
  width: 40px;
  height: 40px;
  border: 1px solid #D4D4D4;
  background: #fff;
  font-size: 20px;
  cursor: pointer;
  border-radius: var(--btn-radius);
  color: var(--block-text-color);
}

.qty-input {
  width: 40px;
  text-align: center;
  height: 40px;
  border:none;
  font-size: 14px;
  box-shadow: none;
}

.qty-error {
  color: red;
  font-size: 14px;
  margin-top: 5px;
  display: none !important;
}
.group.group--horizontal.box-nowrap .product_block.buy_buttons {
    width: auto;
}
@media (max-width: 767px){
  button.add-to-cart,.buy_now_enabled button.shopify-payment-button__button.shopify-payment-button__button--unbranded{
    min-height: var(--btn-height-mobile);
  }
}
{% endstylesheet %}
{% schema %}
{
  "tag": null,
  "name": "Buy Button",
  "settings": [
    {
      "type": "header",
      "content": "Block Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "max": 100,
      "min": 0,
      "default": 5,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "max": 100,
      "min": 0,
      "default": 5,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_radius",
      "label": "Block Radius",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Block Background"
    },
    {
      "type": "header",
      "content": "Add to cart Button Style"
    },
    {
      "type": "color_background",
      "id": "btn_bg",
      "label": "Button Background Color",
      "default": "linear-gradient(90deg, #065D2D 0%, #0C8D46 100%)"
    },
    {
      "type": "color_background",
      "id": "btn_hover_bg",
      "default": "linear-gradient(90deg, rgba(10, 9, 9, 1), rgba(1, 132, 38, 1) 100%)",
      "label": "Button Hover Background Color"
    },
    {
      "type": "text",
      "id": "btn_text_label",
      "label": "Add To Cart Button Label",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "btn_text",
      "default": "#fff",
      "label": "Button Text Color"
    },
    {
      "type": "color",
      "id": "btn_hover_text",
      "default": "#fff",
      "label": "Button Hover Text Color"
    },
    {
      "type": "color",
      "id": "btn_border",
      "label": "Button Border Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "btn_hover_border",
      "label": "Button Hover Border Color"
    },
    {
      "type": "checkbox",
      "id": "show_qty",
      "label": "Show Quantity"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_button",
      "label": "Show Buy Now or Dynamic Button"
    },
    {
      "type": "color_background",
      "id": "buy_btn_bg",
      "label": "Button Background Color",
      "visible_if": "{{ block.settings.show_dynamic_button == true }}",
      "default": "linear-gradient(90deg, #065D2D 0%, #0C8D46 100%)"
    },
    {
      "type": "color_background",
      "id": "buy_btn_hover_bg",
      "visible_if": "{{ block.settings.show_dynamic_button == true }}",
      "default": "linear-gradient(90deg, rgba(10, 9, 9, 1), rgba(10, 9, 9, 1) 100%)",
      "label": "Button Hover Background Color"
    },
    {
      "type": "color",
      "id": "buy_btn_text",
      "visible_if": "{{ block.settings.show_dynamic_button == true }}",
      "default": "#fff",
      "label": "Button Text Color"
    },
    {
      "type": "color",
      "id": "buy_btn_hover_text",
      "visible_if": "{{ block.settings.show_dynamic_button == true }}",
      "default": "#fff",
      "label": "Button Hover Text Color"
    },
    {
      "type": "color",
      "id": "buy_btn_border",
      "visible_if": "{{ block.settings.show_dynamic_button == true }}",
      "label": "Button Border Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "buy_btn_hover_border",
      "visible_if": "{{ block.settings.show_dynamic_button == true }}",
      "label": "Button Hover Border Color"
    },
    {
      "type": "checkbox",
      "id": "enabled_sticky_add",
      "visible_if": "{{ block.settings.show_dynamic_button == true }}",
      "label": "Show Sticky Add Bar"
    },

    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price"
    },
    {
      "type": "range",
      "id": "btn_font",
      "label": "Button Font Size",
      "max": 100,
      "min": 0,
      "default": 14,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "btn_uppercase",
      "label": "Button Text Uppercase"
    },
    {
      "type": "range",
      "id": "btn_height",
      "label": "Button Height Desktop",
      "min": 15,
      "max": 80,
      "step": 1,
      "default": 56
    },
    {
      "type": "range",
      "id": "btn_height_mobile",
      "label": "Button Height Mobile",
      "min": 15,
      "max": 80,
      "step": 1,
      "default": 56
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Button Radius",
      "max": 100,
      "min": 0,
      "default": 10,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "btn_border_width",
      "label": "Border Size",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Add To Cart Button"
    }
  ]
}
{% endschema %}
