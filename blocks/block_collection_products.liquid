{%- capture style_schema -%}
--per-row-desktop: {{ block.settings.per_row_desktop }};
--per-row-tablet: {{ block.settings.per_row_tablet }};
--per-row-mobile: {{ block.settings.per_row_mobile }};
--gap: {{ block.settings.gap }}px;
--gap-m: {{ block.settings.gap_m }}px;
{%- endcapture -%}

{% assign style_schema = style_schema | strip_newlines %}

<div
class="collection-block
{% if block.settings.enable_slider %}is-slider{% endif %}
{% if block.settings.slider_desktop %}slider-desktop{% endif %}
{% if block.settings.slider_tablet %}slider-tablet{% endif %}
{% if block.settings.slider_mobile %}slider-mobile{% endif %}
block-width-desktop-fill
block-width-tablet-fill
block-width-mobile-fill"
style="{{ style_schema }}"
data-slider-id="{{ block.id }}"
{{ block.shopify_attributes }}
>
<div class="collection-track">
{% for product in block.settings.collection.products limit: block.settings.limit %}
    {% assign pid = 'product-' | append: product.id %}
<div class="collection-item">
  {% content_for 'block', type: '_product-card', id: 'static_id', closest.product: product %}
</div>
{% endfor %}
</div>
<div class="slider-arrows">

<button
class="slider-prev"
data-prev="{{ block.id }}"
>
Prev
</button>

<button
class="slider-next"
data-next="{{ block.id }}"
>
Next
</button>

</div>
<div class="slider-dots"></div>
</div>
{% stylesheet %}
.collection-track {
  transition: transform .4s ease;
}

.is-slider .collection-track {
  will-change: transform;
}
.collection-block {
  width: 100%;
  min-width: 0;
}
.collection-track {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap);
  width: 100%;
  min-width: 0;
}
.collection-item {
  flex: 0 0 calc(
    (100% - (var(--gap) * (var(--per-row-desktop) - 1)))
    / var(--per-row-desktop)
  );
  min-width: 0;
}
.is-slider .collection-track {
  flex-wrap: nowrap;
  overflow: hidden;
}

.is-slider .collection-item {
  flex: 0 0 calc(100% / var(--per-row-desktop));
}
.collection-item .sealsubs-target-element.sls-homepage-automatic.sealsubs-full {
    display: none;
}
@media (max-width:1365px) {

.collection-track {
  gap: var(--gap-m);
}

.collection-item {
  flex: 0 0 calc(
    (100% - (var(--gap-m) * (var(--per-row-tablet) - 1)))
    / var(--per-row-tablet)
  );
}
.slider-tablet .collection-track {
  flex-wrap: nowrap;
  overflow: hidden;
}

.slider-tablet .collection-item {
  flex: 0 0 calc(100% / var(--per-row-tablet));
}

}

@media (max-width:767px) {

.collection-track {
  gap: var(--gap-m);
}

.collection-item {
  flex: 0 0 calc(
    (100% - (var(--gap-m) * (var(--per-row-mobile) - 1)))
    / var(--per-row-mobile)
  );
}
.slider-mobile .collection-track {
  flex-wrap: nowrap;
  overflow: hidden;
}

.slider-mobile .collection-item {
  flex: 0 0 calc(100% / var(--per-row-mobile));
}

}
.collection-item .product-wrapper {
    display: block;
}

.collection-item .product_media-wrapper {
    max-width: 100%;
}

.collection-item .prdouctThubs {
    display: none;
}

.collection-item .product_information_wrapper {
    max-width: 100%;
}
{% endstylesheet %}
{% javascript %}
document.querySelectorAll(".collection-block").forEach(block => {

  const track = block.querySelector(".collection-track");
  if (!track) return;

  const id = block.dataset.sliderId;

  const prev = block.querySelector(`[data-prev="${id}"]`);
  const next = block.querySelector(`[data-next="${id}"]`);

  let index = 0;

  function getItemWidth() {

    const item = track.children[0];
    if (!item) return 0;

    const gap = parseFloat(
      getComputedStyle(track).gap
    ) || 0;

    return item.offsetWidth + gap;

  }

  function getVisible() {

    const item = track.children[0];
    if (!item) return 1;

    return Math.round(
      track.offsetWidth / item.offsetWidth
    );

  }

  function move() {

    const w = getItemWidth();

    track.style.transform =
      `translateX(${index * -w}px)`;

  }

  function maxIndex() {

    const total = track.children.length;
    const visible = getVisible();

    return Math.max(0, total - visible);

  }

  next?.addEventListener("click", () => {

    if (index < maxIndex()) {
      index++;
    }

    move();

  });

  prev?.addEventListener("click", () => {

    if (index > 0) {
      index--;
    }

    move();

  });

  window.addEventListener("resize", () => {
    index = 0;
    move();
  });

});
{% endjavascript %}
{% schema %}
{
"name":"Collection",
"blocks": [{ "type": "@theme"},{"type": "_product-card"}],
"settings":[

{ "type":"collection","id":"collection","label":"Collection" },

{ "type":"range","id":"limit","min":1,"max":20,"default":8,"step": 1,"label": "Limit" },

{ "type":"range","id":"per_row_desktop","min":1,"max":6,"default":4,"step": 1,"label": "Per Row Desktop" },

{ "type":"range","id":"per_row_tablet","min":1,"max":4,"default":2,"step": 1,"label": "Pre Row Tablet" },

{ "type":"range","id":"per_row_mobile","min":1,"max":3,"default":1,"step": 1,"label": "Pre Row Mobile" },

{ "type":"checkbox","id":"enable_slider","label":"Enable slider" },

{ "type":"checkbox","id":"slider_desktop","label":"Slider desktop" },

{ "type":"checkbox","id":"slider_tablet","label":"Slider tablet" },

{ "type":"checkbox","id":"slider_mobile","label":"Slider mobile" },

{ "type":"range","id":"gap","min":0,"max":40,"default":16,"step": 1,"label": "Gap Desktop" },

{ "type":"range","id":"gap_m","min":0,"max":40,"default":12,"step": 1,"label": "Gap Mobile" }

],
"presets": [{
"name": "Collection Products"}]

}
{% endschema %}