{%- capture style_schema -%}
--per-row-desktop: {{ block.settings.per_row_desktop }};
--per-row-tablet: {{ block.settings.per_row_tablet }};
--per-row-mobile: {{ block.settings.per_row_mobile }};
--gap: {{ block.settings.gap }}px;
--gap-m: {{ block.settings.gap_m }}px;
--arrow-color: {{ block.settings.arrow_color }};
      --arrow-bg: {{ block.settings.arrow_bg }};
      --dot-color: {{ block.settings.dot_color }};
      --dot-active: {{ block.settings.dot_active }};
{%- endcapture -%}

{% assign style_schema = style_schema | strip_newlines %}

<div class="collection_block_container" style="{{- style_schema -}}">
    
  <div
    class="
      collection_block_slider
      slider-{{ block.id }}
      {% if block.settings.enable_desktop %} slider-desktop{% endif %}
      {% if block.settings.enable_tablet %} slider-tablet{% endif %}
      {% if block.settings.enable_mobile %} slider-mobile{% endif %}
    "
    data-id="{{ block.id }}"
    id="slider-{{ block.id }}"
    data-autoplay="{{ block.settings.autoplay }}"
    data-speed="{{ block.settings.autoplay_speed }}"
    data-arrows="{{ block.settings.show_arrows }}"
    data-dots="{{ block.settings.show_dots }}"
  >
    
    <div class="collection-slider-inner">
      <div
        class="collection-slider-track collection-track"
        id="track-{{ block.id }}"
      >
        {% for product in block.settings.collection.products limit: block.settings.max_items %}
          <div class="collection-item">
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product
            %}
          </div>
        {% endfor %}
      </div>
    </div>
     {% if block.settings.show_arrows %}
      <button class="collection-slider-prev" data-id="{{ block.id }}">‹</button>
      <button class="collection-slider-next" data-id="{{ block.id }}">›</button>
    {% endif %}
    {% if block.settings.show_dots %}
      <div class="collection-slider-dots" id="dots-{{ block.id }}"></div>
    {% endif %}

  </div>

</div>
{% stylesheet %}
.collection_block_slider {
  position: relative;
  width: 100%;
}
.collection_block_slider .sealsubs-target-element.sls-homepage-automatic.sealsubs-full {
    display: none;
}
.collection_block_slider .collection-slider-track {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: calc(
    (100% - (var(--gap) * (var(--per-row-desktop) - 1)))
    / var(--per-row-desktop)
  );
  gap: var(--gap);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
}
.collection_block_slider .collection-slider-track::-webkit-scrollbar {
  display: none;
}

 /* arrows */

    .collection-slider-prev,
    .collection-slider-next{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:36px;
    height:36px;
    border:none;
    cursor:pointer;
    background:var(--arrow-bg);
    color:var(--arrow-color);
    box-shadow: 0px 4px 6px -4px #0000001A;
    border-radius: 100%;
    z-index:5;
    }

    .collection-slider-prev{ left:0; }
    .collection-slider-next{ right:0; }


    /* dots */

    .collection-slider-dots{
    display:flex;
    gap:6px;
    justify-content:center;
    margin-top:8px;
    }

    .collection-slider-dots button{
    width:12px;
    height:12px;
    border-radius:50%;
    border:none;
    background:var(--dot-color);
    opacity:.4;
    }

    .collection-slider-dots button.active{
    background:var(--dot-active);
    width: 42px;
    border-radius: 10px;
    opacity:1;
    }
.collection_block_slider {
  width: 100%;
  min-width: 0;
}
.collection_block_container {
    flex: 1;
    align-self: stretch;
    overflow: hidden;
    width: 100%;
}

/* DESKTOP */
@media (min-width:1366px){
.collection_block_slider.slider-desktop .slider-track{
  grid-auto-columns: calc(
    (100% - (var(--gap) * (var(--per-row-desktop) - 1)))
    / var(--per-row-desktop)
  );
  gap: var(--gap-m);
}
.collection_block_slider:not(.slider-desktop) .collection-slider-track{
  grid-auto-flow: row;
  grid-template-columns: repeat(
    var(--per-row-desktop),
    1fr
  );
  
}
.collection_block_slider:not(.slider-desktop) .collection-slider-prev,
.collection_block_slider:not(.slider-desktop) .collection-slider-next,
.collection_block_slider:not(.slider-desktop) .collection-slider-dots {
  display: none;
}
}
/* TABLET */
@media only screen and (min-width:768px) and (max-width:1365px){
.collection_block_slider .collection-slider-track {
  gap: var(--gap-m);
}
.collection_block_slider.slider-tablet .collection-slider-track{
  grid-auto-columns: calc(
    (100% - (var(--gap-m) * (var(--per-row-tablet) - 1)))
    / var(--per-row-tablet)
  );
  gap: var(--gap-m);
}
.collection_block_slider:not(.slider-tablet) .collection-slider-track{
  grid-auto-flow: row;
  grid-template-columns: repeat(
    var(--per-row-tablet),
    1fr
  );
}
.collection_block_slider:not(.slider-tablet) .collection-slider-prev,
.collection_block_slider:not(.slider-tablet) .collection-slider-next,
.collection_block_slider:not(.slider-tablet) .collection-slider-dots {
  display: none;
}
}


/* MOBILE */

@media (max-width:767px){

.collection_block_slider .collection-slider-track {
  gap: var(--gap-m);
}

.collection_block_slider.slider-mobile .collection-slider-track{
  grid-auto-columns: calc(
    (100% - (var(--gap-m) * (var(--per-row-mobile) - 1)))
    / var(--per-row-mobile)
  );
  gap: var(--gap-m);
}
.collection_block_slider:not(.slider-mobile) .collection-slider-track{
  grid-auto-flow: row;
  grid-template-columns: repeat(
    var(--per-row-mobile),
    1fr
  );
}

.collection_block_slider:not(.slider-mobile) .collection-slider-prev,
.collection_block_slider:not(.slider-mobile) .collection-slider-next,
.collection_block_slider:not(.slider-mobile) .collection-slider-dots {

  display: none;

}

}
{% endstylesheet %}
{% javascript %}
function initSlider(id) {

  const slider = document.getElementById('slider-' + id);
  if (!slider) return;

  const track = document.getElementById('track-' + id);

  const prev = slider.querySelector('.collection-slider-prev');
  const next = slider.querySelector('.collection-slider-next');
  const dotsWrap = document.getElementById('dots-' + id);

  const autoplay = slider.dataset.autoplay === 'true';
  const speed = parseInt(slider.dataset.speed) || 3000;

  let index = 0;
  const slides = track.children;


  function go(i) {
    if (i < 0) i = 0;
    if (i >= slides.length) i = slides.length - 1;
    index = i;
    const slide = slides[index];
    track.scrollTo({
      left: slide.offsetLeft,
      behavior: 'smooth'
    });
    updateDots();
  }


  if (prev) prev.onclick = () => go(index - 1);
  if (next) next.onclick = () => go(index + 1);


  if (dotsWrap) {

    dotsWrap.innerHTML = '';

    for (let i = 0; i < slides.length; i++) {

      let b = document.createElement('button');

      b.onclick = () => go(i);

      dotsWrap.appendChild(b);
    }
  }


  function updateDots() {

    if (!dotsWrap) return;

    dotsWrap.querySelectorAll('button').forEach((d, i) => {

      d.classList.toggle('active', i === index);

    });
  }


  if (autoplay) {

    setInterval(() => {

      index++;

      if (index >= slides.length) index = 0;

      go(index);

    }, speed);
  }


  let isDown = false;
  let startX;
  let scrollLeft;

  track.addEventListener('pointerdown', (e) => {

    isDown = true;

    startX = e.pageX;

    scrollLeft = track.scrollLeft;

  });

  track.addEventListener('pointerup', () => isDown = false);
  track.addEventListener('pointerleave', () => isDown = false);

  track.addEventListener('pointermove', (e) => {

    if (!isDown) return;

    const walk = (e.pageX - startX);

    track.scrollLeft = scrollLeft - walk;

  });
  function updateSliderItems(slider, track) {

  const inner = slider.querySelector(".collection-slider-inner");
  if (!inner) return;

  const style = getComputedStyle(slider);

  const perRow =
    parseInt(style.getPropertyValue("--per-row-desktop")) || 4;

  const gap =
    parseFloat(style.getPropertyValue("--gap")) || 0;

  const containerWidth = inner.clientWidth;

  const itemWidth =
    (containerWidth - gap * (perRow - 1)) / perRow;

  [...track.children].forEach(el => {
    el.style.flex = "0 0 auto";
    el.style.width = itemWidth + "px";
  });

}
}


document.querySelectorAll('.slider_block, .collection_block_slider')
.forEach((el) => {

  initSlider(el.dataset.id);

});


document.addEventListener('shopify:section:load', function (e) {

  e.target
  .querySelectorAll('.slider_block, .collection_block_slider')
  .forEach((el) => {

    initSlider(el.dataset.id);

  });

});
{% endjavascript %}
{% schema %}
{
"name":"Collection",
"tag": null,
"blocks": [{ "type": "@theme"},{"type": "_product-card"}],
"settings":[

{
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },

    {
      "type": "range",
      "id": "max_items",
      "label": "Max products",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },


    {
      "type": "header",
      "content": "Slider enable"
    },

    {
      "type": "checkbox",
      "id": "enable_desktop",
      "label": "Enable slider desktop",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "enable_tablet",
      "label": "Enable slider tablet",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "enable_mobile",
      "label": "Enable slider mobile",
      "default": true
    },


    {
      "type": "header",
      "content": "Slider options"
    },

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay"
    },

    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 8000,
      "step": 500,
      "default": 3000
    },

    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#000"
    },

    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Arrow bg",
      "default": "#fff"
    },

    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#999"
    },

    {
      "type": "color",
      "id": "dot_active",
      "label": "Active dot",
      "default": "#000"
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "per_row_desktop",
      "label": "Per row desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "per_row_tablet",
      "label": "Per row tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },

    {
      "type": "range",
      "id": "per_row_mobile",
      "label": "Per row mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },


    {
      "type": "range",
      "id": "gap",
      "label": "Gap desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },

    {
      "type": "range",
      "id": "gap_m",
      "label": "Gap mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 8
    },

],
"presets": [{
"name": "Collection Products"}]

}
{% endschema %}