{% doc %}
Divider Block
{% enddoc %}

<div
  class="divider-block
  align--{{ block.settings.align }}
  {% if block.settings.hide_mobile %}hide-mobile{% endif %}
  {% if block.settings.hide_desktop %}hide-desktop{% endif %}
  "

  style="

  --bw: {{ block.settings.border }}px;
  --bc: {{ block.settings.color }};
  --w: {{ block.settings.width }}%;

  --pt: {{ block.settings.pt }}px;
  --pb: {{ block.settings.pb }}px;

  --ptm: {{ block.settings.ptm }}px;
  --pbm: {{ block.settings.pbm }}px;

  "

  {{ block.shopify_attributes }}
>

  <div class="divider-line">&nbsp;</div>

</div>



{% stylesheet %}

.divider-block {

  width: 100%;

  padding-top: var(--pt);
  padding-bottom: var(--pb);

}


/* line */

.divider-line {

  width: var(--w);

  border-top: var(--bw) solid var(--bc);

}


/* align */

.align--left .divider-line {

  margin-right: auto;

}

.align--center .divider-line {

  margin-left: auto;
  margin-right: auto;

}

.align--right .divider-line {

  margin-left: auto;

}



/* mobile */

@media (max-width:749px){

  .divider-block {

    padding-top: var(--ptm);
    padding-bottom: var(--pbm);

  }

}


/* hide */

@media (min-width:750px){
  .hide-desktop{ display:none !important; }
}

@media (max-width:749px){
  .hide-mobile{ display:none !important; }
}

{% endstylesheet %}



{% schema %}
{
  "name": "Divider",

  "settings": [

    {
      "type": "range",
      "id": "border",
      "label": "Border size",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },

    {
      "type": "color",
      "id": "color",
      "label": "Border color",
      "default": "#000000"
    },


    {
      "type": "range",
      "id": "width",
      "label": "Width %",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100
    },


    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },


    {
      "type": "header",
      "content": "Padding Desktop"
    },

    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 10
    },

    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 10
    },


    {
      "type": "header",
      "content": "Padding Mobile"
    },

    {
      "type": "range",
      "id": "ptm",
      "label": "Top",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 8
    },

    {
      "type": "range",
      "id": "pbm",
      "label": "Bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 8
    },


    {
      "type": "header",
      "content": "Visibility"
    },

    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide desktop"
    },

    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide mobile"
    }

  ],
  "presets": [
    { "name": "Divider" }
  ]
}
{% endschema %}