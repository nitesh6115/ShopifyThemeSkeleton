{% doc %}
  Divider Block
{% enddoc %}

<div class=" divider-block align--{{ block.settings.align }} {% if block.settings.hide_mobile %}hide-mobile{% endif %} {% if block.settings.hide_desktop %}hide-desktop{% endif %}
    {% if block.settings.height == 'custom' %}
    block-custom-height-desktop
    {% else %}
    block-height-desktop-{{ block.settings.height }}
    {% endif %}
    {% if block.settings.width == 'custom' %}
    block-custom-width-desktop
    {% else %}
    block-width-desktop-{{ block.settings.width }}
    {% endif %}
    {% if block.settings.width_tablet == 'custom' %}
    block-custom-width-tablet
    {% else %}
    block-width-tablet-{{ block.settings.width_tablet }}
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    block-custom-width-mobile
    {% else %}
    block-width-mobile-{{ block.settings.width_mobile }}
    {% endif %}
  " style="
    --bw: {{ block.settings.border }}px;
    --bc: {{ block.settings.color }};
    --w: {{ block.settings.width }}%;

    --pt: {{ block.settings.pt }}px;
    --pb: {{ block.settings.pb }}px;
    --ptm: {{ block.settings.ptm }}px;
    --pbm: {{ block.settings.pbm }}px;
    {% if block.settings.height == 'custom' %}
     --block-custom-height-desktop: {{ block.settings.custom_height }}%;
    {% endif %}
    {% if block.settings.width == 'custom' %}
    --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
    {% endif %}
     {% if block.settings.width_tablet == 'custom' %}
    --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
    {% endif %}
    {% if block.settings.width_mobile == 'custom' %}
    --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div class="divider-line">&nbsp;</div>
</div>

{% stylesheet %}
  .divider-block {
    width: 100%;
    padding-top: var(--pt);
    padding-bottom: var(--pb);
  }
  /* line */
  .divider-line {
    width: var(--w);
    border-top: var(--bw) solid var(--bc);
  }
  /* align */
  .align--left .divider-line {
    margin-right: auto;
  }
  .align--center .divider-line {
    margin-left: auto;
    margin-right: auto;
  }
  .align--right .divider-line {
    margin-left: auto;
  }
  /* mobile */
  @media (max-width:767px){
    .divider-block {
      padding-top: var(--ptm);
      padding-bottom: var(--pbm);
    }
  }
  /* hide */
  @media (min-width:768px){
    .hide-desktop{ display:none !important; }
  }
  @media (max-width:767px){
    .hide-mobile{ display:none !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Divider",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "border",
      "label": "Border size",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "color",
      "id": "color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "fit",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom Height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    {
      "type": "header",
      "content": "Padding Desktop"
    },

    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 10
    },

    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 10
    },

    {
      "type": "header",
      "content": "Padding Mobile"
    },

    {
      "type": "range",
      "id": "ptm",
      "label": "Top",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 8
    },

    {
      "type": "range",
      "id": "pbm",
      "label": "Bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 8
    },

    {
      "type": "header",
      "content": "Visibility"
    },

    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide desktop"
    },

    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide mobile"
    }
  ],
  "presets": [{ "name": "Divider" }]
}
{% endschema %}
