{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
-%}
{%- capture style_schema -%}
--desktop-font-size: {{ block.settings.desktop_font_size }}px;
                --mobile-font-size: {{ block.settings.mobile_font_size }}px;
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-desktop-text-alignment: {{ block.settings.desktop_text_align }};
                --block-mobile-text-alignment: {{ block.settings.mobile_text_align }};
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;

                --price-color: {{ block.settings.price_color }};
                --price-compare_at: {{ block.settings.compare_price_color }};

                --price-desktop-font-size: {{ block.settings.price_font_size }}px;
                --price-mobile-font-size: {{ block.settings.mobile_price_font_size }}px;

                --price-compare-at-desktop-font-size: {{ block.settings.compare_at_price_font_size }}px;
                --price-compare-at-mobile-font-size: {{ block.settings.mobile_compare_at_price_font_size }}px;

                --save-color: {{ block.settings.save_color }};
                --save-bg: {{ block.settings.save_color_bg }};
                --save-radius: {{ block.settings.save_radius }}px;
                {% if block.settings.width == 'custom' %}
                --block-custom-width-desktop: {% if block.settings.custom_width_unit_desktop == 'px' %}{{ block.settings.custom_width_pixel }}px{% else %}{{ block.settings.custom_width }}%{% endif %};
                {% endif %}
                {% if block.settings.width_tablet == 'custom' %}
                --block-custom-width-tablet: {% if block.settings.custom_width_unit_tablet == 'px' %}{{ block.settings.custom_width_tablet_pixel }}px{% else %}{{ block.settings.custom_width_tablet }}%{% endif %};
                {% endif %}
                {% if block.settings.width_mobile == 'custom' %}
                --block-custom-width-mobile: {% if block.settings.custom_width_unit_mobile == 'px' %}{{ block.settings.custom_width_pixel_mobile }}px{% else %}{{ block.settings.custom_width_mobile }}%{% endif %};
                {% endif %}
{% endcapture %}
{% assign style_schema = style_schema | strip_newlines %}
<div class="product_block product__title" {{ block.shopify_attributes }} style="{{- style_schema -}}">
  <div class="product-price">
    {% assign current_variant = product.selected_or_first_available_variant %}
    <span class="price regular_price">
      {{ current_variant.price | money }}
    </span>
    <span class="sale_price">
      {{ current_variant.compare_at_price | money }}
    </span>
    {% assign discount = current_variant.compare_at_price | minus: current_variant.price %}
    {% assign discount_percentage = discount | times: 100 | divided_by: current_variant.compare_at_price %}
    <span class="save"> {{ discount_percentage }}% OFF </span>
  </div>
</div>
{% schema %}
{
  "tag": null,
  "name": "Price",
  "settings": [
    {
      "type": "header",
      "content": "Block Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "max": 100,
      "min": 0,
      "default": 5,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "max": 100,
      "min": 0,
      "default": 5,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_radius",
      "label": "Block Radius",
      "max": 100,
      "min": 0,
      "default": 0,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "desktop_text_align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Desktop Text Alignment"
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Mobile Text Alignment"
    },
    {
      "type": "header",
      "content": "Block Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width Desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_desktop",
      "label": "Choose Unit Width Dektop",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel",
      "default": 48,
      "label": "Custom Width Desktop In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_desktop == 'px' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom Width Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_desktop == '%' and  block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_tablet",
      "label": "Width Tablet",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_tablet",
      "label": "Choose Unit Width Tablet",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_tablet_pixel",
      "default": 48,
      "label": "Custom Width Tablet In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_tablet == 'px' and block.settings.width_tablet == 'custom'}}"
    },
    {
      "type": "range",
      "id": "custom_width_tablet",
      "label": "Custom Width Tablet",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_tablet == '%' and block.settings.width_tablet == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width Mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "custom_width_unit_mobile",
      "label": "Choose Unit Width Mobile",
      "options": [
        {
          "label": "Precent",
          "value": "%"
        },
        {
          "label": "Pixcel",
          "value": "px"
        }
      ],
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "number",
      "id": "custom_width_pixel_mobile",
      "default": 48,
      "label": "Custom Width Mobile In Pixel",
      "visible_if": "{{ block.settings.custom_width_unit_mobile == 'px' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Custom Width Mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.custom_width_unit_mobile == '%' and block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Block Background"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price Color",
      "default": "#000"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare at price Color",
      "default": "#A1A1A1"
    },
    {
      "type": "color",
      "id": "save_color",
      "label": "Save Color",
      "default": "#016630"
    },
    {
      "type": "color",
      "id": "save_color_bg",
      "label": "Save Background Color",
      "default": "#DCFCE7"
    },
    {
      "type": "range",
      "id": "save_radius",
      "label": "Save Radius",
      "default": 4,
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Price Font Size Desktop",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_price_font_size",
      "label": "Price Font Size Mobile",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Compare-at price"
    },
    {
      "type": "range",
      "id": "compare_at_price_font_size",
      "label": "Compare-at Price Font Size Desktop",
      "default": 20,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_compare_at_price_font_size",
      "label": "Compare-at Price Font Size Mobile",
      "default": 15,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [{ "name": "Product Price" }]
}
{% endschema %}
