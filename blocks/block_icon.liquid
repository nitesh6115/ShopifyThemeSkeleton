{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
{%- capture style_schema -%}
  --icon-size: {{ block.settings.size }}px;
  --icon-color: {{ block.settings.color }};
{%- endcapture -%}

{% assign style_schema = style_schema | strip_newlines %}

<div id="icon-{{ block.id }}" class="icon-block block-width-desktop-fit-content" style="{{ style_schema }}" {{ block.shopify_attributes }}>
  <div class="icon-inner">
    {% if block.settings.svg_code != blank %}
      <div class="svg_code">{{ block.settings.svg_code }}</div>
    {% elsif block.settings.icon_image != blank %}
      {%- capture img_alt -%}{%- if block.settings.icon_image.alt != blank -%}{{ block.settings.icon_image.alt }}{% else %}{{ shop.name }}{% endif %}{%- endcapture -%}
    {{ block.settings.icon_image | image_url: width: 1600
            | image_tag:
            loading: 'lazy',
            fetch_priority: fetch_priority,
            widths: '360, 540, 720, 900, 1080, 1320, 1600',
            sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
            alt: img_alt
        }}
    {% else %}
      {% case block.settings.icon %}
        {% when 'star' %}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                <g clip-path="url(#clip0_13_2783)">
                <path d="M6.72283 1.33877C6.74839 1.28712 6.78788 1.24365 6.83684 1.21325C6.8858 1.18285 6.94228 1.16675 6.99991 1.16675C7.05754 1.16675 7.11402 1.18285 7.16298 1.21325C7.21194 1.24365 7.25143 1.28712 7.27699 1.33877L8.62449 4.06819C8.71326 4.24783 8.8443 4.40326 9.00636 4.52112C9.16842 4.63898 9.35665 4.71575 9.55491 4.74485L12.5684 5.18585C12.6255 5.19413 12.6792 5.21821 12.7233 5.25539C12.7674 5.29256 12.8002 5.34134 12.8181 5.39621C12.8359 5.45107 12.8381 5.50984 12.8243 5.56586C12.8104 5.62187 12.7812 5.67291 12.7399 5.71319L10.5606 7.83535C10.4169 7.97541 10.3093 8.1483 10.2472 8.33914C10.1851 8.52997 10.1704 8.73304 10.2042 8.93085L10.7187 11.9292C10.7287 11.9863 10.7226 12.045 10.7009 12.0988C10.6792 12.1525 10.6428 12.199 10.5959 12.2331C10.549 12.2672 10.4935 12.2874 10.4357 12.2914C10.3778 12.2954 10.3201 12.2831 10.2689 12.2559L7.57508 10.8395C7.39758 10.7463 7.2001 10.6976 6.99962 10.6976C6.79914 10.6976 6.60166 10.7463 6.42416 10.8395L3.73091 12.2559C3.67977 12.2829 3.62206 12.2951 3.56434 12.291C3.50662 12.2869 3.45121 12.2667 3.40442 12.2326C3.35762 12.1986 3.32131 12.1521 3.29963 12.0985C3.27794 12.0448 3.27174 11.9862 3.28174 11.9292L3.79566 8.93144C3.82961 8.73353 3.8149 8.53033 3.75281 8.33938C3.69071 8.14842 3.5831 7.97544 3.43924 7.83535L1.25991 5.71377C1.21826 5.67354 1.18874 5.62242 1.17472 5.56623C1.1607 5.51004 1.16275 5.45105 1.18062 5.39596C1.1985 5.34088 1.23148 5.29193 1.27582 5.25468C1.32016 5.21743 1.37407 5.19338 1.43141 5.18527L4.44433 4.74485C4.64281 4.71598 4.8313 4.6393 4.99358 4.52143C5.15586 4.40355 5.28707 4.24801 5.37591 4.06819L6.72283 1.33877Z" fill="currentColor" stroke="currentColor" stroke-width="1.16667" stroke-linecap="round" stroke-linejoin="round"/>
                </g>
                <defs>
                </defs>
            </svg>
        {% when 'heart' %}
          <svg viewBox="0 0 24 24">
            <path d="M12 21s-6-4.35-9-8a5.5 5.5 0 0110-3 5.5 5.5 0 0110 3c-3 3.65-9 8-9 8z"/>
          </svg>
        {% when 'check' %}
          <svg viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"/>
          </svg>
        {% when 'arrow' %}
          <svg viewBox="0 0 24 24">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
      {% endcase %}
    {% endif %}
  </div>
</div>
{% stylesheet %}
.svg_code , svg{
    width: 100%;
    height: auto;
}
  .icon-inner {
    color: var(--icon-color);
    width: var(--icon-size);
}
{% endstylesheet %}
{% schema %}
{
  "name": "Icon",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "default": "star",
      "options": [
        { "value": "star", "label": "Star" },
        { "value": "heart", "label": "Heart" },
        { "value": "check", "label": "Check" },
        { "value": "arrow", "label": "Arrow" }
      ]
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon image"
    },
    {
      "type": "textarea",
      "id": "svg_code",
      "label": "SVG code"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 48
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#000000"
    }
  ],

  "presets": [
    {
      "name": "Icon"
    }
  ]

}
{% endschema %}