  </div>
</div>
{% stylesheet %}
.svg_code , svg{
    width: 100%;
    height: auto;
}
  .icon-inner {
    color: var(--icon-color);
    width: var(--icon-size);
}
{% endstylesheet %}
{% schema %}
{
  "name": "Icon",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "default": "star",
      "options": [
        { "value": "star", "label": "Star" },
        { "value": "heart", "label": "Heart" },
        { "value": "check", "label": "Check" },
        { "value": "arrow", "label": "Arrow" }
      ]
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon image"
    },
    {
      "type": "textarea",
      "id": "svg_code",
      "label": "SVG code"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 48
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#000000"
    }
  ],

  "presets": [
    {
      "name": "Icon"
    }
  ]

}
{% endschema %}