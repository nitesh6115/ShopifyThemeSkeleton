        {% when 'certificate' %}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M10.318 8.59338L11.328 14.2774C11.3393 14.3443 11.3299 14.4131 11.301 14.4746C11.2722 14.536 11.2253 14.5872 11.1666 14.6212C11.1079 14.6553 11.0402 14.6706 10.9725 14.6652C10.9048 14.6597 10.8405 14.6338 10.788 14.5907L8.40129 12.7994C8.28607 12.7133 8.14611 12.6668 8.00229 12.6668C7.85847 12.6668 7.71851 12.7133 7.60329 12.7994L5.21262 14.5901C5.16017 14.633 5.09586 14.6589 5.02829 14.6644C4.96071 14.6699 4.89307 14.6546 4.8344 14.6206C4.77573 14.5867 4.72881 14.5356 4.6999 14.4743C4.671 14.4129 4.66148 14.3443 4.67262 14.2774L5.68196 8.59338" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M8 9.33337C10.2091 9.33337 12 7.54251 12 5.33337C12 3.12424 10.2091 1.33337 8 1.33337C5.79086 1.33337 4 3.12424 4 5.33337C4 7.54251 5.79086 9.33337 8 9.33337Z" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {% when 'cart' %}
        <svg  width="16" height="16" viewBox="0 0 16 16" fill="none">
        <g clip-path="url(#clip0_13_2342)">
