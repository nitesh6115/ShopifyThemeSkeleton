{% doc %}
  @prompt
    Create a new product page template inspired by the Alphalete Athletics product page design. The template should include: a large full-width product image gallery on the left with thumbnail navigation, clean and minimal product details on the right side including product title, price, color swatches for variant selection, size selector buttons, an Add to Cart button with a bold prominent style, product description section, and a sticky add-to-cart bar on scroll. The overall aesthetic should be modern, athletic lifestyle-focused with a clean white background, bold typography, and a premium feel similar to a high-end apparel brand product page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-page-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  .ai-product-page__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ai-product-page__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .ai-product-page__gallery-{{ ai_gen_id }} {
    position: sticky;
    top: 20px;
  }

  .ai-product-page__main-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    margin-bottom: 16px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f5f5f5;
  }

  .ai-product-page__main-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-page__thumbnails-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 12px;
  }

  .ai-product-page__thumbnail-{{ ai_gen_id }} {
    aspect-ratio: 3 / 4;
    border-radius: {{ block.settings.thumbnail_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: border-color 0.2s ease;
    background-color: #f5f5f5;
  }

  .ai-product-page__thumbnail-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.accent_color }};
  }

  .ai-product-page__thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-page__details-{{ ai_gen_id }} {
    padding-top: 20px;
  }

  .ai-product-page__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
  }

  .ai-product-page__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 600;
    margin-bottom: 32px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-page__price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 12px;
    font-size: {{ block.settings.price_size | times: 0.85 }}px;
  }

  .ai-product-page__variant-section-{{ ai_gen_id }} {
    margin-bottom: 28px;
  }

  .ai-product-page__variant-label-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-page__color-swatches-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-product-page__color-swatch-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .ai-product-page__color-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-product-page__color-swatch-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.accent_color }};
    box-shadow: 0 0 0 2px {{ block.settings.background_color }}, 0 0 0 4px {{ block.settings.accent_color }};
  }

  .ai-product-page__size-buttons-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
    gap: 10px;
  }

  .ai-product-page__size-button-{{ ai_gen_id }} {
    padding: 14px 20px;
    border: 2px solid {{ block.settings.text_color }};
    background-color: transparent;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: {{ block.settings.button_border_radius }}px;
  }

  .ai-product-page__size-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.text_color }};
    color: {{ block.settings.background_color }};
  }

  .ai-product-page__size-button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.accent_color }};
    border-color: {{ block.settings.accent_color }};
    color: #ffffff;
  }

  .ai-product-page__size-button-{{ ai_gen_id }}.unavailable {
    opacity: 0.3;
    cursor: not-allowed;
    position: relative;
  }

  .ai-product-page__size-button-{{ ai_gen_id }}.unavailable::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 10%;
    right: 10%;
    height: 1px;
    background-color: {{ block.settings.text_color }};
    transform: rotate(-15deg);
  }

  .ai-product-page__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 18px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 32px;
    border-radius: {{ block.settings.button_border_radius }}px;
  }

  .ai-product-page__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .ai-product-page__add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .ai-product-page__description-{{ ai_gen_id }} {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .ai-product-page__description-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-page__description-content-{{ ai_gen_id }} {
    font-size: 15px;
    line-height: 1.7;
    color: {{ block.settings.text_color }};
    opacity: 0.85;
  }

  .ai-product-page__sticky-bar-{{ ai_gen_id }} {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: {{ block.settings.background_color }};
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding: 16px 20px;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    z-index: 1000;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-product-page__sticky-bar-{{ ai_gen_id }}.visible {
    transform: translateY(0);
  }

  .ai-product-page__sticky-content-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .ai-product-page__sticky-info-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .ai-product-page__sticky-image-{{ ai_gen_id }} {
    width: 60px;
    height: 80px;
    border-radius: 4px;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-product-page__sticky-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-page__sticky-details-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-product-page__sticky-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 4px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-page__sticky-price-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-product-page__sticky-button-{{ ai_gen_id }} {
    padding: 14px 40px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: {{ block.settings.button_border_radius }}px;
    white-space: nowrap;
  }

  .ai-product-page__sticky-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-product-page__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-product-page__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-product-page__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-product-page__gallery-{{ ai_gen_id }} {
      position: static;
    }

    .ai-product-page__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-product-page__sticky-content-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-product-page__sticky-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-page__container-{{ ai_gen_id }} {
      padding: 20px 16px;
    }

    .ai-product-page__thumbnails-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
      gap: 8px;
    }

    .ai-product-page__size-buttons-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));
    }
  }
{% endstyle %}

<product-page-{{ ai_gen_id }} class="ai-product-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-page__container-{{ ai_gen_id }}">
    <div class="ai-product-page__grid-{{ ai_gen_id }}">
      <div class="ai-product-page__gallery-{{ ai_gen_id }}">
        <div class="ai-product-page__main-image-{{ ai_gen_id }}" data-main-image>
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt | escape }}"
              width="1200"
              height="1600"
              loading="eager"
            >
          {% else %}
            <div class="ai-product-page__placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="ai-product-page__thumbnails-{{ ai_gen_id }}">
            {% for image in product.images limit: 6 %}
              <div
                class="ai-product-page__thumbnail-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                data-thumbnail
                data-image-url="{{ image | image_url: width: 1200 }}"
              >
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt="{{ image.alt | escape }}"
                  width="200"
                  height="267"
                  loading="lazy"
                >
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="ai-product-page__details-{{ ai_gen_id }}">
        <h1 class="ai-product-page__title-{{ ai_gen_id }}">
          {{ product.title | default: 'Product Title' }}
        </h1>

        <div class="ai-product-page__price-{{ ai_gen_id }}" data-price>
          {% if product.compare_at_price > product.price %}
            <span class="ai-product-page__price-sale-{{ ai_gen_id }}">
              {{ product.price | money }}
            </span>
            <span class="ai-product-page__price-compare-{{ ai_gen_id }}">
              {{ product.compare_at_price | money }}
            </span>
          {% else %}
            {{ product.price | money | default: '$0.00' }}
          {% endif %}
        </div>

        {% if product.has_only_default_variant == false %}
          {% for option in product.options_with_values %}
            <div class="ai-product-page__variant-section-{{ ai_gen_id }}">
              <div class="ai-product-page__variant-label-{{ ai_gen_id }}">
                {{ option.name }}: <span data-selected-{{ option.name | handleize }}>{{ option.selected_value }}</span>
              </div>

              {% if option.name == 'Color' or option.name == 'Colour' %}
                <div class="ai-product-page__color-swatches-{{ ai_gen_id }}">
                  {% for value in option.values %}
                    <button
                      class="ai-product-page__color-swatch-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                      data-color-option
                      data-value="{{ value | escape }}"
                      style="background-color: {{ value | handleize }};"
                      aria-label="{{ value }}"
                    ></button>
                  {% endfor %}
                </div>
              {% else %}
                <div class="ai-product-page__size-buttons-{{ ai_gen_id }}">
                  {% for value in option.values %}
                    <button
                      class="ai-product-page__size-button-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                      data-size-option
                      data-value="{{ value | escape }}"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}

        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
          
          <button
            type="submit"
            class="ai-product-page__add-to-cart-{{ ai_gen_id }}"
            {% unless product.available %}disabled{% endunless %}
          >
            {% if product.available %}
              {{ block.settings.add_to_cart_text }}
            {% else %}
              Sold Out
            {% endif %}
          </button>
        {% endform %}

        {% if product.description != blank %}
          <div class="ai-product-page__description-{{ ai_gen_id }}">
            <div class="ai-product-page__description-title-{{ ai_gen_id }}">
              {{ block.settings.description_title }}
            </div>
            <div class="ai-product-page__description-content-{{ ai_gen_id }}">
              {{ product.description }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% if block.settings.enable_sticky_bar %}
    <div class="ai-product-page__sticky-bar-{{ ai_gen_id }}" data-sticky-bar>
      <div class="ai-product-page__sticky-content-{{ ai_gen_id }}">
        <div class="ai-product-page__sticky-info-{{ ai_gen_id }}">
          <div class="ai-product-page__sticky-image-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 120 }}"
                alt="{{ product.featured_image.alt | escape }}"
                width="60"
                height="80"
                loading="lazy"
              >
            {% else %}
              <div class="ai-product-page__placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-product-page__sticky-details-{{ ai_gen_id }}">
            <div class="ai-product-page__sticky-title-{{ ai_gen_id }}">
              {{ product.title | default: 'Product Title' }}
            </div>
            <div class="ai-product-page__sticky-price-{{ ai_gen_id }}">
              {{ product.price | money | default: '$0.00' }}
            </div>
          </div>
        </div>
        <button
          class="ai-product-page__sticky-button-{{ ai_gen_id }}"
          data-sticky-add-to-cart
          {% unless product.available %}disabled{% endunless %}
        >
          {% if product.available %}
            {{ block.settings.add_to_cart_text }}
          {% else %}
            Sold Out
          {% endif %}
        </button>
      </div>
    </div>
  {% endif %}
</product-page-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductPage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.mainImage = this.querySelector('[data-main-image]');
        this.thumbnails = this.querySelectorAll('[data-thumbnail]');
        this.colorOptions = this.querySelectorAll('[data-color-option]');
        this.sizeOptions = this.querySelectorAll('[data-size-option]');
        this.variantIdInput = this.querySelector('[data-variant-id]');
        this.stickyBar = this.querySelector('[data-sticky-bar]');
        this.stickyAddToCart = this.querySelector('[data-sticky-add-to-cart]');
        this.mainAddToCart = this.querySelector('.ai-product-page__add-to-cart-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupThumbnails();
        this.setupVariantSelection();
        this.setupStickyBar();
      }

      setupThumbnails() {
        this.thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => {
            const imageUrl = thumbnail.dataset.imageUrl;
            const mainImageElement = this.mainImage.querySelector('img');
            
            if (mainImageElement && imageUrl) {
              mainImageElement.src = imageUrl;
            }

            this.thumbnails.forEach((t) => t.classList.remove('active'));
            thumbnail.classList.add('active');
          });
        });
      }

      setupVariantSelection() {
        this.colorOptions.forEach((option) => {
          option.addEventListener('click', () => {
            this.colorOptions.forEach((o) => o.classList.remove('active'));
            option.classList.add('active');
            this.updateSelectedValue('color', option.dataset.value);
          });
        });

        this.sizeOptions.forEach((option) => {
          option.addEventListener('click', () => {
            if (option.classList.contains('unavailable')) {
              return;
            }
            this.sizeOptions.forEach((o) => o.classList.remove('active'));
            option.classList.add('active');
            this.updateSelectedValue('size', option.dataset.value);
          });
        });
      }

      updateSelectedValue(type, value) {
        const selectedElement = this.querySelector('[data-selected-' + type + ']');
        if (selectedElement) {
          selectedElement.textContent = value;
        }
      }

      setupStickyBar() {
        if (!this.stickyBar) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (this.stickyBar) {
                if (entry.isIntersecting) {
                  this.stickyBar.classList.remove('visible');
                } else {
                  this.stickyBar.classList.add('visible');
                }
              }
            });
          },
          { threshold: 0.1 }
        );

        if (this.mainAddToCart) {
          observer.observe(this.mainAddToCart);
        }

        if (this.stickyAddToCart && this.mainAddToCart) {
          this.stickyAddToCart.addEventListener('click', () => {
            this.mainAddToCart.click();
          });
        }
      }
    }

    customElements.define('product-page-{{ ai_gen_id }}', ProductPage{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Athletic product page",
  "tag": null,
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Product title"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Main image radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "thumbnail_border_radius",
      "label": "Thumbnail radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Add to cart button"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Button text",
      "default": "Add to Cart"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Button text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Product description"
    },
    {
      "type": "text",
      "id": "description_title",
      "label": "Description title",
      "default": "Product Details"
    },
    {
      "type": "header",
      "content": "Sticky bar"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_bar",
      "label": "Enable sticky add to cart bar",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Athletic product page"
    }
  ]
}
{% endschema %}
