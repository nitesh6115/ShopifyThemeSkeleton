
<div class="custom-product-gallery" 
     data-product-id="{{ product.id }}"
     data-section-id="{{ section.id }}">

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured_media = current_variant.featured_media %}
{% assign media_position = 0 %}
{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
{%- capture sizes -%}
  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | times: media_width | divided_by: desktop_columns | round }}px, (min-width: 990px) calc({{ media_width | times: 100 | divided_by: desktop_columns }}vw - 10rem), (min-width: 750px) calc((100vw - 11.5rem) / 2), calc(100vw / {{ mobile_columns }} - 4rem)
{%- endcapture -%}
<div class="custom-product-gallery" data-section-id="{{ section.id }}">

  <ul class="gallery-main">
    {% if featured_media %}
      {% assign media_position = media_position | plus: 1 %}
      <li class="gallery-media-item is-active"
          data-media-id="{{ featured_media.id }}">
        
        {% case featured_media.media_type %}
          {% when 'image' %}
            <div class="zoom-container">
            {{ featured_media
            | image_url: width: 1600
            | image_tag:
            loading: 'lazy',
            class: 'zoom-image',
            fetch_priority: fetch_priority,
            widths: '360, 540, 720, 900, 1080, 1320, 1600',
            sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
            alt: featured_media.alt | escape
            }}
            </div>
          {% when 'video' %}
            {{ featured_media | video_tag: controls: true }}

          {% when 'external_video' %}
            {{ featured_media | external_video_tag }}

          {% when 'model' %}
            {{ featured_media | model_viewer_tag }}
        {% endcase %}

      </li>
    {% endif %}

    {% for media in product.media %}

      {% unless featured_media and media.id == featured_media.id %}

        {% assign media_position = media_position | plus: 1 %}
        {% assign is_active = false %}
        {% if featured_media == nil and forloop.first %}
          {% assign is_active = true %}
        {% endif %}

        <li class="gallery-media-item {% if is_active %}is-active{% endif %}"
            data-media-id="{{ media.id }}"
            data-variant-ids="{% if media.variant_ids.size > 0 %}{{ media.variant_ids | join: ',' }}{% endif %}">

          {% case media.media_type %}
            {% when 'image' %}
              <div class="zoom-container">
              {{ media
            | image_url: width: 1600
            | image_tag:
            loading: 'lazy',
            class: 'zoom-image',
            fetch_priority: fetch_priority,
            widths: '360, 540, 720, 900, 1080, 1320, 1600',
            sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
            alt: media.alt | escape
            }}
            </div>
            {% when 'video' %}
              {{ media | video_tag: controls: true }}

            {% when 'external_video' %}
              {{ media | external_video_tag }}

            {% when 'model' %}
              {{ media | model_viewer_tag }}
          {% endcase %}

        </li>

      {% endunless %}

    {% endfor %}

  </ul>

  <div class="prdouctThubs">
  <div class="gallery-thumbs-wrapper">

    <button type="button" class="thumb-nav thumb-prev">‹</button>

    <div class="gallery-thumbs">
      <div class="gallery-thumbs-track">

        {% comment %} Variant Thumb First {% endcomment %}
        {% if featured_media %}
          <button type="button"
                  class="gallery-thumb is-active"
                  data-media-id="{{ featured_media.id }}">
            {{ featured_media
            | image_url: width: section.settings.media-thumb-width
            | image_tag:
            fetch_priority: fetch_priority,
            loading: 'lazy',
            widths: '50, 100, 150, 200, 250, 300',
            sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
            alt: featured_media.alt | escape
            }}
          </button>
        {% endif %}

        {% comment %} Other Thumbs {% endcomment %}
        {% for media in product.media %}
          {% unless featured_media and media.id == featured_media.id %}

            {% assign is_active = false %}
            {% if featured_media == nil and forloop.first %}
              {% assign is_active = true %}
            {% endif %}

            <button type="button"
                    class="gallery-thumb {% if is_active %}is-active{% endif %}"
                    data-media-id="{{ media.id }}">
              {{ media
            | image_url: width: section.settings.media-thumb-width
            | image_tag:
            loading: 'lazy',
            widths: '50, 100, 150, 200, 250, 300',
            sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
            alt: media.alt | escape
            }}
            </button>

          {% endunless %}
        {% endfor %}

      </div>
    </div>

    <button type="button" class="thumb-nav thumb-next">›</button>

  </div>
  </div>
</div>
</div>