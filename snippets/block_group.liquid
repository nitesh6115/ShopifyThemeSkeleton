{%- doc -%}
  Renders block content for all blocks that extend the group block.

  @param {string} children - The DOM content of the group block.
  @param {object} settings - The settings of the group block.
  @param {string} shopify_attributes - String with Shopify attributes for the editor.
  @param {string} [class] - Custom classes for the group block.
  @param {string} [style] - Custom inline styles for the group block.

  @example
  {% render 'group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}
{%- enddoc -%}
<div
  class="group {{ settings.layout_direction }} {% if settings.hide_desktop %}hide-desktop{% endif %}
  {% if settings.hide_mobile %}hide-mobile{% endif %}
 {% if settings.equal_height %}is-equal{% endif %}"
  style="
    --align-x: {{ settings.align_x }};
    --align-y: {{ settings.align_y }};
    --wrap: {{ settings.wrap }};
    --cols: {{ settings.cols }};
    --cols-m: {{ settings.cols_m }};
    --grow: {{ settings.grow }};
    --shrink: {{ settings.shrink }};
    --gap-x: {{ settings.gap_x }}px;
    --gap-y: {{ settings.gap_y }}px;
    --gap-x-m: {{ settings.gap_x_m }}px;
    --gap-y-m: {{ settings.gap_y_m }}px;
    --bg: {{ settings.background }};
    --radius: {{ settings.radius }}px;
    --border: {{ settings.border }}px;
    --border-color: {{ settings.border_color }};
    --width: {{ settings.width_custom }}%;
    --height: {{ settings.height_custom }}px;
    --pt: {{ settings.pt }}px;
    --pb: {{ settings.pb }}px;
    --pl: {{ settings.pl }}px;
    --pr: {{ settings.pr }}px;
    --ptm: {{ settings.ptm }}px;
    --pbm: {{ settings.pbm }}px;
    --plm: {{ settings.plm }}px;
    --prm: {{ settings.prm }}px;

    {% case block.settings.width %}
      {% when 'fit-content' %}
      --item-width:auto;
      {% when 'fill' %}
      --item-width:fill;
      {% when 'custom' %}
      --item-width:{{ block.settings.custom_width }}%;
      {% endcase %}

      {% case block.settings.width_mobile %}
      {% when 'fit-content' %}
      --item-width-m:auto;
      {% when 'fill' %}
      --item-width-m:fill;
      {% when 'custom' %}
      --item-width-m:{{ block.settings.custom_width_mobile }}%;
      {% endcase %}

      {% case block.settings.height %}
      {% when 'fit' %}
      --item-height:auto;
      {% when 'fill' %}
      --item-height:fill;
      {% when 'custom' %}
      --item-height:{{ block.settings.custom_height }}%;
      {% endcase %}
  "
  {{ shopify_attributes }}
>
  {{- children -}}
</div>



{% stylesheet %}
.group {
  display: flex;
  flex-direction: row;
  flex-wrap: var(--wrap);
  justify-content: var(--align-x);
  align-items: var(--align-y);
  gap: var(--gap-y) var(--gap-x);
  background: var(--bg);
  border-radius: var(--radius);
  border: var(--border) solid var(--border-color);
  padding-top: var(--pt);
  padding-bottom: var(--pb);
  padding-left: var(--pl);
  padding-right: var(--pr);
  width: 100%;
}

/* direction */

.group--horizontal {
  flex-direction: row;
  
}

.group--vertical {
  flex-direction: column;
  align-items: var(--align-x);
}

/* equal height */

.is-equal > * {
  align-self: stretch;
}

/* grow shrink */

.group > * {
  flex-grow: var(--grow);
  flex-shrink: var(--shrink);
  text-align: unset;
}

/* ✅ APPLY COLUMNS ONLY WHEN WRAP */
.group--horizontal > * {
  flex-grow: var(--item-grow, var(--grow));
  flex-shrink: var(--item-shrink, var(--shrink));
  flex-basis: var(
    --item-width,
    calc(
      (100% - (var(--cols) - 1) * var(--gap-x))
      / var(--cols)
    )
  );
}
/* mobile */
.group > * {

  flex-basis: var(--item-width);

}

.group > * > * {

 flex-basis: var(--item-width);

}
@media (max-width: 749px) {

  .group {
    gap: var(--gap-y-m) var(--gap-x-m);
    padding-top: var(--ptm);
    padding-bottom: var(--pbm);
    padding-left: var(--plm);
    padding-right: var(--prm);
  }

  .group--horizontal > * {

  flex-basis: var(
    --item-width-m,
    calc(
      (100% - (var(--cols-m) - 1) * var(--gap-x-m))
      / var(--cols-m)
    )
  );

}

}

/* visibility */

.hide-desktop {
  display: none !important;
}

@media (max-width: 749px) {

  .hide-desktop {
    display: flex !important;
  }

  .hide-mobile {
    display: none !important;
  }

}
{% endstylesheet %}


