<div class="purchase-toggle">
  <button type="button" class="purchase-btn active" data-type="onetime">
    One-Time Purchase
  </button>
  <button type="button" class="purchase-btn" data-type="subscription">
    Subscribe & Save 40%
  </button>
</div>
<style>
.purchase-toggle {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.purchase-btn {
  flex: 1;
  padding: 12px;
  border-radius: 30px;
  border: none;
  background: #eee;
  cursor: pointer;
}

.purchase-btn.active {
  background: #c58a4f;
  color: #fff;
}
</style>
<script>
document.addEventListener('sealsubs:subscription_widget_created', function(e) {
  const buttons = document.querySelectorAll(".purchase-btn");

  // Seal elements (UPDATE THESE SELECTORS IF NEEDED)
  const oneTimeOption = document.querySelector(".seal-one-time");
  const subscriptionOptions = document.querySelector(".seal-subscription-options");

  const oneTimeRadio = document.querySelector('input[value="onetime"]');
  const subscriptionRadio = document.querySelector('input[value="subscription"]');

  buttons.forEach(btn => {
    btn.addEventListener("click", () => {

      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      const type = btn.dataset.type;

      if (type === "onetime") {

        // ✅ Show only one-time
        if (oneTimeOption) oneTimeOption.style.display = "block";
        if (subscriptionOptions) subscriptionOptions.style.display = "none";

        // trigger selection
        if (oneTimeRadio) {
          oneTimeRadio.checked = true;
          oneTimeRadio.dispatchEvent(new Event("change", { bubbles: true }));
        }

      } else {

        // ✅ Show only subscription
        if (oneTimeOption) oneTimeOption.style.display = "none";
        if (subscriptionOptions) subscriptionOptions.style.display = "block";

        // trigger selection
        if (subscriptionRadio) {
          subscriptionRadio.checked = true;
          subscriptionRadio.dispatchEvent(new Event("change", { bubbles: true }));
        }
      }
    });
  });
});
</script>