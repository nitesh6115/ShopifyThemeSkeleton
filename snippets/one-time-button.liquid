<div class="purchase-toggle">
  <button type="button" class="purchase-btn active" data-type="onetime">
    One-Time Purchase
  </button>
  <button type="button" class="purchase-btn" data-type="subscription">
    Subscribe & Save 40%
  </button>
</div>
<style>
.purchase-toggle {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    background: #fff;
    padding: 10px;
    border-radius: 50px;
    box-shadow: 0 10px 25px #00000026;
    max-width: 500px;
    margin: 0 auto;
}
.purchase-btn {
  flex: 1;
  padding: 12px;
  border-radius: 30px;
  border: none;
  background: #fff;
  cursor: pointer;
}

.purchase-btn.active {
  background: #c58a4f;
  color: #fff;
}
</style>
<script>
document.addEventListener('sealsubs:subscription_widget_created', function(e) {

  function initPurchaseToggle() {
    const wrapper = document.querySelector(".sls-purchase-options-container");
    if (!wrapper) return setTimeout(initPurchaseToggle, 500);

    const buttons = document.querySelectorAll(".purchase-btn");

    const allOptions = wrapper.querySelectorAll(".sls-option-container");

    const oneTimeContainer = wrapper
      .querySelector('[data-one-time-option-radio]')
      ?.closest('.sls-option-container');

    const subscriptionContainers = [...allOptions].filter(el => el !== oneTimeContainer);

    const oneTimeRadio = wrapper.querySelector('input[data-type="one_time"]');
    const subscriptionRadios = wrapper.querySelectorAll('input[data-type="subscription"]');

    const oneTimeBtn = document.querySelector('.purchase-btn[data-type="onetime"]');
    const subBtn = document.querySelector('.purchase-btn[data-type="subscription"]');

    // ✅ 1. Hide One-time button if not available
    if (!oneTimeContainer && oneTimeBtn) {
      oneTimeBtn.style.display = "none";
    }

    // ✅ Helper functions
    function activateOneTime() {
      buttons.forEach(b => b.classList.remove("active"));
      oneTimeBtn?.classList.add("active");

      if (oneTimeContainer) oneTimeContainer.style.display = "block";
      subscriptionContainers.forEach(el => el.style.display = "none");
    }

    function activateSubscription() {
      buttons.forEach(b => b.classList.remove("active"));
      subBtn?.classList.add("active");

      subscriptionContainers.forEach(el => el.style.display = "block");
      if (oneTimeContainer) oneTimeContainer.style.display = "none";
    }

    // ✅ 2. Detect initial selected state
    const checkedRadio = wrapper.querySelector('input.sls-option:checked');

    if (checkedRadio) {
      const type = checkedRadio.dataset.type;

      if (type === "one_time") {
        activateOneTime();
      } else {
        activateSubscription();
      }
    } else {
      // fallback (default to subscription)
      activateSubscription();
    }

    // ✅ 3. Button click logic
    buttons.forEach(btn => {
      btn.addEventListener("click", () => {

        const type = btn.dataset.type;

        if (type === "onetime") {

          activateOneTime();

          if (oneTimeRadio) {
            oneTimeRadio.checked = true;
            oneTimeRadio.dispatchEvent(new Event("change", { bubbles: true }));
          }

        } else {

          activateSubscription();

          const firstSubscriptionRadio = subscriptionRadios[0];
          if (firstSubscriptionRadio) {
            firstSubscriptionRadio.checked = true;
            firstSubscriptionRadio.dispatchEvent(new Event("change", { bubbles: true }));
          }
        }
      });
    });
  }

  initPurchaseToggle();
});
</script>