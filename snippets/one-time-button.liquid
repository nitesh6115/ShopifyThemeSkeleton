<div class="purchase-toggle">
  <button type="button" class="purchase-btn active" data-type="onetime">
    One-Time Purchase
  </button>
  <button type="button" class="purchase-btn" data-type="subscription">
    Subscribe & Save 40%
  </button>
</div>
<style>
.purchase-toggle {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.purchase-btn {
  flex: 1;
  padding: 12px;
  border-radius: 30px;
  border: none;
  background: #eee;
  cursor: pointer;
}

.purchase-btn.active {
  background: #c58a4f;
  color: #fff;
}
</style>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const buttons = document.querySelectorAll(".purchase-btn");

  // IMPORTANT: adjust selectors based on Seal widget
  const subscriptionWrapper = document.querySelector(".sealsubs-target-element"); 
  const oneTimeRadio = document.querySelector('input[value="onetime"]');
  const subscriptionRadio = document.querySelector('input[value="subscription"]');
  console.log(subscriptionWrapper)
  buttons.forEach(btn => {
    btn.addEventListener("click", () => {

      // toggle active state
      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      const type = btn.dataset.type;

      if (type === "onetime") {
        // hide subscription UI
        if (subscriptionWrapper) {
          subscriptionWrapper.style.display = "none";
        }

        // trigger one-time purchase
        if (oneTimeRadio) {
          oneTimeRadio.checked = true;
          oneTimeRadio.dispatchEvent(new Event("change", { bubbles: true }));
        }

      } else {
        // show subscription UI
        if (subscriptionWrapper) {
          subscriptionWrapper.style.display = "block";
        }

        // trigger subscription
        if (subscriptionRadio) {
          subscriptionRadio.checked = true;
          subscriptionRadio.dispatchEvent(new Event("change", { bubbles: true }));
        }
      }
    });
  });
});
</script>