<div class="bundle-card {% unless product.available %}is-sold-out{% endunless %}"
     data-product-id="{{ product.id }}"
     data-price="{{ product.selected_or_first_available_variant.price }}"
     data-variant-id="{{ product.selected_or_first_available_variant.id }}"
     data-available="{{ product.available }}">

  <span class="bundle-check">✓</span>
  {% if product.tags contains 'popular' %}
    <span class="bundle-badge">Popular</span>
  {% endif %}
  {% if product.tags contains 'Bestseller' %}
    <span class="bundle-badge">Bestseller</span>
  {% endif %}
  <div class="bundle-image" style="
    ratio--{{ block.settings.ratio }};">
    {{ product.featured_image
  | image_url: width: 533
  | image_tag:
    loading: 'lazy',
    widths: '165,360,533,720',
    class: "bundle_product_image",
    sizes: '(min-width:1200px) 25vw,(min-width:750px) 33vw,50vw',
    alt: product.featured_media.alt | escape
}}
  </div>
  <div class="bundle_card_info">
  <h3 class="bundleProductTitle">{{ product.title }}</h3>
  <div class="customTagLine">{{ product.description | strip_html | truncate: 60 }}</div>



  {%- if product.variants.size > 1 -%}
    <div class="bundle-variants">
      {% for option in product.options_with_values %}
        <div class="bundle-option">
          <label>{{ option.name }}</label>
          <select class="bundle-variant-select" data-option-index="{{ forloop.index0 }}">
            {% for value in option.values %}
              <option value="{{ value }}">{{ value }}</option>
            {% endfor %}
          </select>
        </div>
      {% endfor %}
    </div>
  {%- endif -%}
  <div class="price_button_box">
    <p class="bundle-price">
    {{ product.selected_or_first_available_variant.price | money }}
  </p>
  <button class="bundle-select-btn"
          {% unless product.available %}disabled{% endunless %}>
    {% if product.available %}
      {% if section.settings.icon_only %}
        <span class="clickToAdd">+</span>
      {% else %}
      <span class="clickToAdd">{{ section.settings.btn_lable }}</span>
      {% endif %}
    {% else %}
      <span>Sold Out</span>
    {% endif %}
{% if section.settings.icon_only %}
        <span class="selected_text">✓</span>
      {% else %}
    <span class="selected_text">{{ section.settings.selected_btn_lable }}</span>
      {% endif %}
  </button>
  </div>
 </div>
 <script type="application/json" class="bundle-variants-json">
  {{ product.variants | json }}
</script>
</div>

