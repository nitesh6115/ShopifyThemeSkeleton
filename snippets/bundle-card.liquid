<div class="bundle-card {% unless product.available %}is-sold-out{% endunless %}"
     data-product-id="{{ product.id }}"
     data-price="{{ product.selected_or_first_available_variant.price }}"
     data-variant-id="{{ product.selected_or_first_available_variant.id }}"
     data-available="{{ product.available }}">

  <span class="bundle-check">✓</span>
  {% if product.tags contains 'popular' %}
    <span class="bundle-badge">Popular</span>
  {% endif %}
  {% if product.tags contains 'Bestseller' %}
    <span class="bundle-badge">Bestseller</span>
  {% endif %}
  <div class="bundle-image">
    <img
    srcset="
      {%- if product.featured_media.width >= 165 -%}{{ product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
      {%- if product.featured_media.width >= 360 -%}{{ product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
      {%- if product.featured_media.width >= 533 -%}{{ product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
      {%- if product.featured_media.width >= 720 -%}{{ product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
      {%- if product.featured_media.width >= 940 -%}{{ product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
      {%- if product.featured_media.width >= 1066 -%}{{ product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
      {{ product.featured_media | image_url }} {{ product.featured_media.width }}w
    "
    src="{{ product.featured_media | image_url: width: 533 }}"
    sizes="(min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
    alt="{{ product.featured_media.alt | escape }}"
    class="bundle_product_image"
    {% unless lazy_load == false %}
      loading="lazy"
    {% endunless %}
    width="{{ product.featured_media.width }}"
    height="{{ product.featured_media.height }}"
    >
  </div>
  <div class="bundle_card_info">
  <h3 class="bundleProductTitle">{{ product.title }}</h3>
  <div class="customTagLine">{{ product.description | strip_html | truncate: 60 }}</div>



  {%- if product.variants.size > 1 -%}
    <div class="bundle-variants">
      {% for option in product.options_with_values %}
        <div class="bundle-option">
          <label>{{ option.name }}</label>
          <select class="bundle-variant-select" data-option-index="{{ forloop.index0 }}">
            {% for value in option.values %}
              <option value="{{ value }}">{{ value }}</option>
            {% endfor %}
          </select>
        </div>
      {% endfor %}
    </div>
  {%- endif -%}
  <div class="price_button_box">
    <p class="bundle-price">
    {{ product.selected_or_first_available_variant.price | money }}
  </p>
  <button class="bundle-select-btn"
          {% unless product.available %}disabled{% endunless %}>
    {% if product.available %}
      {% if section.settings.icon_only %}
        <span class="clickToAdd">+</span>
      {% else %}
      <span class="clickToAdd">{{ section.settings.btn_lable }}</span>
      {% endif %}
    {% else %}
      <span>Sold Out</span>
    {% endif %}
{% if section.settings.icon_only %}
        <span class="selected_text">✓</span>
      {% else %}
    <span class="selected_text">{{ section.settings.selected_btn_lable }}</span>
      {% endif %}
  </button>
  </div>
 </div>
 <script type="application/json" class="bundle-variants-json">
  {{ product.variants | json }}
</script>
</div>

