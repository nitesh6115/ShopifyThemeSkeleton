{% comment %}
  Snippet: nfe-product-cards
  Renders product cards for the New Fit Energy section.
  Usage: {% render 'nfe-product-cards', collection: collection, limit: 8 %}
{% endcomment %}

{% for product in collection.products limit: limit %}
  <div class="nfe-card">
    <a href="{{ product.url }}" class="nfe-image-link">
      {% if product.featured_media %}
        <img
          src="{{ product.featured_media | image_url: width: 800 }}"
          alt="{{ product.featured_media.alt | escape }}"
          loading="lazy"
          class="nfe-image"
          width="{{ product.featured_media.width }}"
          height="{{ product.featured_media.height }}"
        >
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'nfe-image placeholder' }}
      {% endif %}

      {% assign days_since = 'now' | date: '%s' | minus: product.created_at | date: '%s' | divided_by: 86400 %}
      {% if days_since <= 30 or product.tags contains 'New' %}
        <span class="nfe-badge">New</span>
      {% endif %}
    </a>

    <button class="nfe-wishlist" aria-label="Add to wishlist">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 21s-7-4.35-9.33-8.86C1.4 9.42 2.86 6 6.2 6c1.94 0 3.5 1.04 4.3 2.6.4.78.6 1.17 1.5 1.17.9 0 1.1-.39 1.5-1.17C14.3 7.04 15.86 6 17.8 6c3.34 0 4.8 3.42 3.53 6.14C19 16.65 12 21 12 21z"/>
      </svg>
    </button>

    {% if product.variants.size > 1 %}
      <div class="nfe-swatches">
        {% comment %} Try to find the option named "Color" / "Colour"; default to option1 {% endcomment %}
        {% assign color_option_index = 0 %}
        {% for option in product.options_with_values %}
          {% assign opt_name_down = option.name | downcase %}
          {% if opt_name_down == 'color' or opt_name_down == 'colour' %}
            {% assign color_option_index = forloop.index0 %}
          {% endif %}
        {% endfor %}

        {% assign seen_values = '' %}
        {% for variant in product.variants limit: 8 %}
          {% case color_option_index %}
            {% when 0 %}
              {% assign color_value = variant.option1 %}
            {% when 1 %}
              {% assign color_value = variant.option2 %}
            {% when 2 %}
              {% assign color_value = variant.option3 %}
            {% else %}
              {% assign color_value = variant.option1 %}
          {% endcase %}

          {% comment %} Skip duplicate swatches for the same color value {% endcomment %}
          {% assign value_key = color_value | handle %}
          {% unless seen_values contains value_key %}
            {% assign seen_values = seen_values | append: value_key | append: ',' %}

            {% if variant.featured_media %}
              <span
                class="nfe-swatch"
                style="background-image: url('{{ variant.featured_media | image_url: width: 40 }}');"
                title="{{ color_value | escape }}"
              ></span>
            {% else %}
              {% comment %}
                Fallback: use the option value as a CSS color.
                Works for standard color names (e.g. "Black", "Pink", "Navy").
                For custom/brand color names that aren't valid CSS colors,
                this will render as transparent — consider adding a
                color swatch image to that variant, or extend this with
                a metafield-based color map.
              {% endcomment %}
              <span
                class="nfe-swatch"
                style="background-color: {{ color_value | handle | replace: '-', '' }};"
                title="{{ color_value | escape }}"
              ></span>
            {% endif %}
          {% endunless %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="nfe-info">
      <h3 class="nfe-product-title">
        <a href="{{ product.url }}">{{ product.title | upcase }}</a>
      </h3>
      {% if product.metafields.custom.subtitle != blank %}
        <p class="nfe-subtitle">{{ product.metafields.custom.subtitle }}</p>
      {% else %}
        <p class="nfe-subtitle">{{ product.type }}</p>
      {% endif %}
      {% if product.selected_or_first_available_variant.option1 != 'Default Title' %}
        <p class="nfe-variant">{{ product.selected_or_first_available_variant.option1 }}</p>
      {% endif %}
      <p class="nfe-price">
        {{ product.price | money }}
        {% if product.compare_at_price > product.price %}
          <span class="nfe-compare-price">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </p>
    </div>
  </div>
{% else %}
  <p class="nfe-empty">Select a collection with products to display this section.</p>
{% endfor %}
