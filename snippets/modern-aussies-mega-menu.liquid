<div class="ma-mega">

  <div class="ma-mega-inner">

    <div class="ma-mega-panel">

      {%- case block.settings.layout -%}

        {%- when 'columns_featured' -%}

          <div class="ma-mega-content">

            <div class="ma-layout-columns">

              {%- for menu_number in (1..3) -%}

                {%- capture menu_key -%}
                  column_{{ menu_number }}_menu
                {%- endcapture -%}

                {%- capture title_key -%}
                  column_{{ menu_number }}_title
                {%- endcapture -%}

                {%- assign selected_menu = block.settings[menu_key] -%}
                {%- assign column_title = block.settings[title_key] -%}

                {%- if selected_menu != blank -%}

                  <div class="ma-menu-column">

                    {%- if column_title != blank -%}
                      <a
                        class="ma-column-heading"
                        href="{{ selected_menu.links.first.url | default: '#' }}"
                      >
                        {{ column_title }}
                      </a>
                    {%- endif -%}

                    <ul class="ma-link-list" role="list">

                      {%- for child_link in selected_menu.links -%}

                        <li>
                          <a href="{{ child_link.url }}">
                            {{ child_link.title }}
                          </a>
                        </li>

                      {%- endfor -%}

                    </ul>

                  </div>

                {%- endif -%}

              {%- endfor -%}

              {%- if block.settings.featured_image != blank -%}

                <a
                  href="{{ block.settings.cta_link | default: link.url }}"
                  class="ma-feature-card"
                >

                  {{
                    block.settings.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '400,600,750,900',
                      sizes: '(min-width: 900px) 30vw, 100vw',
                      alt: block.settings.featured_title | escape
                  }}

                  <div class="ma-feature-overlay">

                    {%- if block.settings.featured_badge != blank -%}
                      <span class="ma-badge">
                        {{ block.settings.featured_badge }}
                      </span>
                    {%- endif -%}

                    {%- if block.settings.featured_title != blank -%}
                      <h3 class="ma-feature-title">
                        {{ block.settings.featured_title }}
                      </h3>
                    {%- endif -%}

                    {%- if block.settings.featured_description != blank -%}
                      <div class="ma-feature-description">
                        {{ block.settings.featured_description }}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.cta_text != blank -%}
                      <span class="ma-cta">
                        {{ block.settings.cta_text }}
                      </span>
                    {%- endif -%}

                  </div>

                </a>

              {%- endif -%}

            </div>

          </div>


        {%- when 'side_image' -%}

          <div class="ma-mega-content">

            <div class="ma-layout-side">

              {%- if block.settings.side_image != blank -%}

                <div class="ma-side-image">

                  {{
                    block.settings.side_image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '250,400,500,600',
                      sizes: '220px',
                      alt: block.settings.featured_title | escape
                  }}

                </div>

              {%- endif -%}

              <div class="ma-side-content">

                {%- for menu_number in (1..2) -%}

                  {%- capture menu_key -%}
                    column_{{ menu_number }}_menu
                  {%- endcapture -%}

                  {%- capture title_key -%}
                    column_{{ menu_number }}_title
                  {%- endcapture -%}

                  {%- assign selected_menu = block.settings[menu_key] -%}
                  {%- assign column_title = block.settings[title_key] -%}

                  {%- if selected_menu != blank -%}

                    <div>

                      {%- if column_title != blank -%}
                        <a
                          class="ma-column-heading"
                          href="{{ selected_menu.links.first.url | default: '#' }}"
                        >
                          {{ column_title }}
                        </a>
                      {%- endif -%}

                      <ul class="ma-link-list" role="list">

                        {%- for child_link in selected_menu.links -%}
                          <li>
                            <a href="{{ child_link.url }}">
                              {{ child_link.title }}
                            </a>
                          </li>
                        {%- endfor -%}

                      </ul>

                    </div>

                  {%- endif -%}

                {%- endfor -%}

              </div>

              <div>

                <h3 class="ma-products-heading">
                  {{ block.settings.featured_title | default: 'Featured products' }}
                </h3>

                <div class="ma-product-grid">

                  {%- for product_number in (1..4) -%}

                    {%- capture product_key -%}
                      product_{{ product_number }}
                    {%- endcapture -%}

                    {%- assign selected_product = block.settings[product_key] -%}

                    {%- if selected_product != blank -%}

                      {% render 'modern-aussies-product-card',
                        product: selected_product,
                        section: section
                      %}

                    {%- endif -%}

                  {%- endfor -%}

                </div>

              </div>

            </div>

          </div>


        {%- when 'hero_feature' -%}

          <div class="ma-layout-hero">

            {%- if block.settings.featured_image != blank -%}

              <div class="ma-hero-image">

                {{
                  block.settings.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '600,800,1000,1200',
                    sizes: '(min-width: 900px) 55vw, 100vw',
                    alt: block.settings.featured_title | escape
                }}

              </div>

            {%- endif -%}

            <div class="ma-hero-copy">

              {%- if block.settings.featured_badge != blank -%}
                <span class="ma-badge">
                  {{ block.settings.featured_badge }}
                </span>
              {%- endif -%}

              {%- if block.settings.featured_title != blank -%}
                <h2 class="ma-feature-title">
                  {{ block.settings.featured_title }}
                </h2>
              {%- endif -%}

              {%- if block.settings.featured_description != blank -%}
                <div class="ma-feature-description">
                  {{ block.settings.featured_description }}
                </div>
              {%- endif -%}

              {%- if block.settings.cta_text != blank and block.settings.cta_link != blank -%}

                <a
                  href="{{ block.settings.cta_link }}"
                  class="ma-cta"
                >
                  {{ block.settings.cta_text }}
                </a>

              {%- endif -%}

            </div>

          </div>


        {%- when 'links_only' -%}

          <div class="ma-mega-content">

            <div class="ma-layout-links">

              {%- for menu_number in (1..4) -%}

                {%- capture menu_key -%}
                  column_{{ menu_number }}_menu
                {%- endcapture -%}

                {%- capture title_key -%}
                  column_{{ menu_number }}_title
                {%- endcapture -%}

                {%- assign selected_menu = block.settings[menu_key] -%}
                {%- assign column_title = block.settings[title_key] -%}

                {%- if selected_menu != blank -%}

                  <div>

                    {%- if column_title != blank -%}
                      <a
                        class="ma-column-heading"
                        href="{{ selected_menu.links.first.url | default: '#' }}"
                      >
                        {{ column_title }}
                      </a>
                    {%- endif -%}

                    <ul class="ma-link-list" role="list">

                      {%- for child_link in selected_menu.links -%}
                        <li>
                          <a href="{{ child_link.url }}">
                            {{ child_link.title }}
                          </a>
                        </li>
                      {%- endfor -%}

                    </ul>

                  </div>

                {%- endif -%}

              {%- endfor -%}

            </div>

          </div>


        {%- when 'products_focus' -%}

          <div class="ma-mega-content">

            <div class="ma-layout-products">

              <div>

                {%- if block.settings.featured_badge != blank -%}
                  <span class="ma-badge">
                    {{ block.settings.featured_badge }}
                  </span>
                {%- endif -%}

                {%- if block.settings.featured_title != blank -%}
                  <h3 class="ma-mega-heading">
                    {{ block.settings.featured_title }}
                  </h3>
                {%- endif -%}

                {%- if block.settings.featured_description != blank -%}
                  <div class="ma-feature-description">
                    {{ block.settings.featured_description }}
                  </div>
                {%- endif -%}

                {%- if block.settings.column_1_menu != blank -%}

                  <ul class="ma-link-list" role="list">

                    {%- for child_link in block.settings.column_1_menu.links -%}

                      <li>
                        <a href="{{ child_link.url }}">
                          {{ child_link.title }}
                        </a>
                      </li>

                    {%- endfor -%}

                  </ul>

                {%- endif -%}

                {%- if block.settings.cta_text != blank and block.settings.cta_link != blank -%}

                  <div style="margin-top:18px;">

                    <a
                      href="{{ block.settings.cta_link }}"
                      class="ma-cta"
                    >
                      {{ block.settings.cta_text }}
                    </a>

                  </div>

                {%- endif -%}

              </div>

              <div>

                <h3 class="ma-products-heading">
                  Featured products
                </h3>

                <div class="ma-product-grid">

                  {%- for product_number in (1..6) -%}

                    {%- capture product_key -%}
                      product_{{ product_number }}
                    {%- endcapture -%}

                    {%- assign selected_product = block.settings[product_key] -%}

                    {%- if selected_product != blank -%}

                      {% render 'modern-aussies-product-card',
                        product: selected_product,
                        section: section
                      %}

                    {%- endif -%}

                  {%- endfor -%}

                </div>

              </div>

            </div>

          </div>

      {%- endcase -%}

    </div>

  </div>

</div>