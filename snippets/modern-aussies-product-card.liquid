{%- if product != blank -%}

  <a
    href="{{ product.url }}"
    class="ma-product-card"
    aria-label="{{ product.title | escape }}"
  >

    <div class="ma-product-image">

      {%- if product.compare_at_price > product.price -%}
        <span class="ma-product-badge">
          Sale
        </span>
      {%- endif -%}

      {%- if product.featured_image != blank -%}

        {{
          product.featured_image
          | image_url: width: 600
          | image_tag:
            loading: 'lazy',
            widths: '180,250,350,450,600',
            sizes: '(min-width: 900px) 240px, 50vw',
            alt: product.featured_image.alt | default: product.title
        }}

      {%- else -%}

        {{ 'product-1' | placeholder_svg_tag }}

      {%- endif -%}

    </div>

    <div class="ma-product-info">

      {%- if product.metafields.reviews.rating.value != blank -%}

        <div
          class="ma-product-rating"
          aria-label="{{ product.metafields.reviews.rating.value }} out of 5 stars"
        >
          ★★★★★
        </div>

      {%- endif -%}

      <h3 class="ma-product-title">
        {{ product.title }}
      </h3>

      <div class="ma-product-price">

        <span class="ma-current-price">
          {{ product.price | money }}
        </span>

        {%- if product.compare_at_price > product.price -%}
          <span class="ma-compare-price">
            {{ product.compare_at_price | money }}
          </span>
        {%- endif -%}

      </div>

    </div>

  </a>

{%- endif -%}