{% liquid
  assign featured_image = product.featured_image
  assign second_image = product.images[1]
%}

<div class="product-card__media">

  <a href="{{ product.url }}" class="product-card__link">

    {% if featured_image %}

      <img
        src="{{ featured_image | image_url: width: 600 }}"
        srcset="
          {{ featured_image | image_url: width: 165 }} 165w,
          {{ featured_image | image_url: width: 360 }} 360w,
          {{ featured_image | image_url: width: 533 }} 533w,
          {{ featured_image | image_url: width: 720 }} 720w,
          {{ featured_image | image_url: width: 940 }} 940w,
          {{ featured_image | image_url: width: 1066 }} 1066w
        "

        sizes="(min-width: 1200px) calc(100vw / {{ section.settings.products_per_row_desktop }}),
               (min-width: 750px) calc(100vw / {{ section.settings.products_per_row_desktop }}),
               calc(100vw / {{ section.settings.products_per_row_mobile }})"

        alt="{{ featured_image.alt | escape }}"
        loading="lazy"

        width="{{ featured_image.width }}"
        height="{{ featured_image.height }}"

        class="product-card__image primary-image"
      >

    {% endif %}


    {% if show_secondary_image and second_image %}

      <img
        src="{{ second_image | image_url: width: 600 }}"
        srcset="
          {{ second_image | image_url: width: 165 }} 165w,
          {{ second_image | image_url: width: 360 }} 360w,
          {{ second_image | image_url: width: 533 }} 533w,
          {{ second_image | image_url: width: 720 }} 720w,
          {{ second_image | image_url: width: 940 }} 940w
        "

        sizes="(min-width: 1200px) calc(100vw / {{ section.settings.products_per_row_desktop }}),
               (min-width: 750px) calc(100vw / {{ section.settings.products_per_row_desktop }}),
               calc(100vw / {{ section.settings.products_per_row_mobile }})"

        alt="{{ second_image.alt | escape }}"
        loading="lazy"

        width="{{ second_image.width }}"
        height="{{ second_image.height }}"

        class="product-card__image hover-image"
      >

    {% endif %}

  </a>

</div>