<script>
  
  window.theme = window.theme || {};
  window.theme.moneyFormat = {{ shop.money_format | json }};
</script>
{% javascript %}
  

/* ---- SAFE MONEY FORMATTER ---- */
if (typeof window.Shopify === "undefined") {
  window.Shopify = {};
}

if (typeof window.Shopify === "undefined") {
  window.Shopify = {};
}

Shopify.formatMoney = function (cents, format) {

  if (typeof cents === "string") {
    cents = cents.replace(".", "");
  }

  if (isNaN(cents) || cents === null) return "0";

  const formatString =
    format ||
    window.theme?.moneyFormat ||
    window.Shopify.money_format    // hard fallback

  const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;

  function formatWithDelimiters(number, precision = 2, thousands = ",", decimal = ".") {
    number = (number / 100.0).toFixed(precision);
    const parts = number.split(".");
    parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands);
    return parts.join(decimal);
  }

  return formatString.replace(placeholderRegex, function (_, token) {

    switch (token) {
      case "amount":
        return formatWithDelimiters(cents, 2);
      case "amount_no_decimals":
        return formatWithDelimiters(cents, 0);
      case "amount_with_comma_separator":
        return formatWithDelimiters(cents, 2, ".", ",");
      case "amount_no_decimals_with_comma_separator":
        return formatWithDelimiters(cents, 0, ".", ",");
      default:
        return formatWithDelimiters(cents, 2);
    }

  });

};

  document.addEventListener('DOMContentLoaded', function () {

  const section = document.querySelector('.bundle-builder');
  if (!section) return;

  const cards = section.querySelectorAll('.bundle-card');
  const subtotalEl = section.querySelector('[data-bundle-subtotal]');
  const savingsEl = section.querySelector('[data-bundle-savings]');
  const totalEl = section.querySelector('[data-bundle-total]');
  const addBtn = section.querySelector('.bundle-add-to-cart');
  const tierPills = section.querySelectorAll('.tier-pill');
  const dotsTire = section.querySelectorAll('.dots-tire');
  const messageEl = section.querySelector('[data-bundle-message]');
  const totalItems = section.querySelector('[data-total-item]')
  const totalSelected = section.querySelector('[selected-total-items]');
  const oneTireMsg = section.querySelector('[tire-right-msg]');
  
  const DiscoutName = section.querySelector('[data-discount-name]');
  // ---- GET TIERS SAFELY ----
  const t1Qty = Number(section.dataset.tier1Qty) || 0;
  const t2Qty = Number(section.dataset.tier2Qty) || 0;
  const t3Qty = Number(section.dataset.tier3Qty) || 0;

  const t1Disc = Number(section.dataset.tier1Discount) || 0;
  const t2Disc = Number(section.dataset.tier2Discount) || 0;
  const t3Disc = Number(section.dataset.tier3Discount) || 0;

  let selected = [];

  // -----------------------------
  // MONEY SAFE CALCULATION
  // -----------------------------
  function calculate() {

  let subtotal = 0;
  let qty = selected.length;

  selected.forEach(item => {
    subtotal += Number(item.price); // cents
  });

  /* ---------------------------------
     BUILD VALID INCREASING TIERS
     Stops when order breaks
  ---------------------------------- */

  const allTiers = [
    { qty: t1Qty, discount: t1Disc, index: 0 },
    { qty: t2Qty, discount: t2Disc, index: 1 },
    { qty: t3Qty, discount: t3Disc, index: 2 }
  ].filter(t => t.qty > 0);

  const tiers = [];

  for (let i = 0; i < allTiers.length; i++) {

    if (i === 0) {
      tiers.push(allTiers[i]);
    } else {
      if (allTiers[i].qty > allTiers[i - 1].qty) {
        tiers.push(allTiers[i]);
      } else {
        break; // stop if not increasing
      }
    }

  }

  /* ---------------------------------
     DETERMINE ACTIVE TIER
  ---------------------------------- */

  let discountPercent = 0;
  let appliedTierIndex = null;
  let nextTier = null;

  for (let i = 0; i < tiers.length; i++) {
    if (qty >= tiers[i].qty) {
      discountPercent = tiers[i].discount;
      appliedTierIndex = tiers[i].index;
      nextTier = tiers[i + 1] || null;
    }
  }

  /* ---------------------------------
     CALCULATE SAVINGS
     (No round up issue)
  ---------------------------------- */

  const savings = Math.floor(subtotal * (discountPercent / 100));
  const total = subtotal - savings;

  subtotalEl.innerHTML = Shopify.formatMoney(subtotal);
  savingsEl.innerHTML = Shopify.formatMoney(savings);
  totalEl.innerHTML = Shopify.formatMoney(total);
  totalItems.innerHTML = 'Items ' + qty;
  if(totalSelected){
    totalSelected.innerHTML = qty +' items selected';
  }
  addBtn.disabled = qty === 0;

  /* ---------------------------------
     TIER UI
  ---------------------------------- */

  tierPills.forEach(pill => pill.classList.remove('active'));
  if(dotsTire){
  dotsTire.forEach(tire => tire.classList.remove('active'))
  dotsTire[qty-1]?.classList.add('active');
  if(qty > t1Qty)
  dotsTire[dotsTire.length - 1]?.classList.add('active')
  }
  DiscoutName.innerHTML = '';

  if (appliedTierIndex !== null) {
    tierPills[appliedTierIndex]?.classList.add('active');
    DiscoutName.innerHTML =
      tierPills[appliedTierIndex]?.getAttribute('discount-name') || '';
  }

  /* ---------------------------------
     MESSAGE LOGIC
  ---------------------------------- */

  if (nextTier) {

    const needed = nextTier.qty - qty;

    if (needed > 0) {
      messageEl.textContent = `Add ${needed} more item${needed > 1 ? 's' : ''} to save ${nextTier.discount}%!`;
      if(oneTireMsg){
       oneTireMsg.textContent = `Add ${needed} more item${needed > 1 ? 's' : ''} to save ${nextTier.discount}%!`; 
      }
    } else {
      messageEl.textContent = `You're saving ${discountPercent}% 🎉`;
      if(oneTireMsg){
       oneTireMsg.textContent = `You're saving ${discountPercent}% 🎉`; 
      }
    }

  } else {

    if (discountPercent > 0) {
      messageEl.textContent = '🎉 Maximum savings unlocked!';
      if(oneTireMsg){
       oneTireMsg.textContent = '🎉 Maximum savings unlocked!'; 
      }
    } else if (tiers.length > 0) {
      const firstTier = tiers[0];
      const needed = firstTier.qty - qty;

      if (needed > 0) {
        messageEl.textContent =
          `Add ${needed} more item${needed > 1 ? 's' : ''} to save ${firstTier.discount}%!`;
          if(oneTireMsg){
       oneTireMsg.textContent = `Add ${needed} more item${needed > 1 ? 's' : ''} to save ${firstTier.discount}%!`;
      }
      }
    }

  }

}

  // -----------------------------
  // CARD SELECT LOGIC
  // -----------------------------
  cards.forEach(card => {

    const button = card.querySelector('.bundle-select-btn');

    button?.addEventListener('click', function () {

      if (button.disabled) return;

      const id = card.dataset.variantId;
      const price = Number(card.dataset.price); // cents

      if (card.classList.contains('selected')) {

        card.classList.remove('selected');
        selected = selected.filter(item => item.id !== id);

      } else {

        card.classList.add('selected');
        selected.push({ id, price });
      }

      calculate();
    });

    // -----------------------------
    // VARIANT HANDLING
    // -----------------------------
    const variantData = JSON.parse(
      card.querySelector('.bundle-variants-json')?.textContent || '[]'
    );

    const selects = card.querySelectorAll('.bundle-variant-select');
    const priceEl = card.querySelector('.bundle-price');

    if (!variantData.length) return;

    function updateVariant() {

      const selectedOptions = [];
      selects.forEach(select => {
        selectedOptions.push(select.value);
      });

      const matchedVariant = variantData.find(variant =>
        variant.options.every((opt, index) => opt === selectedOptions[index])
      );

      if (!matchedVariant) return;

      card.dataset.variantId = matchedVariant.id;
      card.dataset.price = matchedVariant.price; // 

      priceEl.textContent = Shopify.formatMoney(matchedVariant.price);

      if (!matchedVariant.available) {
        button.disabled = true;
        button.textContent = 'Sold Out';
      } else {
        button.disabled = false;
        button.textContent = 'Add';
      }

      // ---- IMPORTANT ----
      // If already selected, update price inside selected array
      if (card.classList.contains('selected')) {

        selected = selected.map(item => {
          if (item.id === matchedVariant.id) {
            return { id: matchedVariant.id, price: matchedVariant.price };
          }
          return item;
        });

        calculate();
      }
    }

    selects.forEach(select => {
      select.addEventListener('change', updateVariant);
    });

  });

  // -----------------------------
  // ADD TO CART
  // -----------------------------
  addBtn.addEventListener('click', function () {

    if (!selected.length) return;

    const items = selected.map(item => ({
      id: item.id,
      quantity: 1
    }));

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items }),
    })
    .then(res => res.json())
    .then(() => {
      window.location.href = '/cart';
    });

  });

});

{% endjavascript %}

