
{{ 'bundle-builder.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
{% capture style_schema %}
  --section-bg: {{ section.settings.section_bg }};
  --section-wraper-width: {% if section.settings.section_width %}100% {% else %}{{ section.settings.wraper_width }}px{% endif %};

  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  --section-padding-left: {{ section.settings.padding_left }}px;
  --section-padding-right: {{ section.settings.padding_right }}px;

  --section-mobile-padding-top: {{ section.settings.padding_top | times: 0.55 | round: 0 }}px;
  --section-mobile-padding-bottom: {{ section.settings.padding_bottom | times: 0.55 | round: 0 }}px;
  --section-mobile-padding-left: {{ section.settings.padding_left | times: 0.55 | round: 0 }}px;
  --section-mobile-padding-right: {{ section.settings.padding_right | times: 0.55 | round: 0 }}px;


  --text-color: {{ section.settings.text_color }};
  --heading-color: {{ section.settings.heading_color }};
  --sub-heading-color: {{  section.settings.sub_heading_color }};

  --desktop-header-heading-size: {{ section.settings.desktop_heading_size }}px;
  --desktop-header-sub-heading-size: {{ section.settings.desktop_sub_heading_size }}px;
  --desktop-header-text-size: {{ section.settings.desktop_text_size }}px;
  
  --mobile-header-heading-size: {{ section.settings.mobile_heading_size }}px;
  --mobile-header-sub-heading-size: {{ section.settings.mobile_sub_heading_size }}px;
  --mobile-header-text-size: {{ section.settings.mobile_text_size }}px;


  --btn-bg: {{ section.settings.button_bg }};
  --btn-hover-bg: {{ section.settings.button_hover_bg }};
  --btn-text: {{ section.settings.button_text_color }};
  --btn-hover-text: {{ section.settings.button_hover_text_color }};
  --btn-radius: {{ section.settings.button_radius }}px;


  --card-bg: {{ section.settings.card_bg }};
  --card-title: {{ section.settings.card_title_color }};
  --card-price-color: {{ section.settings.card_price_color }};
  --card-content-color: {{ section.settings.card_content_color }};
  --card-border: {{ section.settings.card_border_color }};
  --card-selected-border: {{ section.settings.card_selected_border }};
  --card-radius: {{ section.settings.card_radius }}px;
  --card-border-width: {{ section.settings.card_border_width }}px;
  --card-selected-boder-width: {% if section.settings.card_border_width == 0 %}1{% else %}{{ section.settings.card_border_width }}{%endif%}px;

  --card-title-desktop-font-size: {{ section.settings.desktop_product_title_size }}px;
  --card-title-mobile-font-size: {{ section.settings.mobile_product_title_size }}px;

  --card-per-row-desktop: {{ section.settings.products_gird_desktop }};
  --card-per-row-tablet: {{ section.settings.products_gird_tablet }};
  --card-per-row-mobile: {{ section.settings.products_gird_mobile }};
  --card-gap: 20px;
  --card-gap-mobile: 10px;
  --bundle-button-bg: {{ section.settings.bundle-button-bg }};
  --bundle-button-text: {{ section.settings.bundle-button-text }};
  --bundle-button-border: {{ section.settings.bundle-button-border }};
  --bundle-button-hover-bg: {{ section.settings.bundle-button-hover-bg }};
  --bundle-button-hover-text: {{ section.settings.bundle-button-hover-text }};
  --bundle-button-hover-border:{{ section.settings.bundle-button-hover-boder }};

  --progress-bg: {{ section.settings.progress_bg }};
  --progress-bar-heading-color: {{ section.settings.progress_heading_color }};
  --progress-bar-radius: {{ section.settings.progress_radius }}px;
  
  --progress-bar-desktop-heading-font-size: {{ section.settings.bundle_save_text_font_size }}px;
  --progress-bar-mobile-heading-font-size: {{ section.settings.mobile_bundle_save_text_font_size }}px;
  --progress-bar-desktop-text-font-size: {{ section.settings.bundle_text_font_size }}px;
  --progress-bar-mobile-text-Font-size: {{ section.settings.mobile_bundle_text_font_size }}px;

  --progress-fill: {{ section.settings.progress_fill }};
  --tier-active-bg: {{ section.settings.tier_active_bg }};
  --tier-radius: {{ section.settings.progress_fill_radius }}px;
  --tier-border-color: {{ section.settings.tier_border_color }};
  --tier-active-text: {{ section.settings.tier_active_text }};
  --tier-inactive-bg: {{ section.settings.tier_inactive_bg }};
  --tier-inactive-text: {{ section.settings.tier_inactive_text }};
  --progress-bar-message-color:{{ section.settings.bar_message_color }};
  --bundle-footer-bg: {{ section.settings.footer_bg }};
  --bundle-footer-radius: {{ section.settings.footer_radius }}px;
{% endcapture %}

{% assign t1 = section.settings.tier_1_qty | default: 0 | plus: 0 %}
{% assign t2 = section.settings.tier_2_qty | default: 0 | plus: 0 %}
{% assign t3 = section.settings.tier_3_qty | default: 0 | plus: 0 %}

{% assign d1 = section.settings.tier_1_discount | default: 0 %}
{% assign d2 = section.settings.tier_2_discount | default: 0 %}
{% assign d3 = section.settings.tier_3_discount | default: 0 %}
{% assign tier_count = 0 %}

{%- comment -%} Tier 1 {%- endcomment -%}
{% if t1 > 0 %}
  {% assign tier_count = tier_count | plus: 1 %}
{% endif %}

{%- comment -%} Tier 2 (must be > tier 1) {%- endcomment -%}
{% if t2 > 0 and t2 > t1 %}
  {% assign tier_count = tier_count | plus: 1 %}
{% endif %}

{%- comment -%} Tier 3 (must be > tier 2 AND tier 2 valid) {%- endcomment -%}
{% if t3 > 0 and t3 > t2 and t2 > t1 %}
  {% assign tier_count = tier_count | plus: 1 %}
{% endif %}

<section 
  id="bundle-section-{{ section.id }}" style="{{ style_schema }}"
  class="bundle-builder"
  data-tier1-qty="{{ section.settings.tier_1_qty }}"
  data-tier1-discount="{{ section.settings.tier_1_discount }}"
  data-tier2-qty="{{ section.settings.tier_2_qty }}"
  data-tier2-discount="{{ section.settings.tier_2_discount }}"
  data-tier3-qty="{{ section.settings.tier_3_qty }}"
  data-tier3-discount="{{ section.settings.tier_3_discount }}"
>
  <div class="section_container tier_count_{{ tier_count }}">
  <div class="bundle-header">
    {% if section.settings.heading != blank %}
    <h2 class="bundle_header_heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
    <p class="bundle_header_sub_heading">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.content != blank %}
    <div class="rte header_content">{{ section.settings.content }}</div>
    {% endif %}
  </div>
  <div class="bundle-benefits">
    <div class="bundle-benefits-header">
      <span class="bundle-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
<path d="M18.3337 5.8335L11.2503 12.9168L7.08366 8.75016L1.66699 14.1668" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M13.333 5.8335H18.333V10.8335" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
</svg></span>
      <span class="bar_title">{% if section.settings.bundle_save_text != blank %} {{ section.settings.bundle_save_text }} {% else %} Bundle & Save {% endif %}</span>
    </div>


<div class="bundle-tier-tabs">

  {%- comment -%} Tier 1 always valid if qty > 0 {%- endcomment -%}
  {% if t1 > 0 %}
    <button class="tier-pill"
      data-tier="1"
      discount-name="Save {{ d1 }}%">
      Buy {{ t1 }} → Save {{ d1 }}%
    </button>
  {% endif %}

  {%- comment -%} Tier 2 must be greater than Tier 1 {%- endcomment -%}
  {% if t2 > 0 and t2 > t1 %}
    <button class="tier-pill"
      data-tier="2"
      discount-name="Save {{ d2 }}%">
      Buy {{ t2 }} → Save {{ d2 }}%
    </button>
  {% endif %}

  {%- comment -%} Tier 3 must be greater than Tier 2 {%- endcomment -%}
  {% if t3 > 0 and t3 > t2 and t2 > t1 %}
    <button class="tier-pill"
      data-tier="3"
      discount-name="Save {{ d3 }}%">
      Buy {{ t3 }} → Save {{ d3 }}%
    </button>
  {% endif %}

</div>
    <div class="bundle-tier-message">
      <span data-bundle-message> Add {{ section.settings.tier_1_qty }} items to start saving! </span>
    </div>
  </div>
  <div class="bundle-products">
    {% if section.settings.use_collection %}
      {% for product in collections[section.settings.collection].products limit: section.settings.products_limit  %}
        {% render 'bundle-card', product: product %}
      {% endfor %}

    {% else %}
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% render 'bundle-card', product: product %}
      {% endfor %}
    {% endif %}
  </div>
  <div class="bundle_footer">
  <div class="bundle-summary">
    <div class="subtotalBundle {% if tier_count == 1 %}hidden_element{% endif %}"><span>Subtotal: (<em data-total-item>Items 0</em>)</span><span data-bundle-subtotal>{{ 0 | money }}</span></div>
    <div class="bundleDiscount"><span>Bundle Discount <em data-discount-name></em></span><span data-bundle-savings>{{ 0 | money }}</span></div>
    <div class="bundleTotal">{% if tier_count == 1 %}<span selected-total-items >0 item selected:</span>{% else %}<span>Total:</span>{% endif %}<strong data-bundle-total>{{ 0 | money }}</strong></div>
  </div>

  <button class="bundle-add-to-cart" disabled>
<span class="icon_cart"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
<path d="M6.66634 18.3332C7.12658 18.3332 7.49967 17.9601 7.49967 17.4998C7.49967 17.0396 7.12658 16.6665 6.66634 16.6665C6.2061 16.6665 5.83301 17.0396 5.83301 17.4998C5.83301 17.9601 6.2061 18.3332 6.66634 18.3332Z" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M15.8333 18.3332C16.2936 18.3332 16.6667 17.9601 16.6667 17.4998C16.6667 17.0396 16.2936 16.6665 15.8333 16.6665C15.3731 16.6665 15 17.0396 15 17.4998C15 17.9601 15.3731 18.3332 15.8333 18.3332Z" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M1.70801 1.7085H3.37467L5.59134 12.0585C5.67266 12.4375 5.88357 12.7764 6.18777 13.0167C6.49197 13.257 6.87043 13.3838 7.25801 13.3752H15.408C15.7873 13.3745 16.1551 13.2446 16.4505 13.0067C16.746 12.7688 16.9515 12.4373 17.033 12.0668L18.408 5.87516H4.26634" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
</svg></span><span>{{ section.settings.button_text }}</span>
  </button>
  </div>
  {% if tier_count == 1 %}
    <div class="tire_one_footer">
      <div class="tire_left_msg">
      <div class="save_message">SAVE 15% WHEN BOUGHT TOGETHER</div>
      <div class="title_footer">Build Your Own Bundle</div>
      <div class="selectsavemsg">Select any {{ t1 }} products and save {{ d1 }}% automatically</div>
      </div>
      <div class="tire_right_msg"><p tire-right-msg>Select  more products to unlock discount</p>
      <div class="totle_dots_proudct">{% for i in (1..t1) %}<div class="dots-tire">{{ i }}</div>{% endfor %}</div>
      </div>
    </div>
  {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Bundle Builder",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "checkbox",
      "id": "section_width",
      "label": "Full Width"
    },
    {
      "type": "range",
      "id": "wraper_width",
      "label": "Container Width",
      "max": 1900,
      "min": 900,
      "default": 1400,
      "step": 100,
      "unit": "px",
      "visible_if": "{{ section.settings.section_width == false }}"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Bundle"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub-Heading",
      "default": "Mix and match to save more"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Desktop Font Size"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_sub_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 36,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Body Font Size"
    },
    {
      "type": "header",
      "content": "Mobile Font Size"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 28,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_sub_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Body Font Size"
    },
    {
      "type": "header",
      "content": "Section Colors & Style"
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "sub_heading_color",
      "label": "Sub-Heading Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Progress Bar"
    },
    {
      "type": "text",
      "id": "bundle_save_text",
      "label": "Progress Bar Heading",
      "default": "Bundle & Save"
    },
    
    {
      "type": "header",
      "content": "Desktop Font Size"
    },
    {
      "type": "range",
      "id": "bundle_save_text_font_size",
      "label": "Heading Font Size",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "bundle_text_font_size",
      "label": "Text Font Size",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 13
    },
    {
      "type": "header",
      "content": "Mobile Font Size"
    },
    {
      "type": "range",
      "id": "mobile_bundle_save_text_font_size",
      "label": "Heading Font Size",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_bundle_text_font_size",
      "label": "Text Font Size",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16
    },
    {
      "type": "header",
      "content": "Bundle Products & Discount Tires"
    },
    {
      "type": "checkbox",
      "id": "use_collection",
      "label": "Use Collection",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products to show",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.collection != blank }}"
    },
    {
      "type": "range",
      "id": "products_gird_desktop",
      "label": "Products Pre Row Desktop",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.collection != blank }}"
    },
    {
      "type": "range",
      "id": "products_gird_tablet",
      "label": "Products Pre Row Tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.collection != blank }}"
    },
    {
      "type": "range",
      "id": "products_gird_mobile",
      "label": "Products Pre Row Mobile",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.collection != blank }}"
    },
    {
      "type": "range",
      "id": "tier_1_qty",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "label": "Tier 1 Quantity"
    },
    {
      "type": "range",
      "id": "tier_1_discount",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10,
      "label": "Tier 1 Discount %"
    },
    {
      "type": "range",
      "id": "tier_2_qty",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "label": "Tier 2 Quantity"
    },
    {
      "type": "range",
      "id": "tier_2_discount",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 15,
      "label": "Tier 2 Discount %"
    },
    {
      "type": "range",
      "id": "tier_3_qty",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Tier 3 Quantity"
    },
    {
      "type": "range",
      "id": "tier_3_discount",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20,
      "label": "Tier 3 Discount %"
    },
    {
      "type": "header",
      "content": "Progress Bar Colors & Style"
    },
    {
      "type": "color_background",
      "id": "progress_bg",
      "label": "Progress Bar Background",
      "default": "linear-gradient(90deg,#dff3e8,#e9eef3)"
    },
    {
      "type": "range",
      "id": "progress_radius",
      "label": "Section Radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "progress_heading_color",
      "label": "Progress bar Heading Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "progress_fill",
      "label": "Progress Fill Color",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "progress_fill_radius",
      "label": "Tier Radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "color",
      "id": "tier_active_bg",
      "label": "Active Tier Background",
      "default": "#00A63E"
    },
    {
      "type": "color",
      "id": "tier_border_color",
      "label": "Tier Border Color",
      "default": "#E5E7EB"
    },
    {
      "type": "color",
      "id": "tier_active_text",
      "label": "Active Tier Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tier_inactive_bg",
      "label": "Inactive Tier Background",
      "default": "#f3f4f6"
    },
    {
      "type": "color",
      "id": "tier_inactive_text",
      "label": "Inactive Tier Text",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "bar_message_color",
      "label": "Message Color Text",
      "default": "#16a34a"
    },
    {
      "type": "header",
      "content": "Product Card Styles"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    {
      "type": "range",
      "id": "desktop_product_title_size",
      "label": "Product Title Desktop Font Size",
      "default": 16,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_product_title_size",
      "label": "Product Title Mobile Font Size",
      "default": 14,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Product Card Border Radius"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Product Title Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "card_price_color",
      "label": "Product Price Color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "card_content_color",
      "label": "Product Content Color",
