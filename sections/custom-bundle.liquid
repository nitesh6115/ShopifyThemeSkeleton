<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('.bundle-builder');
    const cards = section.querySelectorAll('.bundle-card');
    const subtotalEl = section.querySelector('[data-bundle-subtotal]');
    const savingsEl = section.querySelector('[data-bundle-savings]');
    const totalEl = section.querySelector('[data-bundle-total]');
    const addBtn = section.querySelector('.bundle-add-to-cart');
    const tierPills = section.querySelectorAll('.tier-pill');
    const messageEl = section.querySelector('[data-bundle-message]');
    let selected = [];

    function calculate() {
       
      let subtotal = 0;

      selected.forEach((item) => {
        subtotal += parseFloat(item.price);
      });

      let qty = selected.length;
      console.log("QTY:", qty);
      const t1Qty = parseInt(section.dataset.tier1Qty);
      const t2Qty = parseInt(section.dataset.tier2Qty);
      const t3Qty = parseInt(section.dataset.tier3Qty);
      console.log(t2Qty)
      const t1Disc = parseFloat(section.dataset.tier1Discount);
      const t2Disc = parseFloat(section.dataset.tier2Discount);
      const t3Disc = parseFloat(section.dataset.tier3Discount);

      let discountPercent = 0;
      let nextTierQty = t1Qty;
      let nextTierDiscount = t1Disc;

      // -------- TIER LOGIC --------

      if (qty >= t3Qty) {
        discountPercent = t3Disc;
        nextTierQty = null;
      } else if (qty >= t2Qty) {
        discountPercent = t2Disc;
        nextTierQty = t3Qty;
        nextTierDiscount = t3Disc;
      } else if (qty >= t1Qty) {
        discountPercent = t1Disc;
        nextTierQty = t2Qty;
        nextTierDiscount = t2Disc;
      } else {
        // qty < tier 1
        discountPercent = 0;
        nextTierQty = t1Qty;
        nextTierDiscount = t1Disc;
      }

      // -------- CALCULATE TOTALS --------

      let savings = subtotal * (discountPercent / 100);
      let total = subtotal - savings;

      subtotalEl.textContent = '$' + subtotal.toFixed(2);
      savingsEl.textContent = '$' + savings.toFixed(2);
      totalEl.textContent = '$' + total.toFixed(2);

      addBtn.disabled = qty === 0;

      // -------- FIXED BENEFIT BAR LOGIC --------

      tierPills.forEach((pill) => pill.classList.remove('active'));
      console.log(t1Qty)
      if (qty >= t3Qty) {
        tierPills[2].classList.add('active');
      } else if (qty >= t2Qty) {
        tierPills[1].classList.add('active');
      } else if (qty >= t1Qty) {
        tierPills[0].classList.add('active');
      }

      // -------- FIXED MESSAGE --------

      if (nextTierQty !== null) {
        let needed = nextTierQty - qty;
        console.log(needed)
        if (needed > 0) {
          messageEl.textContent = `Add ${needed} more item${needed > 1 ? 's' : ''} to save ${nextTierDiscount}%!`;
        } else {
          messageEl.textContent = `You’re saving ${discountPercent}% 🎉`;
        }
      } else {
        messageEl.textContent = '🎉 Maximum savings unlocked!';
      }
    }

    cards.forEach((card) => {
      const btn = card.querySelector('.bundle-select-btn');

      btn.addEventListener('click', function () {
        const id = card.dataset.variantId;
        const price = card.dataset.price;

        if (card.classList.contains('selected')) {
          card.classList.remove('selected');
          selected = selected.filter((item) => item.id !== id);
        } else {
          card.classList.add('selected');
          selected.push({ id, price });
        }
        calculate();
      });
    });

    addBtn.addEventListener('click', function () {
      const items = selected.map((item) => ({
        id: item.id,
        quantity: 1,
      }));

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items }),
      }).then(() => {
        window.location.href = '/cart';
      });
    });
  });
  document.querySelectorAll(".bundle-card").forEach(card => {

  const variantData = JSON.parse(
    card.querySelector(".bundle-variants-json")?.textContent || "[]"
  );

  const selects = card.querySelectorAll(".bundle-variant-select");
  const priceEl = card.querySelector(".bundle-price");
  const button = card.querySelector(".bundle-select-btn");

  if (!variantData.length) return;

  function updateVariant() {

    const selectedOptions = [];
    selects.forEach(select => {
      selectedOptions.push(select.value);
    });

    const matchedVariant = variantData.find(variant => {
      return variant.options.every((opt, index) => 
        opt === selectedOptions[index]
      );
    });

    if (!matchedVariant) return;

    card.dataset.variantId = matchedVariant.id;
    card.dataset.price = (matchedVariant.price / 100).toFixed(2);

    priceEl.textContent = Shopify.formatMoney(matchedVariant.price);

    if (!matchedVariant.available) {
      button.disabled = true;
      button.textContent = "Sold Out";
    } else {
      button.disabled = false;
      button.textContent = "Add";
    }
  }

  selects.forEach(select => {
    select.addEventListener("change", updateVariant);
  });

});
</script>
