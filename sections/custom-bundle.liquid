{{ 'bundle-builder.css' | asset_url | stylesheet_tag }}

<section class="bundle-builder" 
  data-tier-1-qty="{{ section.settings.tier_1_qty }}"
  data-tier-1-discount="{{ section.settings.tier_1_discount }}"
  data-tier-2-qty="{{ section.settings.tier_2_qty }}"
  data-tier-2-discount="{{ section.settings.tier_2_discount }}"
  data-tier-3-qty="{{ section.settings.tier_3_qty }}"
  data-tier-3-discount="{{ section.settings.tier_3_discount }}"
>

  <div class="bundle-header">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>

  <div class="bundle-products">
    
    {% if section.settings.use_collection %}
      
      {% for product in collections[section.settings.collection].products %}
        {% render 'bundle-card', product: product %}
      {% endfor %}

    {% else %}

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% render 'bundle-card', product: product %}
      {% endfor %}

    {% endif %}

  </div>

  <div class="bundle-summary">
    <div>Subtotal: <span data-bundle-subtotal>$0.00</span></div>
    <div>You Save: <span data-bundle-savings>$0.00</span></div>
    <div>Total: <strong data-bundle-total>$0.00</strong></div>
  </div>

  <button class="bundle-add-to-cart" disabled>
    {{ section.settings.button_text }}
  </button>

</section>
{% schema %}
{
  "name": "Bundle Builder",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Bundle" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Mix and match to save more" },
    
    { "type": "checkbox", "id": "use_collection", "label": "Use Collection", "default": true },
    { "type": "collection", "id": "collection", "label": "Select Collection" },

    { "type": "range", "id": "tier_1_qty", "min": 1, "max": 10, "step": 1, "default": 2, "label": "Tier 1 Quantity" },
    { "type": "range", "id": "tier_1_discount", "min": 0, "max": 50, "step": 1, "default": 10, "label": "Tier 1 Discount %" },

    { "type": "range", "id": "tier_2_qty", "min": 1, "max": 10, "step": 1, "default": 3, "label": "Tier 2 Quantity" },
    { "type": "range", "id": "tier_2_discount", "min": 0, "max": 50, "step": 1, "default": 15, "label": "Tier 2 Discount %" },

    { "type": "range", "id": "tier_3_qty", "min": 1, "max": 10, "step": 1, "default": 4, "label": "Tier 3 Quantity" },
    { "type": "range", "id": "tier_3_discount", "min": 0, "max": 50, "step": 1, "default": 20, "label": "Tier 3 Discount %" },

    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Add Bundle to Cart" }
  ],

  "blocks": [
    {
      "type": "product",
      "name": "Manual Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Select Product" }
      ]
    }
  ],

  "max_blocks": 12,
  "presets": [
    { "name": "Bundle Builder" }
  ]
}
{% endschema %}
<script>
document.addEventListener("DOMContentLoaded", function(){

  const section = document.querySelector(".bundle-builder");
  const cards = section.querySelectorAll(".bundle-card");
  const subtotalEl = section.querySelector("[data-bundle-subtotal]");
  const savingsEl = section.querySelector("[data-bundle-savings]");
  const totalEl = section.querySelector("[data-bundle-total]");
  const addBtn = section.querySelector(".bundle-add-to-cart");

  let selected = [];

  function calculate() {
    let subtotal = 0;
    selected.forEach(item => subtotal += parseFloat(item.price));

    let qty = selected.length;
    let discount = 0;

    const t1Qty = parseInt(section.dataset.tier1Qty);
    const t2Qty = parseInt(section.dataset.tier2Qty);
    const t3Qty = parseInt(section.dataset.tier3Qty);

    const t1Disc = parseFloat(section.dataset.tier1Discount);
    const t2Disc = parseFloat(section.dataset.tier2Discount);
    const t3Disc = parseFloat(section.dataset.tier3Discount);

    if (qty >= t3Qty) discount = t3Disc;
    else if (qty >= t2Qty) discount = t2Disc;
    else if (qty >= t1Qty) discount = t1Disc;

    let savings = subtotal * (discount / 100);
    let total = subtotal - savings;

    subtotalEl.textContent = "$" + subtotal.toFixed(2);
    savingsEl.textContent = "$" + savings.toFixed(2);
    totalEl.textContent = "$" + total.toFixed(2);

    addBtn.disabled = qty === 0;
  }

  cards.forEach(card => {
    const btn = card.querySelector(".bundle-select-btn");

    btn.addEventListener("click", function(){

      const id = card.dataset.variantId;
      const price = card.dataset.price;

      if (card.classList.contains("selected")) {
        card.classList.remove("selected");
        selected = selected.filter(item => item.id !== id);
      } else {
        card.classList.add("selected");
        selected.push({ id, price });
      }

      calculate();
    });
  });

  addBtn.addEventListener("click", function(){
    const items = selected.map(item => ({
      id: item.id,
      quantity: 1
    }));

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ items })
    }).then(() => {
      window.location.href = "/cart";
    });
  });

});
</script>