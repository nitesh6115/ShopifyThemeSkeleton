<style>
.bundle-builder {
  --section-bg: {{ section.settings.section_bg }};
  --section-wraper-width: {% if section.settings.section_width %}100% {% else %}{{ section.settings.wraper_width }}px{% endif %};

  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  --section-padding-left: {{ section.settings.padding_left }}px;
  --section-padding-right: {{ section.settings.padding_right }}px;

  --text-color: {{ section.settings.text_color }};
  --heading-color: {{ section.settings.heading_color }};

  --desktop-header-heading-size: {{ section.settings.desktop_heading_size }}px;
  --desktop-header-sub-heading-size: {{ section.settings.desktop_sub_heading_size }}px;
  --desktop-header-text-size: {{ section.settings.desktop_text_size }}px;
  
  --mobile-header-heading-size: {{ section.settings.mobile_heading_size }}px;
  --mobile-header-sub-heading-size: {{ section.settings.mobile_sub_heading_size }}px;
  --mobile-header-text-size: {{ section.settings.mobile_text_size }}px;


  --btn-bg: {{ section.settings.button_bg }};
  --btn-hover-bg: {{ section.settings.button_hover_bg }};
  --btn-text: {{ section.settings.button_text_color }};
  --btn-radius: {{ section.settings.button_radius }}px;

  --card-bg: {{ section.settings.card_bg }};
  --card-title: {{ section.settings.card_title_color }};
  --card-border: {{ section.settings.card_border_color }};
  --card-selected-border: {{ section.settings.card_selected_border }};
  --card-radius: {{ section.settings.card_radius }}px;
  --card-border-width: {{ section.settings.card_border_width }}px;
  --card-selected-boder-width: {% if section.settings.card_border_width == 0 %}1{% else %}{{ section.settings.card_border_width }}{%endif%}px;

  --checkbox-bg: {{ section.settings.checkbox_bg }};
  --checkbox-border: {{ section.settings.checkbox_border }};
  --checkbox-active-bg: {{ section.settings.checkbox_active_bg }};
  --checkbox-active-icon: {{ section.settings.checkbox_active_icon }};

  --progress-bg: {{ section.settings.progress_bg }};
  --progress-bar-heading-color: {{ section.settings.progress_heading_color }};
  --progress-bar-radius: {{ section.settings.progress_radius }}px;
  
  --progress-bar-desktop-heading-font-size: {{ section.settings.bundle_save_text_font_size }}px;
  --progress-bar-mobile-heading-font-size: {{ section.settings.mobile_bundle_save_text_font_size }}px;

  --progress-fill: {{ section.settings.progress_fill }};
  --tier-active-bg: {{ section.settings.tier_active_bg }};
  --tier-radius: {{ section.settings.progress_fill_radius }}px;
  --tier-border-color: {{ section.settings.tier_border_color }};
  --tier-active-text: {{ section.settings.tier_active_text }};
  --tier-inactive-bg: {{ section.settings.tier_inactive_bg }};
  --tier-inactive-text: {{ section.settings.tier_inactive_text }};
  --progress-bar-message-color:{{ section.settings.bar_message_color }}
}
</style>
{{ 'bundle-builder.css' | asset_url | stylesheet_tag }}

<section 
  id="bundle-section-{{ section.id }}"
  class="bundle-builder"
  data-tier1-qty="{{ section.settings.tier_1_qty }}"
  data-tier1-discount="{{ section.settings.tier_1_discount }}"
  data-tier2-qty="{{ section.settings.tier_2_qty }}"
  data-tier2-discount="{{ section.settings.tier_2_discount }}"
  data-tier3-qty="{{ section.settings.tier_3_qty }}"
  data-tier3-discount="{{ section.settings.tier_3_discount }}"
>
  <div class="section_container">
  <div class="bundle-header">
    <h2 class="bundle_header_heading">{{ section.settings.heading }}</h2>
    <p class="bundle_header_sub_heading">{{ section.settings.subheading }}</p>
  </div>
  <div class="bundle-benefits">
    <div class="bundle-benefits-header">
      <span class="bundle-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
<path d="M18.3337 5.8335L11.2503 12.9168L7.08366 8.75016L1.66699 14.1668" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
<path d="M13.333 5.8335H18.333V10.8335" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
</svg></span>
      <span class="bar_title">{% if section.settings.bundle_save_text != blank %} {{ section.settings.bundle_save_text }} {% else %} Bundle & Save {% endif %}</span>
    </div>

    <div class="bundle-tier-tabs">
      <button class="tier-pill" data-tier="1">
        Buy {{ section.settings.tier_1_qty }} → Save {{ section.settings.tier_1_discount }}%
      </button>

      <button class="tier-pill" data-tier="2">
        Buy {{ section.settings.tier_2_qty }} → Save {{ section.settings.tier_2_discount }}%
      </button>

      <button class="tier-pill" data-tier="3">
        Buy {{ section.settings.tier_3_qty }} → Save {{ section.settings.tier_3_discount }}%
      </button>
    </div>

    <div class="bundle-tier-message">
      <span data-bundle-message> Add {{ section.settings.tier_1_qty }} items to start saving! </span>
    </div>
  </div>
  <div class="bundle-products">
    {% if section.settings.use_collection %}
      {% for product in collections[section.settings.collection].products limit: section.settings.products_limit  %}
        {% render 'bundle-card', product: product %}
      {% endfor %}

    {% else %}
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% render 'bundle-card', product: product %}
      {% endfor %}
    {% endif %}
  </div>
  <div class="bundle_footer">
  <div class="bundle-summary">
    <div>Subtotal: <span data-bundle-subtotal>$0.00</span></div>
    <div>You Save: <span data-bundle-savings>$0.00</span></div>
    <div>Total: <strong data-bundle-total>$0.00</strong></div>
  </div>

  <button class="bundle-add-to-cart" disabled>
    {{ section.settings.button_text }}
  </button>
  </div>
  </div>
</section>
