<div class="Mega_Menu_Layout" type="mega_menu_2">
   <div class="menu_items_list">
    {%  for i in (1..4) %}
        {%- capture key_image %}promo_image_{{ i }}{%- endcapture -%}
        {%- capture key_title %}promo_title_{{ i }}{%- endcapture -%}
        {%- capture key_text %}promo_text_{{ i }}{%- endcapture -%}
        {%- capture key_link %}promo_link_{{ i }}{%- endcapture -%}
         {% assign promo_image = block.settings[key_image] %}
         {% assign promo_title = block.settings[key_title] %}
         {% assign promo_text = block.settings[key_text] %}
         {% assign promo_link = block.settings[key_link] %}
         {% if promo_image != blank and promo_title != blank  %}
         <div class="Promo_item">
             {% if promo_link != blank %}
                <a href="{{ promo_link }}">
                {% endif %}
            {% capture sizes %}(max-width: {{ promo_image.width | times: 2 }}px) 50vw, {{ promo_image.width }}px{% endcapture %}
            {{ promo_image
                      | image_url: width: 438
                      | image_tag:
                        widths: '50, 75, 100, 150, 200, 300, 400, 500',
                        sizes: sizes,
                        class: 'promo_image_menu'
                    }}
        <div class="promo_text_container">
        <div class="promo_info">
        {% if promo_title != blank %}
            <h3>{{ promo_title }}</h3>
        {% endif %}
        {% if promo_text != blank %}
            <div class="rte">
                {{ promo_text }}
                </div>
        {% endif %}
        </div>
        {% if promo_link != blank %}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
        {%  endif %}
        </div>
    {% if promo_link != blank %}
    </a>
    {% endif %}
         </div>
        {% endif %}
    {% endfor %}
   </div>
</div>