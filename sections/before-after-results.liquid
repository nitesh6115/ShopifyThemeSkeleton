{{ 'before-after-results.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{% capture style_schema %}
    --section-bg: {{ section.settings.section_bg }};
  --section-wraper-width: {% if section.settings.section_width %}100% {% else %}{{ section.settings.wraper_width }}px{% endif %};

  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  --section-padding-left: {{ section.settings.padding_left }}px;
  --section-padding-right: {{ section.settings.padding_right }}px;
     
  --section-mobile-padding-top: {{ section.settings.padding_top | times: 0.55 | round: 0 }}px;
  --section-mobile-padding-bottom: {{ section.settings.padding_bottom | times: 0.55 | round: 0 }}px;
  --section-mobile-padding-left: {{ section.settings.padding_left | times: 0.55 | round: 0 }}px;
  --section-mobile-padding-right: {{ section.settings.padding_right | times: 0.55 | round: 0 }}px;
  --header-desktop-text-alignment: {{ section.settings.desktop_text_align }};
  --header-mobile-text-alignment: {{ section.settings.mobile_text_align }};
  
  --desktop-header-heading-size: {{ section.settings.desktop_heading_size }}px;
  --desktop-header-sub-heading-size: {{ section.settings.desktop_sub_heading_size }}px;
  --desktop-header-text-size: {{ section.settings.desktop_text_size }}px;
  
  --mobile-header-heading-size: {{ section.settings.mobile_heading_size }}px;
  --mobile-header-sub-heading-size: {{ section.settings.mobile_sub_heading_size }}px;
  --mobile-header-text-size: {{ section.settings.mobile_text_size }}px;
  --badge-bg: {{ section.settings.badge_bg }};
  --badge-color: {{ section.settings.badge_color }};
  --badge-font-size: {{ section.settings.badge_size }}px;
  --badge-radius: {{ section.settings.badge_radisu }}px;
  --review-text-color: {{ section.settings.review_text_color }};
  --review-text-font-size: {{ section.settings.review_text_font_size }}px;
  --image-radius: {{ section.settings.image_radius }}px;
  --star-line-color: {{ section.settings.slider_color }};
  
  --card-bg: {{ section.settings.card_bg }};
  --card-radius: {{ section.settings.card_radius }}px;
  --testimonial-size: {{ section.settings.testimonial_size }}px;
  --testimonial-color: {{ section.settings.testimonial_color }};
  --author-color: {{ section.settings.author_color }};
  --disclaimer-font-size: {{ section.settings.disclaimer_font_size }}px;
{% endcapture %}

<div class="before-after-section" style="{{ style_schema }}">
<div class="before-after-container">
  <div class="section-header">
    {% if section.settings.badge_text != blank %}
      <div class="before-after-badge">
        {{ section.settings.badge_text }}
      </div>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
    {% if section.settings.review_text != blank %}
    <div class="review-stars-text">
     {{ section.settings.review_text }}
    </div>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <div class="header-sub-heading" style="color: {{ section.settings.subheading_color }};">
        {{ section.settings.subheading }}
      </div>
    {% endif %}
    {% if section.settings.content != blank %}
      <div class="rte content_header" style="color: {{ section.settings.text_color }};">
        {{ section.settings.content }}
      </div>
    {% endif %}
  </div>
  {%- assign widths = '165,360,535,750,1070,1500' -%}
  <!-- Before After Slider -->
  {% if section.settings.before_image != blank and section.settings.after_image != blank %}   
  <div class="before-after-wrapper">
    <div class="before-after-image-container" id="ba-container-{{ section.id }}">
      <div class="image-container">
        {{
          section.settings.before_image
          | image_url: width: 1500
          | image_tag:
            widths: widths,
            sizes: '(min-width: 1200px) 700px, 100vw',
            loading: 'lazy',
            class: 'image-before slider-image'
        }}
        {{
          section.settings.after_image
          | image_url: width: 1500
          | image_tag:
            widths: widths,
            sizes: '(min-width: 1200px) 700px, 100vw',
            loading: 'lazy',
            class: 'image-after slider-image'
        }}
      </div>
      <!-- step="10" -->
      <input
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="Percentage of before photo shown"
        class="slider slider_button_befor"
      >
      <div class="slider-line" aria-hidden="true"></div>
      <div class="slider-button" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="30"
          height="30"
          fill="currentColor"
          viewBox="0 0 256 256"
        >
          <rect width="256" height="256" fill="none"></rect>
          <line
            x1="128"
            y1="40"
            x2="128"
            y2="216"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></line>
          <line
            x1="96"
            y1="128"
            x2="16"
            y2="128"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></line>
          <polyline
            points="48 160 16 128 48 96"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></polyline>
          <line
            x1="160"
            y1="128"
            x2="240"
            y2="128"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></line>
          <polyline
            points="208 96 240 128 208 160"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="16"
          ></polyline>
        </svg>
      </div>
      <div class="before-after-label label-before">Before</div>
      <div class="before-after-label label-after">After</div>
    </div>
  </div>
  {%  endif %}
  {% if section.settings.disclaimer != blank %}
    <div class="disclaimer" style="color: {{ section.settings.disclaimer_color }};">
      {{ section.settings.disclaimer }}
    </div>
  {% endif %}

  <!-- Testimonial -->
  <div class="testimonial-card">
    <div class="review-stars">★★★★★</div>
    <div class="testimonial-text">"{{ section.settings.testimonial_text }}"</div>
    <div class="testimonial-author  {% if section.settings.author_image %}at_image{% endif %}">
      {% if section.settings.author_image %}
                {{
          section.settings.author_image
          | image_url: width: 150
          | image_tag:
            alt: section.settings.author_image,
            widths: widths,
            sizes: '(min-width: 1200px) 700px, 100vw',
            loading: 'lazy',
            class: 'author_image'
        }}
      {% endif %}
      <div class="author_name">
      {{ section.settings.author_name }}
      </div>
    </div>
  </div>
  </div>
</div>

<script>
  const container = document.querySelector('#ba-container-{{ section.id }}');
  container.querySelector('.slider_button_befor').addEventListener('input', (e) => {
    container.style.setProperty('--position', `${e.target.value}%`);
  });
</script>

{% schema %}
{
  "name": "Before / After Results",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "checkbox",
      "id": "section_width",
      "label": "Full Width"
    },
    {
      "type": "range",
      "id": "wraper_width",
      "label": "Container Width",
      "max": 1900,
      "min": 900,
      "default": 1400,
      "step": 100,
      "unit": "px",
      "visible_if": "{{ section.settings.section_width == false }}"
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Section Background",
      "default": "rgba(255, 255, 255, 1)"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
        {
      "type": "header",
      "content": "Desktop Font Size"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_sub_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Body Font Size"
    },
    {
      "type": "header",
      "content": "Mobile Font Size"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 28,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_sub_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Body Font Size"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#6B6B6B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6B6B6B"
    },
    
    {
          "type": "select",
          "id": "desktop_text_align",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left",
          "label": "Desktop Text Alignment"
        },
        {
          "type": "select",
          "id": "mobile_text_align",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left",
          "label": "Mobile Text Alignment"
        },
  
    { "type": "text", "id": "badge_text", "label": "Badge Text" },
    { "type": "color", "id": "badge_bg", "label": "Badge Background", "default": "#d4f5e0" },
    { "type": "color", "id": "badge_color", "label": "Badge Text Color", "default": "#1a7f4b" },
    { "type": "range", "id": "badge_size", "min": 10, "max": 24, "step": 1, "default": 14, "label": "Badge Font Size" },
    { "type": "range", "id": "badge_radisu", "min": 0, "max": 80, "step": 1, "default": 50, "label": "Badge Radius" },
    
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Results, Real People" },
    
    { "type": "text", "id": "review_text", "label": "Review Text", "default": "4.9 from 12,847 re4views" },
    { "type": "color", "id": "review_text_color", "label": "Badge Text Color", "default": "#1a7f4b" },
    { "type": "range", "id": "review_text_font_size", "min": 0, "max": 80, "step": 1, "default": 50, "label": "Review Text Font Size" },
    
    
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    
    { "type": "image_picker", "id": "before_image", "label": "Before Image" },
    { "type": "image_picker", "id": "after_image", "label": "After Image" },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 20,
      "label": "Image Border Radius"
    },
    { "type": "color", "id": "slider_color", "label": "Slider Line Color", "default": "#ffffff" },

    { "type": "text", "id": "disclaimer", "label": "Disclaimer Text" },
    { "type": "color", "id": "disclaimer_color", "label": "Disclaimer Color", "default": "#999999" },
    { "type": "range", "id": "disclaimer_font_size", "min": 0, "max": 50, "step": 2, "default": 14, "label": "Disclaimer Font Size" },
    
    { "type": "textarea", "id": "testimonial_text", "label": "Testimonial Text" },
    { "type": "image_picker","id": "author_image", "label": "Author Image"},
    { "type": "text", "id": "author_name", "label": "Author Name" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#ffffff" },
    { "type": "range", "id": "card_radius", "min": 0, "max": 50, "step": 2, "default": 20, "label": "Card Radius" },
    {
      "type": "range",
      "id": "testimonial_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "label": "Testimonial Font Size"
    },
    { "type": "color", "id": "testimonial_color", "label": "Testimonial Text Color", "default": "#333333" },
    { "type": "color", "id": "author_color", "label": "Author Color", "default": "#000000" }
  ],
  "presets": [{ "name": "Before / After Results" }]
}
{% endschema %}
