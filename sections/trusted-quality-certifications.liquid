{{ 'trusted-quality-certifications.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
{% capture style_schema %}
  --section-bg: {{ section.settings.section_bg }};
  --section-wraper-width: {% if section.settings.section_width %}100% {% else %}{{ section.settings.wraper_width }}px{% endif %};

    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-left: {{ section.settings.padding_left }}px;
    --section-padding-right: {{ section.settings.padding_right }}px;

    --section-mobile-padding-top: {{ section.settings.padding_top | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-bottom: {{ section.settings.padding_bottom | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-left: {{ section.settings.padding_left | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-right: {{ section.settings.padding_right | times: 0.55 | round: 0 }}px;
    --header-desktop-text-alignment: {{ section.settings.desktop_text_align }};
    --header-mobile-text-alignment: {{ section.settings.mobile_text_align }};
    
    --header-text-color:{{ section.settings.text_color }};
    --header-heading-color: {{ section.settings.heading_color }};
    --header-subheading-color: {{ section.settings.subheading_color }};

    --desktop-header-heading-size: {{ section.settings.desktop_heading_size }}px;
    --desktop-header-sub-heading-size: {{ section.settings.desktop_sub_heading_size }}px;
    --desktop-header-text-size: {{ section.settings.desktop_text_size }}px;

    --mobile-header-heading-size: {{ section.settings.mobile_heading_size }}px;
    --mobile-header-sub-heading-size: {{ section.settings.mobile_sub_heading_size }}px;
    --mobile-header-text-size: {{ section.settings.mobile_text_size }}px;
    --mobile-table-outer-radius: {{ section.settings.mobile-table-outer-radius }}px;
    --desktop-table-outer-radius: {{ section.settings.desktop-table-outer-radius }}px;
{% endcapture %}
<style>
</style>

<div class="trusted-quality-certifications-section"style="{{ style_schema }}">
  <div class="trusted-quality-certifications-container">
    <div class="section-header">
      {% if section.settings.heading != blank %}
        <h2 style="color: {{ section.settings.heading_color }};">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="header-sub-heading" style="color: {{ section.settings.subheading_color }};">
          {{ section.settings.subheading }}
        </div>
      {% endif %}
      {% if section.settings.content != blank %}
        <div class="rte content_header" style="color: {{ section.settings.text_color }};">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>

    <div class="trusted-quality-block">
      <div class="quality-block-wrapper columns-{{ section.settings.columns }}" id="quality-block-{{ section.id }}">
        {% assign reivew_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'quality_block' %}
            <div {{ block.shopify_attributes }}
              class="quality-block"
              data-index="{{ reivew_index }}"
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
                --divider-border-width: {{ block.settings.border_width }}px;
                --divider-border-color: {{ block.settings.border_color }};
                --avatar-size: {{ block.settings.avatar_size }}px;
              "
            >
              <div class="icon-wrapper"
               style="background: {{ block.settings.icon_bg }}; width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px;">

            {% if block.settings.icon_type == 'svg' and block.settings.svg_code != blank %}
              <div class="icon-svg"
                   style="color: {{ block.settings.icon_color }}; width: {{ block.settings.icon_size }}px;">
                {{ block.settings.svg_code }}
              </div>
            {% elsif block.settings.icon_type == 'image' and block.settings.icon_image != blank %}
    
            {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
               
              {{
                blcok.settings.icon_image
                | image_url: width: 1500
                | image_tag: widths: widths, fetchpriority: fetch_priority
              }}
            {% endif %}

          </div>

              {% if block.settings.review_text != blank %}
                <div
                  class="content-hedding-title"
                  style="color: {{ block.settings.text_color }}; --text-font-size: {{ block.settings.text_font }}px"
                >
                  {{ block.settings.review_text }}
                </div>
              {% endif %}
              {% if block.settings.review_content != blank %}
                <div
                  class="content_text_block"
                  style="color: {{ block.settings.content_color }};--purchase-font-size: {{ block.settings.content_font }}px;"
                >
                  {{ block.settings.review_content }}
                </div>
              {% endif %}
            </div>
            {% assign reivew_index = reivew_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="money_back_section">
      <div class="money_block_wrapper">
        {% assign money_back = 0 %}
      {% for block in section.blocks %}
        {% if block.type== 'money_block' %}
          <div {{ block.shopify_attributes }}
              class="quality-block"
              data-index="{{ money_back }}"
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
                --divider-border-width: {{ block.settings.border_width }}px;
                --divider-border-color: {{ block.settings.border_color }};
                --avatar-size: {{ block.settings.avatar_size }}px;
              "
            >
              <div class="icon-wrapper"
               style="background: {{ block.settings.icon_bg }}; width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px;" style="--icon-width: {{ block.settings.icon_size }}px">

            {% if block.settings.icon_type == 'svg' and block.settings.svg_code != blank %}
              <div class="icon-svg"
                   style="color: {{ block.settings.icon_color }}; width: {{ block.settings.icon_size }}px;">
                {{ block.settings.svg_code }}
              </div>
            {% elsif block.settings.icon_type == 'image' and block.settings.icon_image != blank %}
    
            {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
               
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: widths: widths, fetchpriority: fetch_priority
              }}
            {% endif %}

          </div>
          <div class="content_info_block">
              {% if block.settings.review_text != blank %}
                <div
                  class="content-hedding-title"
                  style="color: {{ block.settings.text_color }}; --text-font-size: {{ block.settings.text_font }}px"
                >
                  {{ block.settings.review_text }}
                </div>
              {% endif %}
              {% if block.settings.review_content != blank %}
                <div
                  class="content_text_block"
                  style="color: {{ block.settings.content_color }};--purchase-font-size: {{ block.settings.text_font }}px;"
                >
                  {{ block.settings.review_content }}
                </div>
              {% endif %}
              </div>
            </div>
            {% assign money_back = reivew_index | plus: 1 %}
        {% endif %}
      {% endfor %}
      </div>
    </div>
    <div class="featerd_logo_section">
      {% if section.settings.happy_customer != blank %}
        <div
          class="header_featured_logo"
          style="--font-size-desktop: {{  section.settings.happy_customer_font_size }}px; --font-color: {{ section.settings.happy_customer_Color }};"
        >
          {{ section.settings.happy_customer }}
        </div>
      {% endif %}
      <div class="featured_logo_container">
      {% for block in section.blocks %}
        {% if block.type == 'featured_logo' %}
          <div {{ block.shopify_attributes }}
            class="featured_logo_images "
            style="
              --block-bg: {{ block.settings.bg_color }};
              --block-radius: {{ block.settings.block_radius }}px;
              --block-text-color: {{ block.settings.text_color }};
              --block-desktop-padding-top: {{ block.settings.padding_top }}px;
              --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
              --block-desktop-padding-left: {{ block.settings.padding_left }}px;
              --block-desktop-padding-right: {{ block.settings.padding_right }}px;
              --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
              --divider-border-width: {{ block.settings.border_width }}px;
              --divider-border-color: {{ block.settings.border_color }};
            "
          >
            {% if block.settings.image != blank %}
              {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}

              {{
                block.settings.image
                | image_url: width: 1500
                | image_tag:
                  widths: widths,
                  alt: block.settings.image.alt,
                  sizes: '(min-width: 1200px) 700px, 100vw',
                  loading: 'lazy',
                  class: 'customer_image'
              }}
            {% else %}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.bottom_text != blank %}
      <div class="bottom_text_loved">{{ section.settings.bottom_text }}</div>
    {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trusted Quality",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "checkbox",
      "id": "section_width",
      "label": "Full Width"
    },
    {
      "type": "range",
      "id": "wraper_width",
      "label": "Container Width",
      "max": 1900,
      "min": 900,
      "default": 1400,
      "step": 100,
      "unit": "px",
      "visible_if": "{{ section.settings.section_width == false }}"
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Section Background",
      "default": "rgba(255, 255, 255, 1)"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Desktop Font Size"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_sub_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Body Font Size"
    },
    {
      "type": "header",
      "content": "Mobile Font Size"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 28,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_sub_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Body Font Size"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#6B6B6B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6B6B6B"
    },

    {
      "type": "select",
      "id": "desktop_text_align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Desktop Text Alignment"
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Mobile Text Alignment"
    },

    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted Quality & Certifications" },

    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Every batch meets pharmaceutical-grade standards and is independently verified</p>"
    },
    {
      "type": "range",
      "id": "desktop-table-outer-radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Desktop Table Ourter Radius"
    },
    {
      "type": "range",
      "id": "mobile-table-outer-radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "Mobile Table Ourter Radius"
    },
    {
      "type": "text",
      "label": "Featued In Text",
      "default": "As Featured In",
      "id": "happy_customer"
    },
    {
      "type": "color",
      "id": "happy_customer_font_color",
      "default": "rgba(115, 115, 115, 1)",
      "label": "Font Color"
    },
    {
      "type": "range",
      "id": "happy_customer_font_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Font Size"
    },
    {
      "type": "text",
      "label": "Bottom Text",
      "id": "bottom_text",
      "default": "View all 2,847 customer photos →"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Quality Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "quality_block",
      "name": "Quality Blocks",
      "settings": [
        {
          "type": "header",
          "content": "Block Spacing"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Padding Top",
          "max": 100,
          "min": 0,
          "default": 20,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "Padding Bottom",
          "max": 100,
          "min": 0,
          "default": 20,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_left",
          "label": "Padding Left",
          "max": 100,
          "min": 0,
          "default": 20,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_right",
          "label": "Padding Right",
          "max": 100,
          "min": 0,
          "default": 20,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "block_radius",
          "label": "Block Radius",
          "max": 100,
          "min": 0,
          "default": 14,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "color_background",
          "id": "bg_color",
          "label": "Block Background",
          "default": "#fff"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border Color",
          "default": "rgba(247, 231, 219, 1)"
        },
        {
          "type": "range",
          "id": "border_width",
          "label": "Border Size",
          "max": 100,
          "min": 0,
          "default": 2,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Block Content"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Type",
          "options": [
            { "value": "svg", "label": "SVG Code" },
            { "value": "image", "label": "Image Upload" }
          ],
          "default": "svg"
        },
        {
          "type": "textarea",
          "id": "svg_code",
          "label": "SVG Code (Only if SVG selected)",
          "visible_if": "{{ block.settings.icon_type == 'svg' }}"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image (Only if Image selected)",
          "visible_if": "{{ block.settings.icon_type == 'image' }}"
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon Size",
          "min": 20,
          "max": 80,
          "step": 2,
          "default": 40
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color",
          "default": "#8B5E3C"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Icon Background",
          "default": "#fff"
        },
        {
          "type": "text",
          "id": "review_text",
          "label": "Block Title",
          "default": "GMP Certified"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "rgba(64, 64, 64, 1)"
        },
        {
          "type": "range",
          "id": "text_font",
          "label": "Block Text Font Size",
          "max": 100,
          "min": 0,
          "default": 14,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "text",
          "id": "review_content",
          "label": "Block Content",
          "default": "<p>Good Manufacturing Practice</p>"
        },
        {
          "type": "color",
          "id": "content_color",
          "label": "Content Color",
          "default": "rgba(115, 115, 115, 1)"
        },
        { "type": "range", "id": "content-font-size", "min": 1, "max": 80, "step": 1, "default": 12, "label": "Content Font Size" }
      ]
    },
    {
      "type": "money_block",
      "name": "Money Back Blocks",
      "settings": [
        {
          "type": "header",
          "content": "Block Spacing"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Padding Top",
          "max": 100,
          "min": 0,
          "default": 70,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "Padding Bottom",
          "max": 100,
          "min": 0,
          "default": 70,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_left",
          "label": "Padding Left",
          "max": 100,
          "min": 0,
          "default": 50,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_right",
          "label": "Padding Right",
          "max": 100,
          "min": 0,
          "default": 50,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "block_radius",
          "label": "Block Radius",
          "max": 100,
          "min": 0,
          "default": 14,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "color_background",
          "id": "bg_color",
          "label": "Block Background",
          "default": "#fff"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border Color",
          "default": "rgba(164, 244, 207, 1)"
        },
        {
          "type": "range",
          "id": "border_width",
          "label": "Border Size",
          "max": 100,
          "min": 0,
          "default": 2,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Block Content"
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Type",
          "options": [
            { "value": "svg", "label": "SVG Code" },
            { "value": "image", "label": "Image Upload" }
          ],
          "default": "svg"
        },
        {
          "type": "textarea",
          "id": "svg_code",
          "label": "SVG Code (Only if SVG selected)",
          "visible_if": "{{ block.settings.icon_type == 'svg' }}"
        },
