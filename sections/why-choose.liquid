{{ 'why-choose.css' | asset_url | stylesheet_tag }}

{% capture style_schema %}
  --section-bg: {{ section.settings.section_bg }};
  --section-wraper-width: {% if section.settings.section_width %}100% {% else %}{{ section.settings.wraper_width }}px{% endif %};

  --section-padding-top: {{ section.settings.padding_top }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  --section-padding-left: {{ section.settings.padding_left }}px;
  --section-padding-right: {{ section.settings.padding_right }}px;
     
  --section-mobile-padding-top: {{ section.settings.padding_top | times: 0.55 | round: 0 }}px;
  --section-mobile-padding-bottom: {{ section.settings.padding_bottom | times: 0.55 | round: 0 }}px;
  --section-mobile-padding-left: {{ section.settings.padding_left | times: 0.55 | round: 0 }}px;
  --section-mobile-padding-right: {{ section.settings.padding_right | times: 0.55 | round: 0 }}px;
  --header-desktop-text-alignment: {{ section.settings.desktop_text_align }};
  --header-mobile-text-alignment: {{ section.settings.mobile_text_align }};
  
  --desktop-header-heading-size: {{ section.settings.desktop_heading_size }}px;
  --desktop-header-sub-heading-size: {{ section.settings.desktop_sub_heading_size }}px;
  --desktop-header-text-size: {{ section.settings.desktop_text_size }}px;
  
  --mobile-header-heading-size: {{ section.settings.mobile_heading_size }}px;
  --mobile-header-sub-heading-size: {{ section.settings.mobile_sub_heading_size }}px;
  --mobile-header-text-size: {{ section.settings.mobile_text_size }}px;
{% endcapture %}
{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
<div class="why-choose-section" style="{{ style_schema }}">
  <div class="why-choose-container">
    <div class="section-header">
      <h2 style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
      {% if section.settings.subheading != blank %}
      <div class="header-sub-heading" style="color: {{ section.settings.subheading_color }};">
        {{ section.settings.subheading }}
      </div>
      {% endif %}
      {% if section.settings.content != blank %}
      <div class="rte content_header" style="color: {{ section.settings.text_color }};">
        {{ section.settings.content }}
        </div>
    {% endif %}
    </div>

    <div class="feature-grid columns-{{ section.settings.columns }}">
      {% for block in section.blocks %}
        <div class="feature-card"
             style="
               background: {{ block.settings.card_bg }};
               border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
               border-radius: {{ block.settings.border_radius }}px;
             "
             {{ block.shopify_attributes }}>

          <div class="icon-wrapper"
               style="background: {{ block.settings.icon_bg }}; width: {{ block.settings.icon_size | plus: 20 }}px; height: {{ block.settings.icon_size | plus: 20 }}px;">

            {% if block.settings.icon_type == 'svg' and block.settings.svg_code != blank %}
              <div class="icon-svg"
                   style="color: {{ block.settings.icon_color }}; width: {{ block.settings.icon_size }}px;">
                {{ block.settings.svg_code }}
              </div>
            {% elsif block.settings.icon_type == 'image' and block.settings.icon_image != blank %}
    
            {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
               
              {{
                block.settings.icon_image
                | image_url: width: 1500
                | image_tag: widths: widths, fetchpriority: fetch_priority
              }}
            {% endif %}

          </div>

          <h3 style="color: {{ block.settings.title_color }};">
            {{ block.settings.title }}
          </h3>

          <div class="block_content_box" style="--text-block-color: {{ block.settings.text_color }};">
            {{ block.settings.description }}
          </div>

        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Choose Section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "checkbox",
      "id": "section_width",
      "label": "Full Width"
    },
    {
      "type": "range",
      "id": "wraper_width",
      "label": "Container Width",
      "max": 1900,
      "min": 900,
      "default": 1400,
      "step": 100,
      "unit": "px",
      "visible_if": "{{ section.settings.section_width == false }}"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
          "type": "select",
          "id": "desktop_text_align",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center",
          "label": "Desktop Text Alignment"
        },
        {
          "type": "select",
          "id": "mobile_text_align",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center",
          "label": "Mobile Text Alignment"
        },
        
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Our Formula"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Evidence-based ingredients backed by clinical research, trusted by health professionals worldwide"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Desktop Font Size"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_sub_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Body Font Size"
    },
    {
      "type": "header",
      "content": "Mobile Font Size"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 28,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_sub_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Body Font Size"
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#F3EFEA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#6B6B6B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6B6B6B"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Type",
          "options": [
            { "value": "svg", "label": "SVG Code" },
            { "value": "image", "label": "Image Upload" }
          ],
          "default": "svg"
        },
        {
          "type": "textarea",
          "id": "svg_code",
          "label": "SVG Code (Only if SVG selected)",
          "visible_if": "{{ block.settings.icon_type == 'svg' }}"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image (Only if Image selected)",
          "visible_if": "{{ block.settings.icon_type == 'image' }}"
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon Size",
          "min": 20,
          "max": 80,
          "step": 2,
          "default": 40
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color",
          "default": "#8B5E3C"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Icon Background",
          "default": "#E8D8C3"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Natural Ingredients"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Sourced from certified organic farms with zero synthetic additives.</p>"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#1F1F1F"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#6B6B6B"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card Background",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "border_width",
          "label": "Border Width",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 1
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border Color",
          "default": "#E5E5E5"
        },
        {
          "type": "range",
          "id": "border_radius",
          "label": "Border Radius",
          "min": 0,
          "max": 30,
          "step": 2,
          "default": 12
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Section",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
