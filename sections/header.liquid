{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}
{% render 'search-drawer' %}
{% render 'mobile-menu' %}
<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="reduce-logo-size"
  {% endif %}
  style="--padding-top-mobile:{{- section.settings.padding_top | times : 0.5 -}}px;
  --padding-bottom-mobile:{{- section.settings.padding_bottom | times: 0.5 -}}px;
  --padding-top-desktop:{{- section.settings.padding_top -}}px;
  --padding-bottom-desktop:{{- section.settings.padding_bottom -}}px;"
  class="{% if section.settings.show_line_separator %} border-bottom {% endif %}{% if section.settings.header_transparent and template contains 'index' or section.settings.header_transparent and template contains 'collection' or section.settings.header_transparent and product.metafields.custom.feature_slide_images.value.size >= 1 or template contains 'product.zoom-service' %} header_transparent {% endif %} headerSection color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <header  class="headerWrapper page-width {% if section.menu_type_desktop == 'drawar' %}drawr-menu {% elsif section.settings.menu_type_desktop == 'dropdwon' %} dropdown_menu {% else %} desktop_mega_menu {% endif %}">
    <div class="mobile_drawer">
      <div class="header__buttons open-mobile-menu">
        <div class="mb_button" style="cursor: pointer;display: flex;">
          <svg
            class="icon icon-hamburger icon-lg"
            style="width: 24px"
            viewBox="0 0 24 24"
            stroke="currentColor"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path stroke-linecap="round" d="M3 6H21M3 12H11M3 18H16"></path>
          </svg>
        </div>
        <a href="{{ routes.account_login_url }}" class="account-button">
          <span class="visually-hidden">{{ 'customers.login.title' | t }}</span>
          <svg
            class="icon icon-account"
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="20"
            viewBox="0 0 15 20"
            fill="none"
          >
            <path d="M7.38176 8.32895C9.47463 8.32895 11.1712 6.63234 11.1712 4.53947C11.1712 2.44661 9.47463 0.75 7.38176 0.75C5.28889 0.75 3.59229 2.44661 3.59229 4.53947C3.59229 6.63234 5.28889 8.32895 7.38176 8.32895Z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M7.38158 18.75C11.0441 18.75 14.0132 17.0534 14.0132 14.9605C14.0132 12.8677 11.0441 11.1711 7.38158 11.1711C3.71906 11.1711 0.75 12.8677 0.75 14.9605C0.75 17.0534 3.71906 18.75 7.38158 18.75Z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </a>
      </div>
    </div>
    {% if section.settings.logo_center and section.settings.seconday_menu != blank %}
      <div class="leftheader">
        {% if section.settings.booking_link != blank %}
          <bookingLink>
            <a
              class="{% if section.settings.button_style == 'link' %} link {% else %} button button--{{ section.settings.button_style }} {% endif %}"
              href="{{ section.settings.booking_link }}"
            >
              {{- section.settings.booking_link_text -}}
            </a>
          </bookingLink>
        {% endif %}
        <desktopMenuSecondary class="desktopMenu">
          {% render 'site-nav', menu: section.settings.seconday_menu %}
        </desktopMenuSecondary>
      </div>
    {% endif %}
    <div class="header-logo">
      <a href="{{ routes.root_url }}" class="header__link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__logo motion-reduce',
                widths: widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                fetchpriority:"high",
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>
    {% if section.settings.logo_center and section.settings.seconday_menu != blank %}
      <div class="rightheader">
    {% endif %}
    <desktopMenu class="desktopMenu">
      {% render 'site-nav', menu: section.settings.menu %}
    </desktopMenu>
    <headerUtilities>
      <div class="header__buttons">
        {% comment %}  {% endcomment %}
        <a href="{{ routes.search_url }}" aria-label="Search" data-open-search class="search-drawer-button">
          <span class="visually-hidden">Search</span>
          <svg
            class="icon icon-search"
            xmlns="http://www.w3.org/2000/svg"
            width="17"
            height="17"
            viewBox="0 0 17 17"
            fill="none"
          >
            <path d="M12.7471 12.7196L15.7775 15.75M14.7894 7.7697C14.7894 11.6466 11.6466 14.7894 7.7697 14.7894C3.89282 14.7894 0.75 11.6466 0.75 7.7697C0.75 3.89282 3.89282 0.75 7.7697 0.75C11.6466 0.75 14.7894 3.89282 14.7894 7.7697Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="{{ routes.account_login_url }}" aria-label="Customers" class="account-button small-hide">
          <span class="visually-hidden">{{ 'customers.login.title' | t }}</span>
          <svg
            class="icon icon-account"
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="20"
            viewBox="0 0 15 20"
            fill="none"
          >
            <path d="M7.38176 8.32895C9.47463 8.32895 11.1712 6.63234 11.1712 4.53947C11.1712 2.44661 9.47463 0.75 7.38176 0.75C5.28889 0.75 3.59229 2.44661 3.59229 4.53947C3.59229 6.63234 5.28889 8.32895 7.38176 8.32895Z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M7.38158 18.75C11.0441 18.75 14.0132 17.0534 14.0132 14.9605C14.0132 12.8677 11.0441 11.1711 7.38158 11.1711C3.71906 11.1711 0.75 12.8677 0.75 14.9605C0.75 17.0534 3.71906 18.75 7.38158 18.75Z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </a>
        <a href="{{ routes.cart_url }}"  aria-hidden="true" class="cart-button" id="cart-icon-bubble">
          <span class="visually-hidden">{{ 'cart.title' | t }}</span>
          <svg
            class="icon icon-cart"
            xmlns="http://www.w3.org/2000/svg"
            width="19"
            height="20"
            viewBox="0 0 19 20"
            fill="none"
          >
            <path d="M13.2722 6.04412H14.5001C15.6015 6.04412 16.519 6.88834 16.6105 7.98591L17.3164 16.4565C17.4193 17.6911 16.445 18.75 15.2061 18.75H2.86779C1.62888 18.75 0.654575 17.6911 0.757461 16.4565L1.46335 7.98591C1.55481 6.88834 2.47231 6.04412 3.57368 6.04412H4.80163M13.2722 6.04412H4.80163M13.2722 6.04412V4.98529C13.2722 3.86202 12.826 2.78476 12.0317 1.99049C11.2375 1.19622 10.1602 0.75 9.03692 0.75C7.91362 0.75 6.83639 1.19622 6.04211 1.99049C5.24785 2.78476 4.80163 3.86202 4.80163 4.98529V6.04412M13.2722 6.04412V10.2794M4.80163 6.04412V10.2794" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'cart.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
      </div>
    </headerUtilities>
    {% if section.settings.logo_center and section.settings.seconday_menu != blank %}
      </div>
    {% endif %}
    <div class="header_icons_radius">
      <span class="dropdown__corner corner left top flex absolute pointer-events-none">
        <svg
          class="w-full h-auto"
          viewBox="0 0 101 101"
          stroke="none"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path fill-rule="evenodd" clip-rule="evenodd" d="M101 0H0V101H1C1 45.7715 45.7715 1 101 1V0Z"></path>
          <path d="M1 101C1 45.7715 45.7715 1 101 1" fill="none"></path>
        </svg>
      </span>

      <span class="dropdown__corner corner right top flex absolute pointer-events-none">
        <svg
          class="w-full h-auto"
          viewBox="0 0 101 101"
          stroke="none"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path fill-rule="evenodd" clip-rule="evenodd" d="M101 0H0V101H1C1 45.7715 45.7715 1 101 1V0Z"></path>
          <path d="M1 101C1 45.7715 45.7715 1 101 1" fill="none"></path>
        </svg>
      </span>
    </div>
  </header>
</{{ header_tag }}>
{% javascript %}
  const body = document.body;
  const drawer = document.getElementById('SearchDrawer');
  const overlay = document.getElementById('SearchDrawerOverlay');
  const closeBtn = document.getElementById('SearchDrawerClose');
  document.querySelectorAll('.menu_overlay').forEach((btn) => {
    btn.addEventListener('mouseover', (e) => {
      e.preventDefault();
      document.body.classList.remove('open_menu');
    });
  });

  // --- OPEN DRAWER (add your search icon button id) ---
  document.querySelectorAll('[data-open-search]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      body.classList.add('search-drawer-open');
    });
  });

  // --- CLOSE DRAWER ---
  function closeDrawer() {
    body.classList.remove('search-drawer-open');
  }

  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);

  let items = document.querySelectorAll('.dropDownMenu');
  items.forEach((item) => {
    item.addEventListener('mouseover', () => {
      document.body.classList.add('open_menu');
      item.addEventListener('mouseleave', () => {
        document.body.classList.remove('open_menu');
      });
    });
  });

  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.transparentHeader = this.classList.contains('header_transparent');
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }
      if (this.transparentHeader) {
        this.header.classList.add('shopify-section-header-transparent');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);
      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
  const menu = document.querySelector('.mobile-menu');
  const mobile_overlay = document.querySelector('.mobile-menu-overlay');
  const mobileOpenBtn = document.querySelector('.open-mobile-menu');
  const mobileCloseBtn = document.querySelector('.close-mobile-menu');
  const mobile_data = document.querySelector('desktopMenu');
  const mobile_second = document.querySelector('desktopmenusecondary');
  const DesktopMenuClone = mobile_data.querySelector('nav').cloneNode(true);

// Open menu
mobileOpenBtn.addEventListener('click', () => {
  menu.classList.add('active');
  document.body.classList.add('open_mobile_menu');
  if (mobile_second){
    const DesktopSecondMenuClone = mobile_second.querySelector('nav').cloneNode(true);
    menu.querySelector('mobileMenuWrapper').appendChild(DesktopSecondMenuClone);
  }
  menu.querySelector('mobileMenuWrapper').appendChild(DesktopMenuClone);
  
  subMenu();
  closeSubMenu()
  mobile_overlay.classList.add('active');
});
function closeSubMenu(){
  subItem = menu.querySelectorAll('.moblle_back_header')
  subItem.forEach(btn => {
  btn.addEventListener('click', (e) => {
    const parentUl = e.target.closest('.list-menu');
    parentUl.classList.remove('active');;
    const ParentLi = e.target.closest('li');
    ParentLi.classList.remove('active');;
  })
  })
}
function subMenu (){
  subItem = menu.querySelectorAll('.icon-dropdown')
  subItem.forEach(btn => {
  btn.addEventListener('click', (e) => {
    const parentUl = e.target.closest('.list-menu');
    parentUl.classList.add('active');;
    const ParentLi = e.target.closest('li');
    ParentLi.classList.add('active');;
  })
  })
}
// Close menu
function closeMenu() {
  menu.classList.remove('active');
  document.body.classList.remove('open_mobile_menu');
  mobile_overlay.classList.remove('active');
}

mobileCloseBtn.addEventListener('click', closeMenu);
mobile_overlay.addEventListener('click', closeMenu);

/* ------------------------
   Swipe Left to Close
------------------------ */
let startX = 0;

menu.addEventListener(
  'touchstart',
  e => {
    startX = e.touches[0].clientX;
  },
  { passive: true }
);

menu.addEventListener(
  'touchmove',
  e => {
    const currentX = e.touches[0].clientX;
    const diff = startX - currentX;

    if (diff > 70) closeMenu(); // swipe left
  },
  { passive: true }
);


{% endjavascript %}

{%- stylesheet -%}
    /* section-header */
.section-header.shopify-section-group-header-group {
	z-index: 3;
}

.shopify-section-header-sticky {
	position: sticky;
	top: 0;
}

.shopify-section-header-hidden {
	top: calc(-1 * var(--header-height));
}

.shopify-section-header-hidden.menu-open {
	top: 0;
}

.section-header.animate {
	transition: top 0.15s ease-out;
}

.shopify-section-group-header-group {
	z-index: 4;
}

body.search-drawer-open .shopify-section-group-header-group,
body.open_mobile_menu .shopify-section-group-header-group {
	z-index: 1;
}

.section-header~.shopify-section-group-header-group {
	z-index: initial;
}
.cart-count-bubble {
    font-size: 11px;
    text-decoration: none;
    position: absolute;
    background: rgba(var(--color-foreground));
    color: rgba(var(--color-background));
    z-index: 1;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 100%;
    right: -7px;
    top: -7px;
}
/* Overlay */
#SearchDrawerOverlay {
	position: fixed;
	inset: 0;
	background: rgba(0, 0, 0, 0.4);
	opacity: 0;
	pointer-events: none;
	transition: opacity .3s ease;
	z-index: 90;
  cursor: url("data:image/svg+xml;utf8,\<svg xmlns='http://www.w3.org/2000/svg' width='28' height='28'>\<line x1='4' y1='4' x2='24' y2='24' stroke='white' stroke-width='3'/>\<line x1='24' y1='4' x2='4' y2='24' stroke='white' stroke-width='3'/>\</svg>") 14 14, pointer;
}

.cart-drawer__overlay {
	cursor: none !important;
}

/* Drawer */
#SearchDrawer {
	position: fixed;
	top: 0;
	right: 0;
	width: 576px;
	max-width: 90%;
	height: 100vh;
	background: #fff;
	transform: translateX(100%);
	transition: transform .3s ease;
	z-index: 99;
	display: flex;
	flex-direction: column;
	border-radius: 30px 0px 0px 30px;
}

/* When Active */
.search-drawer-open #SearchDrawer {
	transform: translateX(0);
}

.search-drawer-open #SearchDrawerOverlay {
	opacity: 1;
	pointer-events: auto;
}

.search-drawer-body {
	padding: 0 4rem;
}

.search-drawer-body input[type="text"] {
	width: 100%;
	margin: 0 auto;
	height: 62px;
	border-radius: 5px;
	border: 1px solid #fbfafa;
	background: #fbfafa;
	padding: 0 3rem;
	font-size: 18px;
}

.search-drawer-body button {
	display: none;
}

/* Header */
.search-drawer-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 4rem;
}

.overflow-hidden-mobile .section-header.shopify-section-group-header-group {
	z-index: 1;
}

.search-close {
	width: 48px;
	height: 48px;
	display: flex;
	align-items: center;
	justify-content: center;
}



/* -------------------- */
/* Mobile menu styles   */
/* -------------------- */
.mobile-menu-overlay {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: #0006;
	opacity: 0;
	pointer-events: none;
	transition: opacity .3s ease;
	z-index: 90;
	cursor: none !important;
}

product-info>.page-width {
	max-width: 1570px;
}

.mobile-menu {
	position: fixed;
	top: 0;
	left: 0;
	width: 57.6rem;
	max-width: 90%;
	height: 100vh;
	background: #fff;
	transform: translateX(-100%);
	transition: transform .3s ease;
	z-index: 99;
	display: flex;
	flex-direction: column;
	border-radius: 0 40px 40px 0;
}
.visually-hidden{
  display:none;
}
.mobile-menu.active {
	transform: translateX(0%);
}

.mobile-menu-overlay.active {
	opacity: 1;
	pointer-events: auto;
}

.close-mobile-menu {
	background: none;
	border: none;
	font-size: 30px;
	float: right;
}
/* Main Header Layout */
.header-wrapper {
	display: block;
	position: relative;
	background-color: rgb(var(--color-background));
}

.header-wrapper--border-bottom {
	border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.08);
}

.header {
	display: grid;
	grid-template-areas: 'left-icons heading icons';
	grid-template-columns: 1fr 2fr 1fr;
	align-items: center;
}

    .menu_overlay {
        display: none;
    }
    .open-mobile-menu {
      display: none;
    }
    .header.headerWrapper{
    padding: var(--padding-top-mobile) 0rem var(--padding-bottom-mobile) 0rem;
    }
    .scrolled-past-header header.headerWrapper{
      transition: all .5s cubic-bezier(.6, 0, .4, 1);
      padding-top:  var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
    .open_menu .menu_overlay {
    position: fixed;
    display: block;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background: #0000007a;
    z-index: 3;
    transition: 2s ease in-out;
    }
    #cart-icon-bubble {
      position: relative;
    }
    @keyframes moveAround {
      0% {
        transform: translate(0, 0);
      }
      25% {
        transform: translate(3px, -3px);
      }
      50% {
        transform: translate(0, 0);
      }
      75% {
        transform: translate(-3px, 3px);
      }
      100% {
        transform: translate(0, 0);
      }
    }
    .header_icons_radius {
      display: none;
    }

    .mobile_drawer {
      display: none;
    }
    .headerSection {
      display: block;
      width: 100%;
    }
    header.headerWrapper {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: var(--padding-top-desktop);
      padding-bottom: var(--padding-bottom-desktop);
    }
    .header__buttons {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .header__buttons a {
      display: flex;
      text-align: center;
      color: rgba(var(--color-foreground));
    }
    header_logo img {
      display: block;
    }
    header_logo a {
      display: flex;
    }
    .header__buttons a:hover {
      animation: moveAround 3.5s infinite ease-in-out;
    }
    .header__buttons a svg {
      width: 24px;
      height: 20px;
      stroke-width: 1.4px;
      stroke: rgb(var(--color-foreground));
    }
    .all_link {
      width: 100%;
      position: relative;
    }
    .all_link:before {
      --tw-scale-x: 0;
      content: "";
      background-color: rgb(var(--color-foreground));
      position: absolute;
      height: 1px;
      inset-inline: 0;
      inset-block-start: 0;
      transform: scaleX(var(--tw-scale-x)) scaleY(1);
      transform-origin: center left;
      transition: transform 1s cubic-bezier(0.215, 0.61, 0.355, 1);
      transition-delay: 0.5s;
    }
    span.dropdown__corner {
      width: 24px;
      position: absolute;
    }
    .dropdown__corner.left {
      left: -23px;
    }
    .dropdown__corner.left svg {
      transform: rotate(90deg);
    }

    .corner.right {
      right: -23px;
    }

    .corner svg {
      fill: rgb(var(--color-background));
    }
    nav.mobile-menu.active .desktopMenu {
      display: block;
    }
    .link_effect {
      color: rgba(var(--color-foreground));
      display: inline-block;
    }
    .menutitle.lable {
      font-size: 19px;
      font-weight: bold;
      border-bottom: 1px solid;
      margin-bottom: 15px;
    }
    bookinglink {
      display: none;
    }
      /*======================= Desktop Menu =====================*/
