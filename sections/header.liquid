        display: flex;
        flex-wrap: wrap;
        list-style: none;
        padding: 0;
        margin: 0;
        align-items: center;
        justify-content: center;
      }
      header-menu.dropDownMenu:hover .DropDown {
        visibility: visible;
        opacity: 1;
      }

      .dropdown__container {
        border-end-start-radius: 1.25rem;
        border-end-end-radius: 1.25rem;
        background: rgb(var(--color-background));
        position: relative;
        transition: transform 0.5s cubic-bezier(0.3, 1, 0.3, 1);
        transform: translateY(-100%);
        margin: 0 24px;
        padding-block-end: 2.5rem;
      }
      header-menu.dropDownMenu:hover .DropDown .dropdown__container {
        transform: translateY(0%) !important;
        transition: transform 0.5s cubic-bezier(0.3, 1, 0.3, 1);
      }
      .DropDown ul {
        display: flex;
        flex-direction: column;
      }
      .DropDown ul li,
      .Promo_item,
      .promo_info {
        transform: translate(calc(20% * 1));
        transition: transform 1s cubic-bezier(0.075, 0.82, 0.165, 1),
          opacity 1s cubic-bezier(0.19, 1, 0.22, 1);
        transition-delay: 0.2s;
        opacity: 0;
      }

      header-menu.dropDownMenu:hover .DropDown ul li,
      .DropDown:hover .DropDown ul li,
      header-menu.dropDownMenu:hover .Promo_item,
      header-menu.dropDownMenu:hover .promo_info {
        opacity: 1;
        transform: translate(0%);
        transition-delay: 0.2s;
      }
      header-menu.dropDownMenu a,
      .link_effect {
        background: linear-gradient(to right, currentColor, currentColor) 0
          min(100%, 1.35em) / 0 1px no-repeat;
        background-position-x: right;
        transition: background-size 0.5s cubic-bezier(0.3, 1, 0.3, 1);
        text-decoration: none;
      }

      header-menu.dropDownMenu a:hover,
      .link_effect:hover {
        background-position-x: left;
        background-size: 100% 1px;
      }
      header-menu a {
        overflow: hidden;
        padding-inline: 1.66rem;
        letter-spacing: 0.6px;
        border-radius: 9999px;
        display: flex;
        text-decoration: none;
        position: relative;
        color: rgba(var(--color-foreground));
        text-decoration: none;
        font-weight: 400;
        font-size: 18px;
        height: 40px;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-family: var(--font-body-family);
      }
      header-menu.dropDownMenu .link_effect:hover,
      bookinglink a.link:hover {
        color: rgba(var(--color-button));
      }
      bookinglink a.link {
        font-size: 18px;
        text-decoration: none;
      }
      header-menu a span {
        font-family: var(--font-body-family);
      }

      .DropDown {
        position: absolute;
        visibility: hidden;
        opacity: 0;
        max-width: 275px;
        margin-inline-start: calc(3.5rem * -1);
        min-width: 275px;
        width: max-content;
        top: 100%;
        z-index: 2;
        flex-wrap: wrap;
      }
      header-menu.dropDownMenu:hover:before {
        content: "";
        position: absolute;
        top: 60%;
        right: 0;
        left: 0;
        height: 80px;
        z-index: 1;
      }
      header-menu :hover .DropDown,
      .DropDown:hover {
        visibility: visible;
        opacity: 1;
      }
      childmenulist:hover:before {
        content: "";
        position: absolute;
        width: 50px;
        height: 31px;
        margin: auto;
        right: -10px;
      }
      header-menu .menu_text {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
      }
      header-menu:hover .menu_text {
        opacity: 0;
        transform: translateY(-10%) scale(0.6);
      }
      header-menu.main_link > a {
        background-size: 0 !important;
      }
      .duplicate_main_hover {
        --tw-scale: 0.6;
        --tw-translate-y: 100%;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        border-radius: 9999px;
        color: rgba(var(--color-background));
        background-color: rgba(var(--color-foreground));
        transition: transform 0.5s cubic-bezier(0.3, 1, 0.3, 1);
        transform: translateY(var(--tw-translate-y)) scale(var(--tw-scale));
      }
      header-menu:hover .duplicate_main_hover {
        --tw-scale: 1;
        --tw-translate-y: 0%;
      }

      .DropDown ul.header_menu_list-menu {
        display: flex;
        text-align: left;
        width: 100%;
        align-items: flex-start;
        padding-top: 2rem;
      }

      .DropDown ul.header_menu_list-menu li {
        width: 100%;
        padding: 5px 20px;
      }

      .DropDown ul.header_menu_list-menu li a {
        text-align: left;
        padding-inline: 0;
        font-weight: 100;
        display: inline-block;
        height: auto;
        font-size: 15px;
        position: unset;
      }

      .menu_items li:first-child a {
        font-size: 17px;
        font-weight: 300;
        font-style: normal;
      }

      .menu_items_list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: stretch;
      }
      .all_link a {
        background: transparent !important;
      }
      .menu_items_list .Promo_item {
        width: calc(25% - 10px);
      }
      childmenulistitem.submenu_item {
        display: flex;
        justify-content: space-between;
        position: relative;
      }

      childmenulist:hover > ul.childMenuListItemDropDown {
        visibility: visible;
        opacity: 1;
        transform: translatex(100%);
      }

      childmenulist ul.childMenuListItemDropDown {
        background: var(--gradient-background);
        position: absolute;
        top: 0;
        position: absolute;
        visibility: hidden;
        opacity: 0;
        max-width: 275px;
        min-width: 275px;
        width: max-content;
        top: 0;
        z-index: -1;
        border-radius: 0 10px 10px 0;
        padding: 12px;
        transition: transform 0.5s cubic-bezier(0.3, 1, 0.3, 1);
        transform: translatex(0);
        right: 0;
      }
      childmenulistitem.submenu_item svg.icon.icon-caret {
        width: 13px;
        transform: rotate(-90deg);
        position: absolute;
        right: 10px;
        top: 5px;
      }
    }

