      .shopify-section-header-transparent:hover sticky-header.border-bottom {
        border-bottom: 1px solid rgba(var(--color-button-text),.5);
      }
      .scrolled-past-header.shopify-section-header-transparent sticky-header.border-bottom {
        border-bottom: 1px solid rgba(var(--color-button-text),.5);
      }
      .shopify-section-header-transparent:hover sticky-header,
      .scrolled-past-header sticky-header {
        background: rgb(var(--color-background)) !important;
	      background: var(--gradient-background) !important;
      }
