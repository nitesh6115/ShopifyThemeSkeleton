      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
