{{ 'loved-by-thousands.css' | asset_url | stylesheet_tag }}
{%- assign has_reviews_block = false -%}
{%- assign has_happy_customer_block = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'customer_reviews' -%}
    {%- assign has_reviews_block = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'happy_customer' -%}
    {%- assign has_happy_customer_block = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{% capture style_schema %}

     --section-bg: {{ section.settings.section_bg }};
    --section-wraper-width: {% if section.settings.section_width %}100% {% else %}{{ section.settings.wraper_width }}px{% endif %};

    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-left: {{ section.settings.padding_left }}px;
    --section-padding-right: {{ section.settings.padding_right }}px;

    --section-mobile-padding-top: {{ section.settings.padding_top | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-bottom: {{ section.settings.padding_bottom | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-left: {{ section.settings.padding_left | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-right: {{ section.settings.padding_right | times: 0.55 | round: 0 }}px;
    --header-desktop-text-alignment: {{ section.settings.desktop_text_align }};
    --header-mobile-text-alignment: {{ section.settings.mobile_text_align }};

    --header-text-color:{{ section.settings.text_color }};
    --header-heading-color: {{ section.settings.heading_color }};
    --header-subheading-color: {{ section.settings.subheading_color }};

    --desktop-header-heading-size: {{ section.settings.desktop_heading_size }}px;
    --desktop-header-sub-heading-size: {{ section.settings.desktop_sub_heading_size }}px;
    --desktop-header-text-size: {{ section.settings.desktop_text_size }}px;

    --mobile-header-heading-size: {{ section.settings.mobile_heading_size }}px;
    --mobile-header-sub-heading-size: {{ section.settings.mobile_sub_heading_size }}px;
    --mobile-header-text-size: {{ section.settings.mobile_text_size }}px;
    --mobile-table-outer-radius: {{ section.settings.mobile-table-outer-radius }}px;
    --desktop-table-outer-radius: {{ section.settings.desktop-table-outer-radius }}px;

{%  endcapture %}
<div class="loved-by-thousands-section" style="{{ style_schema }}">
  <div class="loved-by-thousands-container">
    <div class="section-header">
      {% if section.settings.badge_text != blank %}
        <div class="before-after-badge">
          {{ section.settings.badge_text }}
        </div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 style="color: {{ section.settings.heading_color }};">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      {% if section.settings.review_text != blank %}
        <div class="review-stars-text">
          {{ section.settings.review_text }}
        </div>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="header-sub-heading" style="color: {{ section.settings.subheading_color }};">
          {{ section.settings.subheading }}
        </div>
      {% endif %}
      {% if section.settings.content != blank %}
        <div class="rte content_header" style="color: {{ section.settings.text_color }};">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>
    {% if has_reviews_block %}
    <div class="review-slider-section">
      <div class="review-slider-wrapper" id="review-slider-{{ section.id }}">
        {% assign reivew_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'customer_reviews' %}
            <div {{ block.shopify_attributes }}
              class="customer_reviews review-slide {% if reivew_index == 0 %}active{% endif %}"
              data-index="{{ reivew_index }}"
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
                --divider-border-width: {{ block.settings.border_width }}px;
                --divider-border-color: {{ block.settings.border_color }};
                --avatar-size: {{ block.settings.avatar_size }}px;
              "
            >
              {% if block.settings.author_image != blank %}
                {%- assign widths = '165,360,535,750,1070,1500' -%}

                {{
                  block.settings.author_image
                  | image_url: width: block.settings.avatar_size
                  | image_tag:
                    alt: block.settings.author_image,
                    widths: widths,
                    sizes: '(min-width: 1200px) 700px, 100vw',
                    loading: 'lazy',
                    class: 'review-avatar'
                }}
              {% endif %}

              <div
                class="review-stars"
                style="--rating-color: {{ block.settings.star_color }}; --rating-font: {{block.settings.star_size }}px"
              >
                {% for i in (1..block.settings.rating) -%}
                  ★
                {%- endfor %}
              </div>
              {% if block.settings.review_text != blank %}
                <div
                  class="review-text"
                  style="color: {{ block.settings.text_color }}; --text-font-size: {{ block.settings.text_font }}px"
                >
                  "{{ block.settings.review_text }}"
                </div>
              {% endif %}
              {% if block.settings.name != blank %}
                <div class="review-name">
                  {{ block.settings.name }}
                  {% if block.settings.verified %}
                    <span class="verified-badge">✔ Verified Buyer</span>
                  {% endif %}
                </div>
              {% endif %}
              {% if block.settings.purchase_text != blank %}
                <div
                  class="review_purchase_text"
                  style="color: {{ block.settings.purchase_text_color }};--purchase-font-size: {{ block.settings.purchase_text_font }}px;"
                >
                  {{ block.settings.purchase_text }}
                </div>
              {% endif %}
            </div>
            {% assign reivew_index = reivew_index | plus: 1 %}
          {% endif %}
        {% endfor %}
        
        <button class="review-nav review-prev">‹</button>
        <button class="review-nav review-next">›</button>

        <div class="review-dots">
          {% assign dot_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'customer_reviews' %}
              <span class="review-dot {% if dot_index == 0 %}active{% endif %}" data-index="{{ dot_index }}"></span>
              {% assign dot_index = dot_index | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const slider = document.getElementById('review-slider-{{ section.id }}');
        if (!slider) return;
        const slides = slider.querySelectorAll('.review-slide');
        const dots = slider.querySelectorAll('.review-dot');
        const prev = slider.querySelector('.review-prev');
        const next = slider.querySelector('.review-next');

        let current = 0;

        function showSlide(index) {
          slides.forEach((slide, i) => {
            slide.classList.toggle('active', i === index);
          });

          dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === index);
          });

          current = index;
        }

        prev.addEventListener('click', () => {
          let newIndex = current - 1;
          if (newIndex < 0) newIndex = slides.length - 1;
          showSlide(newIndex);
        });

        next.addEventListener('click', () => {
          let newIndex = current + 1;
          if (newIndex >= slides.length) newIndex = 0;
          showSlide(newIndex);
        });

        dots.forEach((dot) => {
          dot.addEventListener('click', function () {
            showSlide(parseInt(this.dataset.index));
          });
        });
      });
    </script>
  {% endif %}
    <div class="happy_customers_box">
      {% if section.settings.happy_customer != blank %}
        <div
          class="header_happycustomer"
          style="--font-size-desktop: {{  section.settings.happy_customer_font_size }}px; --font-color: {{ section.settings.happy_customer_Color }};"
        >
          {{ section.settings.happy_customer }}
        </div>
      {% endif %}
      {% if has_happy_customer_block %}
      <div class="happy-customer_container">
      {% for block in section.blocks %}
        {% if block.type == 'happy_customer' %}
          <div {{ block.shopify_attributes }}
            class="happy_customer_images "
            style="
              --block-bg: {{ block.settings.bg_color }};
              --block-radius: {{ block.settings.block_radius }}px;
              --block-text-color: {{ block.settings.text_color }};
              --block-desktop-padding-top: {{ block.settings.padding_top }}px;
              --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
              --block-desktop-padding-left: {{ block.settings.padding_left }}px;
              --block-desktop-padding-right: {{ block.settings.padding_right }}px;
              --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
              --divider-border-width: {{ block.settings.border_width }}px;
              --divider-border-color: {{ block.settings.border_color }};
            "
          >
            {% if block.settings.image != blank %}
              {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}

              {{
                block.settings.image
                | image_url: width: 1500
                | image_tag:
                  widths: widths,
                  alt: block.settings.image.alt,
                  sizes: '(min-width: 1200px) 700px, 100vw',
                  loading: 'lazy',
                  class: 'customer_image'
              }}
            {% else %}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
    {% if section.settings.bottom_text != blank %}
      <div class="bottom_text_loved">{{ section.settings.bottom_text }}</div>
    {% endif %}
    </div>
  </div>
</div>

{% schema %}
