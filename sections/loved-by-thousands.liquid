      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 28,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_sub_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_text_size",
