      "max": 1900,
      "min": 900,
      "default": 1400,
      "step": 100,
      "unit": "px",
      "visible_if": "{{ section.settings.section_width == false }}"
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Section Background",
      "default": "rgba(255, 255, 255, 1)"
    },
    {
      "type": "header",
