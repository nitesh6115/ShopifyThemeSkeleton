<div class="page-width">
<h1>{{ collection.title }}</h1>
<div class="collection-product product-grid grid " style="
    --desktop-columns: {{ section.settings.products_per_row_desktop }};
    --mobile-columns: {{ section.settings.products_per_row_mobile }};
    --grid-horizontal: {{ section.settings.grid_horizontal_spacing }}px;
    --grid-vertical: {{ section.settings.grid_vertical_spacing }}px;
  ">
  {% paginate collection.products by 20 %}
    {% for product in collection.products %}
      <div class="collection-product grid-item">
        {% render 'product-card',
    product: product,
    show_vendor: section.settings.show_vendor,
    show_rating: section.settings.show_rating,
    show_secondary_image: section.settings.show_secondary_image,
    quick_add: section.settings.enable_quick_add
  %}
      </div>
    {% endfor %}

    {{ paginate | default_pagination }}
  {% endpaginate %}
</div>
</div>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_row_mobile",
      "label": "Products per row (mobile)",
      "min": 0,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_horizontal_spacing",
      "label": "Horizontal spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "grid_vertical_spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "product_image_ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "adapt", "label": "Adapt to image" }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Fill image area" },
        { "value": "contain", "label": "Fit inside container" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show hover image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add",
      "default": true
    }
  ]
}
{% endschema %}
