{{ 'how-we-stack-up.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
{% capture style_schema %}
    --section-bg: {{ section.settings.section_bg }};
    --section-wraper-width: {% if section.settings.section_width %}100% {% else %}{{ section.settings.wraper_width }}px{% endif %};

    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-left: {{ section.settings.padding_left }}px;
    --section-padding-right: {{ section.settings.padding_right }}px;

    --section-mobile-padding-top: {{ section.settings.padding_top | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-bottom: {{ section.settings.padding_bottom | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-left: {{ section.settings.padding_left | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-right: {{ section.settings.padding_right | times: 0.55 | round: 0 }}px;
    --header-desktop-text-alignment: {{ section.settings.desktop_text_align }};
    --header-mobile-text-alignment: {{ section.settings.mobile_text_align }};

    --desktop-header-heading-size: {{ section.settings.desktop_heading_size }}px;
    --desktop-header-sub-heading-size: {{ section.settings.desktop_sub_heading_size }}px;
    --desktop-header-text-size: {{ section.settings.desktop_text_size }}px;

    --mobile-header-heading-size: {{ section.settings.mobile_heading_size }}px;
    --mobile-header-sub-heading-size: {{ section.settings.mobile_sub_heading_size }}px;
    --mobile-header-text-size: {{ section.settings.mobile_text_size }}px;
    --mobile-table-outer-radius: {{ section.settings.mobile-table-outer-radius }}px;
    --desktop-table-outer-radius: {{ section.settings.desktop-table-outer-radius }}px;
{% endcapture %}

<div class="how-we-stack-up-section" style="{{ style_schema }}">
  <div class="how-we-stack-up-container">
    <div class="section-header">
      {% if section.settings.badge_text != blank %}
        <div class="before-after-badge">
          {{ section.settings.badge_text }}
        </div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 style="color: {{ section.settings.heading_color }};">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      {% if section.settings.review_text != blank %}
        <div class="review-stars-text">
          {{ section.settings.review_text }}
        </div>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="header-sub-heading" style="color: {{ section.settings.subheading_color }};">
          {{ section.settings.subheading }}
        </div>
      {% endif %}
      {% if section.settings.content != blank %}
        <div class="rte content_header" style="color: {{ section.settings.text_color }};">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>
    <div class="table_container_box">
      {% for block in section.blocks %}
        {% if block.type == 'header_row' %}
          <div {{ block.shopify_attributes }}
            class="table_row table_header_row"
            style="
              --block-bg: {{ block.settings.bg_color }};
              --block-radius: {{ block.settings.block_radius }}px;
              --block-text-color: {{ block.settings.text_color }};
              --block-desktop-padding-top: {{ block.settings.padding_top }}px;
              --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
              --block-desktop-padding-left: {{ block.settings.padding_left }}px;
              --block-desktop-padding-right: {{ block.settings.padding_right }}px;
              --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
              --divider-border-width: {{ block.settings.border_width }}px;
              --divider-border-color: {{ block.settings.border_color }};
            "
          >
            {% for i in (1..4) %}
              {% capture title %}title_{{ i }}{% endcapture %}
              {% assign block_title = block.settings[title] %}
              <div class="table_content">
                {% if forloop.index == 2 %}
                  <span class="btn"> {{ block_title }}</span>
                {% else %}
                  {{ block_title }}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div {{ block.shopify_attributes }}
            class="table_row table_content_row "
            style="
              --block-bg: {{ block.settings.bg_color }};
              --block-radius: {{ block.settings.block_radius }}px;
              --block-text-color: {{ block.settings.text_color }};
              --block-desktop-padding-top: {{ block.settings.padding_top }}px;
              --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
              --block-desktop-padding-left: {{ block.settings.padding_left }}px;
              --block-desktop-padding-right: {{ block.settings.padding_right }}px;
              --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
              --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
              --divider-border-width: {{ block.settings.border_width }}px;
              --divider-border-color: {{ block.settings.border_color }};
            "
          >
            {% for i in (1..4) %}
              {% capture title %}title_{{ i }}{% endcapture %}
              {% assign block_title = block.settings[title] %}
              <div class="table_content">
                {{ block_title }}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How We Stack Up",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "checkbox",
      "id": "section_width",
      "label": "Full Width"
    },
    {
      "type": "range",
      "id": "wraper_width",
      "label": "Container Width",
      "max": 1900,
      "min": 900,
      "default": 1400,
      "step": 100,
      "unit": "px",
      "visible_if": "{{ section.settings.section_width == false }}"
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Section Background",
      "default": "rgba(255, 255, 255, 1)"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "max": 100,
      "min": 0,
      "default": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Desktop Font Size"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_sub_heading_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Body Font Size"
    },
    {
      "type": "header",
      "content": "Mobile Font Size"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 28,
      "label": "Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_sub_heading_size",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Sub-Heading Font Size"
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Body Font Size"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#6B6B6B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#6B6B6B"
    },

    {
      "type": "select",
      "id": "desktop_text_align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Desktop Text Alignment"
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Mobile Text Alignment"
    },

    { "type": "text", "id": "heading", "label": "Heading", "default": "How we stack up" },

    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "range",
      "id": "desktop-table-outer-radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "Desktop Table Ourter Radius"
    },
    {
      "type": "range",
      "id": "mobile-table-outer-radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "Mobile Table Ourter Radius"
    }
  ],
  "blocks": [
    {
      "type": "content_row",
      "name": "Content Row",
      "settings": [
        {
          "type": "header",
          "content": "Block Spacing"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Padding Top",
          "max": 100,
          "min": 0,
          "default": 10,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "Padding Bottom",
          "max": 100,
          "min": 0,
          "default": 10,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_left",
          "label": "Padding Left",
          "max": 100,
          "min": 0,
          "default": 10,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_right",
          "label": "Padding Right",
          "max": 100,
          "min": 0,
          "default": 10,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "block_radius",
          "label": "Block Radius",
          "max": 100,
          "min": 0,
          "default": 0,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "color_background",
          "id": "bg_color",
          "label": "Block Background",
          "default": "rgba(250, 250, 250, 1)"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border Color"
        },
        {
          "type": "range",
          "id": "border_width",
          "label": "Border Size",
          "max": 100,
          "min": 0,
          "default": 0,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Column 1"
        },
        {
          "type": "textarea",
          "id": "title_1",
          "label": "Title",
          "default": "100% Natural Ingredients"
        },
        {
          "type": "header",
          "content": "Column 2"
        },
        {
          "type": "textarea",
          "id": "title_2",
          "label": "Title",
          "default": "&#10003;"
        },
        {
          "type": "header",
          "content": "Column 3"
        },
        {
          "type": "textarea",
          "id": "title_3",
          "label": "Title",
          "default": "&#215;"
        },
        {
          "type": "header",
          "content": "Column 4"
        },
        {
          "type": "textarea",
          "id": "title_4",
          "label": "Title",
          "default": "&#10003;"
        }
      ]
    },
    {
      "type": "header_row",
      "name": "Header Row",
      "settings": [
        {
          "type": "header",
          "content": "Block Spacing"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Padding Top",
          "max": 100,
          "min": 0,
          "default": 10,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "Padding Bottom",
          "max": 100,
          "min": 0,
          "default": 10,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_left",
          "label": "Padding Left",
          "max": 100,
          "min": 0,
          "default": 10,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "padding_right",
          "label": "Padding Right",
          "max": 100,
          "min": 0,
          "default": 10,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "block_radius",
          "label": "Block Radius",
          "max": 100,
          "min": 0,
          "default": 16,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "color_background",
          "id": "bg_color",
          "label": "Block Background",
          "default": "#fff"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border Color"
        },
        {
          "type": "range",
          "id": "border_width",
          "label": "Border Size",
          "max": 100,
          "min": 0,
          "default": 0,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Column 1"
        },
        {
          "type": "text",
          "id": "title_1",
          "label": "Title",
          "default": "Features"
        },
        {
          "type": "header",
          "content": "Column 2"
        },
        {
          "type": "text",
          "id": "title_2",
          "label": "Title",
          "default": "Product"
        },
        {
          "type": "header",
          "content": "Column 3"
        },
        {
          "type": "text",
          "id": "title_3",
          "label": "Title",
          "default": "Competitor A"
        },
        {
          "type": "header",
          "content": "Column 4"
        },
        {
          "type": "text",
          "id": "title_4",
          "label": "Title",
          "default": "Competitor B"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How We Stack Up",
      "blocks": [
        {
          "type": "header_row"
        },
        {
          "type": "content_row"
        },
        {
          "type": "content_row"
        },
        {
          "type": "content_row"
        },
        {
          "type": "content_row"
        },
        {
          "type": "content_row"
        }
      ]
    }
  ]
}
{% endschema %}
