{{ 'custom-product.css' | asset_url | stylesheet_tag }}
{%- capture style_schema -%}
    --section-bg:{{ section.settings.section_bg }};
    --section-wraper-width:{% if section.settings.section_width %}100%{% else %}{{ section.settings.wraper_width }}px{% endif %};
    --section-padding-top:{{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom:{{ section.settings.padding_bottom_desktop }}px;
    --section-padding-left:{{ section.settings.padding_left_desktop }}px;
    --section-padding-right:{{ section.settings.padding_right_desktop }}px;
    --section-mobile-padding-top:{{ section.settings.padding_top_mobile }}px;
    --section-mobile-padding-bottom:{{ section.settings.padding_bottom_mobile }}px;
    --section-mobile-padding-left:{{ section.settings.padding_left_mobile }}px;
    --section-mobile-padding-right:{{ section.settings.padding_right_mobile }}px;
    --media-radius:{{ section.settings.media-radius }}px;
    --media-thumb-radius:{{ section.settings.media-thumb-radius }}px;
    --media-thumb-width:{{ section.settings.media-thumb-width }}px;
    --media-thumb-mobile-width:{{ section.settings.media-thumb-mobile-width }}px;
    --media-thumb-border-size:{{ section.settings.media-thumb-border-width }}px;
    --media-thumb-border-color:{{ section.settings.media_border }};
    --media-thumb-border-active-color:{{ section.settings.media_border_active }};
{%- endcapture -%}
<div
  class="product_section {% if section.settings.show_thumbs %} enable_thumbs {% else %} hide_thumbs {% endif %}"
  style="{{- style_schema -}}"
  id="MainProduct_{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  <div class="product-wrapper">
    <div class="product_media-wrapper">
      {% render 'product_media_gallery', variant_images: variant_images %}
    </div>
    <div class="product_information_wrapper">
      {%- assign product_form_id = 'product-form-' | append: section.id -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'text' -%}
            <div
              class="product_block product__text"
              {{ block.shopify_attributes }}
              style="
                --desktop-font-size: {{ block.settings.desktop_font_size }}px;
                --mobile-font-size: {{ block.settings.mobile_font_size }}px;
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-desktop-text-alignment: {{ block.settings.desktop_text_align }};
                --block-mobile-text-alignment: {{ block.settings.mobile_text_align }};
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
              "
            >
              <div class="block_content">
                {{- block.settings.text -}}
              </div>
            </div>
          {% when 'price' %}
            <div
              class="product_block product__title"
              {{ block.shopify_attributes }}
              style="
                --desktop-font-size: {{ block.settings.desktop_font_size }}px;
                --mobile-font-size: {{ block.settings.mobile_font_size }}px;
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-desktop-text-alignment: {{ block.settings.desktop_text_align }};
                --block-mobile-text-alignment: {{ block.settings.mobile_text_align }};
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;

                --price-color: {{ block.settings.price_color }};
                --price-compare_at: {{ block.settings.compare_price_color }};

                --price-desktop-font-size: {{ block.settings.price_font_size }}px;
                --price-mobile-font-size: {{ block.settings.mobile_price_font_size }}px;

                --price-compare-at-desktop-font-size: {{ block.settings.compare_at_price_font_size }}px;
                --price-compare-at-mobile-font-size: {{ block.settings.mobile_compare_at_price_font_size }}px;

                --save-color: {{ block.settings.save_color }};
                --save-bg: {{ block.settings.save_color_bg }};
                --save-radius: {{ block.settings.save_radius }}px;
              "
            >
              <div class="product-price">
                {% assign current_variant = product.selected_or_first_available_variant %}

                <span class="price regular_price">
                  {{ current_variant.price | money }}
                </span>
                <span class="sale_price">
                  {{ current_variant.compare_at_price | money }}
                </span>
                {% assign discount = current_variant.compare_at_price | minus: current_variant.price %}
                {% assign discount_percentage = discount | times: 100 | divided_by: current_variant.compare_at_price %}
                <span class="save"> {{ discount_percentage }}% OFF </span>
              </div>
            </div>
          {%- when 'title' -%}
            <div
              class="product_block product__title"
              {{ block.shopify_attributes }}
              style="
                --desktop-font-size: {{ block.settings.desktop_font_size }}px;
                --mobile-font-size: {{ block.settings.mobile_font_size }}px;
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-desktop-text-alignment: {{ block.settings.desktop_text_align }};
                --block-mobile-text-alignment: {{ block.settings.mobile_text_align }};
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
              "
            >
              <h1 class="product_title">{{ product.title | escape }}</h1>
            </div>
          {% when 'variant' %}
            <div
              class="product_block variant_picker"
              {{ block.shopify_attributes }}
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-desktop-text-alignment: {{ block.settings.desktop_text_align }};
                --block-mobile-text-alignment: {{ block.settings.mobile_text_align }};
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
                --pill-bg: {{ block.settings.pill-bg }};
                --pill-text: {{ block.settings.pill-text }};
                --pill-hover-bg: {{ block.settings.hover-pill-bg }};
                --pill-hover-text: {{ block.settings.hover-pill-text }};
                --pill-radius: {{ block.settings.pill-radius }}px;
                --pill-border: {{ block.settings.pill-border }};
                --pill-border-width: {{ block.settings.pill-border-width }}px;
                --pill-hover-border: {{ block.settings.hover-pill-border }};
              "
            >
              {% for option in product.options_with_values %}
                <div class="product-option" data-option-position="{{ option.position }}">
                  <label>{{ option.name }}</label>

                  <div class="option-values">
                    {% for value in option.values %}
                      <button
                        type="button"
                        class="option-value"
                        data-value="{{ value | escape }}"
                      >
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% when 'buy_button' %}
            <div
              class="product_block buy_buttons {% if block.settings.show_dynamic_button %} buy_now_enabled {% endif %}"
              {{ block.shopify_attributes }}
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-desktop-text-alignment: {{ block.settings.desktop_text_align }};
                --block-mobile-text-alignment: {{ block.settings.mobile_text_align }};
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;

                --btn-bg: {{ block.settings.btn_bg }};
                --btn-text: {{ block.settings.btn_text }};
                --btn-hover-bg: {{ block.settings.btn_hover_bg }};
                --btn-hover-text: {{ block.settings.btn_hover_text }};
                --btn-radius: {{ block.settings.btn_radius }}px;
                --btn-border: {{ block.settings.btn_border }};
                --btn-font-size: {{ block.settings.btn_size }}px;
                --btn-uppercase: {% if block.settings.btn_uppercase %} uppercase {% else %} normal {%endif %};
                --btn-border-width: {{ block.settings.btn_border_width }}px;
                --btn-hover-border: {{ block.settings.btn_hover_border }};
              "
            >
              {%- form 'product',
                product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

                {% if block.settings.show_qty %}
                  <div class="product-quantity" data-quantity-wrapper>
                    <button type="button" class="qty-btn qty-minus">−</button>

                    <input
                      type="text"
                      name="quantity"
                      value="1"
                      min="1"
                      step="1"
                      readonly
                      class="qty-input"
                    >

                    <button type="button" class="qty-btn qty-plus">+</button>

                    <p class="qty-error" style="display:none;"></p>
                    
                  </div>
                {% else %}
                  <input
                    type="hidden"
                    name="quantity"
                    value="1"
                    min="1"
                    step="1"
                  >
                {% endif %}
                <div class="button_from">
                  <button
                    type="submit"
                    class="add-to-cart"
                    {% if block.settings.show_price %}
                      data-btn-price
                    {% endif %}
                  >
                    <span class="btn_text">Add to Cart</span>
                    {% if block.settings.show_price %}
                      <span class="icon">—</span>
                      <span class="btn_price">{{ current_variant.price | money }}</span>
                    {% endif %}
                  </button>
                </div>
                {% if block.settings.show_dynamic_button %}
                  {{ form | payment_button }}
                {% endif %}
              {% endform %}
              {% if block.settings.enabled_sticky_add %}
              <div class="sticky-atc" id="StickyATC-{{ section.id }}">
                <div class="sticky-inner">
                  <div class="sticky-left">
                    <img
                      class="sticky-image"
                      alt="{{product.title }}"
                      src="{{  product.featured_image | img_url: '120x' }}"
                      width="120"
                      height="120"
                    >
                    <div class="sticky-meta">
                      <div class="sticky-title">{{ product.title }}</div>
                      <div class="sticky-variant"></div>
                      <div class="sticky-price-wrapper">
                        <span class="sticky-price"></span>
                        <span class="sticky-compare"></span>
                        <span class="sticky-save"></span>
                      </div>
                    </div>
                  </div>

                  <button type="button" class="sticky-btn">Add to Cart</button>
                </div>
              </div>
            {% endif %}
            </div>
          {% when 'liquid' %}
            <div
              class="product_block custom_liquid"
              {{ block.shopify_attributes }}
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
              "
            >
              {{ block.settings.liquid }}
            </div>
          {% when 'trust_badges' %}
            <div
              class="product_block trust_badges"
              {{ block.shopify_attributes }}
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
              "
            >
              <div class="trust-badges">
                {% for i in (1..3) %}
                  {% capture text_key %}text_{{ i }}{% endcapture %}
                  {% capture bg_key %}bg_color_{{ i }}{% endcapture %}
                  {% capture border_key %}border_color_{{ i }}{% endcapture %}
                  {% capture text_color_key %}text_color_{{ i }}{% endcapture %}
                  {% capture icon_key %}icon_{{ i }}{% endcapture %}
                  {% capture icon_color_key %}icon_color_{{ i }}{% endcapture %}

                  {% assign badge_text = block.settings[text_key] %}

                  {% if badge_text != blank %}
                    <div
                      class="trust-badge"
                      style="
                        background: {{ block.settings[bg_key] }};
                        border: 1px solid {{ block.settings[border_key] }};
                        color: {{ block.settings[text_color_key] }};
                      "
                    >
                      <span
                        class="icon"
                        style="                --icon-color: {{ block.settings[icon_color_key] }};"
                      >
                        {{ block.settings[icon_key] }}
                      </span>

                      <span class="text">
                        {{ badge_text }}
                      </span>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% when 'divider' %}
            <div
              class="product_block divider"
              {{ block.shopify_attributes }}
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
                --divider-border-width: {{ block.settings.border_width }}px;
                --divider-border-color: {{ block.settings.border_color }};
              "
            >
              <hr>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>
<script>
(function () {

  const section = document.querySelector('#MainProduct_{{ section.id }}');
  if (!section) return;
  const gallery = document.querySelector(".custom-product-gallery");
  if (!gallery) return;
  const thumbs = gallery.querySelectorAll(".gallery-thumb");
  const track = gallery.querySelector(".gallery-thumbs-track");
  const mediaItems = gallery.querySelectorAll(".gallery-media-item");
  const wrapper = gallery.querySelector(".gallery-thumbs-wrapper");
  const prevBtn = gallery.querySelector(".thumb-prev");
  const nextBtn = gallery.querySelector(".thumb-next");


  /*----------------------------
      MEDIA ELEMENTS 
    ---------------------------*/
    let currentTranslate = 0;

  function checkOverflow() {

  const container = track.parentElement;

  const isOverflowing =
    Math.ceil(track.scrollWidth) >
    Math.ceil(container.clientWidth);

  wrapper.classList.toggle("is-overflowing", isOverflowing);

  if (!isOverflowing) {
    currentTranslate = 0;
    track.style.transform = "translateX(0px)";
  }
}

  function activateMedia(mediaId) {
  
    mediaItems.forEach(item => {
      item.classList.remove("is-active");
      if (item.dataset.mediaId === mediaId) {
        item.classList.add("is-active");
      }

      const video = item.querySelector("video");
      if (video) video.pause();
    });

    thumbs.forEach(thumb => {
      thumb.classList.remove("is-active");
      if (thumb.dataset.mediaId === mediaId) {
        thumb.classList.add("is-active");
        scrollThumbIntoView(thumb);
      }
    });
  }
  
  
  function scrollThumbIntoView(thumb) {
    const thumbLeft = thumb.offsetLeft;
    const thumbRight = thumbLeft + thumb.offsetWidth;
    const visibleLeft = Math.abs(currentTranslate);
    const visibleRight = visibleLeft + track.parentElement.offsetWidth;

    if (thumbLeft < visibleLeft) {
      currentTranslate = -thumbLeft;
    } else if (thumbRight > visibleRight) {
      currentTranslate = -(thumbRight - track.parentElement.offsetWidth);
    }

    track.style.transform = `translateX(${currentTranslate}px)`;
  }

  prevBtn?.addEventListener("click", function() {
    currentTranslate += 100;
    if (currentTranslate > 0) currentTranslate = 0;
    track.style.transform = `translateX(${currentTranslate}px)`;
  });

  nextBtn?.addEventListener("click", function() {
    const maxTranslate = track.parentElement.offsetWidth - track.scrollWidth;
    currentTranslate -= 100;
    if (currentTranslate < maxTranslate) currentTranslate = maxTranslate;
    track.style.transform = `translateX(${currentTranslate}px)`;
  });

  thumbs.forEach(thumb => {
    thumb.addEventListener("click", function() {
      activateMedia(this.dataset.mediaId);
    });
  });
  
  checkOverflow();
  window.addEventListener("resize", checkOverflow);

  const variants = {{ product.variants | json }};
  const form = section.querySelector("form[id^='product-form-']");
  if (!form) return;

  const hiddenInput = form.querySelector("input[name='id']");
  const priceWrapper = section.querySelector('.product-price');
  const optionGroups = section.querySelectorAll('.product-option');
  const addToCartBtn = form.querySelector('.add-to-cart');
  const showBtnPrice = addToCartBtn?.hasAttribute('data-btn-price');

  /* -------------------------
     QUANTITY ELEMENTS
  -------------------------- */
  const qtyWrapper = section.querySelector('[data-quantity-wrapper]');
  const qtyInput = qtyWrapper?.querySelector('.qty-input');
  const plusBtn = qtyWrapper?.querySelector('.qty-plus');
  const minusBtn = qtyWrapper?.querySelector('.qty-minus');
  const qtyError = qtyWrapper?.querySelector('.qty-error');

  /* -------------------------
     STICKY ELEMENTS
  -------------------------- */
  const sticky = section.querySelector('.sticky-atc');
  const stickyBtn = sticky?.querySelector('.sticky-btn');
  const stickyPrice = sticky?.querySelector('.sticky-price');
  const stickyCompare = sticky?.querySelector('.sticky-compare');
  const stickySave = sticky?.querySelector('.sticky-save');
  const stickyVariant = sticky?.querySelector('.sticky-variant');
  const stickyImage = sticky?.querySelector('.sticky-image');

  let selectedOptions = [];
  let currentVariant = null;
  let cartData = null;

  function formatMoney(cents) {
    return new Intl.NumberFormat('{{ shop.locale }}', {
      style: 'currency',
      currency: '{{ shop.currency }}',
    }).format(cents / 100);
  }

  /* -------------------------
     FETCH CART (once)
  -------------------------- */
  fetch('/cart.js')
    .then(res => res.json())
    .then(data => {
      cartData = data;
    });

  /* -------------------------
     INITIAL VARIANT
  -------------------------- */
  const initialVariant =
    variants.find(v => v.id == hiddenInput.value) ||
    variants.find(v => v.available) ||
    variants[0];

  selectedOptions = [
    initialVariant.option1 || null,
    initialVariant.option2 || null,
    initialVariant.option3 || null,
  ];

  updateUI();
  updateVariant();

  /* -------------------------
     OPTION CLICK
  -------------------------- */
  optionGroups.forEach((group, index) => {
    group.querySelectorAll('.option-value').forEach((button) => {
      button.addEventListener('click', function () {
        if (this.classList.contains('is-unavailable')) return;
        selectedOptions[index] = this.dataset.value;
        updateUI();
        updateVariant();
      });
    });
  });

  /* -------------------------
     UPDATE VARIANT
  -------------------------- */
    function updateUI() {
  optionGroups.forEach((group, index) => {
    group.querySelectorAll('.option-value').forEach((button) => {

      const testOptions = [...selectedOptions];
      testOptions[index] = button.dataset.value;

      const existingVariant = variants.find((variant) => {
        return (
          (variant.option1 === testOptions[0] || !variant.option1) &&
          (variant.option2 === testOptions[1] || !variant.option2) &&
          (variant.option3 === testOptions[2] || !variant.option3)
        );
      });

      const isAvailable = existingVariant?.available;
      const exists = !!existingVariant;

      button.classList.remove('is-active', 'is-soldout', 'is-unavailable');

      if (button.dataset.value === selectedOptions[index]) {
        button.classList.add('is-active');
      }

      if (!exists) {
        button.classList.add('is-unavailable');
      } else if (!isAvailable) {
        button.classList.add('is-soldout');
      }

    });
  });
  }
  function updateVariant() {

    currentVariant = variants.find((variant) => {
      return (
        (variant.option1 === selectedOptions[0] || !variant.option1) &&
        (variant.option2 === selectedOptions[1] || !variant.option2) &&
        (variant.option3 === selectedOptions[2] || !variant.option3)
      );
    });

    if (!currentVariant) return;

    hiddenInput.value = currentVariant.id;
     /*-------IMAGE UPDATE --------*/
     if (currentVariant?.featured_media) {
  activateMedia(currentVariant.featured_media.id.toString());
  
}
    /* ---- PRICE ---- */
    const regularPriceEl = priceWrapper.querySelector('.regular_price');
    const comparePriceEl = priceWrapper.querySelector('.sale_price');
    const saveEl = priceWrapper.querySelector('.save');

    regularPriceEl.textContent = formatMoney(currentVariant.price);

    if (currentVariant.compare_at_price && currentVariant.compare_at_price > currentVariant.price) {
      comparePriceEl.textContent = formatMoney(currentVariant.compare_at_price);
      comparePriceEl.style.display = 'inline';

      const percent = Math.round(
        ((currentVariant.compare_at_price - currentVariant.price) * 100) /
        currentVariant.compare_at_price
      );

      saveEl.textContent = percent + '% OFF';
      saveEl.style.display = 'inline';
    } else {
      comparePriceEl.style.display = 'none';
      saveEl.style.display = 'none';
    }

    /* ---- BUTTON ---- */
    if (!currentVariant.available) {
      addToCartBtn.disabled = true;
      addToCartBtn.textContent = 'Sold Out';
    } else {
      addToCartBtn.disabled = false;
      addToCartBtn.innerHTML = showBtnPrice
        ? `<span class='btn_text'>Add to Cart</span><span class='icon'>—</span><span class='btn_price'>${formatMoney(currentVariant.price)}</span>`
        : `<span class='btn_text'>Add to Cart</span>`;
    }

    /* ---- STICKY ---- */
    if (sticky) {
      stickyPrice.textContent = formatMoney(currentVariant.price);
      stickyVariant.textContent = currentVariant.title;

      if (currentVariant.compare_at_price && currentVariant.compare_at_price > currentVariant.price) {
        const percent = Math.round(
          ((currentVariant.compare_at_price - currentVariant.price) * 100) /
          currentVariant.compare_at_price
        );
        stickyCompare.textContent = formatMoney(currentVariant.compare_at_price);
        stickySave.textContent = percent + '% OFF';
        stickyCompare.style.display = 'inline';
        stickySave.style.display = 'block';
      } else {
        stickyCompare.style.display = 'none';
        stickySave.style.display = 'none';
      }

      stickyBtn.disabled = !currentVariant.available;
      stickyBtn.textContent = currentVariant.available ? 'Add to Cart' : 'Sold Out';
    }

    if (qtyInput) {
      qtyInput.value = 1;
      validateQuantity();
    }

    document.dispatchEvent(
      new CustomEvent('variant:change', { detail: { variant: currentVariant } })
    );
  }

  /* -------------------------
     QUANTITY VALIDATION
  -------------------------- */
  function validateQuantity() {
    if (!currentVariant || !qtyInput) return;

    const maxInventory = currentVariant.inventory_quantity;
    const inventoryPolicy = currentVariant.inventory_policy;

    let cartQty = 0;

    if (cartData?.items?.length) {
      const existingItem = cartData.items.find(item => item.id == currentVariant.id);
      cartQty = existingItem ? existingItem.quantity : 0;
    }

    const requestedQty = parseInt(qtyInput.value) || 1;

    if (inventoryPolicy === 'deny') {
      const remaining = maxInventory - cartQty;

      if (remaining <= 0) {
        qtyInput.value = 1;
        plusBtn.disabled = true;
        qtyError.style.display = 'block';
        qtyError.textContent = 'Sold Out';
        return;
      }

      if (requestedQty > remaining) {
        qtyInput.value = remaining;
        qtyError.style.display = 'block';
        qtyError.textContent = `Only ${remaining} left`;
      } else {
        qtyError.style.display = 'none';
      }

      plusBtn.disabled = requestedQty >= remaining;
    } else {
      qtyError.style.display = 'none';
      plusBtn.disabled = false;
    }
  }

  if (qtyInput) {
    plusBtn.addEventListener('click', () => {
      qtyInput.value = parseInt(qtyInput.value) + 1;
      validateQuantity();
    });

    minusBtn.addEventListener('click', () => {
      if (parseInt(qtyInput.value) > 1) {
        qtyInput.value = parseInt(qtyInput.value) - 1;
      }
      validateQuantity();
    });
  }
/* -------------------------
   STICKY SHOW / HIDE
-------------------------- */
/* -------------------------
   STICKY CLICK = REAL SUBMIT
-------------------------- */

if (stickyBtn && form) {
  stickyBtn.addEventListener('click', function () {

    if (!currentVariant || !currentVariant.available) return;

    // Sync quantity from main input
    if (qtyInput) {
      const hiddenQty = form.querySelector("input[name='quantity']");
      if (hiddenQty) {
        hiddenQty.value = qtyInput.value;
      }
    }

    form.requestSubmit(); // safest way
  });
}
if (sticky && addToCartBtn) {

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          sticky.classList.remove('active');
        } else {
          sticky.classList.add('active');
        }
      });
    },
    { threshold: 0 }
  );

  observer.observe(addToCartBtn);
}
/* -------------------------
   SEAL SUBSCRIPTION PRICE SYNC
-------------------------- */

document.addEventListener('sealsubs:price_update', function(e) {

  if (!e.detail) return;

  const {
    price,
    compareAtPrice,
    pricePerDelivery
  } = e.detail;

  if (!price) return;

  /* -------------------------
     UPDATE MAIN PRODUCT PRICE
  -------------------------- */

  const regularPriceEl = priceWrapper?.querySelector('.regular_price');
  const comparePriceEl = priceWrapper?.querySelector('.sale_price');
  const saveEl = priceWrapper?.querySelector('.save');

  if (regularPriceEl) {
    regularPriceEl.textContent = formatMoney(price);
  }

  if (compareAtPrice && compareAtPrice > price) {

    if (comparePriceEl) {
      comparePriceEl.textContent = formatMoney(compareAtPrice);
      comparePriceEl.style.display = 'inline';
    }

    if (saveEl) {
      const percent = Math.round(
        ((compareAtPrice - price) * 100) / compareAtPrice
      );
      saveEl.textContent = percent + '% OFF';
      saveEl.style.display = 'inline';
    }

  } else {
    if (comparePriceEl) comparePriceEl.style.display = 'none';
    if (saveEl) saveEl.style.display = 'none';
  }

  /* -------------------------
     UPDATE STICKY PRICE
  -------------------------- */

  if (stickyPrice) {
    stickyPrice.textContent = formatMoney(price);
  }

});
})();
