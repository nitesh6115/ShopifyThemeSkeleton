<section id="ff-{{ section.id }}" class="ff-faq-{{ section.id }} {% if section.settings.hide_desktop %}ff-hide-desktop{% endif %} {% if section.settings.hide_mobile %}ff-hide-mobile{% endif %}"><style>
.ff-faq-{{ section.id }}{--bg:{{section.settings.background_color}};--hc:{{section.settings.heading_color}};--tc:{{section.settings.text_color}};--ac:{{section.settings.accent_color}};--mw:{{section.settings.max_width}}px;--pt:{{section.settings.padding_top}}px;--pb:{{section.settings.padding_bottom}}px;--ptm:{{section.settings.padding_top_mobile}}px;--pbm:{{section.settings.padding_bottom_mobile}}px;--hs:{{section.settings.heading_size}}px;--hsm:{{section.settings.heading_size_mobile}}px;--bs:{{section.settings.body_size}}px;--bsm:{{section.settings.body_size_mobile}}px;--es:{{section.settings.eyebrow_size}}px;--esm:{{section.settings.eyebrow_size_mobile}}px;background:var(--bg);color:var(--tc);position:relative;overflow:hidden}
.ff-faq-{{ section.id }}::before{content:"";position:absolute;inset:0;background-image:url('{{section.settings.background_image|image_url:width:2400}}');background-position:center;background-size:cover;background-repeat:no-repeat;opacity:calc({{section.settings.overlay_opacity}} / 100);pointer-events:none}
.ff-faq-{{ section.id }} .ff-inner{position:relative;z-index:1;max-width:var(--mw);margin:auto;padding:var(--pt) 20px var(--pb)}
.ff-faq-{{ section.id }} .ff-heading{margin:0 0 18px;color:var(--hc);font-size:var(--hs);line-height:1.08}
.ff-faq-{{ section.id }} .ff-eyebrow{margin:0 0 10px;color:var(--ac);font-size:var(--es);font-weight:800;letter-spacing:.07em;text-transform:uppercase}
.ff-faq-{{ section.id }} .ff-copy{font-size:var(--bs);line-height:1.55}
.ff-faq-{{ section.id }} .ff-center{text-align:{{section.settings.text_align}}}
.ff-faq-{{ section.id }} .ff-button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 26px;border-radius:999px;background:var(--ac);color:#fff;text-decoration:none;font-weight:800;margin-top:22px}
.ff-faq-{{ section.id }} img{display:block;max-width:100%;height:auto}
.ff-faq{max-width:900px;margin:30px auto;text-align:left}.ff-faq details{border-bottom:1px solid #ddd}.ff-faq summary{list-style:none;cursor:pointer;padding:20px 4px;font-weight:800;display:flex;justify-content:space-between}.ff-faq summary::-webkit-details-marker{display:none}.ff-answer{padding:0 4px 20px;line-height:1.6}
@media(max-width:749px){.ff-faq-{{ section.id }} .ff-inner{padding:var(--ptm) 16px var(--pbm)}.ff-faq-{{ section.id }} .ff-heading{font-size:var(--hsm)}.ff-faq-{{ section.id }} .ff-copy{font-size:var(--bsm)}.ff-faq-{{ section.id }} .ff-eyebrow{font-size:var(--esm)}.ff-faq-{{ section.id }}::before{background-image:url('{{section.settings.background_image_mobile|default:section.settings.background_image|image_url:width:1400}}')}.ff-faq-{{ section.id }}.ff-hide-mobile{display:none!important}}
@media(min-width:750px){.ff-faq-{{ section.id }}.ff-hide-desktop{display:none!important}}
</style><div class="ff-inner"><div class="ff-center"><h2 class="ff-heading">{{section.settings.heading}}</h2><p class="ff-copy">{{section.settings.intro}}</p><div class="ff-faq">{% for block in section.blocks %}<details {{block.shopify_attributes}}><summary>{{block.settings.question}}<span>+</span></summary><div class="ff-answer">{{block.settings.answer}}</div></details>{% endfor %}</div><a class="ff-button" href="{{section.settings.button_link|default:'#'}}">{{section.settings.button_label}}</a></div></div></section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile background image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#d94b32"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "default": 1200,
      "min": 700,
      "max": 1600,
      "step": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "default": 64,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "default": 64,
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "default": 40,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "default": 40,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow desktop size",
      "default": 14,
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "label": "Eyebrow mobile size",
      "default": 13,
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading desktop size",
      "default": 48,
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading mobile size",
      "default": 34,
      "min": 20,
      "max": 52,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body desktop size",
      "default": 18,
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body mobile size",
      "default": 16,
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Everything you need to know before you try Furry Freshness."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try Furry Freshness"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Will this actually work on old, set-in stains?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. Add your complete answer here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}