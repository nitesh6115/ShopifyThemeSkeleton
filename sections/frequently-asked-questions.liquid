{{ 'frequently-asked-questions.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
{% capture style_schema %}
     --section-bg: {{ section.settings.section_bg }};
    --section-wraper-width: {% if section.settings.section_width %}100% {% else %}{{ section.settings.wraper_width }}px{% endif %};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-left: {{ section.settings.padding_left }}px;
    --section-padding-right: {{ section.settings.padding_right }}px;

    --section-mobile-padding-top: {{ section.settings.padding_top | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-bottom: {{ section.settings.padding_bottom | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-left: {{ section.settings.padding_left | times: 0.55 | round: 0 }}px;
    --section-mobile-padding-right: {{ section.settings.padding_right | times: 0.55 | round: 0 }}px;
    --header-desktop-text-alignment: {{ section.settings.desktop_text_align }};
    --header-mobile-text-alignment: {{ section.settings.mobile_text_align }};
    
    --header-text-color:{{ section.settings.text_color }};
    --header-heading-color: {{ section.settings.heading_color }};
    --header-subheading-color: {{ section.settings.subheading_color }};

    --desktop-header-heading-size: {{ section.settings.desktop_heading_size }}px;
    --desktop-header-sub-heading-size: {{ section.settings.desktop_sub_heading_size }}px;
    --desktop-header-text-size: {{ section.settings.desktop_text_size }}px;

    --mobile-header-heading-size: {{ section.settings.mobile_heading_size }}px;
    --mobile-header-sub-heading-size: {{ section.settings.mobile_sub_heading_size }}px;
    --mobile-header-text-size: {{ section.settings.mobile_text_size }}px;
    --mobile-image-radius: {{ section.settings.mobile-table-outer-radius }}px;
    --desktop-image-radius: {{ section.settings.desktop-table-outer-radius }}px;

    {% endcapture %}
<div class="frequently-asked-questions-section" style="{{ style_schema }}">
  <div class="frequently-asked-questions-container">
    <div class="section-header">
      {% if section.settings.heading != blank %}
        <h2 style="color: {{ section.settings.heading_color }};">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="header-sub-heading" style="color: {{ section.settings.subheading_color }};">
          {{ section.settings.subheading }}
        </div>
      {% endif %}
      {% if section.settings.content != blank %}
        <div class="rte content_header" style="color: {{ section.settings.text_color }};">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>

    <div class="frequently-asked-questions-box">
      <div class="frequently-asked-questions_content">
        {% assign reivew_index = 0 %}
        {% for block in section.blocks %}
        {%- case block.type -%}
          {%- when 'question' -%}
            {% if block.settings.title != blank and block.settings.answer != blank %}
            <div
              {{ block.shopify_attributes }}
              class="question-block"
              data-index="{{ reivew_index }}"
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
                --divider-border-width: {{ block.settings.border_width }}px;
                --divider-border-color: {{ block.settings.border_color }};
                --avatar-size: {{ block.settings.avatar_size }}px;
              "
            >
                <div class="question-hedding-title" style="color: {{ block.settings.text_color }}; --text-font-size: {{ block.settings.text_font }}px">
                  {{ block.settings.title }}
                    <span class="icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M0.666992 0.666992L4.66699 4.66699L8.66699 0.666992" stroke="#717182" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                </div>
                <div class="answer_text_block" style="color: {{ block.settings.content_color }};--purchase-font-size: {{ block.settings.content_font }}px;">
                    <div class="ans-content">{{ block.settings.answer }}</div>
                </div>
            </div>
        {% endif %}
        {% when 'text_block' %}
            <div
              {{ block.shopify_attributes }}
              class="text-content-block"
              data-index="{{ reivew_index }}"
              style="
                --block-bg: {{ block.settings.bg_color }};
                --block-radius: {{ block.settings.block_radius }}px;
                --block-text-color: {{ block.settings.text_color }};
                --block-desktop-padding-top: {{ block.settings.padding_top }}px;
                --block-desktop-text-alignment: {{ block.settings.desktop_text_align }};
                --block-mobile-text-alignment: {{ block.settings.mobile_text_align }};
                --block-desktop-padding-bottom: {{ block.settings.padding_bottom }}px;
                --block-desktop-padding-left: {{ block.settings.padding_left }}px;
                --block-desktop-padding-right: {{ block.settings.padding_right }}px;
                --block-mobile-padding-top: {{ block.settings.padding_top  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-bottom: {{ block.settings.padding_bottom  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-left: {{ block.settings.padding_left  | times: 0.55 | round: 0  }}px;
                --block-mobile-padding-right: {{ block.settings.padding_right  | times: 0.55 | round: 0 }}px;
                --divider-border-width: {{ block.settings.border_width }}px;
                --divider-border-color: {{ block.settings.border_color }};
                --avatar-size: {{ block.settings.avatar_size }}px;
              "
            >
              {% if block.settings.review_text != blank %}
                <div
                  class="block_text_title"
                  style="color: {{ block.settings.text_color }}; --text-font-size: {{ block.settings.text_font }}px"
                >
                  {{ block.settings.review_text }}
                </div>
              {% endif %}
              {% if block.settings.review_content != blank %}
                <div
                  class="content_text_block"
                  style="color: {{ block.settings.content_color }};--purchase-font-size: {{ block.settings.content_font }}px;"
                >
                  {{ block.settings.review_content }}
                </div>
              {% endif %}
              <div class="btn_box">
              {% if block.settings.btn_1 != blank and block.settings.btn_link_1 != blank %}
                {% capture style_btn_1 %}
                --btn-bg: {{ block.settings.btn_bg_1 }};
                --btn-text: {{ block.settings.btn_text_1 }};
                --btn-hover-bg: {{ block.settings.btn_hover_bg_1 }};
                --btn-hover-text: {{ block.settings.btn_hover_text_1 }};
                --btn-radius: {{ block.settings.btn_radius_1 }}px;
                --btn-border: {{ block.settings.btn_border_1 }};
                --btn-font-size: {{ block.settings.btn_size_1 }}px;
                --btn-uppercase: {% if block.settings.btn_uppercase_1 %} uppercase {% else %} normal {%endif %};
                --btn-border-width: {{ block.settings.btn_border_width_1 }}px;
                --btn-hover-border: {{ block.settings.btn_hover_border_1 }};
                {% endcapture %}
                <a href="{{ block.settings.btn_link_1 }}" class="btn_style" style="{{ style_btn_1 }}">{{ block.settings.btn_1 }}</a>
              {% endif %}
              
              {% if block.settings.btn_2 != blank and block.settings.btn_link_2 != blank %}
                {% capture style_btn_2 %}
                --btn-bg: {{ block.settings.btn_bg_2 }};
                --btn-text: {{ block.settings.btn_text_2 }};
                --btn-hover-bg: {{ block.settings.btn_hover_bg_2 }};
                --btn-hover-text: {{ block.settings.btn_hover_text_2 }};
                --btn-radius: {{ block.settings.btn_radius_2 }}px;
                --btn-border: {{ block.settings.btn_border_2 }};
                --btn-uppercase: {% if block.settings.btn_uppercase_2 %} uppercase {% else %} normal {%endif %};
                --btn-font-size: {{ block.settings.btn_size_2 }}px;
                --btn-border-width: {{ block.settings.btn_border_width_2 }}px;
                --btn-hover-border: {{ block.settings.btn_hover_border_2 }};
                {% endcapture %}
                <a href="{{ block.settings.btn_link_2 }}" class="btn_style" style="{{ style_btn_2 }}">{{ block.settings.btn_2 }}</a>
              {% endif %}
              </div>
            </div>
            
        {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {

  const questions = document.querySelectorAll('.question-block');

  questions.forEach(block => {

    const header = block.querySelector('.question-hedding-title');
    const content = block.querySelector('.answer_text_block');

    if (!header || !content) return;

    header.addEventListener('click', function () {

      const isActive = block.classList.contains('active');

      // Close all (optional – remove if you want multi-open)
      questions.forEach(item => {
        item.classList.remove('active');
        const inner = item.querySelector('.answer_text_block');
        if (inner) inner.style.maxHeight = null;
      });

      // Toggle current
      if (!isActive) {
        block.classList.add('active');
        content.style.maxHeight = content.scrollHeight + "px";
      }

    });

  });

});
    </script>
