          cursor: pointer;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-action svg {
          width: 21px;
          height: 21px;
          fill: none;
          stroke: currentColor;
          stroke-width: 1.8;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-action:hover {
          color: var(--ma-header-hover);
          background: rgba(164,113,24,.08);
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-cart {
          position: relative;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-cart-count {
          position: absolute;
          top: 2px;
          right: 1px;
          min-width: 16px;
          height: 16px;
          padding: 0 3px;
          border-radius: 999px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          background: var(--ma-accent);
          color: #fff;
          font-size: 9px;
          font-weight: 800;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-overlay {
          position: fixed;
          z-index: 998;
          inset: 0;
          display: block;
          background: rgba(0,0,0,.42);
          opacity: 0;
          visibility: hidden;
          pointer-events: none;
          transition: opacity .2s ease, visibility .2s ease;
        }

        #ModernAussiesHeader-{{ section.id }}.drawer-open .ma-mobile-overlay {
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-drawer {
          position: fixed;
          z-index: 999;
          top: 0;
          bottom: 0;
          left: 0;
          width: min(88vw, 390px);
          display: flex;
          flex-direction: column;
          background: var(--ma-mega-bg);
          color: var(--ma-mega-text);
          box-shadow: 10px 0 35px rgba(0,0,0,.16);
          transform: translateX(-100%);
          transition: transform .25s ease;
          overflow: hidden;
        }

        #ModernAussiesHeader-{{ section.id }}.drawer-open .ma-mobile-drawer {
          transform: translateX(0);
        }

        #ModernAussiesHeader-{{ section.id }} .ma-drawer-header {
          min-height: 66px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 10px 16px;
          border-bottom: 1px solid var(--ma-border);
          flex-shrink: 0;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-drawer-logo img {
          width: var(--ma-mobile-logo-width);
          max-height: 44px;
          object-fit: contain;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-drawer-logo-text {
          font-size: 19px;
          font-weight: 800;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-drawer-close {
          width: 38px;
          height: 38px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          border: 0;
          background: transparent;
          color: var(--ma-mega-text);
          cursor: pointer;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-drawer-close svg {
          width: 22px;
          height: 22px;
          fill: none;
          stroke: currentColor;
          stroke-width: 1.8;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-drawer-scroll {
          flex: 1;
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu {
          list-style: none;
          margin: 0;
          padding: 0;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu > li {
          border-bottom: 1px solid var(--ma-border);
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu-button,
        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu-link {
          width: 100%;
          min-height: 52px;
          padding: 13px 17px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          border: 0;
          background: transparent;
          color: var(--ma-mega-text);
          font-size: var(--ma-mobile-nav-size);
          line-height: 1.3;
          font-weight: 750;
          text-align: left;
          cursor: pointer;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu-button:hover,
        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu-button.is-expanded,
        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu-link:hover {
          color: var(--ma-accent);
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu-icon {
          width: 18px;
          height: 18px;
          flex: 0 0 18px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu-icon svg {
          width: 16px;
          height: 16px;
          fill: none;
          stroke: currentColor;
          stroke-width: 1.8;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-submenu {
          display: none;
          padding: 0 16px 16px;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-menu-item.is-expanded > .ma-mobile-submenu {
          display: block;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-submenu-section {
          padding: 12px 0;
          border-top: 1px solid var(--ma-border);
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-submenu-title {
          display: block;
          margin-bottom: 8px;
          color: var(--ma-mega-text);
          font-size: 13px;
          line-height: 1.3;
          font-weight: 800;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-submenu-list {
          list-style: none;
          margin: 0;
          padding: 0;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-submenu-list li + li {
          margin-top: 4px;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-submenu-list a {
          display: block;
          padding: 5px 0;
          color: var(--ma-mega-text);
          font-size: 13px;
          line-height: 1.4;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-submenu-list a:hover {
          color: var(--ma-accent);
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-products {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 10px;
          margin-top: 12px;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-products .ma-product-title {
          font-size: 11px;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-products .ma-product-price {
          font-size: 11px;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-products .ma-compare-price {
          font-size: 10px;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-account {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 8px;
          padding: 15px 16px;
          border-top: 1px solid var(--ma-border);
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-account a {
          min-height: 44px;
          display: flex;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--ma-border);
          border-radius: 3px;
          color: var(--ma-mega-text);
          font-size: 12px;
          font-weight: 800;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-account a:hover {
          border-color: var(--ma-accent);
          color: var(--ma-accent);
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-currency {
          padding: 0 16px 16px;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-currency form {
          border: 1px solid var(--ma-border);
          border-radius: 3px;
          padding: 0 10px;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-currency select {
          width: 100%;
          min-height: 42px;
          border: 0;
          background: transparent;
          color: var(--ma-mega-text);
          font-size: 12px;
          font-weight: 700;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-trust {
          display: block;
          padding: 14px 16px;
          border-top: 1px solid var(--ma-border);
          background: var(--ma-trust-bg);
        }

        #ModernAussiesHeader-{{ section.id }} .ma-mobile-trust .ma-trust-item {
          justify-content: flex-start;
          padding: 5px 0;
          text-align: left;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-trust-bar {
          display: none;
        }

        #ModernAussiesHeader-{{ section.id }} .ma-search-wrap {
          top: 66px;
        }
      }

      @media (min-width: {{ section.settings.mobile_breakpoint | plus: 1 }}px) {
        #ModernAussiesHeader-{{ section.id }} .ma-mobile-only {
          display: none !important;
        }
      }

      @media (max-width: 749px) {
        #ModernAussiesHeader-{{ section.id }} .ma-search-form {
          width: 100%;
        }
      }

      /* Accessibility */
      #ModernAussiesHeader-{{ section.id }} :focus-visible {
        outline: 2px solid var(--ma-accent);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        #ModernAussiesHeader-{{ section.id }} *,
        #ModernAussiesHeader-{{ section.id }} *::before,
        #ModernAussiesHeader-{{ section.id }} *::after {
          transition-duration: .01ms !important;
          scroll-behavior: auto !important;
        }
      }
</style>
<header
  id="ModernAussiesHeader-{{ section.id }}"
  class="ma-header ma-sticky-{{ section.settings.sticky_header }}"
  data-section-id="{{ section.id }}"
  data-sticky-mode="{{ section.settings.sticky_header }}"
  data-mobile-breakpoint="{{ section.settings.mobile_breakpoint }}"
  data-leave-delay="{{ section.settings.mouse_leave_delay }}"
>
  <!--
    ======================================================
         DESKTOP HEADER
    =======================================================
  -->

  <div class="ma-header-main">
    <div class="ma-header-container">
      <!-- Logo -->
      <a
        class="ma-logo"
        href="{{ routes.root_url }}"
        aria-label="{{ shop.name | escape }}"
      >
        {%- if header_logo != blank -%}
          {{
            header_logo
            | image_url: width: 600
            | image_tag: loading: 'eager', widths: '120,180,240,320,400,500,600', class: 'ma-logo-image', alt: shop.name
          }}
        {%- else -%}
          <span class="ma-logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <!-- Navigation -->
      <nav
        class="ma-desktop-nav"
        aria-label="{{ section.settings.navigation_label | escape }}"
      >
        {%- if menu != blank -%}
          <ul class="ma-nav-list" role="list">
            {%- for link in menu.links -%}
              {%- liquid
                assign menu_handle = link.title | handleize
                assign matching_block = blank
                assign has_mega = false

                for block in section.blocks
                  if block.type == 'mega_menu' or block.type == 'mega_menu_2'
                    assign block_menu_handle = block.settings.menu_item | handleize

                    if block_menu_handle == menu_handle
                      assign matching_block = block
                      assign has_mega = true
                      break
                    endif
                  endif
                endfor
              -%}

              <li
                class="ma-nav-item{% if has_mega or link.links != blank  %} has-mega{% endif %}"
                data-menu-item="{{ menu_handle }}"
              >
                <a
                  href="{{ link.url }}"
                  class="ma-nav-link"
                  {% if has_mega %}
                    aria-haspopup="true" aria-expanded="false"
                  {% endif %}
                >
                  <span>{{ link.title }}</span>

                  {%- if link.links != blank or has_mega -%}
                    <span class="ma-nav-arrow" aria-hidden="true"></span>
                  {%- endif -%}

                  {%- if has_mega and matching_block.settings.show_hot_badge -%}
                    <span class="ma-hot">
                      {{ matching_block.settings.hot_badge_text | default: 'Hot' }}
                    </span>
                  {%- endif -%}
                </a>

                {%- if has_mega -%}
                  {%- if matching_block.type == 'mega_menu_2' -%}
                    <div class="ma-mega ma-mega-visual">
                      <div class="ma-mega-inner">
                        <div class="ma-mega-panel">
                          <div class="ma-layout-visual" {{ matching_block.shopify_attributes }}>
                            <div class="ma-visual-sidebar">
                              {%- if matching_block.settings.eyebrow != blank -%}
                                <p class="ma-visual-eyebrow">{{ matching_block.settings.eyebrow }}</p>
                              {%- endif -%}

                              {%- if matching_block.settings.title != blank -%}
                                <h3 class="ma-visual-title">{{ matching_block.settings.title }}</h3>
                              {%- endif -%}

                              {%- if matching_block.settings.description != blank -%}
                                <p class="ma-visual-description">{{ matching_block.settings.description }}</p>
                              {%- endif -%}

                              {%- if matching_block.settings.show_trust_bar -%}
                                <div class="ma-visual-trust">
                                  {%- assign visual_trust_items = 'trust_1_text|trust_2_text|trust_3_text'
                                    | split: '|'
                                  -%}
                                  {%- for trust_key in visual_trust_items -%}
                                    {%- assign trust_text = matching_block.settings[trust_key] -%}
                                    {%- if trust_text != blank -%}
                                      <div class="ma-visual-trust-item">
                                        <span class="ma-visual-trust-icon" aria-hidden="true"></span>
                                        <span>{{ trust_text }}</span>
                                      </div>
                                    {%- endif -%}
                                  {%- endfor -%}
                                </div>
                              {%- endif -%}

                              <div class="ma-visual-categories">
                                {%- assign accordion_opened = false -%}

                                {%- for menu_number in (1..4) -%}
                                  {%- capture category_key -%}column_menu_{{ menu_number }}{%- endcapture -%}
                                  {%- assign category_menu = matching_block.settings[category_key] -%}
                                  {%- if category_menu != blank -%}
                                    {%- for category_link in category_menu.links -%}
                                      {%- assign has_children = false -%}

                                      {%- if category_link.links != blank -%}
                                        {%- assign has_children = true -%}
                                      {%- endif -%}

                                      {%- if has_children -%}
                                        {%- assign is_first_open = false -%}

                                        {%- unless accordion_opened -%}
                                          {%- assign is_first_open = true -%}
                                          {%- assign accordion_opened = true -%}
                                        {%- endunless -%}

                                        <div
                                          class="ma-visual-category-group"
                                          data-visual-accordion
                                        >
                                          <!-- Parent -->
                                          <button
                                            type="button"
                                            class="ma-visual-category ma-visual-category-toggle"
                                            aria-expanded="false"
                                            aria-controls="VisualCategory-{{ section.id }}-{{ matching_block.id }}-{{ menu_number }}-{{ forloop.index }}"
                                          >
                                            <span class="ma-visual-category-title">
                                              {{ category_link.title }}
                                            </span>

                                            <span
                                              class="ma-visual-category-plus"
                                              aria-hidden="true"
                                            >
                                              <span class="ma-plus">+</span>
                                              <span class="ma-minus">−</span>
                                            </span>
                                          </button>

                                          <!-- Accordion content -->
                                          <div
                                            id="VisualCategory-{{ section.id }}-{{ matching_block.id }}-{{ menu_number }}-{{ forloop.index }}"
                                            class="ma-visual-category-content"
                                            {% unless is_first_open %}
                                              hidden
                                            {% endunless %}
                                          >
                                            <div class="ma-visual-category-children">
                                              {%- for child_link in category_link.links -%}
                                                <a
                                                  class="ma-visual-category-child"
                                                  href="{{ child_link.url }}"
                                                >
                                                  {{ child_link.title }}
                                                </a>
                                              {%- endfor -%}
                                            </div>

                                            <!-- View All -->
                                            <a
                                              class="ma-visual-category-view-all"
                                              href="{{ category_link.url }}"
                                            >
                                              <span> View All {{ category_link.title }} </span>

                                              <span
                                                class="ma-visual-category-arrow"
                                                aria-hidden="true"
                                              >
                                                →
                                              </span>
                                            </a>
                                          </div>
                                        </div>

                                      {%- else -%}
                                        <!-- Normal category without children -->
                                        <a
                                          class="ma-visual-category ma-visual-category-link"
                                          href="{{ category_link.url }}"
                                        >
                                          <span class="ma-visual-category-title">
                                            {{ category_link.title }}
                                          </span>
                                        </a>
                                      {%- endif -%}
                                    {%- endfor -%}
                                  {%- endif -%}
                                {%- endfor -%}
                              </div>

                              {%- if matching_block.settings.side_image != blank -%}
                                {%- assign sidebar_image_link = matching_block.settings.side_image_url
                                  | default: link.url
                                -%}
                                <a class="ma-visual-sidebar-banner" href="{{ sidebar_image_link }}">
                                  {{
                                    matching_block.settings.side_image
                                    | image_url: width: 800
                                    | image_tag:
                                      loading: 'lazy',
                                      widths: '300,500,700,800',
                                      alt: matching_block.settings.side_image_alt
                                  }}
                                </a>
                              {%- endif -%}
                            </div>

                            <div class="ma-visual-products">
                              <div class="ma-visual-products-head">
                                <div>
                                  {%- if matching_block.settings.products_eyebrow != blank -%}
                                    <p class="ma-visual-products-eyebrow">
                                      {{ matching_block.settings.products_eyebrow }}
                                    </p>
                                  {%- endif -%}
                                  {%- if matching_block.settings.products_title != blank -%}
                                    <h3 class="ma-visual-products-title">
                                      {{ matching_block.settings.products_title }}
                                    </h3>
                                  {%- endif -%}
                                </div>
                                {%- if matching_block.settings.products_view_all_url != blank -%}
                                  <a
                                    class="ma-visual-view-all"
                                    href="{{ matching_block.settings.products_view_all_url }}"
                                  >
                                    {{ matching_block.settings.products_view_all_label | default: 'View all →' }}
                                  </a>
                                {%- endif -%}
                              </div>

                              <div class="ma-visual-product-grid">
                                {%- for product_number in (1..4) -%}
                                  {%- capture product_key -%}product_{{ product_number }}{%- endcapture -%}
                                  {%- capture badge_key -%}product_{{ product_number }}_badge{%- endcapture -%}
                                  {%- assign visual_product = matching_block.settings[product_key] -%}
                                  {%- assign visual_badge = matching_block.settings[badge_key] -%}

                                  {%- if visual_product != blank -%}
                                    <a class="ma-visual-product-card" href="{{ visual_product.url }}">
                                      <div class="ma-visual-product-image">
                                        {%- if visual_badge != blank -%}
                                          <span class="ma-visual-product-badge">{{ visual_badge }}</span>
                                        {%- endif -%}
                                        {%- if visual_product.featured_image != blank -%}
                                          {{
                                            visual_product.featured_image
                                            | image_url: width: 900
                                            | image_tag:
                                              loading: 'lazy',
                                              widths: '300,450,600,750,900',
                                              alt: visual_product.title
                                          }}
                                        {%- endif -%}
                                      </div>
                                      <div class="ma-visual-product-info">
                                        <p class="ma-visual-product-title">{{ visual_product.title }}</p>
                                        {%- if matching_block.settings.show_product_rating -%}
                                          <div class="ma-visual-product-rating" aria-label="5 out of 5 stars">
                                            ★★★★★
                                          </div>
                                        {%- endif -%}
                                        <div class="ma-visual-product-price">
                                          <span class="ma-visual-current-price">
                                            {{- visual_product.price | money -}}
                                          </span>
                                          {%- if visual_product.compare_at_price > visual_product.price -%}
                                            <span class="ma-visual-compare-price">
                                              {{- visual_product.compare_at_price | money -}}
                                            </span>
                                          {%- endif -%}
                                        </div>
                                      </div>
                                    </a>
                                  {%- endif -%}
                                {%- endfor -%}
                              </div>

                              {%- if matching_block.settings.products_cta_url != blank -%}
                                <div class="ma-visual-products-cta">
                                  <a class="ma-cta" href="{{ matching_block.settings.products_cta_url }}">
                                    {{
                                      matching_block.settings.products_cta_label
                                      | default: 'Shop all home & living →'
                                    }}
                                  </a>
                                </div>
                              {%- endif -%}
                            </div>

                            <div class="ma-visual-feature">
                              {%- if matching_block.settings.featured_image != blank -%}
                                {{
                                  matching_block.settings.featured_image
                                  | image_url: width: 1200
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '500,700,900,1200',
                                    alt: matching_block.settings.featured_title
                                }}
                              {%- endif -%}

                              <div class="ma-visual-feature-copy">
                                {%- if matching_block.settings.featured_badge != blank -%}
                                  <span class="ma-visual-feature-badge">
                                    {{- matching_block.settings.featured_badge -}}
                                  </span>
                                {%- endif -%}
                                {%- if matching_block.settings.featured_label != blank -%}
                                  <span class="ma-visual-feature-label">
                                    {{- matching_block.settings.featured_label -}}
                                  </span>
                                {%- endif -%}
                                {%- if matching_block.settings.featured_title != blank -%}
                                  <h3 class="ma-visual-feature-title">{{ matching_block.settings.featured_title }}</h3>
                                {%- endif -%}
                                {%- if matching_block.settings.featured_description != blank -%}
                                  <p class="ma-visual-feature-description">
                                    {{ matching_block.settings.featured_description }}
                                  </p>
                                {%- endif -%}
                                {%- if matching_block.settings.featured_cta_url != blank -%}
                                  <a
                                    class="ma-visual-feature-link"
                                    href="{{ matching_block.settings.featured_cta_url }}"
                                  >
                                    {{ matching_block.settings.featured_cta_label | default: 'Shop the edit →' }}
                                  </a>
                                {%- endif -%}
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                  {%- else -%}
                    {% render 'modern-aussies-mega-menu', block: matching_block, link: link, section: section %}
                  {%- endif -%}

                {%- elsif link.links != blank -%}
                  <div class="ma-mega">
                    <div class="ma-mega-inner">
                      <div class="ma-mega-panel">
                        <div class="ma-mega-content">
                          <div class="ma-layout-links">
                            <div>
                              <a class="ma-column-heading" href="{{ link.url }}">
                                {{ link.title }}
                              </a>

                              <ul class="ma-link-list" role="list">
                                {%- for child_link in link.links -%}
                                  <li>
                                    <a href="{{ child_link.url }}">
                                      {{ child_link.title }}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>

      <!-- Actions -->
      <div class="ma-actions">
        {%- if section.settings.show_currency and localization.available_countries.size > 1 -%}
          <div class="ma-currency">
            {%- form 'localization', id: 'HeaderCurrencyForm-', class: 'ma-localization-form' -%}
              <select
                name="country_code"
                aria-label="Currency"
                onchange="this.form.submit()"
              >
                {%- for country in localization.available_countries -%}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ country.currency.iso_code }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endform -%}
          </div>
        {%- endif -%}
        {%- if section.settings.enable_search -%}
          <button
            type="button"
            class="ma-action ma-search-toggle"
            aria-label="Search"
            aria-expanded="false"
          >
            <svg
              class="lucide lucide-search"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m21 21-4.34-4.34"></path> <circle cx="11" cy="11" r="8"></circle>
            </svg>
          </button>
        {%- endif -%}

        {%- if section.settings.show_account -%}
          <a
            href="{{ routes.account_url }}"
            class="ma-action"
            aria-label="Account"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              width="800px"
              height="800px"
              viewBox="0 0 32 32"
              version="1.1"
            >
              <title>user</title>
              <path d="M16 16.75c4.28 0 7.75-3.47 7.75-7.75s-3.47-7.75-7.75-7.75c-4.28 0-7.75 3.47-7.75 7.75v0c0.005 4.278 3.472 7.745 7.75 7.75h0zM16 2.75c3.452 0 6.25 2.798 6.25 6.25s-2.798 6.25-6.25 6.25c-3.452 0-6.25-2.798-6.25-6.25v0c0.004-3.45 2.8-6.246 6.25-6.25h0zM30.41 29.84c-1.503-6.677-7.383-11.59-14.41-11.59s-12.907 4.913-14.391 11.491l-0.019 0.099c-0.011 0.048-0.017 0.103-0.017 0.16 0 0.414 0.336 0.75 0.75 0.75 0.357 0 0.656-0.25 0.731-0.585l0.001-0.005c1.351-5.998 6.633-10.41 12.945-10.41s11.594 4.413 12.929 10.322l0.017 0.089c0.076 0.34 0.374 0.59 0.732 0.59 0 0 0.001 0 0.001 0h-0c0.057-0 0.112-0.007 0.165-0.019l-0.005 0.001c0.34-0.076 0.59-0.375 0.59-0.733 0-0.057-0.006-0.112-0.018-0.165l0.001 0.005z"/>
            </svg>
          </a>
        {%- endif -%}

        <a
          href="{{ routes.cart_url }}"
          class="ma-action"
          aria-label="Cart{% if cart_count > 0 %}, {{ cart_count }} items{% endif %}"
        >
          <svg
            class="lucide lucide-shopping-bag"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M16 10a4 4 0 0 1-8 0"></path> <path d="M3.103 6.034h17.794"></path> <path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"></path>
          </svg>

          {%- if cart_count > 0 -%}
            <span class="ma-cart-count">
              {{ cart_count }}
            </span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>

  <!-- Search -->
  {%- if section.settings.enable_search -%}
    <div class="ma-search-wrap">
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="ma-search-form"
      >
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          aria-label="Search"
        >
        <input type="hidden" name="options[prefix]" value="last">

        <button type="submit" aria-label="Submit search">
          <svg
            class="lucide lucide-search"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m21 21-4.34-4.34"></path> <circle cx="11" cy="11" r="8"></circle>
          </svg>
        </button>
      </form>
    </div>
  {%- endif -%}

  <!--
    ======================================================
         MOBILE HEADER
    =======================================================
  -->

  <div class="ma-mobile-header">
    <div class="ma-mobile-left">
      <button
        type="button"
        class="ma-mobile-action ma-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>

    <a
      href="{{ routes.root_url }}"
      class="ma-mobile-logo"
      aria-label="{{ shop.name | escape }}"
    >
      {%- if header_logo != blank -%}
        {{
          header_logo
          | image_url: width: 500
          | image_tag: loading: 'eager', widths: '120,180,240,320,400,500', alt: shop.name
        }}
      {%- else -%}
        <span class="ma-mobile-logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="ma-mobile-right">
      {%- if section.settings.enable_search -%}
        <button
          type="button"
          class="ma-mobile-action ma-search-toggle"
          aria-label="Search"
          aria-expanded="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 5 5"></path>
          </svg>
        </button>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="ma-mobile-action ma-mobile-cart"
        aria-label="Cart{% if cart_count > 0 %}, {{ cart_count }} items{% endif %}"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3.5 4h2l1.5 11h10l2-8H6"></path>
          <circle cx="9" cy="19" r="1.2"></circle>
          <circle cx="17" cy="19" r="1.2"></circle>
        </svg>

        {%- if cart_count > 0 -%}
          <span class="ma-mobile-cart-count">
            {{ cart_count }}
          </span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <!--
    ======================================================
         MOBILE DRAWER
    =======================================================
  -->

  <div class="ma-mobile-overlay" aria-hidden="true"></div>

  <aside
    class="ma-mobile-drawer"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <div class="ma-drawer-header">
      <a
        href="{{ routes.root_url }}"
        class="ma-drawer-logo"
      >
        {%- if header_logo != blank -%}
          {{
            header_logo
            | image_url: width: 400
            | image_tag: loading: 'eager', widths: '120,180,240,320,400', alt: shop.name
          }}
        {%- else -%}
          <span class="ma-drawer-logo-text">
            {{ shop.name }}
          </span>
        {%- endif -%}
      </a>

      <button
        type="button"
        class="ma-drawer-close"
        aria-label="Close menu"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 5l14 14M19 5 5 19"></path>
        </svg>
      </button>
    </div>

    <div class="ma-drawer-scroll">
      <ul class="ma-mobile-menu" role="list">
        {%- if menu != blank -%}
          {%- for link in menu.links -%}
            {%- liquid
              assign menu_handle = link.title | handleize
              assign matching_block = blank
              assign has_mega = false

              for block in section.blocks
                if block.type == 'mega_menu' or block.type == 'mega_menu_2'
                  assign block_menu_handle = block.settings.menu_item | handleize

                  if block_menu_handle == menu_handle
                    assign matching_block = block
                    assign has_mega = true
                    break
                  endif
                endif
              endfor

              assign has_children = false
              if link.links != blank
                assign has_children = true
              endif

              if has_mega
                assign has_children = true
              endif
            -%}

            <li
              class="ma-mobile-menu-item"
              data-mobile-item="{{ menu_handle }}"
            >
              {%- if has_children -%}
                <button
                  type="button"
                  class="ma-mobile-menu-button"
                  aria-expanded="false"
                >
                  <span>
                    {{ link.title }}

                    {%- if has_mega and matching_block.settings.show_hot_badge -%}
                      <span class="ma-hot">
                        {{ matching_block.settings.hot_badge_text | default: 'Hot' }}
                      </span>
                    {%- endif -%}
                  </span>

                  <span class="ma-mobile-menu-icon">
                    <svg class="ma-icon-plus" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 5v14M5 12h14"></path>
                    </svg>

                    <svg class="ma-icon-minus" viewBox="0 0 24 24" aria-hidden="true" style="display:none;">
                      <path d="M5 12h14"></path>
                    </svg>
                  </span>
                </button>

                <div class="ma-mobile-submenu">
                  <!-- Main link -->
                  <div class="ma-mobile-submenu-section">
                    <a
                      class="ma-mobile-submenu-title"
                      href="{{ link.url }}"
                    >
                      View {{ link.title }}
                    </a>
                  </div>

                  {%- if has_mega -%}
                    {%- if matching_block.type == 'mega_menu_2' -%}
                      <div class="ma-mobile-submenu-section">
                        {%- if matching_block.settings.eyebrow != blank -%}
                          <div class="ma-visual-eyebrow">{{ matching_block.settings.eyebrow }}</div>
                        {%- endif -%}
                        {%- if matching_block.settings.title != blank -%}
                          <strong class="ma-mobile-submenu-title">{{ matching_block.settings.title }}</strong>
                        {%- endif -%}
                        {%- if matching_block.settings.description != blank -%}
                          <div style="font-size:13px;line-height:1.45;margin-bottom:10px;">
                            {{ matching_block.settings.description }}
                          </div>
                        {%- endif -%}

                        {%- if matching_block.settings.show_trust_bar -%}
                          <div class="ma-visual-trust">
                            {%- assign mobile_visual_trust_items = 'trust_1_text|trust_2_text|trust_3_text'
                              | split: '|'
                            -%}
                            {%- for trust_key in mobile_visual_trust_items -%}
                              {%- assign trust_text = matching_block.settings[trust_key] -%}
                              {%- if trust_text != blank -%}
                                <div class="ma-visual-trust-item">
                                  <span class="ma-visual-trust-icon" aria-hidden="true"></span>
                                  <span>{{ trust_text }}</span>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}

                        {%- for menu_number in (1..4) -%}
                          {%- capture category_key -%}
                                column_menu_{{ menu_number }}
                            {%- endcapture -%}

                          {%- assign category_menu = matching_block.settings[category_key] -%}

                          {%- if category_menu != blank -%}
                            {%- for category_link in category_menu.links -%}
                              {%- if category_link.links != blank -%}
                                <!--
                                  =========================================
                                      MOBILE CATEGORY WITH CHILDREN
                                  ==========================================
                                -->

                                <div class="ma-mobile-visual-category-group">
                                  <button
                                    type="button"
                                    class="ma-mobile-visual-category-toggle"
                                    aria-expanded="false"
                                  >
                                    <span class="ma-mobile-visual-category-title">
                                      {{ category_link.title }}
                                    </span>

                                    <span
                                      class="ma-mobile-visual-category-icon"
                                      aria-hidden="true"
                                    >
                                      <span class="ma-mobile-visual-plus">+</span>
                                      <span class="ma-mobile-visual-minus">−</span>
                                    </span>
                                  </button>

                                  <!-- Children -->
                                  <div
                                    class="ma-mobile-visual-category-content"
                                    hidden
                                  >
                                    <div class="ma-mobile-visual-category-children">
                                      {%- for child_link in category_link.links -%}
                                        <a
                                          href="{{ child_link.url }}"
                                          class="ma-mobile-visual-category-child"
                                        >
                                          {{ child_link.title }}
                                        </a>
                                      {%- endfor -%}
                                    </div>

                                    <!-- View All -->
                                    <a
                                      href="{{ category_link.url }}"
                                      class="ma-mobile-visual-category-view-all"
                                    >
                                      <span> View All {{ category_link.title }} </span>

                                      <span aria-hidden="true">→</span>
                                    </a>
                                  </div>
                                </div>

                              {%- else -%}
                                <!--
                                  =========================================
                                      MOBILE CATEGORY WITHOUT CHILDREN
                                  ==========================================
                                -->

                                <a
                                  class="ma-mobile-visual-category-link"
                                  href="{{ category_link.url }}"
                                >
                                  <span>
                                    {{ category_link.title }}
                                  </span>

                                  <span
                                    class="ma-mobile-visual-category-plus"
                                    aria-hidden="true"
                                  >
                                    +
                                  </span>
                                </a>
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>

                    {%- else -%}
                      {%- case matching_block.settings.layout -%}
                        {%- when 'columns_featured' -%}
                          {%- for menu_setting in (1..4) -%}
                            {%- capture menu_key -%}column_{{ menu_setting }}_menu{%- endcapture -%}
                            {%- capture title_key -%}column_{{ menu_setting }}_title{%- endcapture -%}

                            {%- assign selected_menu = matching_block.settings[menu_key] -%}
                            {%- assign column_title = matching_block.settings[title_key] -%}

                            {%- if selected_menu != blank -%}
                              <div class="ma-mobile-submenu-section">
                                {%- if column_title != blank -%}
                                  <strong class="ma-mobile-submenu-title">
                                    {{ column_title }}
                                  </strong>
                                {%- endif -%}

                                <ul class="ma-mobile-submenu-list">
                                  {%- for child_link in selected_menu.links -%}
                                    <li>
                                      <a href="{{ child_link.url }}">
                                        {{ child_link.title }}
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}

                        {%- when 'side_image' -%}
                          {%- for menu_setting in (1..2) -%}
                            {%- capture menu_key -%}column_{{ menu_setting }}_menu{%- endcapture -%}
                            {%- capture title_key -%}column_{{ menu_setting }}_title{%- endcapture -%}

                            {%- assign selected_menu = matching_block.settings[menu_key] -%}
                            {%- assign column_title = matching_block.settings[title_key] -%}

                            {%- if selected_menu != blank -%}
                              <div class="ma-mobile-submenu-section">
                                {%- if column_title != blank -%}
                                  <strong class="ma-mobile-submenu-title">
                                    {{ column_title }}
                                  </strong>
                                {%- endif -%}

                                <ul class="ma-mobile-submenu-list">
                                  {%- for child_link in selected_menu.links -%}
                                    <li>
                                      <a href="{{ child_link.url }}">
                                        {{ child_link.title }}
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}

                        {%- when 'links_only' -%}
                          {%- for menu_setting in (1..4) -%}
                            {%- capture menu_key -%}column_{{ menu_setting }}_menu{%- endcapture -%}
                            {%- capture title_key -%}column_{{ menu_setting }}_title{%- endcapture -%}

                            {%- assign selected_menu = matching_block.settings[menu_key] -%}
                            {%- assign column_title = matching_block.settings[title_key] -%}

                            {%- if selected_menu != blank -%}
                              <div class="ma-mobile-submenu-section">
                                {%- if column_title != blank -%}
                                  <strong class="ma-mobile-submenu-title">
                                    {{ column_title }}
                                  </strong>
                                {%- endif -%}

                                <ul class="ma-mobile-submenu-list">
                                  {%- for child_link in selected_menu.links -%}
                                    <li>
                                      <a href="{{ child_link.url }}">
                                        {{ child_link.title }}
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}

                        {%- when 'products_focus' -%}
                          {%- if matching_block.settings.column_1_menu != blank -%}
                            <div class="ma-mobile-submenu-section">
                              <strong class="ma-mobile-submenu-title">
                                {{ matching_block.settings.column_1_title | default: 'Shop' }}
                              </strong>

                              <ul class="ma-mobile-submenu-list">
                                {%- for child_link in matching_block.settings.column_1_menu.links -%}
                                  <li>
                                    <a href="{{ child_link.url }}">
                                      {{ child_link.title }}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          {%- endif -%}

                        {%- when 'hero_feature' -%}
                          <div class="ma-mobile-submenu-section">
                            {%- if matching_block.settings.featured_badge != blank -%}
                              <span class="ma-badge">
                                {{ matching_block.settings.featured_badge }}
                              </span>
                            {%- endif -%}

                            {%- if matching_block.settings.featured_title != blank -%}
                              <strong class="ma-mobile-submenu-title">
                                {{ matching_block.settings.featured_title }}
                              </strong>
                            {%- endif -%}

                            {%- if matching_block.settings.featured_description != blank -%}
                              <div style="font-size:13px;line-height:1.45;margin-bottom:10px;">
                                {{ matching_block.settings.featured_description }}
                              </div>
                            {%- endif -%}

                            {%- if matching_block.settings.cta_text != blank
                              and matching_block.settings.cta_link != blank
                            -%}
                              <a
                                href="{{ matching_block.settings.cta_link }}"
                                class="ma-cta"
                              >
                                {{ matching_block.settings.cta_text }}
                              </a>
                            {%- endif -%}
                          </div>
                      {%- endcase -%}
                    {%- endif -%}

                  {%- else -%}
                    {%- for child_link in link.links -%}
                      <div class="ma-mobile-submenu-section">
                        <a
                          class="ma-mobile-submenu-title"
                          href="{{ child_link.url }}"
                        >
                          {{ child_link.title }}
                        </a>

                        {%- if child_link.links != blank -%}
                          <ul class="ma-mobile-submenu-list">
                            {%- for grandchild_link in child_link.links -%}
                              <li>
                                <a href="{{ grandchild_link.url }}">
                                  {{ grandchild_link.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}

                  {%- if has_mega -%}
                    {%- assign mobile_products = 0 -%}

                    <div class="ma-mobile-products">
                      {%- if matching_block.settings.product_1 != blank -%}
                        {% assign mobile_products = mobile_products | plus: 1 %}
                        {% render 'modern-aussies-product-card',
                          product: matching_block.settings.product_1,
                          section: section
                        %}
                      {%- endif -%}

                      {%- if matching_block.settings.product_2 != blank and mobile_products < 2 -%}
                        {% assign mobile_products = mobile_products | plus: 1 %}
                        {% render 'modern-aussies-product-card',
                          product: matching_block.settings.product_2,
                          section: section
                        %}
                      {%- endif -%}
                    </div>

                    {%- if matching_block.settings.cta_text != blank and matching_block.settings.cta_link != blank -%}
                      <div style="padding-top:14px;">
                        <a
                          href="{{ matching_block.settings.cta_link }}"
                          class="ma-cta"
                        >
                          {{ matching_block.settings.cta_text }}
                        </a>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                </div>

              {%- else -%}
                <a
                  class="ma-mobile-menu-link"
                  href="{{ link.url }}"
                >
                  <span>{{ link.title }}</span>

                  <span class="ma-mobile-menu-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="m9 5 7 7-7 7"></path>
                    </svg>
                  </span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      <!-- Account -->
      {%- if section.settings.show_account -%}
        <div class="ma-mobile-account">
          <a href="{{ routes.account_url }}"> Account </a>

          <a href="{{ routes.cart_url }}">
            Cart{% if cart_count > 0 %} ({{ cart_count }}){% endif %}
          </a>
        </div>
      {%- endif -%}

      <!-- Currency -->
      {%- if section.settings.show_currency and localization.available_countries.size > 1 -%}
        <div class="ma-mobile-currency">
          {%-
            form 'localization',
            id: 'MobileCurrencyForm-' | append: section.id
          -%}
            <select
              name="country_code"
              aria-label="Currency"
              onchange="this.form.submit()"
            >
              {%- for country in localization.available_countries -%}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ country.name }} — {{ country.currency.iso_code }}
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        </div>
      {%- endif -%}

      <!-- Mobile Trust -->
      {%- if section.settings.enable_trust_bar -%}
        <div class="ma-mobile-trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_item' -%}
              <div
                class="ma-trust-item"
                {{ block.shopify_attributes }}
              >
                <span class="ma-trust-icon">
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 5h11v11H3z"></path>
                        <path d="M14 9h4l3 3v4h-7z"></path>
                        <circle cx="7" cy="18" r="1.5"></circle>
                        <circle cx="18" cy="18" r="1.5"></circle>
                      </svg>

                    {%- when 'returns' -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 7v5h5"></path>
                        <path d="M4.5 12A8 8 0 1 0 7 6.3"></path>
                      </svg>

                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3 20 6v5c0 5-3.2 8.2-8 10-4.8-1.8-8-5-8-10V6z"></path>
                        <path d="m8.5 12 2.2 2.2 4.8-5"></path>
                      </svg>

                    {%- when 'check' -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="8.5"></circle>
                        <path d="m8 12 2.6 2.6L16 9"></path>
                      </svg>
                  {%- endcase -%}
                </span>

                <span>
                  {{ block.settings.text }}
                </span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </aside>

  <!--
    ======================================================
         DESKTOP TRUST BAR
    =======================================================
  -->

  {%- if section.settings.enable_trust_bar -%}
    <div class="ma-trust-bar">
      <div class="ma-trust-inner">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_item' -%}
            <div
              class="ma-trust-item"
              {{ block.shopify_attributes }}
            >
              <span class="ma-trust-icon">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M3 5h11v11H3z"></path>
                      <path d="M14 9h4l3 3v4h-7z"></path>
                      <circle cx="7" cy="18" r="1.5"></circle>
                      <circle cx="18" cy="18" r="1.5"></circle>
                    </svg>

                  {%- when 'returns' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 7v5h5"></path>
                      <path d="M4.5 12A8 8 0 1 0 7 6.3"></path>
                    </svg>

                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 3 20 6v5c0 5-3.2 8.2-8 10-4.8-1.8-8-5-8-10V6z"></path>
                      <path d="m8.5 12 2.2 2.2 4.8-5"></path>
                    </svg>

                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="8.5"></circle>
                      <path d="m8 12 2.6 2.6L16 9"></path>
                    </svg>
                {%- endcase -%}
              </span>

              <span>
                {{ block.settings.text }}
              </span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <!--
    ======================================================
         JAVASCRIPT
    =======================================================
  -->

  <script>
    (() => {
      document.addEventListener('DOMContentLoaded', () => {
        const header = document.querySelector(
            '#ModernAussiesHeader-{{ section.id }}'
        );

        if (!header) return;

        function updateHeaderHeight() {
            const headerHeight = header.getBoundingClientRect().height;

            document.body.style.setProperty(
            '--header-height',
            `${headerHeight}px`
            );
        }

        // Initial
        updateHeaderHeight();

        // Resize
        window.addEventListener('resize', updateHeaderHeight);

        // Also catches changes caused by content/layout changes
        if (window.ResizeObserver) {
            const observer = new ResizeObserver(updateHeaderHeight);
            observer.observe(header);
        }
        });

      const root = document.getElementById('ModernAussiesHeader-{{ section.id }}');
        
      if (!root || root.dataset.initialized === 'true') return;

      root.dataset.initialized = 'true';

      const leaveDelay = Number(root.dataset.leaveDelay || 150);

      let closeTimer = null;
      /* -------------------------------------------------------
        STICKY HEADER
        ------------------------------------------------------- */

        const stickyMode = root.dataset.stickyMode;

        if (stickyMode === 'on_scroll') {

        let lastScrollY = window.scrollY;
        let ticking = false;

        function updateStickyHeader() {

            const currentScrollY = window.scrollY;

            /* At the very top */
            if (currentScrollY <= 10) {

            root.classList.remove('ma-header-hidden');
            root.classList.remove('ma-header-visible');
            root.classList.remove('ma-sticky-scrolled');

            document.body.classList.remove('ma-header-hidden');
            document.body.classList.remove('ma-header-visible');
            document.body.classList.remove('ma-sticky-scrolled');
            

            }

            /* Scrolling down */
            else if (currentScrollY > lastScrollY) {

            root.classList.add('ma-header-hidden');
            root.classList.remove('ma-header-visible');
            root.classList.add('ma-sticky-scrolled');

            document.body.classList.add('ma-header-hidden');
            document.body.classList.remove('ma-header-visible');
            document.body.classList.add('ma-sticky-scrolled'); 

            }

            /* Scrolling up */
            else if (currentScrollY < lastScrollY) {

            root.classList.remove('ma-header-hidden');
            root.classList.add('ma-header-visible');
            root.classList.add('ma-sticky-scrolled');

            document.body.classList.remove('ma-header-hidden');
            document.body.classList.add('ma-header-visible');
            document.body.classList.add('ma-sticky-scrolled');

            }

            lastScrollY = currentScrollY;

            ticking = false;
        }


        window.addEventListener(
            'scroll',
            () => {

            if (!ticking) {

                window.requestAnimationFrame(
                updateStickyHeader
                );

                ticking = true;

            }

            },
            {
            passive: true
            }
        );

        }
      const desktopItems = Array.from(root.querySelectorAll('.ma-desktop-nav .ma-nav-item.has-mega'));

      function clearCloseTimer() {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = null;
        }
      }

      function closeDesktopMenus() {
        clearCloseTimer();

        desktopItems.forEach((item) => {
          item.classList.remove('is-open');

          const link = item.querySelector(':scope > .ma-nav-link');

          if (link) {
            link.setAttribute('aria-expanded', 'false');
          }
        });
      }

      function openDesktopMenu(item) {
        clearCloseTimer();

        desktopItems.forEach((other) => {
          if (other !== item) {
            other.classList.remove('is-open');

            const otherLink = other.querySelector(':scope > .ma-nav-link');

            if (otherLink) {
              otherLink.setAttribute('aria-expanded', 'false');
            }
          }
        });

        item.classList.add('is-open');

        const link = item.querySelector(':scope > .ma-nav-link');

        if (link) {
          link.setAttribute('aria-expanded', 'true');
        }
      }

      function closeDesktopSoon() {
        clearCloseTimer();

        closeTimer = window.setTimeout(() => {
          closeDesktopMenus();
        }, leaveDelay);
      }

      desktopItems.forEach((item) => {
        const mega = item.querySelector(':scope > .ma-mega');

        if (!mega) return;

        item.addEventListener('mouseenter', () => {
          openDesktopMenu(item);
        });

        item.addEventListener('mouseleave', () => {
          closeDesktopSoon();
        });

        item.addEventListener('focusin', () => {
          openDesktopMenu(item);
        });

        item.addEventListener('focusout', (event) => {
          if (!item.contains(event.relatedTarget)) {
            closeDesktopSoon();
          }
        });

        mega.addEventListener('mouseenter', () => {
          clearCloseTimer();
        });

        mega.addEventListener('mouseleave', () => {
          closeDesktopSoon();
        });
      });

      document.addEventListener('click', (event) => {
        if (!root.contains(event.target)) {
          closeDesktopMenus();
        }
      });
      /* -------------------------------------------------------
        VISUAL MEGA MENU CATEGORY ACCORDIONS
        ------------------------------------------------------- */

      const visualAccordions = Array.from(root.querySelectorAll('[data-visual-accordion]'));

      visualAccordions.forEach((group) => {
        const button = group.querySelector(':scope > .ma-visual-category-toggle');

        const content = group.querySelector(':scope > .ma-visual-category-content');

        if (!button || !content) return;

        button.addEventListener('click', () => {
          const isOpen = group.classList.contains('is-open');

          /* Close all other accordions */
          visualAccordions.forEach((otherGroup) => {
            if (otherGroup === group) return;

            otherGroup.classList.remove('is-open');

            const otherButton = otherGroup.querySelector(':scope > .ma-visual-category-toggle');

            const otherContent = otherGroup.querySelector(':scope > .ma-visual-category-content');

            if (otherButton) {
              otherButton.setAttribute('aria-expanded', 'false');
            }

            if (otherContent) {
              otherContent.hidden = true;
            }
          });

          /* Toggle clicked accordion */

          if (isOpen) {
            group.classList.remove('is-open');

            button.setAttribute('aria-expanded', 'false');

            content.hidden = true;
          } else {
            group.classList.add('is-open');

            button.setAttribute('aria-expanded', 'true');

            content.hidden = false;
          }
        });
      });
      /* -------------------------------------------------------
         MOBILE DRAWER
      ------------------------------------------------------- */

      const menuToggle = root.querySelector('.ma-menu-toggle');
      const drawer = root.querySelector('.ma-mobile-drawer');
      const drawerClose = root.querySelector('.ma-drawer-close');
      const overlay = root.querySelector('.ma-mobile-overlay');

      function openDrawer() {
        root.classList.add('drawer-open');

        if (menuToggle) {
          menuToggle.setAttribute('aria-expanded', 'true');
          menuToggle.setAttribute('aria-label', 'Close menu');
        }

        if (drawer) {
          drawer.setAttribute('aria-hidden', 'false');
        }

        document.documentElement.classList.add('ma-mobile-menu-open');
        document.body.classList.add('ma-mobile-menu-open');
      }

      function closeDrawer() {
        root.classList.remove('drawer-open');

        if (menuToggle) {
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.setAttribute('aria-label', 'Open menu');
        }

        if (drawer) {
          drawer.setAttribute('aria-hidden', 'true');
        }

        document.documentElement.classList.remove('ma-mobile-menu-open');
        document.body.classList.remove('ma-mobile-menu-open');
      }

      if (menuToggle) {
        menuToggle.addEventListener('click', () => {
          if (root.classList.contains('drawer-open')) {
            closeDrawer();
          } else {
            openDrawer();
          }
        });
      }

      if (drawerClose) {
        drawerClose.addEventListener('click', closeDrawer);
      }

      if (overlay) {
        overlay.addEventListener('click', closeDrawer);
      }

      /* -------------------------------------------------------
         MOBILE EXPANDABLE MENUS
      ------------------------------------------------------- */

      const mobileItems = Array.from(root.querySelectorAll('.ma-mobile-menu-item'));

      mobileItems.forEach((item) => {
        const button = item.querySelector(':scope > .ma-mobile-menu-button');

        if (!button) return;

        const submenu = item.querySelector(':scope > .ma-mobile-submenu');

        if (!submenu) return;

        button.addEventListener('click', () => {
          const wasExpanded = item.classList.contains('is-expanded');

          mobileItems.forEach((otherItem) => {
            otherItem.classList.remove('is-expanded');

            const otherButton = otherItem.querySelector(':scope > .ma-mobile-menu-button');

            if (otherButton) {
              otherButton.setAttribute('aria-expanded', 'false');
            }

            const plus = otherItem.querySelector('.ma-icon-plus');
            const minus = otherItem.querySelector('.ma-icon-minus');

            if (plus) plus.style.display = '';
            if (minus) minus.style.display = 'none';
          });

          if (!wasExpanded) {
            item.classList.add('is-expanded');
            button.setAttribute('aria-expanded', 'true');

            const plus = item.querySelector('.ma-icon-plus');
            const minus = item.querySelector('.ma-icon-minus');

            if (plus) plus.style.display = 'none';
            if (minus) minus.style.display = '';
          }
        });
      });
      /* -------------------------------------------------------
        MOBILE VISUAL MEGA MENU ACCORDIONS
        ------------------------------------------------------- */

      const mobileVisualAccordionGroups = Array.from(root.querySelectorAll('.ma-mobile-visual-category-group'));

      mobileVisualAccordionGroups.forEach((group) => {
        const button = group.querySelector(':scope > .ma-mobile-visual-category-toggle');

        const content = group.querySelector(':scope > .ma-mobile-visual-category-content');

        if (!button || !content) return;

        button.addEventListener('click', () => {
          const isOpen = group.classList.contains('is-open');

          /* ---------------------------------------------
            Close all other category accordions
            --------------------------------------------- */

          mobileVisualAccordionGroups.forEach((otherGroup) => {
            if (otherGroup === group) return;

            otherGroup.classList.remove('is-open');

            const otherButton = otherGroup.querySelector(':scope > .ma-mobile-visual-category-toggle');

            const otherContent = otherGroup.querySelector(':scope > .ma-mobile-visual-category-content');

            if (otherButton) {
              otherButton.setAttribute('aria-expanded', 'false');
            }

            if (otherContent) {
              otherContent.hidden = true;
            }
          });

          /* ---------------------------------------------
            Toggle current category
            --------------------------------------------- */

          if (isOpen) {
            group.classList.remove('is-open');

            button.setAttribute('aria-expanded', 'false');

            content.hidden = true;
          } else {
            group.classList.add('is-open');

            button.setAttribute('aria-expanded', 'true');

            content.hidden = false;
          }
        });
      });
      /* -------------------------------------------------------
         SEARCH
      ------------------------------------------------------- */

      const searchToggles = root.querySelectorAll('.ma-search-toggle');

      searchToggles.forEach((toggle) => {
        toggle.addEventListener('click', () => {
          const isOpen = root.classList.toggle('search-open');

          searchToggles.forEach((button) => {
            button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });

          if (isOpen) {
            const input = root.querySelector('.ma-search-form input[type="search"]');

            if (input) {
              window.setTimeout(() => input.focus(), 50);
            }
          }
        });
      });

      /* -------------------------------------------------------
         ESCAPE KEY
      ------------------------------------------------------- */

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        closeDesktopMenus();
        closeDrawer();

        if (root.classList.contains('search-open')) {
          root.classList.remove('search-open');

          searchToggles.forEach((button) => {
            button.setAttribute('aria-expanded', 'false');
          });
        }
      });

      /* -------------------------------------------------------
         VIEWPORT SAFETY
      ------------------------------------------------------- */

      const mediaQuery = window.matchMedia(`(max-width: ${root.dataset.mobileBreakpoint}px)`);

      function handleBreakpointChange(event) {
        if (!event.matches) {
          closeDrawer();
        }

        closeDesktopMenus();
      }

      if (mediaQuery.addEventListener) {
        mediaQuery.addEventListener('change', handleBreakpointChange);
      } else {
        mediaQuery.addListener(handleBreakpointChange);
      }
    })();
  </script>
</header>

{% schema %}
{
  "name": "Modern Aussies Header",
  "tag": "header",
  "class": "section-modern-aussies-header",
  "settings": [
    {
      "type": "select",
      "id": "sticky_header",
      "label": "Sticky header",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "on_scroll",
          "label": "Sticky on scroll"
        },
        {
          "value": "always",
          "label": "Sticky always"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Desktop logo width",
      "min": 80,
      "max": 320,
      "step": 5,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 70,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 125
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Navigation accessibility label",
      "default": "Main navigation"
    },
    {
      "type": "range",
      "id": "nav_font_size",
      "label": "Desktop navigation font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "nav_font_weight",
      "label": "Navigation font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "menu_gap",
      "label": "Navigation item spacing",
      "min": 5,
      "max": 45,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Header layout"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Desktop header height",
      "min": 55,
      "max": 120,
      "step": 1,
      "unit": "px",
      "default": 78
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Maximum content width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "mobile_breakpoint",
      "label": "Mobile breakpoint",
      "min": 640,
      "max": 1100,
      "step": 10,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile header horizontal padding",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Header colours"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header background",
      "default": "#F4EFE4"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Header text",
      "default": "#1B2A4A"
    },
    {
      "type": "color",
      "id": "header_hover",
      "label": "Header hover colour",
      "default": "#A47118"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#A47118"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#DED8CA"
    },
    {
      "type": "header",
      "content": "Mega menu"
    },
    {
      "type": "color",
      "id": "mega_background",
      "label": "Mega menu background",
      "default": "#F4EFE4"
    },
    {
      "type": "color",
      "id": "mega_text",
      "label": "Mega menu text",
      "default": "#1B2A4A"
    },
    {
      "type": "range",
      "id": "mega_title_size",
      "label": "Mega menu title size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "mega_link_size",
      "label": "Mega menu link size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "mega_radius",
      "label": "Mega menu radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "mouse_leave_delay",
      "label": "Desktop mouse-leave delay",
      "min": 0,
      "max": 1000,
      "step": 25,
      "unit": "ms",
      "default": 150
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Product title size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "product_price_size",
      "label": "Product price size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#1B2A4A"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Trust bar"
    },
    {
      "type": "checkbox",
      "id": "enable_trust_bar",
      "label": "Enable trust bar",
      "default": true
    },
    {
      "type": "color",
      "id": "trust_background",
      "label": "Trust bar background",
      "default": "#1B2A4A"
    },
    {
      "type": "color",
      "id": "trust_text",
      "label": "Trust bar text",
      "default": "#F4EFE4"
    },
    {
      "type": "header",
      "content": "Header actions"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search products..."
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile typography"
    },
    {
      "type": "range",
      "id": "mobile_nav_font_size",
      "label": "Mobile navigation font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item",
          "info": "Enter the exact top-level navigation item this mega menu belongs to. Example: Home & Living"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Mega menu layout",
          "options": [
            {
              "value": "columns_featured",
              "label": "Columns + featured image"
            },
            {
              "value": "side_image",
              "label": "Side image + columns + products"
            },
            {
              "value": "hero_feature",
              "label": "Large featured hero"
            },
            {
              "value": "links_only",
              "label": "Multi-column links"
            },
            {
              "value": "products_focus",
              "label": "Products + links"
            }
          ],
          "default": "columns_featured"
        },
        {
          "type": "checkbox",
          "id": "show_hot_badge",
          "label": "Show Hot badge",
          "default": false
        },
        {
          "type": "text",
          "id": "hot_badge_text",
          "label": "Hot badge text",
          "default": "Hot"
        },
        {
          "type": "header",
          "content": "Column 1"
        },
        {
          "type": "text",
          "id": "column_1_title",
          "label": "Column 1 title"
        },
        {
          "type": "link_list",
          "id": "column_1_menu",
