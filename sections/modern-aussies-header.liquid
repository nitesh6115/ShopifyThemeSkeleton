{% comment %}
  Modern Aussies Header
  Native Shopify / Dawn-compatible section

  FEATURES
  - Shopify navigation menu
  - Multiple mega-menu layout types
  - Mega menu matched to top-level navigation item
  - Link-list columns
  - Featured image
  - Side image
  - Featured badge/title/description
  - CTA + Shopify URL
  - Product pickers
  - Automatic product URL / image / price / compare-at
  - Trust bar
  - Logo settings
  - Desktop hover mega menu
  - Configurable mouse-leave delay
  - Mobile drawer
  - Mobile expandable submenus
  - Account
  - Cart
  - Currency selector
  - Responsive breakpoint
  - Theme Editor compatible
  - No React
  - No external dependencies
  - No hardcoded product URLs
{% endcomment %}

{%- liquid
  assign menu = section.settings.menu
  assign header_logo = section.settings.logo
  assign cart_count = cart.item_count

  if section.settings.logo_width > 0
    assign logo_width = section.settings.logo_width
  else
    assign logo_width = 150
  endif
-%}

<style>
      #ModernAussiesHeader-{{ section.id }} {
        --ma-header-bg: {{ section.settings.header_background }};
        --ma-header-text: {{ section.settings.header_text }};
        --ma-header-hover: {{ section.settings.header_hover }};
        --ma-accent: {{ section.settings.accent_color }};
        --ma-mega-bg: {{ section.settings.mega_background }};
        --ma-mega-text: {{ section.settings.mega_text }};
        --ma-border: {{ section.settings.border_color }};
        --ma-trust-bg: {{ section.settings.trust_background }};
        --ma-trust-text: {{ section.settings.trust_text }};
        --ma-header-height: {{ section.settings.header_height }}px;
        --ma-logo-width: {{ logo_width }}px;
        --ma-nav-size: {{ section.settings.nav_font_size }}px;
        --ma-nav-weight: {{ section.settings.nav_font_weight }};
        --ma-mega-title-size: {{ section.settings.mega_title_size }}px;
        --ma-mega-link-size: {{ section.settings.mega_link_size }}px;
        --ma-product-title-size: {{ section.settings.product_title_size }}px;
        --ma-product-price-size: {{ section.settings.product_price_size }}px;
        --ma-container-width: {{ section.settings.container_width }}px;
        --ma-menu-gap: {{ section.settings.menu_gap }}px;
        --ma-mega-radius: {{ section.settings.mega_radius }}px;
        --ma-card-radius: {{ section.settings.card_radius }}px;
        --ma-breakpoint: {{ section.settings.mobile_breakpoint }}px;
        --ma-leave-delay: {{ section.settings.mouse_leave_delay }}ms;
        --ma-mobile-logo-width: {{ section.settings.mobile_logo_width }}px;
        --ma-mobile-nav-size: {{ section.settings.mobile_nav_font_size }}px;
        --ma-mobile-padding: {{ section.settings.mobile_padding }}px;

        position: relative;
        z-index: 50;
        width: 100%;
        background: var(--ma-header-bg);
        color: var(--ma-header-text);
      }
        /* =========================================================
        STICKY HEADER
    ========================================================= */

    /* ---------------------------------------------------------
     STICKY ALWAYS
  --------------------------------------------------------- */

  #ModernAussiesHeader-{{ section.id }}.ma-sticky-always {
    position: fixed;
    top: 0;
    z-index: 1000;
  }


  /* ---------------------------------------------------------
     STICKY ON SCROLL
  --------------------------------------------------------- */

  #ModernAussiesHeader-{{ section.id }}.ma-sticky-on_scroll {
    position: fixed;
    top: 0;
    z-index: 1000;
    transition:
      transform .25s ease,
      box-shadow .25s ease;
  }


  /* Header hidden while scrolling down */

  #ModernAussiesHeader-{{ section.id }}.ma-sticky-on_scroll.ma-header-hidden {
    transform: translateY(-100%);
  }


  /* Header visible */

  #ModernAussiesHeader-{{ section.id }}.ma-sticky-on_scroll.ma-header-visible {
    transform: translateY(0);
  }


  /* Shadow after scrolling */

  #ModernAussiesHeader-{{ section.id }}.ma-sticky-scrolled {
    box-shadow: 0 4px 18px rgba(0, 0, 0, .08);
  }
  
      #ModernAussiesHeader-{{ section.id }} *,
      #ModernAussiesHeader-{{ section.id }} *::before,
      #ModernAussiesHeader-{{ section.id }} *::after {
        box-sizing: border-box;
      }

      #ModernAussiesHeader-{{ section.id }} a {
        color: inherit;
        text-decoration: none;
      }

      #ModernAussiesHeader-{{ section.id }} button,
      #ModernAussiesHeader-{{ section.id }} input,
      #ModernAussiesHeader-{{ section.id }} select {
        font: inherit;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-header-main {
        width: 100%;
        min-height: var(--ma-header-height);
        border-bottom: 1px solid var(--ma-border);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-header-container {
        width: min(100% - 40px, var(--ma-container-width));
        min-height: var(--ma-header-height);
        margin: 0 auto;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 30px;
      }

      /* ---------------------------------------------------------
         LOGO
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-logo {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        flex-shrink: 0;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-logo img {
        display: block;
        width: var(--ma-logo-width);
        height: auto;
        max-height: calc(var(--ma-header-height) - 18px);
        object-fit: contain;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-logo-text {
        color: var(--ma-header-text);
        font-size: 22px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -0.03em;
      }

      /* ---------------------------------------------------------
         DESKTOP NAV
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-desktop-nav {
        min-width: 0;
        height: 100%;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-nav-list {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--ma-menu-gap);
        list-style: none;
        padding: 0;
        margin: 0;
        height: 100%;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-nav-item {
        position: static;
        height: 100%;
        display: flex;
        align-items: center;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-nav-link {
        position: relative;
        height: 100%;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding:0;
        color: var(--ma-header-text);
        font-size: var(--ma-nav-size);
        line-height: 1.2;
        font-weight: var(--ma-nav-weight);
        white-space: nowrap;
        transition: color .18s ease;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-nav-link:hover,
      #ModernAussiesHeader-{{ section.id }} .ma-nav-link:focus-visible,
      #ModernAussiesHeader-{{ section.id }} .ma-nav-item.is-open > .ma-nav-link {
        color: var(--ma-header-hover);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 2px;
        background: var(--ma-accent);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform .18s ease;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-nav-item.is-open > .ma-nav-link::after,
      #ModernAussiesHeader-{{ section.id }} .ma-nav-link:hover::after {
        transform: scaleX(1);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-nav-arrow {
        width: 8px;
        height: 8px;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: rotate(45deg) translateY(-2px);
        transition: transform .18s ease;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-nav-item.is-open .ma-nav-arrow {
        transform: rotate(225deg) translate(-1px, -1px);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-hot {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 3px 6px;
        border-radius: 999px;
        background: var(--ma-accent);
        color: #fff;
        font-size: 9px;
        line-height: 1;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
      }

      /* ---------------------------------------------------------
         HEADER ACTIONS
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-shrink: 0;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-action {
        position: relative;
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        background: transparent;
        color: var(--ma-header-text);
        cursor: pointer;
        padding: 0;
        border-radius: 50%;
        transition: background .18s ease, color .18s ease;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-action:hover,
      #ModernAussiesHeader-{{ section.id }} .ma-action:focus-visible {
        color: var(--ma-header-hover);
        background: rgba(164, 113, 24, .08);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-action svg {
        width: 21px;
        height: 21px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.8;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-cart-count {
        position: absolute;
        top: 1px;
        right: 0;
        min-width: 17px;
        height: 17px;
        padding: 0 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: var(--ma-accent);
        color: #fff;
        font-size: 9px;
        line-height: 1;
        font-weight: 800;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-currency {
        display: inline-flex;
        align-items: center;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-currency select {
        appearance: none;
        border: 0;
        background: transparent;
        color: var(--ma-header-text);
        cursor: pointer;
        padding: 5px 18px 5px 3px;
        font-size: 12px;
        font-weight: 700;
        background-image:
          linear-gradient(45deg, transparent 50%, currentColor 50%),
          linear-gradient(135deg, currentColor 50%, transparent 50%);
        background-position:
          calc(100% - 8px) 50%,
          calc(100% - 4px) 50%;
        background-size: 4px 4px, 4px 4px;
        background-repeat: no-repeat;
      }

      /* ---------------------------------------------------------
         SEARCH
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-search-wrap {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        display: none;
        padding: 14px 20px;
        background: var(--ma-header-bg);
        border-bottom: 1px solid var(--ma-border);
        box-shadow: 0 10px 30px rgba(27,42,74,.10);
      }

      #ModernAussiesHeader-{{ section.id }}.search-open .ma-search-wrap {
        display: block;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-search-form {
        width: min(100%, 760px);
        margin: 0 auto;
        display: flex;
        align-items: center;
        border: 1px solid var(--ma-border);
        background: #fff;
        border-radius: 3px;
        overflow: hidden;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-search-form input {
        flex: 1;
        min-width: 0;
        height: 48px;
        border: 0;
        outline: 0;
        padding: 0 15px;
        color: #1B2A4A;
        background: transparent;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-search-form button {
        width: 50px;
        height: 48px;
        border: 0;
        background: var(--ma-accent);
        color: #fff;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      /* ---------------------------------------------------------
         MEGA MENU
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-mega {
        position: absolute;
        z-index: 60;
        top: 100%;
        left: 0;
        right: 0;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-5px);
        transition:
          opacity .16s ease,
          transform .16s ease,
          visibility .16s ease;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-nav-item.is-open .ma-mega {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-mega-inner {
        width: 100%;
        margin: 0 auto;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-mega-panel {
        background: var(--ma-mega-bg);
        color: var(--ma-mega-text);
        border: 1px solid var(--ma-border);
        border-radius: var(--ma-mega-radius);
        box-shadow: 0 18px 50px rgba(27,42,74,.14);
        overflow: hidden;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-mega-content {
        padding: 25px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-mega-heading {
        margin: 0 0 15px;
        color: var(--ma-mega-text);
        font-size: var(--ma-mega-title-size);
        line-height: 1.2;
        font-weight: 800;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-column-heading {
        display: block;
        margin-bottom: 10px;
        color: var(--ma-mega-text);
        font-size: 14px;
        line-height: 1.3;
        font-weight: 800;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-link-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-link-list li + li {
        margin-top: 7px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-link-list a {
        display: inline-block;
        color: var(--ma-mega-text);
        font-size: var(--ma-mega-link-size);
        line-height: 1.4;
        transition: color .16s ease, transform .16s ease;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-link-list a:hover {
        color: var(--ma-accent);
        transform: translateX(2px);
      }

      /* ---------------------------------------------------------
         LAYOUT 1 - COLUMNS + FEATURED
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-layout-columns {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(260px, 1.15fr);
        gap: 25px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-feature-card {
        position: relative;
        min-height: 250px;
        overflow: hidden;
        border-radius: var(--ma-card-radius);
        background: #e8e3d8;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-feature-card img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-feature-overlay {
        position: absolute;
        inset: auto 0 0;
        padding: 20px;
        color: #fff;
        background: linear-gradient(transparent, rgba(0,0,0,.72));
      }

      #ModernAussiesHeader-{{ section.id }} .ma-badge {
        display: inline-flex;
        padding: 5px 8px;
        margin-bottom: 7px;
        border-radius: 3px;
        background: var(--ma-accent);
        color: #fff;
        font-size: 10px;
        line-height: 1;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-feature-title {
        margin: 0 0 5px;
        color: inherit;
        font-size: 21px;
        line-height: 1.15;
        font-weight: 800;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-feature-description {
        margin: 0 0 12px;
        font-size: 13px;
        line-height: 1.45;
      }

      /* ---------------------------------------------------------
         LAYOUT 2 - SIDE IMAGE + COLUMNS + PRODUCTS
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-layout-side {
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr) minmax(320px, 1.2fr);
        gap: 25px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-side-image {
        min-height: 280px;
        overflow: hidden;
        border-radius: var(--ma-card-radius);
        background: #e8e3d8;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-side-image img {
        width: 100%;
        height: 100%;
        min-height: 280px;
        display: block;
        object-fit: cover;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-side-content {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 25px;
      }

      /* ---------------------------------------------------------
         LAYOUT 3 - LARGE HERO
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-layout-hero {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        min-height: 330px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-hero-image {
        min-height: 330px;
        overflow: hidden;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-hero-image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-hero-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 38px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-hero-copy .ma-feature-title {
        color: var(--ma-mega-text);
        font-size: 30px;
        margin-bottom: 12px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-hero-copy .ma-feature-description {
        color: var(--ma-mega-text);
        font-size: 14px;
        max-width: 460px;
        margin-bottom: 20px;
      }

      /* ---------------------------------------------------------
         LAYOUT 4 - LINKS ONLY
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-layout-links {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 30px;
      }

      /* ---------------------------------------------------------
         LAYOUT 5 - PRODUCTS FOCUS
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-layout-products {
        display: grid;
        grid-template-columns: minmax(190px, .75fr) minmax(0, 1.75fr);
        gap: 30px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-products-heading {
        margin: 0 0 15px;
        font-size: 15px;
        font-weight: 800;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-card {
        min-width: 0;
        border: 1px solid var(--ma-border);
        border-radius: var(--ma-card-radius);
        background: var(--ma-mega-bg);
        overflow: hidden;
        transition: transform .18s ease, box-shadow .18s ease;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(27,42,74,.10);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-image {
        position: relative;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #f0ece3;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform .25s ease;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-card:hover .ma-product-image img {
        transform: scale(1.03);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-badge {
        position: absolute;
        left: 8px;
        top: 8px;
        z-index: 1;
        padding: 4px 6px;
        border-radius: 3px;
        background: var(--ma-accent);
        color: #fff;
        font-size: 9px;
        line-height: 1;
        font-weight: 800;
        text-transform: uppercase;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-info {
        padding: 10px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-title {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        margin: 0 0 7px;
        color: var(--ma-mega-text);
        font-size: var(--ma-product-title-size);
        line-height: 1.3;
        font-weight: 700;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-rating {
        display: flex;
        align-items: center;
        gap: 3px;
        margin-bottom: 5px;
        color: var(--ma-accent);
        font-size: 10px;
        letter-spacing: 1px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-product-price {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 7px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-current-price {
        color: var(--ma-mega-text);
        font-size: var(--ma-product-price-size);
        font-weight: 800;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-compare-price {
        color: #777;
        font-size: 12px;
        text-decoration: line-through;
      }

      /* ---------------------------------------------------------
         NEW LAYOUT - VISUAL HOME / PRODUCTS / FEATURED
      --------------------------------------------------------- */

      #ModernAussiesHeader-{{ section.id }} .ma-layout-visual {
        display: grid;
        grid-template-columns: minmax(250px, .78fr) minmax(520px, 1.7fr) minmax(250px, .72fr);
        min-height: 570px;
        background: var(--ma-mega-bg);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-visual-sidebar {
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 24px 20px 18px;
        border-right: 1px solid var(--ma-border);
      }

      #ModernAussiesHeader-{{ section.id }} .ma-visual-eyebrow {
        margin: 0 0 4px;
        color: var(--ma-accent);
        font-size: 13px;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-visual-title {
        margin: 0 0 8px;
        color: var(--ma-mega-text);
        font-size: 30px;
        line-height: 1.08;
        font-weight: 800;
        letter-spacing: -.02em;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-visual-description {
        margin: 0 0 13px;
        color: var(--ma-mega-text);
        font-size: 14px;
        line-height: 1.5;
        opacity: .82;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-visual-trust {
        display: grid;
        gap: 6px;
        margin: 0 0 14px;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-visual-trust-item {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--ma-mega-text);
        font-size: 14px;
        line-height: 1.25;
        font-weight: 600;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-visual-trust-icon {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        border: 1px solid var(--ma-accent);
        border-radius: 50%;
        position: relative;
      }

      #ModernAussiesHeader-{{ section.id }} .ma-visual-trust-icon::after {
