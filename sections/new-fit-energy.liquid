{% comment %}
  New Fit Energy - Product Carousel Section
  Install: Add this file to your theme's "Sections" folder (e.g. sections/new-fit-energy.liquid)
  Then add the section to your template/theme editor as a new section.
{% endcomment %}

<section class="nfe-section" data-section-id="{{ section.id }}">
  <div class="nfe-header">
    <h2 class="nfe-title">{{ section.settings.heading }}</h2>
    <div class="nfe-controls">
      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="nfe-view-all">{{ section.settings.view_all_text | upcase }}</a>
      {% endif %}
      <button class="nfe-arrow nfe-prev" aria-label="Previous">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="nfe-arrow nfe-next" aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  {% if section.settings.show_tabs %}
  <div class="nfe-tabs">
    <button class="nfe-tab active" data-panel="1">{{ section.settings.tab1_label }}</button>
    <button class="nfe-tab" data-panel="2">{{ section.settings.tab2_label }}</button>
  </div>
  {% endif %}

  <div class="nfe-track-wrap">
    {% assign collection1 = collections[section.settings.tab1_collection] %}
    <div class="nfe-track nfe-panel active" id="nfe-track-{{ section.id }}-1" data-panel="1">
      {% render 'nfe-product-cards', collection: collection1, limit: section.settings.products_to_show %}
    </div>

    {% if section.settings.show_tabs %}
      {% assign collection2 = collections[section.settings.tab2_collection] %}
      <div class="nfe-track nfe-panel" id="nfe-track-{{ section.id }}-2" data-panel="2">
        {% render 'nfe-product-cards', collection: collection2, limit: section.settings.products_to_show %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .nfe-section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 24px 60px;
    font-family: inherit;
  }

  .nfe-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
  }

  .nfe-title {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin: 0;
    text-transform: uppercase;
  }

  .nfe-controls {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nfe-view-all {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: underline;
    color: inherit;
    text-underline-offset: 4px;
  }

  .nfe-arrow {
    background: none;
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
  }
  .nfe-arrow:hover { background: #f4f4f4; }

  .nfe-tabs {
    display: inline-flex;
    border: 2px solid #111;
    border-radius: 30px;
    overflow: hidden;
    margin-bottom: 24px;
  }
  .nfe-tab {
    padding: 10px 28px;
    background: #fff;
    border: none;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .nfe-tab.active {
    background: #111;
    color: #fff;
  }

  .nfe-track-wrap {
    position: relative;
  }

  .nfe-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .nfe-track::-webkit-scrollbar { display: none; }

  .nfe-card {
    flex: 0 0 calc(25% - 15px);
    min-width: 260px;
    scroll-snap-align: start;
    position: relative;
  }

  .nfe-image-link {
    display: block;
    position: relative;
    background: #e9e9e7;
    aspect-ratio: 3/4;
    overflow: hidden;
  }

  .nfe-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .nfe-image-link:hover .nfe-image {
    transform: scale(1.03);
  }

  .nfe-badge {
    position: absolute;
    bottom: 14px;
    left: 14px;
    background: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 6px 12px;
    text-transform: uppercase;
  }

  .nfe-wishlist {
    position: absolute;
    top: 14px;
    right: 14px;
    background: none;
    border: none;
    cursor: pointer;
    color: #111;
    padding: 0;
  }

  .nfe-swatches {
    display: flex;
    gap: 6px;
    margin-top: 12px;
  }
  .nfe-swatch {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid #ddd;
    background-size: cover;
    background-position: center;
    display: inline-block;
  }

  .nfe-info {
    margin-top: 8px;
  }
  .nfe-product-title {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin: 4px 0 2px;
  }
  .nfe-product-title a {
    color: inherit;
    text-decoration: none;
  }
  .nfe-subtitle, .nfe-variant {
    font-size: 13px;
    color: #555;
    margin: 0;
    line-height: 1.4;
  }
  .nfe-price {
    font-size: 13px;
    font-weight: 700;
    margin: 4px 0 0;
  }
  .nfe-compare-price {
    font-weight: 400;
    color: #999;
    text-decoration: line-through;
    margin-left: 6px;
  }

  .nfe-empty {
    padding: 40px;
    text-align: center;
    color: #888;
  }

  .nfe-panel {
    display: none;
  }
  .nfe-panel.active {
    display: flex;
  }

  @media (max-width: 990px) {
    .nfe-card { flex: 0 0 calc(50% - 10px); }
    .nfe-title { font-size: 24px; }
  }
  @media (max-width: 600px) {
    .nfe-card { flex: 0 0 80%; }
    .nfe-header { flex-direction: column; gap: 16px; }
  }
</style>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var section = document.querySelector('[data-section-id="' + sectionId + '"]') || document.getElementById('nfe-track-' + sectionId + '-1').closest('.nfe-section');
    var prev = section.querySelector('.nfe-prev');
    var next = section.querySelector('.nfe-next');
    var tabs = section.querySelectorAll('.nfe-tab');
    var panels = section.querySelectorAll('.nfe-panel');

    function activePanel() {
      return section.querySelector('.nfe-panel.active');
    }

    function scrollAmount(track) {
      var card = track.querySelector('.nfe-card');
      return card ? card.getBoundingClientRect().width + 20 : 300;
    }

    prev.addEventListener('click', function() {
      var track = activePanel();
      if (track) track.scrollBy({ left: -scrollAmount(track), behavior: 'smooth' });
    });
    next.addEventListener('click', function() {
      var track = activePanel();
      if (track) track.scrollBy({ left: scrollAmount(track), behavior: 'smooth' });
    });

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        if (tab.classList.contains('active')) return;

        var panelNum = tab.getAttribute('data-panel');

        tabs.forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');

        panels.forEach(function(p) {
          p.classList.toggle('active', p.getAttribute('data-panel') === panelNum);
          if (p.getAttribute('data-panel') === panelNum) {
            p.scrollTo({ left: 0 });
          }
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "New Fit Energy",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW FIT ENERGY"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View all"
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show Women's/Men's tabs",
      "default": true
    },
    {
      "type": "text",
      "id": "tab1_label",
      "label": "Tab 1 label",
      "default": "Women's"
    },
    {
      "type": "collection",
      "id": "tab1_collection",
      "label": "Tab 1 collection"
    },
    {
      "type": "text",
      "id": "tab2_label",
      "label": "Tab 2 label",
      "default": "Men's"
    },
    {
      "type": "collection",
      "id": "tab2_collection",
      "label": "Tab 2 collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "New Fit Energy",
      "category": "Collection"
    }
  ]
}
{% endschema %}
